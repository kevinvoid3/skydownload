"ap22_quest_01_hint_07" = "Due Nest-Werkstatt ist jetzt eröffnet!";
"ap22_quest_01_hint_08" = "Neue Möbel werden regelmäßig eingeführt und kommen häufig wieder.";
"ap22_quest_01_hint_09" = "Sammle , um sie gegen das Set Saison des Nistens einzutauschen.";
"ap22_quest_01_hint_10" = "Etwas stimmt nicht.";
"ap22_quest_01_hint_11" = "Der Nisten-Helfer hat etwas für dich.";
"ap22_quest_01_hint_12" = "Wähle einen Platz für den Hocker, um die Ausstellung zu vervollständigen.";
