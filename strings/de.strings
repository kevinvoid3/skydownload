"season_intro_2_08" = "Eine Gruppe Propheten, die ihre Weisheit mit dir teilen möchten, wartet auf deine Ankunft auf der Insel der Dämmerung.";
"season_intro_2_09" = "Künstler im Ruhestand und Dorfbewohner leben ein einfaches Leben unter dem gewaltigen Kolosseum im Tal des Triumphs.";
"season_intro_2_10" = "Eine Gruppe junger Pfadfinder hat einige Lager im verborgenen Wald aufgeschlagen.";
"season_intro_2_11" = "Die Sterne stehen gut und haben einen Besucher von weit her zum Tresor des Wissens geführt.";
"season_intro_2_12" = "Die Winde enthüllen ein Netz von Gängen über dem Verborgenen Wald.";
"season_intro_2_13" = "Eine Bande von Plünderern hat in der Goldenen Ödnis eine entlegene Insel entdeckt.";
"season_intro_2_14" = "Eine Truppe junger Schauspieler rücken im Tal des Triumphs ins Rampenlicht.";
"season_intro_2_15" = "Finsternis fällt aus dem Auge von Eden auf das Königreich von Sky herab.";
"season_intro_2_16" = "Eine bezaubernde Stimme hallt durch das Tal des Triumphs.";
"season_intro_2_17" = "Unter dem Tresor des Wissens hat sich die Tür zu einem vergessenen Archiv geöffnet. Im Inneren finden Geister Zuflucht.";
