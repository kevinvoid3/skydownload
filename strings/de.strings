"ap31_fetch_letter_hint1" = "Bringe Vincents Brief zu Theo";
"ap31_flowertouch_hint1" = "Nähere dich Theos Sonnenblume";
"ap31_fq1_letter1_part1" = "Ich freue mich schon auf Weihnachten.";
"ap31_fq1_letter1_part2" = "Vor zwei Jahren gingen wir abends im Schnee spazieren –";
"ap31_fq1_letter1_part3" = "erinnerst du dich noch daran?";
"ap31_fq1_letter1_part4" = "Als wir den Mond über Mariënhof aufgehen sahen?";
"ap31_fq1_letter2_part1" = "Ich kann nicht in Worte fassen, wie froh ich bin,";
"ap31_fq1_letter2_part2" = "wieder mit der Malerei angefangen zu haben!";
"ap31_fq1_letter2_part3" = "Ich hatte schon lange darüber nachgedacht,";
"ap31_fq1_letter2_part4" = "aber ich hielt es immer für unmöglich und unerreichbar für mich.";
"ap31_fq1_letter3_part1" = "Gräber, Sämänner, Pflüger, Männer und Frauen –";
"ap31_fq1_letter3_part2" = "ich muss sie alle immerzu malen.";
"ap31_fq1_letter3_part3" = "Alles, was zum Landleben gehört, muss ich untersuchen und malen.";
"ap31_fq1_letter3_part4" = "Ich fühle im Angesicht der Natur nicht mehr so hilflos wie es einst der Fall war!";
"ap31_fq1_letter4_part1" = "Die Malerei fällt mir leichter, als ich es je für möglich gehalten hätte.";
"ap31_fq1_letter4_part2" = "Vielleicht ist das der beste Weg ... Meine ganze Anstrengung in ein Gemälde zu stecken?";
"ap31_fq1_letter4_part3" = "Ich muss gestehen ...";
"ap31_fq1_letter4_part4" = "...ich habe keine Ahnung.";
"ap31_fq1_letter5_part1" = "Das Geld ist mir noch nicht ganz ausgegangen,";
"ap31_fq1_letter5_part2" = "aber es ist nicht mehr viel übrig.";
"ap31_fq1_letter5_part3" = "Ich muss eine große Summe für Malerbedarf ausgeben.";
"ap31_fq1_letter5_part4" = "Hoffentlich kannst du mir bald etwas schicken.";
"ap31_fq2_letter1_part1" = "Ich wusste nicht einmal, wer die Impressionisten sind.";
"ap31_fq2_letter1_part2" = "Jetzt habe ich sie gesehen,";
"ap31_fq2_letter1_part3" = "und auch wenn ich noch nicht dazugehöre,";
"ap31_fq2_letter1_part4" = "habe ich große Bewunderung für die Gemälde einiger bestimmter Impressionisten.";
"ap31_fq2_letter2_part1" = "Ich habe dir einige Malereien geschickt.";
"ap31_fq2_letter2_part2" = "Sag mir,";
"ap31_fq2_letter2_part3" = "warum sie sich nicht verkaufen.";
"ap31_fq2_letter2_part4" = "Und wie ich malen soll, damit sich das ändert?";
"ap31_fq2_letter3_part1" = "Ich hoffe, mich so zu verbessern,";
"ap31_fq2_letter3_part2" = "dass du mit Zuversicht";
"ap31_fq2_letter3_part3" = "meine Arbeit zeigen wirst,";
"ap31_fq2_letter3_part4" = "ohne Schande über dich zu bringen.";
"ap31_fq3_letter1_part1" = "Ich will dieses Jahr wahre Fortschritte machen.";
"ap31_fq3_letter1_part2" = "Fortschritte die ich,";
"ap31_fq3_letter1_part3" = "um ehrlich zu sein,";
"ap31_fq3_letter1_part4" = "bitter nötig habe.";
"ap31_fq3_letter2_part1" = "Ich plane mit solcher Sorgfalt,";
"ap31_fq3_letter2_part2" = "und doch stellte sich heute heraus, dass ich für die zehn Meter Leinwand alle Farben perfekt kalkuliert hatte,";
"ap31_fq3_letter2_part3" = "mit einer Ausnahme:";
"ap31_fq3_letter2_part4" = "dem grundlegenden Gelb.";
"ap31_fq3_letter3_part1" = "Ich hatte noch nie solches Glück, denn die Natur hier ist außergewöhnlich schön.";
"ap31_fq3_letter3_part2" = "Alles und überall.";
"ap31_fq3_letter3_part3" = "Das Himmelsgewölbe ist ein herrliches Blau, die Sonne strahlt wie heller Schwefel ...";
"ap31_fq3_letter3_part4" = "So weich und bezaubernd wie die himmlischen Blau- und Gelbtöne von Vermeer van Delft.";
"ap31_fq3_letter3_part5" = "Ich vermag nichts so Schönes zu malen.";
"ap31_fq3_letter3_part6" = "Aber es fesselt mich so sehr, dass ich mich vergesse.";
"ap31_fq3_letter4_part1" = "Ich wollte das Haus nicht nur für mich selbst einrichten, sondern so, dass es noch jemanden beherbergen könnte.";
"ap31_fq3_letter4_part2" = "Dies hat natürlich den Großteil des Geldes verbraucht.";
"ap31_fq3_letter4_part3" = "Mit dem übrigen Geld habe ich zwölf Stühle gekauft,";
"ap31_fq3_letter4_part4" = "einen Spiegel";
"ap31_fq3_letter4_part5" = "und einige wenige unerlässliche Dinge.";
"ap31_fq3_letter4_part6" = "Das heißt, dass ich nächste Woche einziehen kann!";
"ap31_fq3_letter5_part1" = "Ich bin so zufrieden mit dem Haus und mit der Arbeit,";
"ap31_fq3_letter5_part2" = "… dass ich daran zu glauben wage, dass diese Freude nicht allein meine sein wird,";
"ap31_fq3_letter5_part3" = "sondern dass du daran teilhaben wirst, indem auch dir das Glück gewogen sein wird.";
"ap31_fq3_letter6_part1" = "Ich freue mich darauf, mein Haus einrichten zu können – und das wird mir sicher helfen, durchzuhalten.";
"ap31_fq4_letter1_part1" = "Es würde mich so freuen,";
"ap31_fq4_letter1_part2" = "wenn du mich besuchen könntest, um Jo und unser kleines Baby zu sehen!";
"ap31_fq4_letter1_part3" = "Wie wir bereits erwähnten,";
"ap31_fq4_letter1_part4" = "haben wir ihn nach dir benannt.";
"ap31_fq4_letter2_part1" = "Nun, weißt du, worauf ich hoffe, wenn ich mir die Hoffnung erlaube?";
"ap31_fq4_letter2_part2" = "Dass die Familie dir sein wird,";
"ap31_fq4_letter2_part3" = "was die Natur für mich ist.";
"ap31_fq4_letter2_part4" = "Die Erdklumpen, das Gras, der gelbe Weizen, der Bauer.";
"ap31_fq4_letter3_part1" = "Dieser Schrecken des Lebens ist bereits weniger ausgeprägt.";
"ap31_fq4_letter3_part2" = "Die Melancholie weniger drängend.";
"ap31_fq4_letter3_part3" = "Doch Motivation, die habe ich überhaupt nicht ... Wenige Begehren, wenn überhaupt.";
"ap31_fq4_letter3_part4" = "Und fast gar nichts von dem, was zu einem gewöhnlichen Leben gehört.";
"ap31_fq4_letter4_part1" = "Ich arbeite ohne Unterlass in meinem Zimmer,";
"ap31_fq4_letter4_part2" = "was mir guttut,";
"ap31_fq4_letter4_part3" = "und, wie ich denke,";
"ap31_fq4_letter4_part4" = "diese abnormen Gedanken verjagt.";
"ap31_fq4_letter5_part1" = "Seit sechs Wochen habe ich keinen Fuß nach draußen gesetzt ...";
"ap31_fq4_letter5_part2" = "...nicht einmal in den Garten.";
"ap31_fq4_letter5_part3" = "Nächste Woche,";
"ap31_fq4_letter5_part4" = "wenn die Leinwände, an denen ich gerade arbeite, fertig sind,";
"ap31_fq4_letter5_part5" = "werde ich es jedoch versuchen.";
"ap31_fq4_letter6_part1" = "Hier und da habe sogar ich Freunde gefunden, und Dinge, die ich liebe.";
"ap31_fq4_letter6_part2" = "Kannst du es dann verstehen,";
"ap31_fq4_letter6_part3" = "dass ich, trotz meines schrecklichen Leidens,";
"ap31_fq4_letter6_part4" = "hier dennoch Bindungen gebildet habe,";
"ap31_fq4_letter6_part5" = "die etwas zu tief sind?";
"ap31_fq4_letter7_part1" = "Mehr und mehr sehe ich Verrücktheit als eine Krankheit, so wie jeder andere.";
"ap31_fq4_letter7_part2" = "Der Wechsel der Umgebung ist gut für mich.";
"ap31_fq4_letter7_part3" = "Der Arzt hier ist geneigt, das, was mir widerfährt, als etwas Ähnliches wie einen epileptischen Anfall zu betrachten.";
"ap31_fq4_letter7_part4" = "Aber ich habe mich damit nicht befasst.";
"ap31_fq5_date1" = "Sechs Monate später";
"ap31_fq5_date2" = "Zwei Tage später";
"ap31_fq5_letter1_part1" = "Neben dem Kind";
"ap31_fq5_letter1_part10" = "zu zeigen und bewundert werden zu lassen,";
"ap31_fq5_letter1_part11" = "so viel wie möglich.";
"ap31_fq5_letter1_part2" = "hat er mir noch eine weitere Aufgabe überlassen:";
"ap31_fq5_letter1_part3" = "für das Kind alle Schätze vollständig zu erhalten,";
"ap31_fq5_letter1_part4" = "die Theo und Vincent gesammelt haben.";
"ap31_fq5_letter1_part5" = "Auch das ist meine Arbeit.";
"ap31_fq5_letter1_part6" = "Ich lebe gänzlich in meinen Gedanken mit Theo und Vincent.";
"ap31_fq5_letter1_part7" = "Oh, wie unendlich innig und süß und liebend war ihr Verhältnis zueinander!";
"ap31_fq5_letter1_part8" = "Wie sie für den anderen fühlten und wie sie sich gegenseitig verstanden!";
"ap31_fq5_letter1_part9" = "Die Arbeit von Vincent";
"ap31_fq6_diary_part1" = "Neben dem Kind,";
"ap31_fq6_diary_part2" = "wurde mir eine weitere Aufgabe hinterlassen…";
"ap31_fq6_diary_part3" = "Vincents Gemälde.";
"ap31_fq6_diary_part4" = "Ich muss sie zeigen.";
"ap31_fq6_diary_part5" = "Ich muss sicherstellen, dass sie gewürdigt werden.";
"ap31_fq6_diary_part6" = "Diese Gemälde sind Schätze.";
"ap31_fq6_diary_part7" = "Sie dürfen nicht vergessen werden.";
"ap31_fq6_diary_part8" = "Die Welt muss sich daran erinnern, wer er war.";
"ap31_fq6_endletter_1" = "Du darfst nicht glauben, dass deine Arbeit ohne Wert ist.";
"ap31_fq6_endletter_2" = "Verliere nicht den Mut. Es liegen bessere Tage voraus.";
"ap31_fq6_endletter_3" = "Du bist nicht allein ... Ich denke immer an dich.";
"ap31_fq6_endletter_4" = "Eines Tages werden die Menschen verstehen, was du wirklich zu tun versuchst.";
"ap31_fq6_epilogue2_part1" = "Über einen Zeitraum von 10 Jahren fertigte Vincent über 800 Gemälde an,";
"ap31_fq6_epilogue2_part2" = "sowie über 1.000 Zeichnungen und Skizzen.";
"ap31_fq6_epilogue2_part3" = "Er konnte nur einige wenige davon verkaufen.";
"ap31_fq6_epilogue_part1" = "Johanna widmete ihr Leben dafür, die Hunderte von Van-Gogh-Kunstwerken und Briefen, die sie geerbt hatte, der Öffentlichkeit bekannt zu machen.";
"ap31_fq6_epilogue_part2" = "Nach 15 Jahren der Beharrlichkeit wurde eine Ausstellung von Van Gogh im Städtischen Museum in Amsterdam gehalten.";
"ap31_fq6_epilogue_part3" = "Sie festigte Vincents Ruf als Künstler.";
"ap31_fq6_epilogue_part4" = "Bis heute bleibt es die größte Van-Gogh-Ausstellung mit über 230 Gemälden.";
