"ap26_chase_intro" = "Fange den blauen Vogel, um seine wahre Natur zu enthüllen.";
"ap26_feather_hint" = "Eine blaue Feder! Der Vogel muss in der Nähe sein ...";
"ap26_fetch01_fragment_intro_00" = "Sammle Federn des blauen Vogels, um die Feier zu verschönern!";
"ap26_fetch01_intro_00" = "„Ich kenne einen Vogel, blau wie Saphire ...";
"ap26_fetch01_intro_01" = "Dem königlichen Haarwuschel-Teenager zur Zitadelle folgen, um den blauen Vogel zu suchen?";
"ap26_fetch01_intro_02" = "... dessen Gezwitscher bei üppigen Festmahlen ertönt.“";
"ap26_fetch01_outro_01" = "„Ein Vogel ward gefunden, mit blauen Federn ...";
"ap26_fetch01_outro_02" = "... doch er verflüchtigte sich wie Kerzenrauch.“";
"ap26_fetch02_intro_00" = "„Ich kenne einen Vogel, blau wie die Augen meiner Mutter ...";
"ap26_fetch02_intro_01" = "Der Nostalgischen Wunderkerzen-Mutter zum Tresorarchiv folgen, um den Blauen Vogel zu suchen?";
"ap26_fetch02_intro_02" = "... dessen Rufe in unseren kostbaren Erinnerungen widerhallen.“";
"ap26_fetch02_mem_01" = "„Geliebte Enkeltochter, wir haben für dich diese Schaukel an unserem Lieblingsbaum befestigt.“";
"ap26_fetch02_mem_02" = "„Schau an, wie hoch du jetzt hinauskommst!“";
"ap26_fetch02_mem_03" = "„Mein Kind, es ist wundervoll, nach all dieser Zeit mit dir hierher zurückzukehren.“";
"ap26_fetch02_outro_02" = "... doch je fester wir ihn hielten, desto schneller schwand er.“";
"ap26_fetch03_hint_01" = "Vielleicht würde der Vogel sich über eine Performance von euch beiden freuen!";
"ap26_fetch03_hint_02" = "Aber dafür brauchst du passende Kleidung ...";
"ap26_fetch03_intro_00" = "„Ich kenne einen Vogel, blau wie Indigostoff ...";
"ap26_fetch03_intro_01" = "Der verkleideten Konfetti-Cousine in die Sternenlichtwüste folgen, um den blauen Vogel zu suchen?";
"ap26_fetch03_intro_02" = "... dessen Rufe ertönen, wann immer sich staunende Mengen einfinden.";
"ap26_fetch03_outro_02" = "... doch er löst sich auf wie ein loser Faden.“";
"ap26_fetch04_dialog_01" = "„Dieser friedliche Wald ist das Zuhause vieler bunter Vögel.“";
"ap26_fetch04_dialog_02" = "„Ich bin sicher, dass wir den blauen Vogel hier finden können!“";
"ap26_fetch04_intro_00" = "„Ich kenne einen Vogel, blau wie ein unberührter Fluss ...";
"ap26_fetch04_intro_01" = "Dem Holzfällenden Bittenden Vater zum Verborgenen Wald folgen, um den blauen Vogel zu suchen?";
"ap26_fetch04_intro_02" = "... dessen Ruf die friedliche Harmonie des Waldes widerspiegelt.“";
"ap26_fetch04_outro_01" = "„Ein Vogel ward gefunden, mit blauen Federn ...";
"ap26_fetch04_outro_02" = "... aber er verlor sich im Wind und übrig blieb nur die Stille.“";
"ap26_fetch05_intro_00" = "„Ich kennen einen Vogel, blau wie die Sterne ...";
"ap26_fetch05_intro_01" = "Dem Hellseherischen Weisen Großvater folgen, um den blauen Vogel zu suchen?";
"ap26_fetch05_intro_02" = "... dessen Ruf verkündet, wo große Schicksale geboren werden.“";
"ap26_fetch05_outro_01" = "„Ein Vogel ward gefunden, mit blauen Federn ...";
"ap26_fetch05_outro_02" = "... aber wie das Schicksal war er nicht dazu bestimmt, nur gehalten zu werden.“";
"ap26_fetch05_quest_01" = "„Diese Kinder kennen ihre Schicksale und sind auf dem Weg, geboren zu werden.“";
"ap26_fetch05_quest_02" = "„Andere brauchen Hilfe vom blauen Vogel, um ihr Schicksal laut aussprechen zu können.“";
"ap26_fetch05_quest_03" = "„Offenbare mir dein Schicksal, Kind.“";
"ap26_fetch05_quest_04" = "„Ich werde Gärtner und wundervolle Dinge wachsen lassen!“";
"ap26_fetch05_quest_05" = "„Wenn ich geboren werde, werde ich Maschinen entwickeln, die die Kranken heilen!“";
"ap26_fetch05_quest_06" = "„Ich werde Lieder singen, die den Hoffnungslosen Hoffnung geben!“";
"ap26_fetch05_quest_07" = "„Dein Schicksal zu kennen, ist erst der Anfang ...“";
"ap26_fetch06_quest_01" = "Wen schätzt du mehr als Reichtum?";
"ap26_fetch06_quest_02" = "Welche Erinnerung treibt dich an?";
"ap26_fetch06_quest_03" = "Wenn du in den Spiegel schaust, welches Selbst siehst du?";
"ap26_fetch06_quest_04" = "Warum stören wir unsere eigene Harmonie?";
"ap26_fetch06_quest_05" = "Wie lange wirst du warten, ehe du dein Schicksal verfolgst?";
"ap26_fetch06_quest_06" = "„Wo ist dein blauer Vogel?“";
"ap26_fetchintro_hint_01" = "Um den Kummer dieses Kindes zu heilen, musst du den blauen Vogel finden.";
"ap26_prologue_00" = "Ein Kind wurde von einer mächtigen und anhaltenden Trauer ergriffen.";
"ap26_prologue_01" = "Die Familie des Kindes hat sich eingefunden, um ihm den Kummer zu nehmen.";
"ap26_prologue_02" = "Gemeinsam müsst ihr den legendären blauen Vogel finden und zurückbringen!";
