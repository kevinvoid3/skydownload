"ap24_void_quests_confirm_menu" = "Das folgende Abenteuer wird allein erlebt. Währenddessen wirst du deine Freunde nicht sehen. Möchtest du fortfahren?";
"ap25_attract_mote" = "Das farbige Licht ist auf diesen Schmetterling übergegangen ...\n\nAnlocken, damit er etwas farbiges Licht mit dir teilt?";
"ap25_color_returned_black" = "Du hast das schwarze Licht zur Farben-Werkstatt zurückgebracht!\nDie Geister benötigen noch eine Farbe ...";
"ap25_color_returned_blue" = "Du hast das blaue Licht zur Farben-Werkstatt zurückgebracht!\nDie Geister benötigen noch eine Farbe ...";
"ap25_color_returned_cyan" = "Du hast das türkise Licht zur Farben-Werkstatt zurückgebracht!\nDie Geister benötigen noch eine Farbe ...";
"ap25_color_returned_green" = "Du hast das grüne Licht zur Farben-Werkstatt zurückgebracht!\nDie Geister benötigen noch eine Farbe ...";
"ap25_color_returned_magenta" = "Du hast das lila licht zur Farben-Werkstatt zurückgebracht!\nDie Geister benötigen noch eine Farbe ...";
"ap25_color_returned_red" = "Du hast das rote Licht zur Farben-Werkstatt zurückgebracht!\nDie Geister benötigen noch eine Farbe ...";
"ap25_color_returned_white" = "Du hast das weiße Licht zur Farben-Werkstatt zurückgebracht!\nDie Geister benötigen noch eine Farbe ...";
"ap25_color_returned_yellow" = "Du hast das gelbe Licht zur Farben-Werkstatt zurückgebracht!\nDie Geister benötigen noch eine Farbe ...";
"ap25_dye_introduced" = "Jetzt kannst du die Werkstatt nutzen, um kosmetische Gegenstände zu färben.";
"ap25_fetch01_intro_00" = "Farbiges Licht könnte in bestimmten Dunkelpflanzen eingeschlossen sein.";
"ap25_fetch01_intro_01" = "Bringe gelbes Licht von den neuen Dunkelpflanzen in der Tageslichtprärie zurück.";
"ap25_fetch02_intro_00" = "Einige Arten von farbigem Licht treten seltener auf.";
"ap25_fetch02_intro_01" = "Bringe türkises Licht von den neuen Dunkelpflanzen im Verborgenen Wald zurück.";
"ap25_fetch03_intro_01" = "Bringe lila licht von den neuen Dunkelpflanzen in der Goldenen Ödnis zurück.";
"ap25_fetch04_intro_00" = "Bring seltenes weißes Licht und schwarzes Licht von Orten wie dem Präriegipfel und dem Auge von Eden zurück.";
"ap25_fetch05_intro_00" = "Die Geister möchten dir zu Ehren ihre Stile anpassen! Kreiere einen Stil für dich selbst und die Geister.";
"ap25_fetch05_intro_00_b" = "Nutze die Farben-Werkstatt, um dich dem Gruppenstil der Geister anzupassen.";
"ap25_found_dye" = "Liefere dieses farbige Licht an die Leuchten-Helferin in der Farben-Werkstatt im Volieren-Dorf.";
