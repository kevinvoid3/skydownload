"drinking_text1" = "Alle waren dieses Jahr so fleißig beim Aufbauen!";
"drinking_text10" = "Man glaubt es kaum, aber alles in Sky hat ein Skelett! Knochen! Sogar das HAAR hat Knochen!";
"drinking_text11" = "Ich habe gehört, dass es früher Muffins und Pizza gab … aber dann wurde alles aufgegessen.";
"drinking_text12" = "Ich bin eigentlich Klon 73. Samantha übt gerade für ihren Auftritt.";
"drinking_text13" = "Ich habe mal gehört, dass Ash unten im Kühlschrank eine Ananaspizza vergessen hat, aber das ist schon Jahre her.";
"drinking_text14" = "Sogar die Mitarbeiter debattieren über die Farbe mancher Umhänge! Errätst du, welche?";
"drinking_text15" = "Es gibt mehr TGC-Haustiere als TGC-Mitarbeiter! Die meisten von ihnen sind Katzen.";
"drinking_text16" = "Hier gibt es so viele Orte zu entdecken!";
"drinking_text17" = "Falls du zu viel trinkst, befindet sich unten eine Toilette. Keine Sorge, diesmal wirst du nicht hineingezogen.";
"drinking_text18" = "An der Jam-Station kannst du zusammen mit Freunden Musik machen.";
"drinking_text2" = "Ich habe gesehen, wie sie sich für die Aufführungen vorbereiten.";
"drinking_text3" = "Wusstest du, dass die Mitarbeiter von TGC für uns auftreten werden?";
"drinking_text4" = "Ich habe gehört, dass jede Aufführung ein bisschen von der Kreativität des Designers zeigt!";
"drinking_text5" = "Ich habe gehört, dass es 30 Minuten nach jeder vollen Stunde eine Gruppenaufführung gibt.";
"drinking_text6" = "Hast du den Auftritt der Designer schon gesehen?! Da passieren tolle Sachen auf der Bühne.";
"drinking_text7" = "Manche Leute spielen gerne mit dunklen Drachen! Ich aber nicht. Nie im Leben.";
"drinking_text8" = "Hast du schon mal durch das Dachfenster geschaut und dich gefragt, ob das vielleicht alles nur eine Simulation ist?";
"drinking_text9" = "Neben der Bühne stehen ein paar riesige Lautsprecher. Was für eine Party!";
