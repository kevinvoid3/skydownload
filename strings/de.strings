"ap14_story_tree_1a2a3a4a_abv" = "Er zersplitterte ...";
"ap14_story_tree_1a2a3a4a_cont" = "Der Nachthimmel pulsierte hell. Wo einst ein Stern leuchtete, waren gerade unzählige andere winzige Punkte entstanden.";
"ap14_story_tree_1a2a3a4a_cont_abv" = "Der Nachthimmel pulsierte hell ...";
"ap14_story_tree_1a2a3a4b" = "Er spendet einem einsamen Kind, das allein durch die Wüste streifte, sein Licht";
"ap14_story_tree_1a2a3a4b_abv" = "Er spendete sein Licht ...";
"ap14_story_tree_1a2a3a4b_cont" = "Geleitet von seinem Licht, offenbarte sich dem Kind der Weg nach vorne. Von nun an würde es nie mehr allein sein.";
"ap14_story_tree_1a2a3a4b_cont_abv" = "Geleitet von seinem Licht ...";
"ap14_story_tree_1a2a3a_abv" = "Er konnte es nicht länger in sich speichern ...";
"ap14_story_tree_1a2a3a_cont" = "In einem Akt der Selbstlosigkeit ...";
"ap14_story_tree_1a2a3b" = "Sein Licht hüllte den ganzen Himmel ein";
"ap14_story_tree_1a2a3b4a" = "Er konnte nichts als seine blendenden Strahlen sehen";
"ap14_story_tree_1a2a3b4a_abv" = "Er konnte nichts sehen ...";
"ap14_story_tree_1a2a3b4a_cont" = "Schweigend und allein dämpfte er sein Licht, bis wieder Umrisse zu erkennen waren. Er wusste, dass sein Leuchten sinnlos war, da es nichts erhellen konnte.";
