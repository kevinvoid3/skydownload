"mischief_sam_chat_32" = "Was ist mit euch drei passiert?";
"mischief_sam_chat_33" = "Wirklich sehr seltsam …";
"mischief_sam_chat_34" = "Was ist das da drüben?";
"mischief_sam_chat_35" = "Was macht dieser Krebs mit Jenovas Hut?";
"mischief_sam_chat_36" = "Hmmm. Woher kommt unser kleiner Freund denn?";
"mischief_sam_chat_37" = "Was soll das heißen, die kam aus meinem Kopf?!";
"mischief_sam_chat_38" = "Vergiss sie. Yoshi und Nat geht es gut?! Gut gemacht!";
"mischief_sam_chat_39" = "Jenovas Stimme klingelt in meinen Ohren, kannst du das hören?";
"mischief_sam_chat_4" = "Was sollen wir jetzt tun?";
"mischief_sam_chat_40" = "Behalte einen klaren Kopf!";
"mischief_sam_chat_41" = "Ich spüre, dass die Krill-Katze hinter allem steckt … mal wieder.";
"mischief_sam_chat_42" = "Suche nach Hinweisen in der Höhle der Krill-Katze. Beeil dich!";
"mischief_sam_chat_5" = "Sollten sich nicht Yoshi und Nat darum kümmern?";
"mischief_sam_chat_6" = "Ich hätte schwören können, dass ich sie hier unten gesehen habe …";
"mischief_sam_chat_7" = "Vielleicht kannst du sie finden!";
"mischief_sam_chat_8" = "Was ist das für ein Geräusch?!";
"mischief_sam_chat_9" = "Was machen wir jetzt?";
"mischief_sam_clone_chat_1" = "H …Hallo … ist das Ding an? Klon 42 meldet sich zum Dienst!";
"mischief_sam_clone_chat_2" = "Willkommen im Pool der verschrotteten Ideen.";
"mischief_sam_clone_chat_3" = "Die waren wirklich schrecklich, lass sie am besten hier.";
"mischief_sam_clone_chat_4" = "Ich nehme an, du bist auf der Suche nach dem Outfit vom letzten Jahr?";
"mischief_sam_clone_chat_5" = "Nicht retro genug? Vielleicht kann Nat helfen!";
"mischief_sam_hint_chat_1" = "Die Legende spricht von– aahh!";
"mischief_sam_hint_chat_2" = "Irgendetwas stimmt nicht ganz. Lass uns nachforschen!";
"mischief_sam_hint_chat_3" = "Mein Gehirn ist in letzter Zeit so benebelt …";
"mischief_sam_riddle_1" = "Ich schwöre, ich habe Nat mit einem Stapel von Reikas Klamotten weglaufen sehen …";
"mischief_sam_riddle_2" = "Hast du Yoshis Krebs gesehen? Ist gerade vorbeigekrabbelt, mit einer Kiste auf dem Kopf.";
"mischief_sam_riddle_3" = "Ist da gerade ein Besen vorbeigeflogen?";
"mischief_sam_riddle_4" = "Ich wette, Yoshi hat versucht, gegen den Dunkeldrachen anzutreten und verloren. Jemand sollte nach ihm sehen …";
"mischief_sam_riddle_5" = "Blubb blubb …";
"mischief_sam_riddle_6" = "Miezmiezmiezmiez …";
"mischief_samantha_officechat_1" = "Hallihallo!";
"mischief_samantha_officechat_2" = "Was ich hier mache? Nun, weißt du … nach dem Aufruhr, den wir letztes Jahr verursacht haben …";
"mischief_samantha_officechat_3" = "Wurde ich zum Aufräumkommando verbannt.";
"mischief_samantha_officechat_4" = "Verrate es nicht dem Management, aber ich bin eigentlich Klon 13.";
"mischief_samantha_officechat_5" = "Übrigens, hast du die Katze von Atlas gesehen?";
"mischief_samantha_officechat_6" = "Ich habe sie neulich aufgeschreckt und sie seitdem nicht mehr gesehen.";
"mischief_samantha_officechat_7" = "Ich fange an, mir Sorgen zu machen …";
"mischief_skidmore_chat_1" = "Oh, nein, Samantha! Das wird dem Management gar nicht gefallen …";
"mischief_skidmore_chat_10" = "Ich muss hier raus!";
"mischief_skidmore_chat_11" = "Hier drüben ist eine Öffnung, geht sie ganz durch?";
"mischief_skidmore_chat_12" = "Wohin sind alle verschwunden? Was ist da draußen los?";
"mischief_skidmore_chat_13" = "Streiche. Überall Streiche …";
"mischief_skidmore_chat_14" = "Nat! Yoshi! Hier seid ihr also hin!";
"mischief_skidmore_chat_15" = "Wir müssen euch beide hier rausholen …";
"mischief_skidmore_chat_16" = "Samanthaaaaa!!!";
"mischief_skidmore_chat_17" = "Keine Ahnung, ich bin hier unten aufgewacht.";
"mischief_skidmore_chat_18" = "Helfen wir den beiden, sie sehen nicht so gut aus.";
"mischief_skidmore_chat_2" = "Das ist der Grund, warum wir keine schönen Dinge haben können …";
"mischief_skidmore_chat_3" = "Fang an, zu arbeiten! Drück auf den Knopf! Heiz dem Kessel ein!";
"mischief_skidmore_chat_4" = "Diese Schlitzohren! Wohin sind sie abgehauen?";
"mischief_skidmore_chat_5" = "Oh nein, Samantha! Nicht schon wieder …";
"mischief_skidmore_chat_6" = "Das wird dem Management gar nicht gefallen …";
"mischief_skidmore_chat_7" = "Wir können einfach keine schönen Dinge haben, oder?";
"mischief_skidmore_chat_8" = "Wir brauchen Verstärkung!! Geh Nat und Yoshi suchen!";
"mischief_skidmore_chat_9" = "Bevor du gehst, hilfst du uns, den Kessel zum Laufen zu bringen?";
"mischief_skidmore_riddle_1" = "Yoshi hat etwas von einem kleinen Imbiss gesagt. Schau nach, ob du ihm helfen kannst.";
"mischief_skidmore_riddle_2" = "Hast du da eben Weinen gehört?";
"mischief_skidmore_riddle_3" = "Sag dem Management nicht, dass wir unsere eigene Party feiern!";
"mischief_skidmore_riddle_4" = "Hast du Angst im Dunkeln? Ich schon!";
"mischief_skidmore_riddle_5" = "Ist dieses Himmelskind gerade vor meinen Augen geschrumpft?!";
"mischief_skidmore_riddle_6" = "Krebse mit Hüten … Was fällt ihnen als nächstes ein … Krill?";
"mischief_skidmore_riddle_7" = "Die Party ist dieses Jahr offiziell abgesegnet. Wir versprechen es!";
"mischief_skidmore_riddle_8" = "Krebse mit Hüten … Was fällt ihnen als nächstes ein … Eine Krill-Achterbahn?";
"mischief_skidmore_riddle_9" = "Was ist das für ein knirschendes Geräusch, das von oben kommt?";
"mischief_yoshi_chat_1" = "Zum Glück hast du mich gefunden!";
"mischief_yoshi_chat_10" = "Haaah …";
"mischief_yoshi_chat_11" = "Ich fühle mich komisch …";
"mischief_yoshi_chat_2" = "Es waren 84 Jahre …";
"mischief_yoshi_chat_3" = "Fühlt sich an, als würde ich zu einem Fossil werden.";
"mischief_yoshi_chat_4" = "So hungrig …";
"mischief_yoshi_chat_5" = "Ich hab schon überlegt, diesen Kürbishut zu essen … aber vielleicht möchtest du ihn haben?";
"mischief_yoshi_chat_6" = "Zum Glück haben du und Nat mich gefunden!";
"mischief_yoshi_chat_7" = "Ich fühle mich, als würde ich mich in ein Fossil verwandeln. Genau wie dieses alte Kostüm.";
