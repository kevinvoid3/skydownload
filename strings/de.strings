"ap22_quest_02_hint_05" = "Kehre zum Nisten-Helfer zurück.";
"ap22_quest_02_hint_06" = "Es funktioniert! Ziehe an dem Hebel, um zu sehen, wohin er dich führt.";
"ap22_quest_02_hint_07" = "Willkommen!";
"ap22_quest_02_hint_08" = "Dieses Nest ist für dich.";
"ap22_quest_02_hint_09" = "Ein Ort zum Dekorieren, Entspannen, Spielen und Teilen mit Freunden.";
"ap22_quest_02_hint_10" = "Interagiere zunächst mit dem Nest-Schrein.";
"ap22_quest_02_hint_11" = "Nutze das Bearbeitungsmenü, um neue Dekorationen zu platzieren.";
"ap22_quest_02_hint_12" = "Gut! Wenn du bereit bist, kehre zum Nest-Schrein zurück, um dein Arrangement zu speichern.";
"ap22_quest_02_hint_13" = "Glückwunsch! Dies ist nur der erste Schritt deines Nestabenteuers.";
"ap22_quest_02_hint_14" = "Der Nisten-Helfer wartet in seiner Werkstatt auf dich.";
"ap22_quest_03_hint_01" = "Der Nisten-Helfer braucht mehr Materialien.";
"ap22_quest_03_hint_02" = "Hinter dem Tempel des Ältesten des Waldes gibt es einen Hain voller goldener Blumen.";
"ap22_quest_03_hint_03" = "Triff den Nisten-Helfer hinter dem Tempel des Waldes und hilf beim Sammeln von Fallholz.";
"ap22_quest_03_hint_04" = "Hilf dem Nisten-Helfer beim Sammeln von Fallholz.";
"ap22_quest_03_hint_05" = "Triff den Nisten-Helfer in der Werkstatt.";
"ap22_quest_03_hint_fail_01" = "Lästige Dunkelkrabben haben das Fallholz zerstört. Meditiere hier, um es erneut zu versuchen.";
"ap22_quest_03_hint_fail_02" = "Versuche es mit Schreien, um die Dunkelkrabben umzuwerfen!";
"ap22_quest_05_hint_01" = "Der Nisten-Helfer möchte dir eine Einweihungsparty schmeißen!";
"ap22_quest_05_hint_02" = "Deine Gäste sind bald da! Wenn du dein Nest vorbereitet hast, meditiere hier, um sie herein zu bitten.";
"ap22_quest_05_hint_03" = "Bist du bereit, deine Einweihungsparty zu starten?";
"ap22_quest_05_hint_04" = "Nimm den Nisten-Helfer zum Hereinbitten bei der Hand.";
"ap22_quest_05_hint_05" = "Begib dich zu deinem Nest, um mit den Feierlichkeiten zu beginnen.";
"ap22_quest_05_hint_06" = "Alle sind da! Sprich mit dem Nisten-Helfer, wenn du bereit bist, mit allen zu feiern.";
"ap22_quest_05_hint_07" = "Drei!";
"ap22_quest_05_hint_08" = "Zwei!";
"ap22_quest_05_hint_09" = "EINS!";
"ap22_quest_05_hint_10" = "FROHES NISTEN!!!";
"ap22_quest_05_hint_11" = "Wenn du bereit bist, die Party zu beenden, sprich mit dem Nisten-Helfer und hol dir deine Belohnung.";
"ap22_quest_05_hint_12" = "Kehre zu deinem Nest zurück, um deine Belohnung abzuholen!";
"ap23_quest01_confirmmenu_hint1" = "Bereit, es noch einmal zu versuchen?";
"ap23_quest01_confirmmenu_hint2" = "Komm zum Duette-Helfer zurück, wenn du bereit bist, es noch einmal zu probieren.";
"ap23_quest01_confirmmenu_hint3" = "Du scheinst Schwierigkeiten beim Komplettieren dieses Notenblatts zu haben. Willst du es überspringen?";
"ap23_quest01_hint1" = "Der Duette-Helfer kann die Tür nicht allein öffnen.";
"ap23_quest01_hint2" = "Lerne mit dem Duette-Helfer, wie man Musik spielt.";
"ap23_quest01_hint3" = "Spiele zusammen mit dem Duette-Helfer, um die Musiktür zu öffnen.";
"ap23_quest01_hint4" = "Lass es uns noch einmal versuchen.";
"ap23_quest01_hint5" = "Gehe mit dem Duette-Helfer an Bord des Bootes.";
"ap23_quest01_menu1" = "Bereit, es noch einmal zu versuchen?";
"ap23_quest01_menu2" = "Komm zum Duette-Helfer zurück, wenn du bereit bist, es noch einmal zu probieren.";
"ap23_quest01_tutorial_hint1" = "Tolle Arbeit! Lass uns die nächste Note lernen.";
"ap23_quest01_tutorial_hint2" = "Lass uns diese notiz noch einmal versuchen.";
"ap23_quest01_tutorial_hint3" = "Fantastische arbeit!";
"ap23_quest01_tutorial_hint4" = "Jetzt lass uns das ganze lied spielen.";
"ap23_quest02_hint1" = "Reinige die netze und zünde die kerzen an am tisch.";
"ap23_quest02_hint2" = "Versuche, mehr netze zu reinigen!";
"ap23_quest02_hint3" = "Versuche, mehr Dunkelpflanzen zu entfernen.";
"ap23_quest02_hint4" = "Beende zuerst den Wiederaufbau der Konzerthalle.";
"ap23_quest02_hint5" = "Hilf dem Duette-Helfer und säubere den Bühnenbereich.";
"ap23_quest02_hint6" = "Der Duette-Helfer möchte dir den Rest des Lieds beibringen.";
"ap23_quest02_hint7" = "Zünde die kerzen an am tisch.";
"ap23_quest03_hint1" = "Stelle die Hülle mit deiner Flamme wieder her.";
"ap23_quest03_menu1" = "Komm zurück zum klavier, wenn du bereit bist, es erneut zu versuchen.";
"ap23_quest04_hint1" = "Spiele das Musikinstrument, um der mitfühlenden Cellistin zu helfen.";
"ap23_quest04_hint2" = "Folge der mitfühlenden Cellistin und spiele ihr Lied.";
"ap23_quest04_hint3" = "Führe die zwei Geister auf der Bühne der Konzerthalle wieder zusammen.";
"ap23_quest04_menu1" = "Komm zurück zum Cello, wenn du bereit bist, erneut zu versuchen.";
"ap23_quest05_aviary_hint1" = "Bringe die Geister in die Konzerthalle, um das Konzert gemeinsam zu genießen.";
