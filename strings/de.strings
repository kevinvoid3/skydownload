"ap14_story_tree_1a2a3b4b_cont" = "Er strahlte voller Stolz, bis das Kind in einem Tempel Zuflucht fand. Endlich konnte er jemandem helfen und zur Ruhe kommen.";
"ap14_story_tree_1a2a3b4b_cont_abv" = "Er strahlte voller Stolz ...";
"ap14_story_tree_1a2a3b_abv" = "Sein Licht umhüllte ...";
"ap14_story_tree_1a2a3b_cont" = "Als er schließlich nach unten blickte ...";
"ap14_story_tree_1a2a_cont" = "Bis ...";
"ap14_story_tree_1a2b" = "Er dunkler wurde";
"ap14_story_tree_1a2b3a" = "Sein Licht war schon fast vom Himmel verschwunden";
"ap14_story_tree_1a2b3a4a" = "Er teilte sich in unzählige kleine Lichtpunkte auf und prasselte sanft auf den Boden herab.";
"ap14_story_tree_1a2b3a4a_abv" = "Er teilte sich auf ...";
"ap14_story_tree_1a2b3a4a_cont" = "Aus seinen Echos entstanden wunderschöne Kreaturen des Lichts. Das Ende einer Schöpfung bedeutete die Entstehung neuen Lebens.";
"ap14_story_tree_1a2b3a4a_cont_abv" = "Aus seinen Echos ...";
"ap14_story_tree_1a2b3a4b" = "Er sank langsam Richtung Boten und leuchtete dabei heller als der Mond selbst.";
"ap14_story_tree_1a2b3a4b_abv" = "Er sank langsam ...";
"ap14_story_tree_1a2b3a4b_cont" = "Ein Kind entstand, ein Stern hatte sich verwandelt.";
"ap14_story_tree_1a2b3a4b_cont_abv" = "Ein Kind entstand ...";
"ap14_story_tree_1a2b3a_cont" = "Aber bevor er ganz verschwand ...";
"ap14_story_tree_1a2b3b" = "Bat ihn ein Kind um einen Gefallen";
