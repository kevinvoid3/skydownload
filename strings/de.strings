"ap23_quest05_aviary_hint3" = "3 weitere Geister übrig zum Einsammeln.";
"ap23_quest05_aviary_hint4" = "2 weitere Geister übrig zum Einsammeln.";
"ap23_quest05_aviary_hint5" = "1 weiterer Geist übrig zum Einsammeln.";
"ap23_quest05_aviary_hint6" = "Bringe die Geister zur Konzerthalle.";
"ap23_quest05_aviary_hint7" = "Möchtest du die Geister zurück zur Konzerthalle bringen?";
"ap23_quest05_hint1" = "Kehre zurück zum Volieren-Dorf und bringe andere Geister, um dem Konzert des musikalischen Duos zu lauschen.";
