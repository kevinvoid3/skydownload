"ap31_fq1_letter1_part1" = "Anh đã bắt đầu mong Giáng sinh rồi.";
"ap31_fq1_letter1_part2" = "Hai năm trước mình từng dạo bước trong đêm tuyết—";
"ap31_fq1_letter1_part3" = "em còn nhớ không?";
