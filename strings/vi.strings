"ap11_fetch_03_beach_04" = "Cùng leo lên đỉnh nào!";
"ap11_fetch_03_belltower_01" = "Một ngôi nhà vui nhộn!";
"ap11_fetch_03_belltower_02" = "Nó còn lớn hơn toàn bộ hành tinh của tôi.";
"ap11_fetch_03_belltower_03" = "Tôi thích cách nó hát theo gió.";
"ap11_fetch_03_belltower_04" = "Nhìn cách trang trí bằng chuông.";
"ap11_fetch_03_belltower_05" = "Giống như bầu trời được trang trí bởi các vì sao.";
"ap11_fetch_03_belltower_06" = "Chuông là dành cho các loài vật.";
"ap11_fetch_03_belltower_07" = "Đứa trẻ nào cũng biết điều đó.";
"ap11_fetch_03_belltower_08" = "Hãy đến chỗ bức tượng đó.";
"ap11_fetch_03_bye_01" = "Bạn có biết...";
"ap11_fetch_03_bye_02" = "\"thuần hóa\" là gì không?";
"ap11_fetch_03_bye_03" = "Một con cáo nói với tôi rằng, điều đó nghĩa là thiết lập mối quan hệ.";
"ap11_fetch_03_bye_04" = "Nhìn xem!";
"ap11_fetch_03_bye_05" = "Nếu chúng ta thiết lập quan hệ, thì chúng ta sẽ cần nhau.";
"ap11_fetch_03_bye_06" = "Trong số hàng triệu đứa trẻ...";
"ap11_fetch_03_bye_07" = "Với tôi, bạn là duy nhất trên đời.";
"ap11_fetch_03_bye_08" = "Với bạn, tôi là duy nhất trên đời.";
"ap11_fetch_03_end_quote" = "Nếu cho phép bản thân bị thuần hóa, thì phải chấp nhận nguy cơ rơi lệ.";
