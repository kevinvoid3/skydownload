"ap32_fetch_01_hint_0" = "Bão đang ập đến! Thu buồm lại!";
"ap32_fetch_01_hint_1" = "Buộc chặt các dây câu lại";
"ap32_fetch_01_hint_10" = "...và, cuối cùng, người học trò của ông.";
"ap32_fetch_01_hint_11" = "Ngư Dân Già biết rằng Ngọc Trai Huyền Thoại vẫn đang ở ngoài kia...";
"ap32_fetch_01_hint_13" = "Quay về nhà tới chỗ con tàu đắm ở cuối hòn đảo";
"ap32_fetch_01_hint_14" = "Nhưng Quái Vật đã cướp đi thành quả của ông...";
"ap32_fetch_01_hint_2" = "Kiểm tra xem mẻ lưới hôm nay có gì";
"ap32_fetch_01_hint_6" = "Ngày xửa ngày xưa, Ngư Dân Già vớt được\nmột Ngọc Trai Huyền Thoại.";
"ap32_fetch_01_hint_7" = "Quái Vật đã cướp đi tất cả...";
"ap32_fetch_01_hint_8" = "...may mắn của ông...";
"ap32_fetch_01_hint_9" = "...phẩm giá của ông...";
"ap32_fetch_02_hint_0" = "Lên thuyền cùng Ngư Dân Già.";
"ap32_fetch_02_hint_1" = "Hạ buồm xuống và buộc chặt lại.";
"ap32_fetch_02_hint_10" = "Hãy cầm lái.";
"ap32_fetch_02_hint_11" = "Ngoài khu vực nhiệm vụ, đang hiệu chỉnh lại";
"ap32_fetch_02_hint_12" = "Tinh linh đã chuẩn bị một mái chèo vừa cỡ trẻ con.";
"ap32_fetch_02_hint_13" = "Đặt món quà xuống và chuẩn bị ra khơi.";
"ap32_fetch_02_hint_2" = "Các Sinh Vật Ánh Sáng đã chạy mất. Hãy đuổi theo chúng!";
"ap32_fetch_02_hint_3" = "Đi theo các Sinh Vật Ánh Sáng để tìm ngọc trai.";
"ap32_fetch_02_hint_4" = "Hãy đi theo những con cá đuối!";
"ap32_fetch_02_hint_5" = "Đẩy sang trái để rẽ phải. Đẩy sang phải để rẽ trái.";
"ap32_fetch_02_hint_6" = "Chờ trong lúc thuyền rời bến.";
"ap32_fetch_02_hint_7" = "Bạn đã đi lệch hướng quá xa. Hét lớn để xem cần đi đâu.";
"ap32_fetch_02_hint_8" = "Cầm lấy bánh lái và đi theo các Sinh Vật Ánh Sáng.";
"ap32_fetch_02_hint_9" = "Cầm lấy bánh lái và đi theo những con cá đuối.";
"ap32_fetch_02_intro_1" = "Ngư Dân Già không chấp nhận thất bại.";
"ap32_fetch_02_outro_1" = "Dù chưa thấy tăm hơi Quái Vật,\nnhưng Ngư Dân Già vẫn quyết tâm tìm bằng được Ngọc Trai Huyền Thoại.";
"ap32_fetch_02_rudder_tutorial_0" = "Vuốt trái để sang phải. Vuốt phải để sang trái.";
"ap32_fetch_02_rudder_tutorial_1" = "Vuốt trái để sang phải. Vuốt phải để sang trái.";
"ap32_fetch_02_rudder_tutorial_2" = "Vuốt trái để lái thuyền đi thẳng. Vuốt trái lần nữa để lái thuyền sang phải.";
"ap32_fetch_02_sail_tutorial_0" = "Hạ buồm xuống và buộc chặt lại.";
"ap32_fetch_02_sail_tutorial_1" = "Vuốt xuống lần nữa để tăng tốc. Giữ lên để giảm tốc.";
"ap32_fetch_03_hint_10" = "Được rồi! Mau túm lấy lưới nào!";
"ap32_fetch_03_hint_11" = "Ngư Dân Già biết đi theo những con cá đuối là một cách hay để tìm ngọc trai.";
"ap32_fetch_03_hint_12" = "Cầm lấy bánh lái và đi theo những con cá đuối";
"ap32_fetch_03_hint_13" = "Ngư Dân Già biết loài lợn biển đánh hơi những viên ngọc trai rất giỏi.";
"ap32_fetch_03_hint_14" = "Ngư Dân Già biết có một viên ngọc trai lớn ở ngay gần đây!";
"ap32_fetch_03_hint_15" = "Quay trở lại mặt nước.";
"ap32_fetch_03_hint_16" = "Hoàn hảo để làm mồi nhử Quái Vật!";
"ap32_fetch_03_hint_2" = "Hãy đi theo những con cá đuối!";
