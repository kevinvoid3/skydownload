"drinking_text4" = "Tôi nghe nói mỗi màn trình diễn đều thể hiện một chút sự sáng tạo của người thiết kế!";
"drinking_text5" = "Tôi nghe nói cứ đến phút thứ 30 của một giờ sẽ có một buổi biểu diễn nhóm.";
"drinking_text6" = "Bạn đã xem các nhân viên thiết kế biểu diễn chưa?! Những chương trình tuyệt vời đang diễn ra trên sân khấu.";
"drinking_text7" = "Một số người thích chơi với đám Rồng Hắc Ám! Nhưng không phải tôi. Không đời nào.";
"drinking_text8" = "Bạn đã bao giờ nhìn lên giếng trời và tự hỏi liệu có lẽ tất cả chỉ là mô phỏng?";
"drinking_text9" = "Gần sân khấu có những chiếc loa khổng lồ. Thật là một bữa tiệc hoành tráng!";
