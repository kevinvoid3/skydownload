"drinking_text11" = "Tôi nghe nói ngày xưa bạn có thể tìm thấy bánh nướng và pizza... nhưng sau đó chúng đều bị ăn hết.";
"drinking_text12" = "Thực ra tôi là Bản Sao 73. Samantha đang luyện tập cho màn trình diễn của mình.";
"drinking_text13" = "Tôi từng nghe nói Ash để lại một ít pizza dứa trong tủ lạnh ở tầng dưới, nhưng chuyện đó đã cách đây nhiều năm rồi.";
"drinking_text14" = "Ngay cả các nhân viên cũng tranh luận về màu sắc của mấy chiếc áo choàng! Bạn đoán thử coi?";
"drinking_text15" = "Ở TGC, thú cưng còn đông hơn cả nhân viên! Chúng hầu hết là mèo.";
"drinking_text16" = "Có rất nhiều nơi để khám phá quanh đây!";
"drinking_text17" = "Nhà vệ sinh ở tầng dưới, nếu bạn quá chén. Đừng lo, lần này... bạn sẽ không bị cuốn vào trong đâu.";
"drinking_text18" = "Trạm Phát Thanh mở ra hợp tác âm nhạc với bạn bè!";
"drinking_text2" = "Lúc trước tôi đã thấy họ chuẩn bị cho buổi biểu diễn.";
