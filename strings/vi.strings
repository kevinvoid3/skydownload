"ap14_story_tree_1a2a3a4b_abv" = "Nó ban ánh sáng...";
"ap14_story_tree_1a2a3a4b_cont" = "Được dẫn đường bởi ánh sáng, đứa trẻ đã nhìn thấy con đường phía trước. Kể từ đó, nó sẽ không bao giờ đơn độc.";
"ap14_story_tree_1a2a3a4b_cont_abv" = "Được dẫn đường bởi ánh sáng...";
"ap14_story_tree_1a2a3a_abv" = "Nó không còn chứa được...";
"ap14_story_tree_1a2a3a_cont" = "Với hành động quên mình...";
"ap14_story_tree_1a2a3b" = "Ánh sáng của nó bao trùm cả bầu trời";
"ap14_story_tree_1a2a3b4a" = "Ngôi sao không nhìn thấy gì ngoài ánh sáng chói lòa của chính mình";
"ap14_story_tree_1a2a3b4a_abv" = "Ngôi sao không nhìn thấy gì...";
"ap14_story_tree_1a2a3b4a_cont" = "Lặng lẽ và đơn độc, nó tắt dần ánh sáng cho đến khi những hình bóng quay trở lại. Nó vô tư tỏa sáng mà không cần mục đích.";
"ap14_story_tree_1a2a3b4a_cont_abv" = "Lặng lẽ và đơn độc...";
"ap14_story_tree_1a2a3b4b" = "Nó nhìn thấy một đứa trẻ đang tự tin rảo bước trên Hoang Mạc đầy ánh sáng";
"ap14_story_tree_1a2a3b4b_abv" = "Nó nhìn thấy một đứa trẻ...";
"ap14_story_tree_1a2a3b4b_cont" = "Mang trong mình niềm tự hào, nó tỏa sáng một cách kỳ diệu cho đến khi đứa trẻ tìm thấy nơi ẩn náu trong một ngôi đền. Ấm áp vì giúp được người khác, cuối cùng nó đã được nghỉ ngơi.";
"ap14_story_tree_1a2a3b4b_cont_abv" = "Mang trong mình niềm tự hào...";
"ap14_story_tree_1a2a3b_abv" = "Ánh sáng của nó bao trùm...";
"ap14_story_tree_1a2a3b_cont" = "Cuối cùng khi nó nhìn xuống bên dưới...";
"ap14_story_tree_1a2a_cont" = "Cho đến khi...";
"ap14_story_tree_1a2b" = "Nó trở nên mờ dần";
"ap14_story_tree_1a2b3a" = "Ánh sáng của nó gần như lụi tàn trên bầu trời";
"ap14_story_tree_1a2b3a4a" = "Nó tách thành vô số luồng sáng, nhẹ nhàng đáp xuống mặt đất bên dưới.";
"ap14_story_tree_1a2b3a4a_abv" = "Nó tách thành...";
"ap14_story_tree_1a2b3a4a_cont" = "Những âm thanh vang vọng của nó làm rung chuyển những sinh vật ánh sáng xinh đẹp. Sự kết thúc của một sự sống đã thổi bùng lên một sự sống mới.";
"ap14_story_tree_1a2b3a4a_cont_abv" = "Những âm thanh vang vọng của nó...";
"ap14_story_tree_1a2b3a4b" = "Nó bắt đầu đáp xuống mặt đất bên dưới, sáng hơn cả mặt trăng.";
"ap14_story_tree_1a2b3a4b_abv" = "Nó bắt đầu đáp xuống...";
"ap14_story_tree_1a2b3a4b_cont" = "Một đứa trẻ xuất hiện, một ngôi sao đã biến đổi.";
"ap14_story_tree_1a2b3a4b_cont_abv" = "Một đứa trẻ xuất hiện...";
"ap14_story_tree_1a2b3a_cont" = "Nhưng trước khi nó hoàn toàn tan biến...";
