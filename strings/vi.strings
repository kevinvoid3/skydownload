"ap24_side01_chat_01" = "Đó là buổi tối phù hợp cho một giai điệu.";
"ap24_side01_chat_02" = "Một giai điệu mới.";
"ap24_side01_chat_03" = "Một phần là kỳ vọng...";
"ap24_side01_chat_04" = "...hai phần là nỗi buồn của mùa xuân.";
"ap24_side01_chat_05" = "Và phần còn lại,";
"ap24_side01_chat_06" = "là niềm vui lớn lao khi được ở một mình và tận hưởng điều đó!";
"ap24_side02_chat_01" = "Chúng ta đã ngồi như thế này vào mùa xuân.";
"ap24_side02_chat_02" = "Anh còn nhớ không?";
"ap24_side02_chat_03" = "Chúng ta đã tỉnh dậy sau giấc ngủ đông và đó là ngày đầu tiên.";
"ap24_side02_chat_04" = "Tất cả những người khác vẫn còn ngủ.";
"ap24_side02_chat_05" = "Anh có nói về những kế hoạch.";
"ap24_side02_chat_06" = "Anh có kế hoạch nào cho riêng mình không?";
"ap24_side02_chat_07" = "Có, anh có một kế hoạch.";
"ap24_side02_chat_08" = "Nhưng đó là một kế hoạch đầy cô độc, em biết đấy.";
"ap24_side02_chat_09" = "Anh đang nghĩ đến việc ra đi.";
"ap24_side02_chat_10" = "Bao giờ anh đi?";
"ap24_side02_chat_11" = "Bây giờ - ngay lúc này!";
"ap24_side02_chat_12" = "Anh sẽ đi lâu không?";
"ap24_side02_chat_13" = "Không đâu, vào ngày đầu tiên của mùa xuân, anh sẽ lại ở đây huýt sáo dưới cửa sổ.";
"ap24_side02_chat_14" = "Một năm trôi qua nhanh lắm!";
"ap24_side03_chat_01" = "Bạn là - ờ - một họa sĩ phải không?";
"ap24_side03_chat_02" = "Hay có lẽ là một nhà thơ?";
"ap24_side03_chat_03" = "Tôi là tất cả mọi thứ!";
"ap24_side03_chat_04" = "Và tôi thấy bạn là nhà khám phá.";
"ap24_side03_chat_05" = "Bạn đang nghĩ đến việc khám phá điều gì?";
"ap24_side03_chat_06" = "Ồ, mọi thứ.";
"ap24_side03_chat_07" = "Ví dụ như các vì sao!";
"ap24_side03_chat_08" = "Các vì sao!";
"ap24_side03_chat_09" = "Vậy tôi phải đi cùng bạn.";
"ap24_side03_chat_10" = "Các vì sao là thứ tôi yêu thích nhất.";
"ap24_side03_chat_11" = "Tôi luôn nằm và nhìn ngắm chúng trước khi đi ngủ…";
"ap24_side03_chat_12" = "...và tự hỏi ai đang ở trên đó.";
"ap24_side04_chat_01" = "Haiz...";
"ap24_side04_chat_02" = "Bạn có vẻ buồn.";
"ap24_side04_chat_03" = "Tôi đã tặng đi món đồ chơi yêu thích của mình.";
"ap24_side04_chat_04" = "Tôi nghĩ rằng sẽ thật vui nếu làm điều gì đó tốt đẹp.";
"ap24_side04_chat_05" = "À. Bạn hối hận ư?";
"ap24_side04_chat_06" = "Ừ.";
"ap24_side04_chat_07" = "Bạn đã mất món đồ chơi…";
"ap24_side04_chat_08" = "...nhưng có lẽ bạn đã nhận được nhiều hơn những gì bạn nghĩ.";
"ap24_side06_chat_01" = "Bí mật của họ liên quan đến những cơn giông bão!";
"ap24_side06_chat_02" = "Chính là những cơn giông mà họ luôn tìm kiếm và mong chờ...";
"ap24_side06_chat_03" = "Có chuyện gì với mình vậy?";
"ap24_side06_chat_04" = "Mình không phải là Hattifattener, mình là Moominpappa...";
"ap24_side06_chat_05" = "Mình đang làm gì ở đây?";
"ap24_side06_chat_06" = "Mình đang về nhà! Mình sẽ rời đi ngay lập tức!";
"ap24_side07_story_01" = "Có một lần, Moominpappa bỏ đi mà không một lời giải thích.";
"ap24_side07_story_02" = "Không ai biết chắc chắn ông ấy đi đâu.";
"ap24_side07_story_03" = "Trong suốt cuộc đời, Moominpappa chưa bao giờ cảm thấy dễ chịu đến vậy.";
"ap24_side07_story_04" = "Ông cảm thấy tuyệt vời khi không phải nói...";
"ap24_side07_story_05" = "...hay giải thích điều gì, với bản thân hay với người khác.";
"ap24_side07_story_06" = "Ông chỉ ngồi đó nhìn về phía đường chân trời...";
"ap24_side07_story_07" = "...và lắng nghe tiếng róc rách của nước.";
"ap24_storybook_hint01" = "Hóa thành một con bướm và bay đến Moominvalley?";
"ap24_storybook_hint02" = "Tự do khám phá Moominvalley dưới góc nhìn của một con bướm?";
"ap24_storybook_hint03" = "Đến Moominvalley?";
