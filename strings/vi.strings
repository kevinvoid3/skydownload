"ap11_fetch_03_statue_04" = "...";
"ap11_fetch_03_statue_05" = "Âm thanh đó là gì?";
"ap11_fetch_03_statue_06" = "Theo tôi nào!";
"ap11_fetch_03_tunnel_01" = "Hãy tiếp tục khám phá!";
"ap11_fetch_03_tunnel_02" = "Nơi này dẫn đến đâu?";
"ap11_fetch_03_tunnel_03" = "Chà!!!";
"ap11_fetch_03_tunnel_04" = "Thật là vui!";
"ap11_fetch_03_waterfall_01" = "Có nghe thấy không?";
"ap11_fetch_03_waterfall_02" = "Dòng thác đang hát ...";
"ap11_fetch_03_waterfall_03" = "Nước có lẽ cũng tốt cho trái tim ...";
"ap11_fetch_03_waterfall_hint_01" = "Nước chảy từ đâu?";
"ap11_fetch_03_waterfall_hint_02" = "Chúng ta hãy đi tìm nguồn nước.";
"ap11_fetch_04_burn01_01" = "Hạt cũng có hạt tốt hạt xấu.";
"ap11_fetch_04_burn02_01" = "Những hạt xấu như bao báp có thể trở thành thảm họa nếu không được chăm sóc sớm.";
"ap11_fetch_04_burn03_01" = "Nếu đó là củ cải hoặc hoa hồng, người ta sẽ để nó phát triển ở bất cứ nơi nào nó muốn.";
"ap11_fetch_04_burn04_01" = "Những bông hoa này gợi cho tôi nhớ đến bông hồng của mình ở nơi xa.";
"ap11_fetch_04_burn05_01" = "Những bông hoa dịu dàng.";
"ap11_fetch_04_burn05_02" = "Đôi khi bạn cần che chở chúng khỏi gió.";
"ap11_fetch_04_burn06_01" = "Tôi lắng nghe bông hồng của tôi khi cô ấy càu nhàu, hoặc khoe khoang ...";
"ap11_fetch_04_burn06_02" = "hoặc thậm chí đôi khi cô ấy không nói gì.";
"ap11_fetch_04_burn07_01" = "Thời gian bạn dành để tưới hoa hồng của mình ...";
"ap11_fetch_04_burn07_02" = "Là lý do tại sao chúng trở nên quan trọng như vậy.";
"ap11_fetch_04_burn_start_hint" = "Loại bỏ bóng tối, chăm sóc những bông hoa.";
"ap11_fetch_04_bye01_01" = "Những bông hồng này thật đẹp.";
"ap11_fetch_04_bye01_02" = "Nhưng chúng trống rỗng.";
"ap11_fetch_04_bye01_03" = "Bông hồng của tôi là độc nhất.";
"ap11_fetch_04_bye01_04" = "Bông hồng của tôi tỏa hương khắp hành tinh.";
"ap11_fetch_04_bye01_05" = "Nhưng tôi không biết làm sao để thưởng thức hết những ân sủng đó.";
"ap11_fetch_04_bye02_01" = "Con cáo của tôi từng nói rằng ...";
"ap11_fetch_04_bye02_02" = "Người ta chỉ nhìn rõ bằng trái tim.";
