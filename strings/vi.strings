"ap31_fq1_letter3_part2" = "anh phải vẽ họ không ngừng nghỉ.";
"ap31_fq1_letter3_part3" = "Mọi thứ thuộc về nếp sống đồng quê, anh phải quan sát và vẽ lại hết.";
"ap31_fq1_letter3_part4" = "Anh không còn thấy mình nhỏ bé trước thiên nhiên như xưa nữa!";
"ap31_fq1_letter4_part1" = "Hội họa đến với anh tự nhiên hơn anh tưởng.";
"ap31_fq1_letter4_part2" = "Có lẽ đó là cách tốt nhất... dồn trọn tâm can vào hội họa?";
"ap31_fq1_letter4_part3" = "Anh phải thú thật...";
"ap31_fq1_letter4_part4" = "...anh cũng chẳng biết nữa.";
"ap31_fq1_letter5_part1" = "Tiền chưa cạn hẳn,";
"ap31_fq1_letter5_part2" = "nhưng cũng chẳng còn bao nhiêu.";
"ap31_fq1_letter5_part3" = "Anh tốn khá nhiều vào họa cụ rồi.";
"ap31_fq1_letter5_part4" = "Mong em sớm gửi thêm cho anh một ít.";
"ap31_fq2_letter1_part1" = "Trước kia anh còn chẳng biết trường phái ấn tượng là gì,";
"ap31_fq2_letter1_part2" = "giờ được tận mắt xem tranh của họ,";
"ap31_fq2_letter1_part3" = "và dù chưa thực sự thuộc giới đó,";
"ap31_fq2_letter1_part4" = "anh vô cùng ngưỡng mộ một số bức tranh của trường phái này...";
"ap31_fq2_letter2_part1" = "Anh có gửi bưu điện cho em mấy bức vẽ đấy.";
"ap31_fq2_letter2_part2" = "Cứ nói thẳng cho anh nghe,";
"ap31_fq2_letter2_part3" = "sao chúng không bán được,";
"ap31_fq2_letter2_part4" = "và phải vẽ sao người ta mới mua?";
"ap31_fq2_letter3_part1" = "Anh mong mình sẽ tiến bộ đến mức";
"ap31_fq2_letter3_part2" = "em có thể tự tin";
"ap31_fq2_letter3_part3" = "đem tranh anh đi giới thiệu";
"ap31_fq2_letter3_part4" = "mà không hề thấy ngượng.";
"ap31_fq3_letter1_part1" = "Năm nay anh muốn thực sự bứt phá...";
"ap31_fq3_letter1_part2" = "...một sự bứt phá,";
"ap31_fq3_letter1_part3" = "nói thật nhé,";
"ap31_fq3_letter1_part4" = "đó là điều anh đang rất khao khát lúc này.";
"ap31_fq3_letter2_part1" = "Anh tính kỹ lắm rồi,";
"ap31_fq3_letter2_part2" = "vậy mà hôm nay, với mười mét toan, dù đã căn ke hoàn hảo";
"ap31_fq3_letter2_part3" = "cho mọi loại màu... lại sót mất một thứ:";
"ap31_fq3_letter2_part4" = "sắc vàng cơ bản.";
"ap31_fq3_letter3_part1" = "Anh chưa bao giờ may mắn đến thế, cảnh sắc nơi đây đẹp tuyệt..";
"ap31_fq3_letter3_part2" = "Đẹp mọi nơi, mọi lúc.";
"ap31_fq3_letter3_part3" = "Vòm trời mang sắc xanh choáng ngợp, còn mặt trời tỏa sắc vàng nhạt như lưu huỳnh...";
"ap31_fq3_letter3_part4" = "...dịu dàng và mê đắm hệt như màu xanh và vàng thiên thanh trong tranh của Vermeer.";
"ap31_fq3_letter3_part5" = "Anh chẳng tài nào vẽ đẹp được như thế.";
"ap31_fq3_letter3_part6" = "Nhưng nó cuốn hút đến mức anh cứ thả mình đắm chìm...";
"ap31_fq3_letter4_part1" = "Anh muốn sắm sửa đồ đạc không chỉ cho mình, mà để đủ chỗ đón thêm người đến ở.";
"ap31_fq3_letter4_part2" = "Đương nhiên việc này ngốn gần sạch tiền rồi.";
"ap31_fq3_letter4_part3" = "Với chút đỉnh còn lại, anh mua mười hai cái ghế,";
"ap31_fq3_letter4_part4" = "một cái gương,";
"ap31_fq3_letter4_part5" = "cùng vài món lặt vặt không thể thiếu...";
"ap31_fq3_letter4_part6" = "...nghĩa là tuần sau anh dọn vào ở được rồi!";
"ap31_fq3_letter5_part1" = "Anh đang rất hạnh phúc với nhà mới và công việc...";
"ap31_fq3_letter5_part2" = "...đến mức tôi dám tin niềm vui này sẽ không của riêng tôi,";
"ap31_fq3_letter5_part3" = "mà em ở phương xa cũng sẽ chung vui bằng những vận may đang tới!";
"ap31_fq3_letter6_part1" = "Anh sẽ rất vui nếu tự tay trang hoàng nhà cửa - điều đó sẽ giúp anh trụ vững.";
"ap31_fq4_letter1_part1" = "Em sẽ rất vui";
"ap31_fq4_letter1_part2" = "nếu anh đến thăm Jo và em bé nhà em!";
"ap31_fq4_letter1_part3" = "Như đã nói với anh từ trước,";
"ap31_fq4_letter1_part4" = "vợ chồng em lấy tên anh đặt cho thằng bé.";
"ap31_fq4_letter2_part1" = "Chà, em biết anh mong gì mỗi khi cho phép mình mơ mộng không?";
"ap31_fq4_letter2_part2" = "Rằng gia đình nhỏ sẽ là điểm tựa của em,";
"ap31_fq4_letter2_part3" = "giống như thiên nhiên đối với anh vậy...";
"ap31_fq4_letter2_part4" = "...như cục đất, ngọn cỏ, đồng lúa mì vàng ươm, và người nông dân.";
"ap31_fq4_letter3_part1" = "Giờ thì nỗi ám ảnh sinh tồn đã vơi bớt,";
"ap31_fq4_letter3_part2" = "sự u sầu cũng không còn bủa vây.";
"ap31_fq4_letter3_part3" = "Nhưng anh chẳng còn chút động lực nào... khát khao cũng nguội lạnh...";
"ap31_fq4_letter3_part4" = "...và gần như chẳng màng đến một cuộc sống bình thường nữa.";
"ap31_fq4_letter4_part1" = "Anh đang nhốt mình trong phòng làm việc không ngừng,";
"ap31_fq4_letter4_part2" = "điều này giúp anh thấy khuây khỏa";
"ap31_fq4_letter4_part3" = "và có lẽ là xua tan";
"ap31_fq4_letter4_part4" = "những ý nghĩ điên rồ này.";
"ap31_fq4_letter5_part1" = "Đã sáu tuần anh chẳng ra khỏi cửa...";
"ap31_fq4_letter5_part2" = "...ra vườn cũng không.";
"ap31_fq4_letter5_part3" = "Tuần tới,";
"ap31_fq4_letter5_part4" = "khi xong mấy bức toan dang dở,";
"ap31_fq4_letter5_part5" = "dù vậy, anh sẽ thử ra ngoài xem sao.";
"ap31_fq4_letter6_part1" = "Nơi này nơi kia, anh cũng tìm được những người bạn và những điều mình yêu.";
"ap31_fq4_letter6_part2" = "Vậy em có hiểu được không,";
"ap31_fq4_letter6_part3" = "trong khi vẫn thấy căn bệnh của mình thật đáng sợ,";
"ap31_fq4_letter6_part4" = "thì ở chốn này, anh lại tạo ra những gắn kết";
"ap31_fq4_letter6_part5" = "có phần quá đỗi sâu đậm?";
"ap31_fq4_letter7_part1" = "Từng chút một, anh bắt đầu coi sự điên loạn chỉ là một căn bệnh như bao bệnh khác.";
"ap31_fq4_letter7_part2" = "Đổi không gian sống đang giúp ích cho anh.";
"ap31_fq4_letter7_part3" = "Bác sĩ ở đây nghiêng về chẩn đoán anh bị giống như động kinh.";
"ap31_fq4_letter7_part4" = "Nhưng anh cũng chả tìm hiểu sâu làm gì.";
"ap31_fq5_date1" = "Sáu tháng sau";
"ap31_fq5_date2" = "Hai ngày sau";
"ap31_fq5_letter1_part1" = "Ngoài con ra,";
"ap31_fq5_letter1_part10" = "phải đưa ra ánh sáng và để chúng được công nhận";
"ap31_fq5_letter1_part11" = "nhiều nhất có thể,";
"ap31_fq5_letter1_part2" = "anh ấy còn để lại cho tôi một tâm nguyện khác—";
"ap31_fq5_letter1_part3" = "là giữ gìn nguyên vẹn cho con,";
"ap31_fq5_letter1_part4" = "mọi di sản vô giá mà Theo và Vincent đã vun đắp.";
"ap31_fq5_letter1_part5" = "Đó cũng chính là lẽ sống của tôi.";
"ap31_fq5_letter1_part6" = "Tâm trí tôi luôn sống cùng Theo và Vincent.";
"ap31_fq5_letter1_part7" = "Ôi, tình anh em của họ mới ngọt ngào, dịu dàng và yêu thương nhau biết bao!";
"ap31_fq5_letter1_part8" = "Cách họ hướng về nhau - cách họ thấu hiểu nhau mới tuyệt làm sao!";
"ap31_fq5_letter1_part9" = "tranh của Vincent—";
"ap31_fq6_diary_part1" = "Ngoài đứa trẻ,";
"ap31_fq6_diary_part2" = "tôi còn được giao thêm một nhiệm vụ khác…";
"ap31_fq6_diary_part3" = "Những bức tranh của Vincent.";
"ap31_fq6_diary_part4" = "Tôi phải trưng bày chúng.";
"ap31_fq6_diary_part5" = "Tôi phải đảm bảo chúng được trân trọng.";
"ap31_fq6_diary_part6" = "Những bức tranh này là kho báu.";
"ap31_fq6_diary_part7" = "Chúng không thể bị lãng quên.";
"ap31_fq6_diary_part8" = "Thế giới phải nhớ ông ấy là ai.";
"ap31_fq6_endletter_1" = "Anh không được nghĩ tranh của mình là đồ bỏ đi.";
"ap31_fq6_endletter_2" = "Đừng nản lòng. Những ngày tươi sáng đang ở phía trước.";
"ap31_fq6_endletter_3" = "Anh không đơn độc đâu... em luôn nghĩ về anh.";
"ap31_fq6_endletter_4" = "Rồi sẽ có ngày, người đời sẽ hiểu những gì anh đang nỗ lực truyền tải.";
"ap31_fq6_epilogue2_part1" = "Suốt 10 năm, Vincent đã vẽ hơn 800 bức tranh,";
"ap31_fq6_epilogue2_part2" = "cùng hơn 1000 bản phác thảo.";
"ap31_fq6_epilogue2_part3" = "Nhưng sinh thời, ông chỉ bán được vài bức.";
"ap31_fq6_epilogue_part1" = "Johanna đã dành cả cuộc đời để đưa hàng trăm tác phẩm nghệ thuật và thư từ của Van Gogh mà cô thừa kế đến với công chúng.";
"ap31_fq6_epilogue_part2" = "Sau 15 năm ròng rã, một triển lãm Van Gogh đã được tổ chức tại Bảo tàng Stedelijk ở Amsterdam.";
"ap31_fq6_epilogue_part3" = "Sự kiện này đã khẳng định tên tuổi của Vincent trong giới nghệ thuật.";
"ap31_fq6_epilogue_part4" = "Cho đến nay, đây vẫn là triển lãm Van Gogh lớn nhất, với hơn 230 bức tranh.";
