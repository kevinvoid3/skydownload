"ap26_fetch01_fragment_intro_00" = "Thu thập lông vũ từ chú chim xanh để góp thêm sắc màu cho lễ hội!";
"ap26_fetch01_intro_00" = "\"Ta biết về một chú chim, xanh như ngọc sapphire...";
"ap26_fetch01_intro_01" = "Đi theo Thiếu Niên Hoàng Tộc Tóc Rối đến Thành Trì để tìm Chim Xanh chứ?";
"ap26_fetch01_intro_02" = ".. tiếng hót của nó vang vọng giữa những bữa tiệc xa hoa.\"";
"ap26_fetch01_outro_01" = "\"Một chú chim đã được tìm thấy, và lông vũ của nó xanh thẳm...";
"ap26_fetch01_outro_02" = "... nhưng nó biến mất tựa khói nến.\"";
"ap26_fetch02_intro_00" = "\"Ta biết về một chú chim, xanh như đôi mắt của mẫu thân ta...";
"ap26_fetch02_intro_01" = "Đi theo Phụ Huynh Pháo Hoa Ký Ức đến Kho Lưu Trữ để tìm Chim Xanh chứ?";
"ap26_fetch02_intro_02" = "... tiếng hót của nó vang vọng trong những ký ức quý giá của chúng ta.\"";
"ap26_fetch02_mem_01" = "\"Đứa cháu yêu quý, chúng ta đã làm chiếc xích đu này cho con trên cái cây mà ta yêu thích nhất.\"";
"ap26_fetch02_mem_02" = "\"Nhìn con bay cao đến nhường nào kìa!\"";
"ap26_fetch02_mem_03" = "\"Con yêu, thật tuyệt khi được trở về đây cùng con sau bao năm tháng.\"";
"ap26_fetch02_outro_02" = "... nhưng càng siết chặt, nó lại càng phai mờ nhanh hơn.\"";
"ap26_fetch03_hint_01" = "Có lẽ chú chim muốn nhìn thấy các con cùng nhau biểu diễn!";
"ap26_fetch03_hint_02" = "Nhưng các con vẫn chưa có trang phục biểu diễn...";
"ap26_fetch03_intro_00" = "\"Ta biết về một chú chim, xanh như vải chàm...\"";
"ap26_fetch03_intro_01" = "Đi theo Anh Họ Pháo Hoa Hóa Trang đến Sa Mạc Ánh Sao để tìm Chim Xanh chứ?";
"ap26_fetch03_intro_02" = "... tiếng hót của nó ngân vang nơi nào có đám đông ngưỡng mộ.";
"ap26_fetch03_outro_02" = "... nhưng nó bung ra như sợi chỉ lỏng lẻo.\"";
"ap26_fetch04_dialog_01" = "\"Khu rừng yên bình này là nhà của rất nhiều loài chim sặc sỡ.\"";
"ap26_fetch04_dialog_02" = "\"Tôi chắc chắn chúng ta có thể tìm thấy chim xanh ở đây!\"";
"ap26_fetch04_intro_00" = "\"Tôi biết một loài chim, xanh như dòng sông nguyên sơ...";
"ap26_fetch04_intro_01" = "Đi theo Phụ Huynh Kêu Cầu Đốn Cây đến Cao Nguyên Thanh Vắng để tìm Chim Xanh?";
"ap26_fetch04_intro_02" = "...tiếng hót của nó phản chiếu sự hài hòa yên bình của khu rừng.";
"ap26_fetch04_outro_01" = "\"Một con chim đã được tìm thấy, lông của nó màu xanh lam...";
"ap26_fetch04_outro_02" = "...nhưng nó đã tan tác trong gió và chỉ để lại sự im lặng.\"";
"ap26_fetch05_intro_00" = "\"Tôi biết một loài chim, xanh như những vì sao...";
"ap26_fetch05_intro_01" = "Đi theo Ông Bà Tiên Tri Minh Triết để tìm Chim Xanh?";
"ap26_fetch05_intro_02" = "...tiếng hót của nó vang vọng nơi những định mệnh vĩ đại ra đời.”";
"ap26_fetch05_outro_01" = "\"Một con chim đã được tìm thấy, lông của nó màu xanh lam...";
"ap26_fetch05_outro_02" = "...nhưng giống như định mệnh, nó không chỉ đơn thuần là để nắm giữ.\"";
"ap26_fetch05_quest_01" = "\"Những đứa trẻ này biết định mệnh của mình, và đang chuẩn bị ra đời.\"";
"ap26_fetch05_quest_02" = "“Những người khác cần sự giúp đỡ của chim xanh để nói lên định mệnh của họ.\"";
"ap26_fetch05_quest_03" = "\"Hãy nói cho ta biết định mệnh của con.\"";
"ap26_fetch05_quest_04" = "\"Con sẽ trở thành một người làm vườn và làm cho những điều tươi đẹp lớn lên!\"";
"ap26_fetch05_quest_05" = "\"Khi con ra đời, con sẽ phát minh ra những cỗ máy chữa lành bệnh tật!\"";
"ap26_fetch05_quest_06" = "\"Con sẽ hát những bài ca mang lại hy vọng cho những người đang tuyệt vọng!\"";
"ap26_fetch05_quest_07" = "\"Biết được định mệnh của mình chỉ là sự khởi đầu...\"";
"ap26_fetch06_quest_01" = "Bạn trân trọng điều gì hơn sự giàu sang?";
"ap26_fetch06_quest_02" = "Bạn nhớ điều gì thúc đẩy bạn tiến về phía trước?";
"ap26_fetch06_quest_03" = "Khi bạn nhìn vào gương, bạn thấy bản thân nào?";
"ap26_fetch06_quest_04" = "Tại sao chúng ta lại phá vỡ sự hài hòa của chính mình?";
"ap26_fetch06_quest_05" = "Bạn sẽ đợi bao lâu trước khi theo đuổi định mệnh của mình?";
"ap26_fetch06_quest_06" = "\"Con Chim Xanh của bạn ở đâu?\"";
"ap26_fetchintro_hint_01" = "Để chữa lành nỗi buồn của đứa trẻ này, ngươi phải tìm Chim Xanh.";
"ap26_prologue_00" = "Một đứa trẻ đã bị bao trùm bởi nỗi buồn sâu sắc và dai dẳng.";
"ap26_prologue_01" = "Gia đình đứa trẻ đã tụ họp, ai cũng mong muốn giúp xua tan nỗi buồn ấy.";
"ap26_prologue_02" = "Cùng nhau, các ngươi phải tìm và mang về Chim Xanh trong truyền thuyết!";
