"ap11_spirit_beckon_01" = "Bạn biết họ không thể di chuyển, phải không?";
"ap11_spirit_beckon_02" = "Tôi có quyền yêu cầu họ tuân theo! Mệnh lệnh của tôi rất hợp lý.";
"ap11_spirit_beckon_03" = "Từ giờ, bạn hãy ở nguyên một chỗ.";
"ap11_spirit_beckon_04" = "Những người lớn thật kỳ lạ.";
"ap11_spirit_gloating_01" = "Một du khách từ xa đến đây để chiêm ngưỡng tôi.";
"ap11_spirit_gloating_02" = "Tôi là người đàn ông đẹp nhất, ăn mặc đẹp nhất, giàu có nhất và thông minh nhất trên đảo.";
"ap11_spirit_gloating_03" = "Nhưng bạn là con người duy nhất ở đây.";
"ap11_spirit_gloating_04" = "Xin hãy tiếp tục vỗ tay!";
"ap11_spirit_gloating_05" = "Những người lớn thật là kỳ quặc.";
"ap11_spirit_scheme_01" = "Bạn làm gì với những ngôi sao này?";
"ap11_spirit_scheme_02" = "Tôi sở hữu chúng. Tôi có 501 triệu ngôi sao.";
"ap11_spirit_scheme_03" = "Sao bạn lại giữ các ngôi sao này?";
"ap11_spirit_scheme_04" = "Chúng giúp tôi giàu có.";
"ap11_spirit_scheme_05" = "Tại sao bạn muốn trở nên giàu có?";
"ap11_spirit_scheme_06" = "Để mua thêm các ngôi sao.";
"ap11_spirit_scheme_07" = "Người lớn thật là kỳ quặc.";
"ap11_spirit_slouch_01" = "Sao bạn lại uống loại nước đen sì sì vậy?";
"ap11_spirit_slouch_02" = "Để tôi có thể quên.";
"ap11_spirit_slouch_03" = "Quên cái gì?";
"ap11_spirit_slouch_04" = "Quên rằng tôi xấu hổ.";
"ap11_spirit_slouch_05" = "Xấu hổ về điều gì?";
"ap11_spirit_slouch_06" = "Xấu hổ vì uống phải nước đen này!";
"ap11_spirit_slouch_07" = "Người lớn thật là kỳ quặc.";
"ap11_spirit_sneeze_01" = "Xin chào, đang đọc gì thế?";
"ap11_spirit_sneeze_02" = "Đừng làm phiền tôi. Tôi đang tìm hiểu một du khách đến từ hành tinh khác.";
"ap11_spirit_sneeze_03" = "Những người lớn chắc chắn rất thú vị.";
"ap11_spirit_stretch_01" = "Bạn trông thật mệt mỏi! Sao vẫn còn bật đèn thế?";
"ap11_spirit_stretch_02" = "Tôi có lệnh phải bật đèn khi nó tắt.";
"ap11_spirit_stretch_03" = "Vậy tại sao bạn lại tắt nó sau khi bật nó lên?";
"ap11_spirit_stretch_04" = "Tôi có một lệnh khác để tắt đèn khi nó đang bật.";
"ap11_spirit_stretch_05" = "Vậy thì bạn đúng là một người không may mắn.";
"ap11_spirit_stretch_06" = "Mệnh lệnh chính là mệnh lệnh.";
"ap12_fetch_01_candle_01" = "Đưa cây nến này cho Thợ Sửa Chuông.";
"ap12_fetch_01_candle_02" = "Đưa cây nến này cho Kiến Trúc Sư Tài Ba.";
"ap12_fetch_01_candle_03" = "Đưa cây nến này cho Người Chỉ Dẫn Tích Cực.";
"ap12_fetch_01_candle_04" = "Đưa cây nến này cho Người Luyện Ánh Sáng.";
"ap12_fetch_01_candle_05" = "Đưa những cây nến còn lại cho Tinh Linh của họ.";
"ap12_fetch_01_candle_06" = "Tinh Linh này chưa sẵn sàng. Đưa nến cho Tinh Linh khác.";
"ap12_fetch_01_candle_07" = "Tinh Linh này đã nhận nến rồi.";
"ap12_fetch_01_cine_00" = "Con Đường Gió kết nối các vương quốc bị chặn rồi.";
"ap12_fetch_01_cine_01" = "Dùng khả năng bay của bạn giúp các Tinh Linh mở lại Con Đường Gió.";
"ap12_fetch_01_cine_02" = "Phân phát nến cho các Tinh Linh để mang ánh sáng trở lại Con Đường Gió.";
"ap12_fetch_02_cine_00" = "Con thuyền kết nối các Tinh Linh đã biến mất dưới những đám mây.";
"ap12_fetch_02_cine_01" = "Bay qua mây đưa thuyền về.";
"ap12_fetch_02_cine_02" = "Đưa mảnh bạn tìm thấy cho Chỉ Dẫn Bay.";
