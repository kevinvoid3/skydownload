"sf_art_07_09" = "Ý tưởng về Quỹ Đạo\n(Tác phẩm nghệ thuật của Tom Zhao)";
"sf_art_08_00" = "Trong giai đoạn đầu, những “vệ thú” được phác họa như những nhân vật thần thoại bảo vệ vương quốc của họ. Dần dần, họ được phát triển thành những nhân vật tiên tổ mang hình dáng loài người được chúng ta công nhận là không thể thiếu trong sự trỗi dậy và sụp đổ của vương quốc.";
"sf_art_08_01" = "Cùng nhau, họ được dẫn dắt bởi một vị Quốc Vương, người cuối cùng đã hy sinh bản thân để sinh ra một thế hệ mới - những đứa con của ánh sáng.\n(Tác phẩm nghệ thuật của Jacky Ke Jiang)";
"sf_art_08_02" = "ĐẢO BÌNH MINH - TRÍ TUỆ\n(Tác phẩm nghệ thuật của Tom Zhao)";
"sf_art_08_03" = "THẢO NGUYÊN ÁNH SÁNG - ĐỒNG CẢM\n(Tác phẩm nghệ thuật của Tom Zhao)";
"sf_art_08_04" = "RỪNG MƯA - NHẪN NẠI\n(Tác phẩm nghệ thuật của Tom Zhao)";
"sf_art_09_00" = "Đội ngũ nghệ thuật đã khám phá những khoảnh khắc câu chuyện quan trọng khi mỗi vị Tổ tiên gặp gỡ Những cư dân Sky... và đâu là cách có tác động lớn nhất để ghi lại hình ảnh này một cách trực quan?";
"sf_art_09_01" = "THUNG LŨNG VINH QUANG - VƯỢT TRỘI\n(Tác phẩm nghệ thuật của Tom Zhao)";
"sf_art_09_02" = "HOANG MẠC HOÀNG KIM - CAN ĐẢM\n(Tác phẩm nghệ thuật của Tom Zhao)";
"sf_art_09_03" = "KHO TRI THỨC - NIỀM TIN\n(Tác phẩm nghệ thuật của Tom Zhao)";
"sf_art_09_04" = "QUỐC VƯƠNG - HY SINH\n(Tác phẩm nghệ thuật của Khang Le)";
"sf_art_10_01" = "Khi phát triển cốt truyện, chúng tôi đã phác thảo ra mục đích sống mà các cư dân trong nền văn minh này có thể có.\n(Bản phác thảo của Yuichiro Tanabe)";
"sf_art_10_02" = "(Bản phác thảo của Yuichiro Tanabe)";
"sf_art_10_03" = "(Bản phác thảo của Yuichiro Tanabe)";
"sf_art_10_04" = "Câu chuyện bắt đầu bằng việc dân làng ở mỗi vương quốc tôn thờ chu kỳ linh hồn như một phần của việc nhân loại và thiên nhiên cùng tồn tại.\n(Bản phác thảo của Yuichiro Tanabe)";
"sf_art_10_05" = "(Bản phác thảo của Yuichiro Tanabe)";
"sf_art_10_06" = "(Tác phẩm nghệ thuật của Jacky Ke Jiang, Tom Zhao)";
"sf_art_11_00" = "Các Tinh Linh Tổ Tiên mang tới một khoảnh khắc về các nền văn minh trong quá khứ. Ký ức của họ mang lại kết cấu và hương vị to lớn cho từng vương quốc, với các tầng truyền thuyết và khám phá xung quanh mỗi một địa điểm.";
"sf_art_11_01" = "ĐẢO BÌNH MINH\n(Tác phẩm nghệ thuật của Yuichiro Tanabe)";
"sf_art_11_02" = "THẢO NGUYÊN ÁNH SÁNG\n(Tác phẩm nghệ thuật của Yuichiro Tanabe)";
"sf_art_11_03" = "RỪNG MƯA\n(Tác phẩm nghệ thuật của Yuichiro Tanabe)";
"sf_art_11_04" = "THUNG LŨNG VINH QUANG\n(Tác phẩm nghệ thuật của Yuichiro Tanabe)";
"sf_art_11_05" = "HOANG MẠC HOÀNG KIM\n(Tác phẩm nghệ thuật của Yuichiro Tanabe)";
"sf_art_11_06" = "KHO TRI THỨC\n(Tác phẩm nghệ thuật của Yuichiro Tanabe)";
"sf_art_12_00" = "Khi thiết kế các sinh vật, chúng tôi đã cân nhắc kỹ lưỡng về một hệ sinh thái rộng lớn hơn liên quan đến các chòm sao và vòng đời. Chúng tôi đưa ra những ẩn ý về cách ánh sáng và hư không tác động đến chúng về mặt lịch sử trên thế giới.";
"sf_art_12_01" = "Những sinh vật hùng vĩ này đã đưa ánh sáng quay trở lại các vì sao. Chúng tôi đã thiết kế chúng để chúng chuyển động một cách tao nhã giống như sinh vật thủy sinh đang bơi giữa những đám mây.\n(Tác phẩm nghệ thuật của Yuichiro Tanabe)";
"sf_art_12_02" = "Ban đầu, đội ngũ nghệ thuật bắt đầu với thiết kế loài cá, nhưng họ đã phát triển hình dạng của chúng thành cá đuối trong những lần xuất hiện lại sau đó.n\\\\(Tác phẩm nghệ thuật của Tom Zhao)";
"sf_art_13_00" = "Khi hình dung hư không là những người kể chuyện, chúng tôi đã thể hiện tác động của chúng một cách trung lập và tôn vinh vẻ đẹp riêng của cả hai dạng sống ánh sáng và bóng tối.\nBằng cách tôn vinh cả hai mặt tồn tại của chúng một cách bình đẳng, chúng tôi có thể dệt nên một thế giới phong phú hơn.";
"sf_art_13_01" = "Chúng tôi bắt đầu thử nghiệm những màu sắc và hình dạng có thể kết hợp những cảm xúc khi gặp bóng tối và hư không.\n(Tác phẩm nghệ thuật của Khang Le)";
"sf_art_13_02" = "Trong các tác phẩm nghệ thuật này, các dạng sống bị hư không xâm chiếm được thể hiện dưới dạng Nước Hắc Ám, Cây/Hoa Hắc Ám, Cua Hắc Ám và Rồng Hắc Ám.\n(Tác phẩm nghệ thuật của Tom Zhao)";
"sf_art_14_00" = "Vì thế giới của Sky trải qua nhiều vòng lặp, nên chúng tôi giữ cho hình đại diện luôn mở và dễ chỉnh sửa.\nKhi bắt đầu thiết kế các nhân vật trong bối cảnh nhóm, chúng tôi đã cân nhắc sự hài hòa về mặt thẩm mỹ của chúng trên màn hình.";
"sf_art_14_01" = "(Tác phẩm nghệ thuật của Jacky Ke Jiang)";
"sf_art_14_02" = "(Tác phẩm nghệ thuật của Yuichiro Tanabe)";
"sf_art_14_03" = "(Tác phẩm nghệ thuật của Jacky Ke Jiang)";
"sf_art_14_04" = "(Tác phẩm nghệ thuật của Jacky Ke Jiang)";
"sf_art_14_05" = "(Tác phẩm nghệ thuật của Yuichiro Tanabe)";
"sf_art_15_00" = "Mục tiêu của chúng tôi là làm cho hình đại diện cư dân Sky có thể tượng trưng cho bất kỳ nhóm người chơi nào.\nThay vì khuôn mặt, chúng tôi đã thêm mặt nạ để bạn có thể chọn biểu cảm và diện mạo của riêng mình.";
"sf_art_15_01" = "Mặc dù được phác thảo vào năm 2015 nhưng hình ảnh nhóm này đã báo trước sự phát triển về mặt nghệ thuật của Sky trước khi các mùa phiêu lưu bắt đầu.\n(Tác phẩm nghệ thuật của Yuichiro Tanabe)";
"sf_hist_02_00" = "Sony Computer Entertainment đã đề nghị phát hành ba trò chơi điện tử bao gồm flOw, Flower và Journey.\n\nTất cả các tựa game đều tái định nghĩa lối chơi sáng tạo, dễ tiếp cận và mang hướng tích cực.";
"sf_hist_03_00" = "Được thúc đẩy do sự kiện Journey được công nhận là 'Trò chơi của năm' và khả năng kết nối người chơi trên toàn cầu, studio đã tìm cách tập trung vào các chủ đề về lòng biết ơn và cộng đồng cho dự án tiếp theo của họ.\n\nĐây là hạt giống cho việc mở rộng sang nền tảng di động để tiếp cận nhiều khán giả hơn, và phát triển tựa sách tự xuất bản của họ, Sky.";
"sf_hist_03_01" = "Khám Phá Thiết Kế Trò Chơi";
"sf_hist_03_02" = "Tư Duy Tường Thuật Và Hoạt Hình";
"sf_hist_03_03" = "Chuẩn Bị Cho Một Ý Tưởng Thiết Kế Mới";
"sf_hist_03_04" = "Lên Kế Hoạch Nghệ Thuật";
"sf_hist_04_00" = "Trong vài năm phát triển đầu tiên, studio đã lặp lại quá trình thám hiểm và khám phá vui nhộn. Bước nhảy vọt trong lĩnh vực phát triển di động, trò chơi miễn phí, và tự xuất bản một tựa game vận hành trực tiếp đã thách thức đội ngũ và làm kéo dài lịch trình sản xuất.";
"sf_hist_04_01" = "Thử Nghiệm Thiết Kế Âm Thanh";
"sf_hist_04_02" = "Thảo Luận Nghệ Thuật Môi Trường";
"sf_hist_04_05" = "Đội ngũ nghệ thuật đã nghiên cứu rất nhiều hình dạng đám mây và cách chúng di chuyển để thiết kế một thế giới trên bầu trời.";
"sf_hist_04_06" = "Cảm hứng đến từ những cảm xúc được những đám mây truyền tải vào những thời điểm khác nhau trong ngày.";
"sf_hist_04_07" = "Nguyên mẫu ban đầu để thử nghiệm.";
"sf_hist_04_08" = "Nhiều nguyên mẫu đã được tạo ra để giúp lên kế hoạch cho các công nghệ và phần mềm làm trò chơi cần thiết đối với cảnh quan và hoạt động bay lượn trên mây.";
"sf_hist_04_09" = "Một điều hiển nhiên là khi đã ở giữa trời mây, chúng ta sẽ cần phải dựa vào chúng để làm một phông nền và khung cảnh đầy cảm xúc.";
"sf_hist_04_10" = "Giới thiệu môi trường quen thuộc.";
"sf_hist_04_11" = "Thế giới con người trong Sky.";
"sf_hist_04_12" = "Thử nghiệm hoạt động bay ở đường chân trời phía trên khung cảnh thành phố của con người.";
"sf_hist_04_13" = "Thử nghiệm ban đầu của người chơi trong thế giới Sky.";
"sf_hist_04_14" = "Một ví dụ khác về hình đại diện của người chơi không khoác áo choàng.";
"sf_hist_04_15" = "Đội ngũ đã đặt thiết kế ban đầu này ở Thảo Nguyên Ánh Sáng làm hình đại diện mẫu với vòng năng lượng hiển thị sức bay.";
"sf_hist_05_01" = "Teaser trực quan đầu tiên của Sky";
"sf_hist_06_00" = "Mùa thu năm 2017, Sky đã chính thức ra mắt tại Sự kiện Đặc biệt của Apple ở Cupertino, California. Trò chơi ra mắt trên AppStore dành cho iPhone và iPad.\n\nTrò chơi đã bước vào giai đoạn thử nghiệm beta kín cho đến khi được phát hành vào ngày 18 tháng 7 năm 2019.";
"sf_hist_06_03" = "Mỗi mùa đều có lối chơi, câu chuyện, nhân vật, biểu cảm và vật phẩm mới.";
"sf_hist_06_04" = "Ba bản phát hành đầu tiên này là: 'Mùa Tri Ân', 'Mùa Ánh Sáng' và 'Mùa Sở Hữu'.";
"sf_hist_06_05" = "CHUYỆN HẬU TRƯỜNG: Studio gắn bó với nhau qua những hoạt động như chơi bóng bàn, trò chơi điện tử, làm/tặng nến sáp cho nhau, xem phim và tham gia các chuyến đi nghiên cứu đến Disneyland. 🕯️";
"sf_hist_07_00" = "Vào năm 2020, Sky đã phát hành bốn mùa phiêu lưu mới cũng như ra mắt trên cửa hàng Google Play.";
"sf_hist_07_05" = "CHUYỆN HẬU TRƯỜNG: Hai trong số những phần này có thể đã được phát hành dưới những cái tên hoàn toàn khác... Bạn có đoán được chúng liên quan đến mùa nào không?\n\nMùa Hội Họp, Mùa Thức Tỉnh, Mùa Khởi Nguyên\nMùa Lữ Hành, Mùa Rạng Rỡ, Mùa Di Cư\n\n🕯️";
"sf_hist_08_00" = "Vào tháng 7 năm 2020, trò chơi đã kỷ niệm sinh nhật một tuổi. Thời điểm này chứng kiến ​​thế giới bị ảnh hưởng nặng nề bởi đại dịch COVID-19.";
"sf_hist_08_01" = "Kỷ niệm Sky một tuổi\n\nThông qua sáng kiến ​​'Gói Chữa Lành' đặc biệt, thatgamecompany đã phát động chiến dịch phi lợi nhuận đầu tiên của Sky nhằm hỗ trợ những người lao động ở tuyến đầu thông qua Tổ chức Bác Sĩ Không Biên Giới. Nhờ cộng đồng, hơn 1 triệu USD đã được quyên góp.";
"sf_hist_09_00" = "Là một phần của mỗi mùa phiêu lưu TRONG NĂM 2021, Sky đã chứng kiến ​​sự mở rộng liên tục trên khắp các vương quốc, nơi đã giới thiệu các tính năng mới, những câu chuyện sâu sắc hơn, thúc đẩy đa người chơi và lối chơi độc đáo.";
"sf_hist_09_03" = "Mùa Hoàng Tử Bé\n\nBên cạnh sự kiện kỷ niệm hai năm trò chơi và mở rộng sang nền tảng Nintendo Switch, Sky cũng chào đón sự kiện hợp tác IP đầu tiên với Olivier d'Agay và Hoàng Tử Bé yêu quý của Antoine de Saint-Exupéry.";
"sf_hist_09_05" = "CHUYỆN HẬU TRƯỜNG: Bạn có biết…?\n\nMùa Giấc Mơ: Một số nhân vật mà chúng tôi đã cân nhắc và có thể đã đưa vào là Chủ Quán Cà Phê, Người Biểu Diễn Thổi Lửa và Nghệ Sĩ Đàn Hạc.";
"sf_hist_09_06" = "CHUYỆN HẬU TRƯỜNG: Trong Mùa Hoàng Tử Bé, những bài thơ của Rose ban đầu không phải là một phần của cách viết và thiết kế tường thuật.\n\nSự xuất hiện của cô đã được thêm vào giữa quá trình sản xuất và mang lại chiều sâu mới cho mùa này.";
"sf_hist_10_00" = "Vào năm 2021, triển lãm FUTURES của Viện Smithsonian và sự kiện Barbican Virtual Realms đã giới thiệu các thiết kế sáng tạo của Sky và thatgamecompany tới những người tham dự.";
"sf_hist_10_01" = "Triển lãm FUTURES của Viện Smithsonian năm 2021, Washington DC";
"sf_hist_10_02" = "Sky showcase tại triển lãm FUTURES của Viện Smithsonian";
"sf_hist_10_03" = "Sky được mô phỏng lại tại sự kiện Barbican Virtual Realms vào năm 2021, London";
"sf_hist_11_00" = "Vào năm 2022, Sky ra mắt trên Sony PlayStation, cộng đồng Sky ngày càng phát triển.\n\nTrong năm đó, các mùa phiêu lưu đã giới thiệu các khả năng mới của người chơi, và studio đã công bố một dự án hoạt hình Sky đang được sản xuất.";
"sf_hist_11_04" = "Sự kiện hợp tác của Sky với nghệ sĩ âm nhạc được yêu thích trên toàn thế giới, AURORA, đã giới thiệu những công nghệ mới giúp âm nhạc của cô trở nên sống động trong trò chơi. Mùa này hỗ trợ một buổi hòa nhạc trực tiếp đồng thời, không giống bất kỳ buổi hòa nhạc nào trước đây.";
"sf_hist_11_05" = "CHUYỆN HẬU TRƯỜNG: Đội ngũ đã khởi động 'Sky Assemblies' khai mạc tại Long Beach, California.\n\nTại đây, các cư dân Sky đã tổ chức nhiều lễ hội khác nhau, cùng nhau chơi trực tiếp và gặp được những người bạn mới ở sự kiện.";
"sf_hist_12_00" = "Khi Sky phát triển, đội ngũ phát triển và phát hành của studio cũng lớn mạnh nhằm phát triển trò chơi cũng như các mối quan hệ đối tác.";
"sf_hist_12_01" = "Sky kỷ niệm sinh nhật lần thứ 3.";
"sf_hist_12_02" = "Nhờ sự hỗ trợ hào phóng của cộng đồng người chơi, hợp tác phi lợi nhuận của đội ngũ với Dự án Trevor đã bước sang năm thứ 2 và gây quỹ được tổng cộng hơn 680.000 USD.";
"sf_hist_13_00" = "Đội ngũ Sky và thatgamecompany tập trung vào việc tạo ra bước đột phá mới để chuẩn bị cho sinh nhật 4 tuổi.\n\nBốn mùa mới đã được phát triển và phát hành bổ sung trong năm này.";
"sf_hist_13_05" = "Kể từ năm 2021, cộng đồng Sky của chúng tôi đã huy động được hơn 1,84 triệu USD cho tổ chức The Ocean Cleanup.\n\nNhiệm vụ của họ là nghiên cứu, chiết xuất và giám sát tình trạng ô nhiễm nhựa ở các đại dương và sông ngòi trên toàn cầu.";
"sf_hist_14_00" = "Sky mong muốn lập Kỷ lục Guinness Thế giới mới cho “Thế giới ảo chủ đề hòa nhạc có nhiều người dùng nhất” trong thời gian tại Gamescom.";
"sf_hist_14_01" = "Sự kiện Kỷ lục Guinness Thế giới đã thành công rực rỡ. Sky không chỉ phá kỷ lục mà còn làm được điều đó khi thu hút được hơn 10.000 người dùng đồng thời trên cùng một máy chủ.";
"sf_hist_15_00" = "Sky sẽ tôn vinh sinh nhật 5 tuổi thật phong cách khi studio tổ chức một sự kiện kéo dài hai ngày tại Tokyo, Nhật Bản. Những người chơi toàn cầu của chúng tôi trong trò chơi cũng sẽ cùng chúng tôi ăn mừng.";
"sf_hist_15_01" = "Sự kiện hợp tác của Mùa Cửu Sắc Lộc giới thiệu một câu chuyện lôi cuốn cùng dàn nhân vật tuyệt đẹp vào vương quốc Sky.";
"sf_hist_15_02" = "Được xuất bản vào mùa hè này, cuốn artbook 'The Art of Sky' nhìn lại chặng đường phát triển kéo dài 7 năm của trò chơi (2012-2019).";
"sf_hist_15_03" = "Gần đây nhất, đội ngũ cũng đã phát hành 'Mùa Xây Tổ'.";
