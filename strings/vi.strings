"bloom25_site5_question_01" = "Một bông hoa nở từ thời gian và năng lượng của bạn.";
"bloom25_site5_question_02" = "Dành một khoảnh khắc yên tĩnh để viết một lời nhắn gửi chân thành đến bông hồng này.";
"bloom25_site5_quote" = "\"Chính thời gian bạn dành cho bông hồng của mình khiến nó trở nên quan trọng.\"";
"bloom25_site6_question_01" = "Hãy ngước nhìn những vì sao trên bầu trời. Bạn có nghe thấy chúng hát cho bạn không?";
