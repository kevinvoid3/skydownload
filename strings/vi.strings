"sf_art_01_00" = "Sky ban đầu được tạo ra như là phần tiếp theo của Cloud (một trò chơi được thiết kế trước khi studio thatgamecompany được thành lập).\n\nSky bắt đầu phát triển vào năm 2012 bởi một đội ngũ khoảng 10 nhà phát triển tại văn phòng ở Santa Monica, California.";
"sf_art_01_01" = "Hình ảnh đầu tiên của Sky là một bức phác họa bằng bút chì nổi bật về những đứa trẻ bay cùng nhau, tâm hồn chúng hòa quyện vào nhau trong hình dáng của một con chim thần thoại.\n(Bản phác thảo của Jenova Chen)";
"sf_art_01_02" = "Bức vẽ The Giant của nghệ sĩ người Mỹ N.C. Wyeth là nguồn cảm hứng trung tâm của Sky ngay từ những ngày đầu.\n(Bức vẽ The Giant của N.C. Wyeth)";
"sf_art_01_03" = "Chủ đề câu chuyện của Hoàng Tử Bé đã trở thành nguồn tham khảo trong quá trình phát triển ban đầu.\n(Hình ảnh Hoàng Tử Bé, tác giả Antoine de Saint-Exupéry)";
"sf_art_01_04" = "Phim tài liệu Winged Migration đã cho chúng tôi biết về các trạng thái khác nhau do các loài chim bay đường dài tạo ra.\n(Đạo diễn Jacques Perrin, Jacques Cluzaud, Michel Debats)";
"sf_art_02_01" = "“Overview Effect” là một video có sức ảnh hưởng lớn được chia sẻ bởi các phi hành gia từ trạm vũ trụ. Họ nói về cảm giác kinh ngạc mà họ cảm nhận được khi nhìn ngắm trái đất. Điều này đã truyền cảm hứng cho một bức tranh ban đầu ở giai đoạn tiền sản xuất.\n(Tác phẩm nghệ thuật của Jenova Chen)";
"sf_art_03_00" = "Trong quá trình khám phá nghệ thuật ban đầu, các bản phác thảo tâm trạng đầu tiên của chúng tôi dựa trên ý tưởng về một đứa trẻ bay lên bầu trời để gặp được những người khổng lồ.\n\nTrong giai đoạn này, chúng tôi đã vẽ nhiều hòn đảo mà bạn có thể lướt qua.";
"sf_art_03_01" = "Những bức tranh này toát lên vẻ huyền ảo và trẻ thơ.\n(Tác phẩm nghệ thuật của Jacky Ke Jiang)";
"sf_art_03_02" = "Chúng tôi đã tưởng tượng ra con đường của những linh hồn gặp được những người khổng lồ và sinh vật kỳ diệu giữa những đám mây.\n(Tác phẩm nghệ thuật của Jacky Ke Jiang)";
"sf_art_03_03" = "Sự tự do và cảm giác bay lượn trên những hòn đảo xanh mướt và đại dương đã trở thành mục tiêu phát triển quan trọng.\n(Tác phẩm nghệ thuật của Yuichiro Tanabe)";
"sf_art_03_04" = "(Tác phẩm nghệ thuật của Yuichiro Tanabe)";
"sf_art_03_05" = "(Tác phẩm nghệ thuật của Tiffany Hayashi, Yuichiro Tanabe)";
"sf_art_04_00" = "Đội ngũ chúng tôi nhận ra rằng chủ đề “kết nối” sẽ là yếu tố cốt lõi của trò chơi. Chúng tôi đã tạo ra một nguyên mẫu để thử nghiệm những cách kết nối khác nhau, bao gồm tùy chọn cho phép người chơi nắm tay nhau. Lần chơi thử này đã trở thành một cột mốc quan trọng trong quá trình phát triển trò chơi của chúng tôi.";
"sf_art_04_01" = "(Tác phẩm nghệ thuật của Yuichiro Tanabe, Jacky Ke Jiang)";
"sf_art_05_01" = "(Tác phẩm nghệ thuật của Tom Zhao)";
"sf_art_05_02" = "(Tác phẩm nghệ thuật của Tom Zhao)";
"sf_art_05_03" = "(Tác phẩm nghệ thuật của Tom Zhao)";
"sf_art_06_00" = "Các trụ cột cốt lõi trong trò chơi của chúng tôi là Kỳ quan, Nhân loại và Cộng đồng đã trở thành cách chúng tôi hợp lý hóa nghệ thuật, thiết kế và câu chuyện. Nếu không có những trụ cột này, có lẽ thế giới Sky đã không tồn tại.";
"sf_art_06_01" = "KỲ QUAN. Trung tâm có sự an toàn, nhưng xung quanh là bóng tối.\n(Tác phẩm nghệ thuật của Tom Zhao)";
"sf_art_06_02" = "NHÂN LOẠI. Mọi khoảnh khắc đều tuyệt vời hơn khi có những người chơi khác.\n(Tác phẩm nghệ thuật của Tom Zhao)";
"sf_art_06_03" = "CỘNG ĐỒNG. Cảm giác bạn thuộc về một cộng đồng toàn cầu đại diện cho lòng nhân ái và vị tha.\n(Tác phẩm nghệ thuật của Tom Zhao)";
"sf_art_07_00" = "Khu vực này giới thiệu tác phẩm nghệ thuật ban đầu về các vương quốc của thế giới, và phác họa tâm trạng của cung bậc cảm xúc.";
"sf_art_07_01" = "Ý tưởng về Đảo Bình Minh\n(Tác phẩm nghệ thuật của Yuichiro Tanabe)";
"sf_art_07_02" = "Ý tưởng về Thảo Nguyên Ánh Sáng\n(Tác phẩm nghệ thuật của Tom Zhao)";
"sf_art_07_03" = "Ý tưởng về Rừng Mưa\n(Tác phẩm nghệ thuật của Tom Zhao)";
"sf_art_07_04" = "Ý tưởng về Thung Lũng Vinh Quang\n(Tác phẩm nghệ thuật của Tom Zhao)";
"sf_art_07_05" = "Ý tưởng về Hoang Mạc Hoàng Kim\n(Tác phẩm nghệ thuật của Khang Le)";
"sf_art_07_06" = "Ý tưởng về Kho Tri Thức\n(Tác phẩm nghệ thuật của Jacky Ke Jiang)";
