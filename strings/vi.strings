"ap14_story_tree_1a2a3a4a" = "Nó vỡ tan, mang lại cho người khác ánh hào quang mà nó gây dựng được qua hàng năm trời";
"ap14_story_tree_1a2a3a4a_abv" = "Nó vỡ tan...";
"ap14_story_tree_1a2a3a4a_cont" = "Bầu trời đêm sáng rực. Nơi một ngôi sao tỏa sáng, vô số dấu chân kim khác vừa xuất hiện.";
"ap14_story_tree_1a2a3a4a_cont_abv" = "Bầu trời đêm sáng rực...";
