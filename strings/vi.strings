"ap11_fetch_05_bye_02" = "Tôi rất vui khi có bạn như một người bạn.";
"ap11_fetch_05_end_quote" = "Người ta phải chịu trách nhiệm mãi mãi với những thứ mình đã thuần hóa.";
"ap11_fetch_05_meet_01" = "Tôi tìm thấy cái này trong hang động mà chúng tôi đã tới.";
"ap11_fetch_05_meet_02" = "Làm thế nào để dùng?";
"ap11_fetch_05_meet_03" = "Thử cái này giúp tôi được không?";
"ap11_fetch_05_outro_01" = "(Khụ khụ)";
"ap11_fetch_05_outro_02" = "Những ngày đó, tôi giúp hành tinh của anh ấy thơm ngát.";
"ap11_fetch_05_outro_03" = "Những đêm đó, tôi héo mòn.";
"ap11_fetch_05_outro_04" = "Nhưng anh ấy không thể thấy tình bạn của tôi,";
"ap11_fetch_05_outro_05" = "hay niềm vui trong tâm hồn tôi.";
"ap11_fetch_05_outro_06" = "Liệu anh ấy có biết ...?";
"ap11_fetch_05_reflect_01" = "Lẽ ra tôi nên đánh giá cô ấy dựa trên hành động...";
"ap11_fetch_05_reflect_02" = "chứ không phải là lời nói.";
"ap11_fetch_05_reflect_03" = "......";
"ap11_fetch_05_reflect_04" = "Bạn có cho rằng tôi nên có trách nhiệm với bông hồng của mình không?";
"ap11_fetch_05_sunset_01" = "Tôi rất thích cảnh hoàng hôn.";
"ap11_fetch_05_sunset_02" = "Giống như trở về nhà.";
"ap11_fetch_05_sunset_03" = "Có một ngày, tôi đã nhìn hoàng hôn bốn mươi bốn lần!";
"ap11_fetch_05_sunset_04" = "Tôi tự hỏi, liệu bông hồng của tôi có còn ngắm hoàng hôn?";
"ap11_fetch_05_sunset_05" = "Tôi tự hỏi, liệu cô ấy có an toàn trước gió không?";
"ap11_fetch_05_sunset_06" = ".......";
"ap11_fetch_05_sunset_07" = "Bạn có thể chơi một bản nhạc khác cho tôi được không?";
"ap11_fetch_06_campfire_01" = "Tôi sẽ tặng bạn một món quà ...";
"ap11_fetch_06_campfire_02" = "Đó là quà của tôi. Chỉ vậy thôi.";
"ap11_fetch_06_campfire_03" = "Tối nay, tôi sẽ trở về nhà.";
