"ap11_fetch_03_outro_05" = "Liệu anh ấy có nhìn lại và nhớ đến tôi không?";
"ap11_fetch_03_statue_01" = "Những sinh vật này là gì?";
"ap11_fetch_03_statue_02" = "Chúng có thể được thuần hóa?";
