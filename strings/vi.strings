"ap11_fetch_06_campfire_05" = "Tôi sẽ nở nụ cười trên ngôi sao đó.";
"ap11_fetch_06_campfire_06" = "Và khi bạn nhìn lên bầu trời đêm ...";
"ap11_fetch_06_campfire_07" = "bạn sẽ thấy giống như tất cả các ngôi sao đang cười.";
"ap11_fetch_06_campfire_08" = "Sẽ rất xa xôi và khó khăn ...";
"ap11_fetch_06_campfire_09" = "Có lẽ tôi sẽ rất sợ.";
"ap11_fetch_06_campfire_10" = "Trông như thể tôi đang đau khổ.";
"ap11_fetch_06_campfire_11" = "Đừng đến chứng kiến điều đó.";
"ap11_fetch_06_campfire_12" = "Vào ban đêm, bạn sẽ nhìn lên các vì sao.";
"ap11_fetch_06_campfire_13" = "Ngôi sao của tôi sẽ là một trong số đó, tỏa sáng vì bạn.";
"ap11_fetch_06_campfire_14" = "Và, bạn sẽ thích ngắm nhìn tất cả các vì sao trên trời ...";
"ap11_fetch_06_campfire_15" = "Tất cả các ngôi sao đó sẽ là bạn của bạn.";
"ap11_fetch_06_end_quote" = "Làm thế nào để tiếp cận anh ta? Tìm anh ta ở đâu? Thật là bí ẩn, vùng đất của nước mắt.";
"ap11_fetch_06_outro_01" = "(Khụ khụ)";
"ap11_fetch_06_outro_02" = "Thời gian của tôi sắp hết rồi...";
"ap11_fetch_06_outro_03" = "Tôi cầu xin sự tha thứ.";
"ap11_fetch_06_outro_04" = "Vậy mà, anh ấy vẫn chưa trở về.";
"ap11_fetch_06_outro_05" = "Liệu anh ấy có quay lại với tôi không?";
"ap11_fetch_07_end_quote" = "Ngôi sao của tôi sẽ là một trong số đó, tỏa sáng vì bạn. Và, bạn sẽ thích ngắm nhìn tất cả các vì sao trên trời ... Tất cả các ngôi sao đó sẽ là bạn của bạn.";
"ap11_fetch_07_end_quote_01" = "Ngôi sao của tôi sẽ là một trong số đó, tỏa sáng vì bạn.";
"ap11_fetch_07_end_quote_02" = "Và, bạn sẽ thích ngắm nhìn tất cả các vì sao trên trời ...";
"ap11_fetch_07_end_quote_03" = "Tất cả các ngôi sao đó sẽ là bạn của bạn.";
