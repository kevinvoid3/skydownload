"ap11_fetch_04_end_quote" = "Những ngôi sao trở nên rạng rỡ vì một bông hoa bạn không nhìn thấy ...";
"ap11_fetch_04_meet_01" = "Có thứ gì đó kỳ lạ ở đằng kia.";
"ap11_fetch_04_meet_02" = "Những bông hoa này đang thiếu dưỡng khí!";
"ap11_fetch_04_outro_01" = "Tiếng cười của anh im bặt.";
"ap11_fetch_04_outro_02" = "Sự phù phiếm của tôi sụp đổ.";
"ap11_fetch_04_outro_03" = "Không có bạn mình bên cạnh,";
"ap11_fetch_04_outro_04" = "những buổi hoàng hôn này trở nên ít ngọt ngào hơn.";
"ap11_fetch_04_outro_05" = "Không biết một ngày nào đó anh ấy có hối hận không?";
