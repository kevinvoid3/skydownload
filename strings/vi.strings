"ap11_fetch_02_whale_03" = "Thứ này có thể thuần hóa được chứ?";
"ap11_fetch_03_beach_01" = "Chưa bao giờ tôi thấy nhiều nước như vậy trên bất kỳ hành tinh nào mà tôi từng đến!";
