"ap14_story_tree_1a2b3b4a" = "Nó dồn toàn bộ sức lực của mình vào lần nháy sáng yếu ớt cuối cùng.";
"ap14_story_tree_1a2b3b4a_abv" = "Nó dồn toàn bộ sức lực của mình...";
"ap14_story_tree_1a2b3b4a_cont" = "Chứng kiến ​​những tia sáng cuối cùng của ngôi sao, đứa trẻ không còn cảm thấy cô đơn nữa. Giờ là hy vọng, kiên trì.";
"ap14_story_tree_1a2b3b4a_cont_abv" = "Chứng kiến ​​những tia sáng cuối cùng của ngôi sao...";
"ap14_story_tree_1a2b3b4b" = "Nó dành những tia sáng cuối cùng để giúp đỡ đứa trẻ lang thang.";
"ap14_story_tree_1a2b3b4b_abv" = "Nó dành...";
"ap14_story_tree_1a2b3b4b_cont" = "Rọi sáng một hang động, ngôi sao dẫn đứa trẻ đi tìm nơi trú ẩn... như lời tiên tri đã báo trước.";
"ap14_story_tree_1a2b3b4b_cont_abv" = "Rọi sáng một hang động...";
"ap14_story_tree_1a2b3b_cont" = "Nghe thấy tiếng gọi của họ...";
