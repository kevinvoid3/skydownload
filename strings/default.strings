"mischief26_walter_office_chat_1" = "*woof*";
"mischief26_zack_office_chat_1" = "What, how did you get here?";
"mischief26_zack_office_chat_10" = "When you're ready, here is a portal to my favorite secret place.";
"mischief26_zack_office_chat_11" = "See you in the skies!";
"mischief26_zack_office_chat_2" = "Oh well, welcome to my office. I am already hard at work on the next event.";
"mischief26_zack_office_chat_3" = "Working from home can feel a bit isolating at times...";
"mischief26_zack_office_chat_4" = "...but it's hard to beat working with your dog.";
"mischief26_zack_office_chat_5" = "We try a lot of weird things and crazy ideas as we build sky.";
"mischief26_zack_office_chat_6" = "Experimenting means failing so they don't always land 100% of the time. Just know our goal is always to make the coolest game for you and your friends.";
"mischief26_zack_office_chat_7" = "I appreciate you sticking with us through the ups and downs. Being able to make art for a living is the coolest job in the world.";
"mischief26_zack_office_chat_8" = "Thank you for stopping in";
"mischief26_zack_office_chat_9" = "Leave me a message at the pond";
"mischief26_zombiecrab_intro_chat_1" = "H e l l o";
"mischief26_zombiecrab_intro_chat_2" = "F i n d m o r e r e d c r a b s";
"mischief26_zombiecrab_intro_chat_3" = "T h e y c o n v e r t b r a i n p o w e r";
"mischief26_zombiecrab_intro_chat_4" = "t o s o m e t h i n g m o r e u s e f u l";
