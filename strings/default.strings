"ap26_chase_intro" = "Catch the blue bird to reveal its true nature.";
"ap26_feather_hint" = "A blue feather! The bird must be nearby...";
"ap26_fetch01_fragment_intro_00" = "Collect feathers from the blue bird to add to the celebration!";
"ap26_fetch01_intro_00" = "\"I know of a bird, blue like sapphires...";
"ap26_fetch01_intro_01" = "Follow Royal Hairtousle Teen to the Citadel to seek the Blue Bird?";
"ap26_fetch01_intro_02" = "... whose call rings out at lavish feasts.\"";
"ap26_fetch01_outro_01" = "\"A bird was found, and its feathers were blue...";
"ap26_fetch01_outro_02" = "...but it disappeared like candle smoke.\"";
"ap26_fetch02_intro_00" = "\"I know of a bird, blue like my mother's eyes...";
"ap26_fetch02_intro_01" = "Follow Nostalgic Sparkler Parent to the Vault Archive to seek the Blue Bird?";
"ap26_fetch02_intro_02" = "...whose call echoes within our precious memories.\"";
"ap26_fetch02_mem_01" = "\"Beloved grandchild, we made this swing for you on our favorite tree.\"";
"ap26_fetch02_mem_02" = "\"Look how high you can go now!\"";
"ap26_fetch02_mem_03" = "\"My child, it's wonderful to return here with you after all this time.\"";
"ap26_fetch02_outro_02" = "...but the tighter we held, the faster it faded.\"";
"ap26_fetch03_hint_01" = "Perhaps the bird would like to see you perform together!";
"ap26_fetch03_hint_02" = "But you aren't dressed for a performance yet...";
"ap26_fetch03_intro_00" = "\"I know of a bird, blue like indigo cloth...";
"ap26_fetch03_intro_01" = "Follow Costumed Confetti Cousin to the Starlight Desert to seek the Blue Bird?";
"ap26_fetch03_intro_02" = "...whose call trills wherever crowds flock in admiration.";
"ap26_fetch03_outro_02" = "...but it unwound from itself like loose thread.";
"ap26_fetch04_dialog_01" = "\"This peaceful forest is home to many colorful birds.\"";
"ap26_fetch04_dialog_02" = "\"I'm sure we can find the blue bird here!\"";
"ap26_fetch04_intro_00" = "\"I know of a bird, blue like a pristine river...";
"ap26_fetch04_intro_01" = "Follow Woodcutting Pleaful Parent to the Hidden Forest to seek the Blue Bird?";
"ap26_fetch04_intro_02" = "...whose call reflects the peaceful harmony of the forest.”";
"ap26_fetch04_outro_01" = "\"A bird was found, and its feathers were blue...";
"ap26_fetch04_outro_02" = "...but it scattered in the wind and left only silence.\"";
"ap26_fetch05_intro_00" = "\"I know of a bird, blue like the stars...";
"ap26_fetch05_intro_01" = "Follow Divining Wise Grandparent to seek the Blue Bird?";
"ap26_fetch05_intro_02" = "...whose call trumpets where great destinies are born”";
"ap26_fetch05_outro_01" = "\"A bird was found, and its feathers were blue...";
"ap26_fetch05_outro_02" = "...but like a destiny, it was not meant to be merely held.\"";
"ap26_fetch05_quest_01" = "\"These children know their destinies, and are off to be born.\"";
"ap26_fetch05_quest_02" = "“Others need help from the blue bird to speak their destiny out loud.\"";
"ap26_fetch05_quest_03" = "\"Tell me your destiny, Child.\"";
"ap26_fetch05_quest_04" = "\"I'm going to be a gardener and make beautiful things grow!\"";
"ap26_fetch05_quest_05" = "\"When I am born, I will invent machines that heal the sick!\"";
"ap26_fetch05_quest_06" = "\"I'm going to sing songs that give hope to those who have none!\"";
"ap26_fetch05_quest_07" = "\"Knowing your destiny is only the beginning...\"";
"ap26_fetch06_quest_01" = "Who do you treasure more than wealth?";
"ap26_fetch06_quest_02" = "What do you remember that propels you forward?";
"ap26_fetch06_quest_03" = "When you look in the mirror, which self do you see?";
"ap26_fetch06_quest_04" = "Why do we disrupt our own harmony?";
"ap26_fetch06_quest_05" = "How long will you wait before you pursue your destiny?";
"ap26_fetch06_quest_06" = "\"Where is your Blue Bird?\"";
"ap26_fetchintro_hint_01" = "To heal this child's sorrow, you must find the Blue Bird.";
"ap26_prologue_00" = "A child has been stricken with a powerful and enduring sadness.";
"ap26_prologue_01" = "The child's family has gathered, each hoping to help lift the sorrow.";
"ap26_prologue_02" = "Together, you must find and bring back the legendary Blue Bird!";
