"ap31_fetch_letter_hint1" = "Deliver Vincent's letter to Theo";
"ap31_flowertouch_hint1" = "Approach Theo's sunflower";
"ap31_fq1_letter1_part1" = "I am already looking forward to Christmas.";
"ap31_fq1_letter1_part2" = "Two years ago we took that evening walk in the snow—";
"ap31_fq1_letter1_part3" = "do you still remember?";
"ap31_fq1_letter1_part4" = "When we saw the moon rising above Mariënhof?";
"ap31_fq1_letter2_part1" = "Words cannot express how happy I feel...";
"ap31_fq1_letter2_part2" = "...to have taken up drawing again!";
"ap31_fq1_letter2_part3" = "It had long been on my mind,";
"ap31_fq1_letter2_part4" = "but I always considered it impossible and beyond my reach.";
"ap31_fq1_letter3_part1" = "Diggers, sowers, ploughmen, men and women—";
"ap31_fq1_letter3_part2" = "I must draw them all incessantly.";
"ap31_fq1_letter3_part3" = "Everything that belongs to country life, I must examine it and draw it.";
"ap31_fq1_letter3_part4" = "I no longer feel as helpless before nature as I once did!";
"ap31_fq1_letter4_part1" = "Painting comes more naturally to me than I thought it would.";
"ap31_fq1_letter4_part2" = "Maybe that's the best way forward...to pour all my effort into painting?";
"ap31_fq1_letter4_part3" = "I must confess...";
"ap31_fq1_letter4_part4" = "...I have no idea.";
"ap31_fq1_letter5_part1" = "My money is not yet entirely gone,";
"ap31_fq1_letter5_part2" = "but I do not have much left.";
"ap31_fq1_letter5_part3" = "I have had to spend a large sum on painting supplies.";
"ap31_fq1_letter5_part4" = "I hope you can send something soon.";
"ap31_fq2_letter1_part1" = "I did not even know what the impressionists were,";
"ap31_fq2_letter1_part2" = "now I have seen them,";
"ap31_fq2_letter1_part3" = "and though not being one of the club yet,";
"ap31_fq2_letter1_part4" = "I have much admired certain impressionists’ pictures...";
"ap31_fq2_letter2_part1" = "I have mailed you some drawings.";
"ap31_fq2_letter2_part2" = "Go ahead and tell me";
"ap31_fq2_letter2_part3" = "why they won't sell,";
"ap31_fq2_letter2_part4" = "and how I might draw ones that will?";
"ap31_fq2_letter3_part1" = "I hope to improve in such a way";
"ap31_fq2_letter3_part2" = "that you may confidently";
"ap31_fq2_letter3_part3" = "show my work";
"ap31_fq2_letter3_part4" = "without embarrassing yourself.";
"ap31_fq3_letter1_part1" = "I want to make real progress this year...";
"ap31_fq3_letter1_part2" = "...progress,";
"ap31_fq3_letter1_part3" = "to be honest,";
"ap31_fq3_letter1_part4" = "that I sorely need.";
"ap31_fq3_letter2_part1" = "I plan so carefully,";
"ap31_fq3_letter2_part2" = "but even today I found that for the ten meters of canvas, I had perfectly budgeted";
"ap31_fq3_letter2_part3" = "all the colors...with one exception:";
"ap31_fq3_letter2_part4" = "the fundamental yellow.";
"ap31_fq3_letter3_part1" = "I've never been so fortunate, for here nature is exceptionally beautiful.";
"ap31_fq3_letter3_part2" = "Everything and everywhere.";
"ap31_fq3_letter3_part3" = "The vault of the sky is a magnificent blue, and the sun has a radiance of pale sulfur...";
"ap31_fq3_letter3_part4" = "...just as soft and charming as the celestial blues and yellows in Vermeer of Delft.";
"ap31_fq3_letter3_part5" = "I cannot paint anything as beautifully as that.";
"ap31_fq3_letter3_part6" = "But it captivates me so much that I let myself go...";
"ap31_fq3_letter4_part1" = "I wanted to furnish the house not just for myself, but in such a way as to be able to accommodate someone else.";
"ap31_fq3_letter4_part2" = "Naturally, this has eaten up most of the money.";
"ap31_fq3_letter4_part3" = "With what remains, I have purchased twelve chairs,";
"ap31_fq3_letter4_part4" = "a mirror,";
"ap31_fq3_letter4_part5" = "and a few small indispensable things...";
"ap31_fq3_letter4_part6" = "...which means, by next week, I will be able to move in!";
"ap31_fq3_letter5_part1" = "I am so happy with the house, and with the work...";
"ap31_fq3_letter5_part2" = "...that I dare to believe this joy will not be mine alone,";
"ap31_fq3_letter5_part3" = "but that you will share it on your end by having good fortune as well!";
"ap31_fq3_letter6_part1" = "I will be so happy to be able to furnish my house - and that can only help me pull through.";
"ap31_fq4_letter1_part1" = "I would be so happy";
"ap31_fq4_letter1_part2" = "if you could come visit to see Jo and our little baby!";
"ap31_fq4_letter1_part3" = "As we mentioned before,";
"ap31_fq4_letter1_part4" = "we have named him after you.";
"ap31_fq4_letter2_part1" = "Well, do you know what I hope for, when I allow myself to hope?";
"ap31_fq4_letter2_part2" = "That the family will be for you";
"ap31_fq4_letter2_part3" = "what nature is for me...";
"ap31_fq4_letter2_part4" = "...the clods of earth, the grass, the yellow wheat, the peasant.";
"ap31_fq4_letter3_part1" = "Now, this horror of living is already less pronounced,";
"ap31_fq4_letter3_part2" = "the melancholy less acute.";
"ap31_fq4_letter3_part3" = "But of motivation, I have none at all...few, if any, desires...";
"ap31_fq4_letter3_part4" = "...and almost none of what belongs to an ordinary life.";
"ap31_fq4_letter4_part1" = "I am working relentlessly in my room,";
"ap31_fq4_letter4_part2" = "which does me good";
"ap31_fq4_letter4_part3" = "and chases away, I imagine,";
"ap31_fq4_letter4_part4" = "these abnormal ideas.";
"ap31_fq4_letter5_part1" = "It is six weeks since I have set foot outside...";
"ap31_fq4_letter5_part2" = "...not even into the garden.";
"ap31_fq4_letter5_part3" = "Next week,";
"ap31_fq4_letter5_part4" = "when I have finished the canvases in progress,";
"ap31_fq4_letter5_part5" = "I am, however, going to try.";
"ap31_fq4_letter6_part1" = "Here and there, even I have found friends and things that I love.";
"ap31_fq4_letter6_part2" = "Can you understand, then,";
"ap31_fq4_letter6_part3" = "while still finding my affliction horrible,";
"ap31_fq4_letter6_part4" = "that nevertheless I have formed bonds here";
"ap31_fq4_letter6_part5" = "that are a little too deep?";
"ap31_fq4_letter7_part1" = "Bit by bit, I am coming to view madness as an illness, just like any other.";
"ap31_fq4_letter7_part2" = "The change of scenery is doing me good.";
"ap31_fq4_letter7_part3" = "The doctor here is inclined to view what I experienced as something similar to an epileptic attack.";
"ap31_fq4_letter7_part4" = "But I haven't looked into it.";
"ap31_fq5_date1" = "Six Months Later";
"ap31_fq5_date2" = "Two Days Later";
"ap31_fq5_letter1_part1" = "Besides the child,";
"ap31_fq5_letter1_part10" = "to show it and have it be appreciated";
"ap31_fq5_letter1_part11" = "as much as possible,";
"ap31_fq5_letter1_part2" = "he has left me yet another task—";
"ap31_fq5_letter1_part3" = "to preserve intact, for the child,";
"ap31_fq5_letter1_part4" = "all of the treasures that Theo and Vincent had gathered.";
"ap31_fq5_letter1_part5" = "That, too, is my work.";
"ap31_fq5_letter1_part6" = "I live entirely in my thoughts with Theo and Vincent.";
"ap31_fq5_letter1_part7" = "Oh, how infinitely tender and sweet and loving their relationship was!";
"ap31_fq5_letter1_part8" = "How they felt for one another - how they understood each other!";
"ap31_fq5_letter1_part9" = "the work of Vincent—";
"ap31_fq6_diary_part1" = "Besides the child,";
"ap31_fq6_diary_part2" = "I have been left with another task…";
"ap31_fq6_diary_part3" = "Vincent’s paintings.";
"ap31_fq6_diary_part4" = "I must show them.";
"ap31_fq6_diary_part5" = "I must make sure they are appreciated.";
"ap31_fq6_diary_part6" = "These paintings are treasures.";
"ap31_fq6_diary_part7" = "They cannot be forgotten.";
"ap31_fq6_diary_part8" = "The world must remember who he was.";
"ap31_fq6_endletter_1" = "You must not believe that your work is without value.";
"ap31_fq6_endletter_2" = "Do not lose courage. Better days are ahead.";
"ap31_fq6_endletter_3" = "You are not alone...I am always thinking of you.";
"ap31_fq6_endletter_4" = "One day, people will understand what you are really trying to do.";
"ap31_fq6_epilogue2_part1" = "Over a period of 10 years, Vincent produced more than 800 paintings,";
"ap31_fq6_epilogue2_part2" = "and over 1000 drawings and sketches.";
"ap31_fq6_epilogue2_part3" = "He only ever managed to sell a few.";
"ap31_fq6_epilogue_part1" = "Johanna devoted her life to bringing the hundreds of Van Gogh artworks and letters she inherited to public attention.";
"ap31_fq6_epilogue_part2" = "After 15 years of persistence, a Van Gogh exhibition was held at Amsterdam’s Stedelijk Museum.";
"ap31_fq6_epilogue_part3" = "It cemented Vincent’s reputation as an artist.";
"ap31_fq6_epilogue_part4" = "To date, it remains the largest Van Gogh exhibition, with over 230 paintings.";
