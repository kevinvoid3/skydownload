"ap12_fetch_04_meditate" = "Navigate through the Wind Path to save any trapped creatures.";
"ap12_fetch_05_cine_01" = "Speak to the Flight Guide to finish restoring The Wind Paths.";
"ap12_fetch_05_manta_01" = "Find and burn all the Darkness on these stones so the Great Manta can shatter them.";
"ap12_fetch_05_manta_02" = "Ride the Great Manta back to the Island.";
"ap12_fetch_05_meditate" = "Rescue the trapped mantas and clear away the darkness.";
