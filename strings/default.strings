"ap11_asteroid_name_01" = "Asteroid 325";
"ap11_asteroid_name_02" = "Asteroid 326";
"ap11_asteroid_name_03" = "Asteroid 327";
"ap11_asteroid_name_04" = "Asteroid 328";
