"season_intro_2_04" = "Una famiglia di spiriti è sparsa nei vari regni di Sky. Aiutala a guadagnare ricompense stagionali.";
"season_intro_2_05" = "Un gruppo di viandanti è arrivato nella terra di Sky, portando nuove armonie e tesori esotici.";
"season_intro_2_06" = "Un gruppo di spiriti ha iniziato il suo viaggio verso la prosperità.";
"season_intro_2_07" = "Un gruppo di spiriti della Prateria Diurna si è andato a rilassare sulle isole vicine.";
"season_intro_2_08" = "Sull'Isola dell'Alba attende il tuo arrivo un gruppo di Profeti desiderosi di trasmettere il loro sapere.";
"season_intro_2_09" = "I ballerini in pensione e gli abitanti del villaggio vivono una vita semplice ai piedi dell'imponente Colosseo nella Valle del Trionfo";
"season_intro_2_10" = "Un gruppo di giovani scout si è accampato nella Foresta Nascosta.";
"season_intro_2_11" = "Le stelle si allineano per accogliere un ospite da molto lontano nella Cupola della Conoscenza.";
"season_intro_2_12" = "I venti rivelano una rete di passaggi sopra la Foresta Nascosta.";
"season_intro_2_13" = "Un equipaggio di predoni ha scoperto un'isola lontana nel Deserto Dorato.";
"season_intro_2_14" = "Una troupe di giovani artisti è salita sul palco nella Valle del Trionfo.";
"season_intro_2_15" = "L'oscurità dall'occhio dell'Eden sta cadendo sul Regno di Sky.";
"season_intro_2_16" = "Una voce incantevole risuona attraverso la Valle del Trionfo.";
"season_intro_2_17" = "Sotto la Cupola della Conoscenza si è aperta la porta di una Cripta dimenticata in cui si rifugiano gli spiriti.";
"season_intro_2_18" = "Da qualche parte nell'Isola dell'Alba, un'artigiana delle maschere si prepara a guidare adolescenti riluttanti nello studio della Transizione.";
"season_intro_2_19" = "Un traghetto è apparso vicino alle Grotte della Prateria. Trovalo per viaggiare verso una terra sbalorditiva.";
"season_intro_2_20" = "In un rifugio abbandonato sulle nuvole, un Assistente speranzoso attende da tempo il vostro arrivo.";
"season_intro_2_21" = "Una visitatrice e un murale nell'Oasi a Mezzaluna ti aspettano per raccontare una storia magica.";
"season_intro_2_22" = "Nel Villaggio degli Uccelli, esplora un nuovo laboratorio pieno di confortevoli decorazioni...";
"season_intro_2_23" = "Nel Villaggio degli Uccelli si è aperto l'ingresso a una misteriosa sala concerti...";
"season_intro_2_24" = "Un Libro di fiabe nascosto nella Cupola della Conoscenza contiene i racconti da una valle lontana.";
"season_intro_2_25" = "Nel Villaggio degli Uccelli, la luce emerge da quella che una volta era la Bottega di tintura...";
"season_intro_2_26" = "Nella radura elevata della Foresta Nascosta...";
"season_intro_2_27" = "Una Lanterna della memoria nascosta nella Cripta della conoscenza ha il potere di viaggiare in un tempo e uno spazio lontani";
"season_intro_2_28" = "Nell’Isola dell’Alba, questo branco di creature di luce migranti è l’ultimo del suo genere.";
"season_intro_2_29" = "Nella Cupola della Conoscenza, un compito importante si svolge a porte chiuse...";
"season_intro_2_30" = "In alto nei cieli sopra il Villaggio della Voliera...";
"season_intro_2_31" = "Nello Spazio delle storie un uomo arriva per seguire la sua passione:";
"season_intro_2_32" = "Al porto nella Cinta Esterna...";
"season_intro_3_04" = "Ogni giorno ci sono nuove missioni da completare e candele stagionali da trovare.";
