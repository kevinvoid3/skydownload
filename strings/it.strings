"ap32_fetch_01_hint_0" = "Si sta formando una tempesta! Ammaina le vele!";
"ap32_fetch_01_hint_1" = "Lega le reti da pesca";
"ap32_fetch_01_hint_10" = "...e, finalmente, il suo apprendista.";
"ap32_fetch_01_hint_11" = "Il Vecchio Pescatore sapeva che la Perla Leggendaria era ancora là fuori...";
"ap32_fetch_01_hint_13" = "Torna a casa al relitto alla fine dell'isola";
"ap32_fetch_01_hint_14" = "Ma un Mostro gli ha rubato il suo bottino...";
"ap32_fetch_01_hint_2" = "Verifica il bottino di oggi";
"ap32_fetch_01_hint_6" = "Molto tempo fa, Il Vecchio Pescatore ha preso\nuna Perla Leggendaria.";
"ap32_fetch_01_hint_7" = "Il Mostro gli aveva rubato tutto...";
"ap32_fetch_01_hint_8" = "...la sua fortuna...";
"ap32_fetch_01_hint_9" = "...la sua dignità...";
"ap32_fetch_02_hint_0" = "Unisciti al Vecchio Pescatore sulla barca.";
"ap32_fetch_02_hint_1" = "Abbassa la vela e legala .";
"ap32_fetch_02_hint_10" = "Prendi il timone.";
"ap32_fetch_02_hint_11" = "Fuori dall'area della missione, ricalibrazione in corso";
"ap32_fetch_02_hint_12" = "Lo spirito preparò un remo a misura di bambino.";
"ap32_fetch_02_hint_13" = "Posa il regalo e preparati a salpare.";
"ap32_fetch_02_hint_2" = "Le Creature di luce sono sfuggite. Inseguile!";
"ap32_fetch_02_hint_3" = "Insegui le Creature di luce per trovare le perle.";
"ap32_fetch_02_hint_4" = "Insegui le mante!";
"ap32_fetch_02_hint_5" = "Spingi a sinistra per andare a destra. Spingi a destra per andare a sinistra.";
"ap32_fetch_02_hint_6" = "Attendi mentre la barca lascia il porto.";
"ap32_fetch_02_hint_7" = "Hai deviato troppo. Grida per vedere dove andare.";
"ap32_fetch_02_hint_8" = "Prendi il timone e insegui le Creature di luce.";
"ap32_fetch_02_hint_9" = "Prendi il timone e insegui le mante.";
"ap32_fetch_02_intro_1" = "Il Vecchio Pescatore si è rifiutato di accettare la sconfitta.";
"ap32_fetch_02_outro_1" = "Non c'era ancora traccia del Mostro,\nma il Vecchio Pescatore era determinato a trovare la Perla Leggendaria.";
"ap32_fetch_02_rudder_tutorial_0" = "Scorri a sinistra per girare a destra. Scorri a destra per girare a sinistra.";
"ap32_fetch_02_rudder_tutorial_1" = "Scorri a sinistra per girare a destra. Scorri a destra per girare a sinistra.";
"ap32_fetch_02_rudder_tutorial_2" = "Scorri a sinistra per timonare dritto. Scorri ancora a sinistra per timonare a destra.";
"ap32_fetch_02_sail_tutorial_0" = "Abbassa la vela e legala.";
"ap32_fetch_02_sail_tutorial_1" = "Trascina ancora verso il basso per prendere velocità. Trascina verso l'alto per rallentare.";
"ap32_fetch_03_hint_10" = "Ha funzionato! Sbrigati e afferra la rete!";
"ap32_fetch_03_hint_11" = "Il Vecchio Pescatore sapeva che inseguire le mante era un ottimo modo per trovare delle perle.";
"ap32_fetch_03_hint_12" = "Prendi il timone e insegui le mante";
"ap32_fetch_03_hint_13" = "Il Vecchio Pescatore sapeva che i lamantini avevano il fiuto per le perle più grandi.";
"ap32_fetch_03_hint_14" = "Il Vecchio Pescatore sapeva che una grossa perla fosse nelle vicinanze!";
"ap32_fetch_03_hint_15" = "Torna in superficie.";
"ap32_fetch_03_hint_16" = "È un'esca perfetta per il Mostro!";
"ap32_fetch_03_hint_2" = "Insegui le mante!";
"ap32_fetch_03_hint_4" = "Insegui i lamantini!";
"ap32_fetch_03_hint_5" = "Insegui le tartarughe!";
"ap32_fetch_03_hint_6" = "La perla è troppo in profondità. Immergiti!";
"ap32_fetch_03_hint_7" = "È troppo piccola.";
"ap32_fetch_03_hint_8" = "È ancora troppo piccola.";
