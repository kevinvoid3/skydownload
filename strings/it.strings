"ap14_story_tree_0" = "C'era una volta...";
"ap14_story_tree_1a" = "una stella scintillante";
"ap14_story_tree_1a2a" = "diventava più luminosa";
"ap14_story_tree_1a2a3a" = "non poté più contenere la luce dentro di sé";
"ap14_story_tree_1a2a3a4a" = "si frantumò, donando agli altri lo splendore che aveva accumulato nel corso dei secoli.";
"ap14_story_tree_1a2a3a4a_abv" = "si frantumò...";
"ap14_story_tree_1a2a3a4a_cont" = "Il cielo notturno pulsava luminoso. Dove una stella brillava, emersero innumerevoli puntini luminosi.";
"ap14_story_tree_1a2a3a4a_cont_abv" = "Il cielo notturno pulsava luminoso...";
"ap14_story_tree_1a2a3a4b" = "donò la sua luce a un bambino solitario che vagava nel deserto.";
"ap14_story_tree_1a2a3a4b_abv" = "donò la sua luce...";
"ap14_story_tree_1a2a3a4b_cont" = "Guidato dalla sua luce, il bambino vide la via da seguire. Da quel momento in poi, non sarebbe più stato solo.";
"ap14_story_tree_1a2a3a4b_cont_abv" = "Guidato dalla sua luce...";
"ap14_story_tree_1a2a3a_abv" = "non poté più contenere...";
"ap14_story_tree_1a2a3a_cont" = "In un atto di altruismo...";
"ap14_story_tree_1a2a3b" = "la sua luce avvolse tutto il cielo.";
"ap14_story_tree_1a2a3b4a" = "non riuscì a vedere altro che il bagliore accecante dei suoi raggi.";
"ap14_story_tree_1a2a3b4a_abv" = "non riuscì a vedere altro...";
"ap14_story_tree_1a2a3b4a_cont" = "Silenziosa e solitaria, attenuò la sua luce fino a quando non tornarono delle sagome. Sapeva che, se non c'era niente su cui brillare, il suo splendore non aveva senso.";
"ap14_story_tree_1a2a3b4a_cont_abv" = "Silenziosa e solitaria...";
"ap14_story_tree_1a2a3b4b" = "vide un bambino che vagava con passo sicuro nel deserto illuminato.";
"ap14_story_tree_1a2a3b4b_abv" = "Vide un bambino...";
"ap14_story_tree_1a2a3b4b_cont" = "Raggiante di orgoglio, brillò meravigliosamente finché il bambino non trovò rifugio in un tempio. Lieta di essere stata d'aiuto, finalmente si riposò.";
"ap14_story_tree_1a2a3b4b_cont_abv" = "Raggiante di orgoglio...";
"ap14_story_tree_1a2a3b_abv" = "la sua luce avvolse...";
"ap14_story_tree_1a2a3b_cont" = "Quando finalmente guardò giù...";
"ap14_story_tree_1a2a_cont" = "fino a quando...";
"ap14_story_tree_1a2b" = "diventava più fioca";
"ap14_story_tree_1a2b3a" = "la sua luce quasi svanì nel cielo.";
"ap14_story_tree_1a2b3a4a" = "Si divise in innumerevoli granelli di luce che scesero dolcemente sul suolo sottostante.";
"ap14_story_tree_1a2b3a4a_abv" = "Si divise...";
"ap14_story_tree_1a2b3a4a_cont" = "Dai suoi echi svolazzarono meravigliose creature di luce. La fine di una vita diede inizio a un'altra.";
"ap14_story_tree_1a2b3a4a_cont_abv" = "Dai suoi echi...";
"ap14_story_tree_1a2b3a4b" = "iniziò la sua discesa verso il suolo sottostante, splendendo più luminosa persino della luna.";
"ap14_story_tree_1a2b3a4b_abv" = "iniziò la sua discesa...";
"ap14_story_tree_1a2b3a4b_cont" = "Così nacque un bambino: la stella si era trasformata.";
"ap14_story_tree_1a2b3a4b_cont_abv" = "Così nacque un bambino...";
"ap14_story_tree_1a2b3a_cont" = "Ma prima di sparire del tutto...";
"ap14_story_tree_1a2b3b" = "un bambino la vide ed espresse un desiderio.";
"ap14_story_tree_1a2b3b4a" = "raccolse tutte le sue forze per tremolare debolmente un'ultima volta.";
"ap14_story_tree_1a2b3b4a_abv" = "raccolse tutte le sue forze...";
"ap14_story_tree_1a2b3b4a_cont" = "Vedendo quell'ultimo bagliore, il bambino non si sentì più solo. Ora speranzoso, sarebbe andato avanti.";
"ap14_story_tree_1a2b3b4a_cont_abv" = "Vedendo quell'ultimo bagliore...";
"ap14_story_tree_1a2b3b4b" = "usò la sua ultima luce per aiutare il bambino errante.";
"ap14_story_tree_1a2b3b4b_abv" = "usò...";
"ap14_story_tree_1a2b3b4b_cont" = "Illuminando una grotta, la stella condusse il bambino verso un rifugio... come nella profezia.";
"ap14_story_tree_1a2b3b4b_cont_abv" = "Illuminando una grotta...";
"ap14_story_tree_1a2b3b_cont" = "Sentendo quella voce...";
"ap14_story_tree_1a2b_cont" = "fino a quando...";
"ap14_story_tree_1a_cont" = "Ogni notte...";
"ap14_story_tree_1b" = "un bambino silenzioso";
"ap14_story_tree_1b2a" = "cercava un compagno";
"ap14_story_tree_1b2a3a" = "le sue gambe stanche non ce la fecero più.";
"ap14_story_tree_1b2a3a4a" = "vide un altro bambino che entrava in una modesta grotta.";
"ap14_story_tree_1b2a3a4a_abv" = "vide un altro bambino...";
"ap14_story_tree_1b2a3a4a_cont" = "I bambini divennero amici e la grotta divenne la loro casa. Un giorno ne avrebbero accolto un altro.";
"ap14_story_tree_1b2a3a4a_cont_abv" = "I bambini divennero amici...";
"ap14_story_tree_1b2a3a4b" = "notò che i disegni sulla pietra iniziarono a brillare.";
"ap14_story_tree_1b2a3a4b_abv" = "notò che i disegni...";
"ap14_story_tree_1b2a3a4b_cont" = "I disegni mostravano tre figure che viaggiavano in barca. Il bambino era destinato a diventare il quarto.";
"ap14_story_tree_1b2a3a4b_cont_abv" = "I disegni mostravano...";
"ap14_story_tree_1b2a3a_abv" = "le sue gambe stanche...";
"ap14_story_tree_1b2a3a_cont" = "Riposando all'ombra di una insolita formazione rocciosa...";
"ap14_story_tree_1b2a3a_cont_abv" = "Riposando all'ombra...";
"ap14_story_tree_1b2a3b" = "un tempio eclissò il sole al tramonto.";
"ap14_story_tree_1b2a3b4a" = "Notando il bambino, la figura sollevò un bastone raggiante.";
"ap14_story_tree_1b2a3b4a_abv" = "Notando il bambino...";
"ap14_story_tree_1b2a3b4a_cont" = "Emerse uno stormo di uccelli che guidò il bambino verso la salvezza. Lì dentro, avrebbe scoperto il destino del suo compagno.";
"ap14_story_tree_1b2a3b4a_cont_abv" = "Emerse uno stormo di uccelli...";
"ap14_story_tree_1b2a3b4b" = "Debolmente, la figura si appoggiò a un bastone tremante.";
"ap14_story_tree_1b2a3b4b_abv" = "Debolmente, la figura...";
"ap14_story_tree_1b2a3b4b_cont" = "Il bambino offrì la sua luce, restituendo forza alla figura. Insieme, avrebbero riunito le stelle.";
"ap14_story_tree_1b2a3b4b_cont_abv" = "Il bambino offrì la sua luce...";
"ap14_story_tree_1b2a3b_abv" = "un tempio eclissò...";
"ap14_story_tree_1b2a3b_cont" = "Dal suo interno emerse una figura imponente.";
"ap14_story_tree_1b2a3b_cont_abv" = "Dal suo interno...";
"ap14_story_tree_1b2a_cont" = "fino a quando...";
"ap14_story_tree_1b2b" = "marciava attraverso il deserto";
"ap14_story_tree_1b2b3a" = "salì sulla duna più alta.";
"ap14_story_tree_1b2b3a4a" = "vide una modesta grotta.";
"ap14_story_tree_1b2b3a4a_cont" = "Due candelai emersero a braccia aperte. Finalmente il bambino aveva trovato una casa.";
"ap14_story_tree_1b2b3a4a_cont_abv" = "Due candelai...";
"ap14_story_tree_1b2b3a4b" = "notò una grotta minacciosa.";
"ap14_story_tree_1b2b3a4b_cont" = "All'interno delle camere inquietanti, affrontò molte sfide. Era stato preannunciato che sarebbe stato il primo a superarle.";
"ap14_story_tree_1b2b3a4b_cont_abv" = "All'interno delle camere inquietanti...";
"ap14_story_tree_1b2b3a_cont" = "Scrutando mentre il sole illuminava il paesaggio...";
"ap14_story_tree_1b2b3b" = "cadde in una valle.";
"ap14_story_tree_1b2b3b4a" = "vide una fiamma lontana all'orizzonte che si avvicinava lentamente.";
"ap14_story_tree_1b2b3b4a_abv" = "vide una fiamma lontana...";
"ap14_story_tree_1b2b3b4a_cont" = "Lo sconosciuto offrì una candela di luce, poi la sua mano. Era arrivato un guardiano, forse addirittura un amico.";
"ap14_story_tree_1b2b3b4a_cont_abv" = "Lo sconosciuto offrì...";
"ap14_story_tree_1b2b3b4b" = "alzò lo sguardo in cerca di soccorso e vide una stella scintillante.";
"ap14_story_tree_1b2b3b4b_abv" = "alzò lo sguardo in cerca...";
"ap14_story_tree_1b2b3b4b_cont" = "Delineava la sagoma di un magnifico tempio. Udì delle campane: la sua avventura era appena iniziata.";
"ap14_story_tree_1b2b3b4b_cont_abv" = "Delineava la sagoma...";
"ap14_story_tree_1b2b3b_cont" = "Risvegliandosi nel freddo della notte...";
"ap14_story_tree_1b2b_cont" = "fino a quando...";
"ap14_story_tree_1b_cont" = "Ogni giorno...";
