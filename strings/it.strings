"ap11_fetch_02_bye_02" = "Nessuno è mai soddisfatto...";
"ap11_fetch_02_bye_03" = "Solo i bambini sanno cosa vogliono...";
"ap11_fetch_02_bye_04" = "Ho amici da scoprire e molte cose da comprendere.";
