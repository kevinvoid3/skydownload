"ap22_quest_03_hint_fail_02" = "Prova a gridare per abbattere i granchi oscuri!";
"ap22_quest_05_hint_01" = "La Guida ai Nidi vuole organizzarti una festa per inaugurare la tua dimora!";
"ap22_quest_05_hint_02" = "I tuoi ospiti arriveranno tra breve! Quando avrai finito di preparare il tuo Nido, medita qui per invitarli a entrare.";
"ap22_quest_05_hint_03" = "Vuoi iniziare la festa di inaugurazione della casa?";
"ap22_quest_05_hint_04" = "Prendi per mano la Guida ai Nidi per invitarla a entrare.";
"ap22_quest_05_hint_05" = "Vai al tuo nido per iniziare i festeggiamenti.";
"ap22_quest_05_hint_06" = "Sono tutti qui! Parla con la Guida ai Nidi quando vuoi iniziare i festeggiamenti.";
"ap22_quest_05_hint_07" = "Tre!";
"ap22_quest_05_hint_08" = "Due!";
"ap22_quest_05_hint_09" = "UNO!";
"ap22_quest_05_hint_10" = "EVVIVA I NIDI!!!";
"ap22_quest_05_hint_11" = "Quando vuoi terminare la festa, parla con la Guida ai Nidi per ritirare la tua ricompensa.";
"ap22_quest_05_hint_12" = "Torna al Nido per ritirare la ricompensa!";
"ap23_quest01_confirmmenu_hint1" = "Pronto a riprovare?";
"ap23_quest01_confirmmenu_hint2" = "Torna dalla Guida ai duetti quando vuoi riprovare.";
"ap23_quest01_confirmmenu_hint3" = "Sembra che tu abbia difficoltà a completare questo spartito. Vuoi saltarlo?";
"ap23_quest01_hint1" = "La Guida ai duetti ha bisogno di aiuto per aprire la porta.";
"ap23_quest01_hint2" = "Impara a suonare presso la Guida ai duetti.";
"ap23_quest01_hint3" = "Suona insieme alla Guida ai duetti per aprire la porta musicale.";
"ap23_quest01_hint4" = "Proviamoci un'altra volta.";
"ap23_quest01_hint5" = "Sali a bordo della barca con la Guida ai duetti.";
"ap23_quest01_menu1" = "Pronto a riprovare?";
"ap23_quest01_menu2" = "Torna dalla Guida ai duetti quando vuoi riprovare.";
"ap23_quest01_tutorial_hint1" = "Ottimo lavoro! Impariamo la nota successiva.";
"ap23_quest01_tutorial_hint2" = "Proviamo questa nota un'altra volta.";
"ap23_quest01_tutorial_hint3" = "Lavoro fantastico!";
"ap23_quest01_tutorial_hint4" = "Ora proviamo a suonare tutta la canzone.";
"ap23_quest02_hint1" = "Pulisci le ragnatele e accendi le candele al tavolo.";
"ap23_quest02_hint2" = "Prova a pulire più ragnatele!";
"ap23_quest02_hint3" = "Prova a rimuovere più piante scure!";
"ap23_quest02_hint4" = "Finisci di restaurare la sala concerti.";
"ap23_quest02_hint5" = "Aiuta la Guida ai duetti e pulisci il palco.";
"ap23_quest02_hint6" = "La Guida ai duetti vuole insegnarti il resto della canzone.";
"ap23_quest02_hint7" = "Accendi le candele al tavolo.";
"ap23_quest03_hint1" = "Ripristina il guscio con la tua fiamma.";
"ap23_quest03_menu1" = "Torna al pianoforte quando sei pronto a riprovare.";
"ap23_quest04_hint1" = "Suona lo strumento musicale per aiutare la Violoncellista compassionevole.";
"ap23_quest04_hint2" = "Segui e suona la canzone della Violoncellista compassionevole.";
"ap23_quest04_hint3" = "Riunisci i due spiriti sul palco della sala concerti.";
"ap23_quest04_menu1" = "Torna al violoncello quando vuoi riprovare.";
"ap23_quest05_aviary_hint1" = "Porta gli spiriti nella sala concerti per goderti il concerto insieme a loro.";
"ap23_quest05_aviary_hint2" = "Ancora 4 spiriti da raccogliere.";
"ap23_quest05_aviary_hint3" = "Ancora 3 spiriti da raccogliere.";
"ap23_quest05_aviary_hint4" = "Ancora 2 spiriti da raccogliere.";
"ap23_quest05_aviary_hint5" = "Ancora 1 spirito da raccogliere.";
"ap23_quest05_aviary_hint6" = "Porta gli spiriti nella sala concerti.";
"ap23_quest05_aviary_hint7" = "Vuoi portare gli spiriti nella sala concerti?";
"ap23_quest05_hint1" = "Ritorna al Villaggio degli Uccelli e porta altri spiriti per ascoltare il concerto del duo musicale.";
"ap23_quest05_hint2" = "Esegui un brano di preludio per iniziare il concerto musicale.";
"ap23_quest05_hint3" = "Esibisciti insieme al duo musicale per un ultimo magico concerto.";
"ap24_credits_01" = "Grazie per aver giocato...";
"ap24_credits_02" = "Stagione dei Mumin";
"ap24_credits_03" = "Basato su \"La bambina invisibile\"";
"ap24_credits_04" = "di Tove Jansson";
"ap24_credits_05" = "Con scene selezionate dai libri";
"ap24_credits_06" = "\"Caccia alla cometa\"";
"ap24_credits_07" = "\"Il cappello del Gran Bau\"";
"ap24_credits_08" = "e \"Racconti dalla Valle dei Mumin\"";
"ap24_fq01_chat_01" = "Ti porto nella tua nuova casa.";
"ap24_fq01_chat_02" = "Dai, vieni!";
"ap24_fq01_chat_03" = "Ci siamo quasi.";
"ap24_fq01_chat_04" = "Dai, vieni!";
"ap24_fq01_chat_05" = "Chi ci hai portato?";
"ap24_fq01_chat_06" = "Si chiama Ninny.";
"ap24_fq01_chat_07" = "Era spaventata da una signora che si prendeva cura di lei, ma non le voleva bene...";
"ap24_fq01_chat_08" = "e così è diventata invisibile.";
"ap24_fq01_chat_09" = "Ho incontrato quella donna ed era orribile, aveva un atteggiamento gelidamente sarcastico.";
"ap24_fq01_chat_10" = "Terribile!";
"ap24_fq01_chat_11" = "Se le persone si spaventano molto spesso, a volte diventano invisibili.";
"ap24_fq01_chat_12" = "Dai una sedia alla bambina.";
"ap24_fq01_chat_13" = "Questa è la tua nuova famiglia!";
"ap24_fq01_story_01" = "Una sera piovosa, una persona gentile stava conducendo una bambina invisibile attraverso la valle dei Mumin.";
"ap24_fq01_story_02" = "Si chiamava Dede.";
"ap24_fq01_story_03" = "Forse i suoi amici avrebbero potuto aiutare la bambina a tornare visibile.";
"ap24_fq02_chat_01" = "Dormi quanto vuoi. Domattina la colazione sarà pronta quando lo vorrai tu.";
"ap24_fq02_story_01" = "Il campanello d'argento tintinnò alle spalle di Mamma Mumin al piano di sopra.";
"ap24_fq02_story_02" = "Sogni d'oro, Ninny.";
"ap24_fq03_chat_01" = "Mamma! Ha le zampe! Sono comparse le zampe!";
"ap24_fq03_chat_02" = "Magnifico! E sarà ancora meglio quando un giorno potremo vedere il suo musetto.";
"ap24_fq03_chat_03" = "Raccoglievano le mele. Era una splendida mattina d'autunno.";
"ap24_fq03_chat_04" = "Brava, Ninny!";
"ap24_fq03_chat_05" = "Oh, quello era il barattolo che usavamo per dare il cibo ai bombi.";
"ap24_fq03_chat_06" = "Ora non dobbiamo più portarlo al campo.";
"ap24_fq03_chat_07" = "Vedo le sue gambe!";
"ap24_fq04_chat_01" = "Grazie mille a tutti.";
"ap24_fq04_chat_02" = "Siamo felici di poterti vedere un po' di più oggi!";
"ap24_fq04_chat_03" = "E hai anche iniziato a parlare. Conosci qualche gioco carino?";
"ap24_fq04_chat_04" = "No...";
"ap24_fq04_chat_05" = "Però ho sentito parlare dei giochi!";
"ap24_fq04_story_01" = "Quella notte, Mamma Mumin fece a Ninny un vestito rosa e lo sistemò nella soffitta orientale.";
"ap24_fq04_story_02" = "Ninny scese a fare colazione con la famiglia Mumin.";
"ap24_fq05_chat_01" = "Ninny era visibile fino al collo, soltanto il suo viso era ancora invisibile.";
"ap24_fq05_chat_02" = "Il Mumin era felicissimo. Decise di insegnare a Ninny tutti i giochi che conosceva.";
"ap24_fq05_chat_03" = "Sali, Ninny!";
"ap24_fq05_chat_04" = "Mi dispiace, non posso...";
"ap24_fq05_chat_05" = "Corri, corri, dai!";
"ap24_fq05_chat_06" = "Scusa...";
"ap24_fq05_chat_07" = "Non sai saltare?";
"ap24_fq05_chat_08" = "Era chiaro a tutti che giocava solo per cortesia e non per divertirsi.";
"ap24_fq05_chat_09" = "Mi dispiace tanto...";
"ap24_fq05_chat_10" = "Pensi che qualcuno apprezzi ciò che stai facendo?";
"ap24_fq05_chat_11" = "Non hai un briciolo di entusiasmo?";
"ap24_fq05_chat_12" = "Vuoi una botta sul naso?";
"ap24_fq05_chat_13" = "Non sa giocare...";
"ap24_fq05_chat_14" = "Non sa arrabbiarsi.";
"ap24_fq05_chat_15" = "Ecco cosa c'è che non va in lei.";
"ap24_fq05_chat_16" = "Non avrai mai un volto finché non imparerai a combattere!";
"ap24_fq05_chat_17" = "Sì, certo.";
"ap24_fq06_chat_01" = "Cos'ha Ninny?";
"ap24_fq06_chat_01b" = "È spaventata?";
"ap24_fq06_chat_02" = "Sì, Ninny pensa che il mare sia troppo grande.";
"ap24_fq06_chat_03" = "Ciao.";
"ap24_fq06_chat_04" = "Come sta la bambina invisibile?";
"ap24_fq06_chat_05" = "Soltanto la testa è ancora invisibile.";
"ap24_fq06_chat_06" = "Puoi darci una mano con la barca?";
"ap24_fq06_chat_07" = "Oddio, l'acqua sembra gelida!";
"ap24_fq06_chat_08" = "Per settimane non era successo niente di entusiasmante.";
"ap24_fq06_chat_09" = "Ottimo lavoro!";
"ap24_fq06_chat_10" = "Io non avrei potuto fare di meglio!";
"ap24_fq06_chat_11" = "La vedo, la vedo!";
"ap24_fq06_chat_12" = "Non osare spingerla in questo grande mare spaventoso!";
"ap24_fq06_story_01" = "Passarono i giorni e Ninny era ancora senza volto.";
"ap24_fq06_story_02" = "Un giorno la famiglia andò alla spiaggia a tirare a riva la barca per l'inverno.";
"ap24_fq06_story_03" = "Quando giunsero in vista del mare, Ninny si fermò all'improvviso.";
"ap24_fq06_story_04" = "Papà Mumin ebbe un'idea scherzosa e cominciò ad avvicinarsi di soppiatto a mamma Mumin.";
"ap24_fq06_story_05" = "Non voleva veramente spingerla in acqua, era uno scherzo per far ridere un po' i bambini.";
"ap24_name_little" = "Dada";
"ap24_name_moominmamma" = "Mamma Mumin";
"ap24_name_moominpappa" = "Papà Mumin";
"ap24_name_moomintroll" = "Mumin";
"ap24_name_ninny" = "Ninny";
"ap24_name_sniff" = "Sniffa";
"ap24_name_snufkin" = "Wilson";
"ap24_name_too_ticky" = "Dede";
"ap24_side01_chat_01" = "È la serata giusta per una melodia.";
"ap24_side01_chat_02" = "Una nuova melodia.";
"ap24_side01_chat_03" = "Una parte di aspettative...";
"ap24_side01_chat_04" = "due parti di malinconia primaverile...";
"ap24_side01_chat_05" = "e per il resto...";
"ap24_side01_chat_06" = "solo il grande piacere di godersi un po' di solitudine!";
"ap24_side02_chat_01" = "Ci sedevamo proprio così in primavera.";
"ap24_side02_chat_02" = "Te lo ricordi?";
"ap24_side02_chat_03" = "Ci eravamo svegliati dal letargo invernale ed era il primo giorno.";
"ap24_side02_chat_04" = "Tutti gli altri dormivano ancora.";
"ap24_side02_chat_05" = "Hai parlato di progetti.";
"ap24_side02_chat_06" = "Ne hai qualcuno anche tu?";
"ap24_side02_chat_07" = "Sì, ho un progetto.";
"ap24_side02_chat_08" = "Però è una cosa solitaria.";
"ap24_side02_chat_09" = "Stai pensando di andartene.";
"ap24_side02_chat_10" = "Quando parti?";
"ap24_side02_chat_11" = "Adesso, subito!";
"ap24_side02_chat_12" = "Sarai via a lungo?";
"ap24_side02_chat_13" = "No, il primo giorno di primavera sarò di nuovo qui a fischiare sotto la tua finestra.";
"ap24_side02_chat_14" = "Un anno passa velocemente!";
"ap24_side03_chat_01" = "Non è che per caso sei un pittore?";
"ap24_side03_chat_02" = "O magari un poeta?";
"ap24_side03_chat_03" = "Io sono tutto!";
"ap24_side03_chat_04" = "E vedo che voi siete esploratori.";
"ap24_side03_chat_05" = "Cosa pensate di scoprire?";
"ap24_side03_chat_06" = "Oh, tutto.";
"ap24_side03_chat_07" = "Le stelle, per esempio!";
"ap24_side03_chat_08" = "Le stelle!";
"ap24_side03_chat_09" = "Allora devo venire con voi.";
"ap24_side03_chat_10" = "Adoro le stelle.";
"ap24_side03_chat_11" = "Quando mi metto a letto le guardo sempre prima di addormentarmi...";
"ap24_side03_chat_12" = "e mi chiedo da chi siano abitate.";
"ap24_side04_chat_01" = "Sigh...";
"ap24_side04_chat_02" = "Mi sembri giù.";
"ap24_side04_chat_03" = "Ho regalato il mio giocattolo preferito.";
"ap24_side04_chat_04" = "Pensavo che sarebbe stato bello fare qualcosa di carino.";
"ap24_side04_chat_05" = "Ah. Te ne penti?";
"ap24_side04_chat_06" = "Sì.";
"ap24_side04_chat_07" = "Hai perso il giocattolo...";
"ap24_side04_chat_08" = "ma forse hai guadagnato qualcosa di più importante.";
"ap24_side06_chat_01" = "Il loro segreto ha a che fare con i temporali!";
"ap24_side06_chat_02" = "Li cercano e li bramano sempre...";
"ap24_side06_chat_03" = "Cosa mi è successo?";
"ap24_side06_chat_04" = "Non sono un Fungarello, sono Papà Mumin...";
"ap24_side06_chat_05" = "Cosa ci faccio qui?";
"ap24_side06_chat_06" = "Vado a casa! Me ne vado subito!";
"ap24_side07_story_01" = "Una volta, Papà Mumin se ne andò di casa senza la minima spiegazione.";
"ap24_side07_story_02" = "Nessuno sapeva con certezza dove fosse andato.";
"ap24_side07_story_03" = "Mai nella sua vita Papà Mumin si era sentito così a suo agio.";
"ap24_side07_story_04" = "Amava il fatto di non dover dire nulla...";
"ap24_side07_story_05" = "o spiegare alcunché, a se stesso o agli altri.";
"ap24_side07_story_06" = "Poteva semplicemente sedersi a guardare l'orizzonte...";
"ap24_side07_story_07" = "e ascoltare il suono dell'acqua.";
"ap24_storybook_hint01" = "Vuoi diventare una farfalla e recarti nella Valle dei Mumin?";
"ap24_storybook_hint02" = "Vuoi esplorare liberamente la Valle dei Mumin come una farfalla?";
"ap24_storybook_hint03" = "Vuoi recarti nella Valle dei Mumin?";
"ap24_title_comet" = "Caccia alla cometa";
"ap24_title_finn" = "Il cappello del Gran Bau";
"ap24_title_tales" = "Racconti dalla Valle dei Mumin";
"ap24_void_quests_confirm_menu" = "La seguente avventura va vissuta in solitaria. Non vedrai i tuoi amici per tutta la durata. Vuoi continuare?";
"ap25_attract_mote" = "La luce colorata della pianta si è trasferita su questa farfalla...\n\nVuoi attirarla per condividere con te un po' di luce colorata?";
"ap25_color_returned_black" = "Hai portato la luce nera alla Bottega di tintura!\nGli spiriti hanno bisogno di un altro colore...";
"ap25_color_returned_blue" = "Hai portato la luce blu alla Bottega di tintura!\nGli spiriti hanno bisogno di un altro colore...";
"ap25_color_returned_cyan" = "Hai portato la luce azzurra alla Bottega di tintura!\nGli spiriti hanno bisogno di un altro colore...";
"ap25_color_returned_green" = "Hai portato la luce verde alla Bottega di tintura!\nGli spiriti hanno bisogno di un altro colore...";
"ap25_color_returned_magenta" = "Hai portato la luce viola alla Bottega di tintura!\nGli spiriti hanno bisogno di un altro colore...";
"ap25_color_returned_red" = "Hai portato la luce rossa alla Bottega di tintura!\nGli spiriti hanno bisogno di un altro colore...";
"ap25_color_returned_white" = "Hai portato la luce bianca alla Bottega di tintura!\nGli spiriti hanno bisogno di un altro colore...";
"ap25_color_returned_yellow" = "Hai portato la luce gialla alla Bottega di tintura!\nGli spiriti hanno bisogno di un altro colore...";
"ap25_dye_introduced" = "Ora puoi usare la bottega per tingere gli elementi estetici.";
"ap25_fetch01_intro_00" = "La luce colorata potrebbe essere intrappolata in alcune piante scure.";
"ap25_fetch01_intro_01" = "Riporta la luce gialla dalle nuove piante scure nella Prateria Diurna.";
"ap25_fetch02_intro_00" = "Certi tipi di luce colorata appaiono meno frequentemente.";
"ap25_fetch02_intro_01" = "Riporta la luce azzurra dalle nuove piante scure nella Foresta Nascosta.";
"ap25_fetch03_intro_01" = "Riporta la luce viola dalle nuove piante scure nel Deserto Dorato.";
"ap25_fetch04_intro_00" = "Riporta la luce bianca e la luce nera rare da luoghi come le Vette della Prateria e l'Occhio di Eden.";
"ap25_fetch05_intro_00" = "Gli spiriti desiderano onorarti adottando il tuo stesso stile! Crea uno stile per te e per gli spiriti.";
"ap25_fetch05_intro_00_b" = "Utilizza la Bottega di tintura per abbinare lo stile a quello del gruppo degli spiriti!";
"ap25_found_dye" = "Consegna questa luce colorata alla guida allo splendore nella Bottega di tintura presso il Villaggio degli Uccelli.";
"ap25_light_introduced" = "Puoi anche visualizzare gli elementi estetici in diverse condizioni di illuminazione.";
"ap26_act00_title" = "L'Uccello Azzurro";
"ap26_act01_sub" = "Il palazzo";
"ap26_act01_title" = "Atto I";
"ap26_act02_sub" = "La terra del ricordo";
"ap26_act02_title" = "Atto II";
"ap26_act03_sub" = "Prima del sipario";
"ap26_act03_title" = "Atto III";
"ap26_act04_sub" = "La foresta";
"ap26_act04_title" = "Atto IV";
"ap26_act05_sub" = "Il regno del futuro";
"ap26_act05_title" = "Atto V";
"ap26_act06_sub" = "Il risveglio";
"ap26_act06_title" = "Atto VI";
"ap26_chase_intro" = "Cattura l'Uccello Azzurro per scoprire la sua vera natura.";
"ap26_feather_hint" = "Una piuma blu! L'uccello deve essere qui vicino...";
"ap26_fetch01_fragment_intro_00" = "Raccogli le piume dell'Uccello Azzurro per rendere la festa ancora più grande!";
"ap26_fetch01_intro_00" = "\"Esiste un uccello, blu come lo zaffiro...";
"ap26_fetch01_intro_01" = "Vuoi seguire l'Adolescente spettinato nobile fino alla Cittadella per cercare l'Uccello Azzurro?";
"ap26_fetch01_intro_02" = "...il cui cinguettio risuona nei banchetti sontuosi.\"";
"ap26_fetch01_outro_01" = "\"Trovarono un uccello dalle piume azzurre...";
"ap26_fetch01_outro_02" = "...ma scomparve come il fumo di una candela.\"";
"ap26_fetch02_intro_00" = "\"Esiste un uccello, azzurro come gli occhi di mia madre...";
"ap26_fetch02_intro_01" = "Vuoi seguire la Madre scintillante nostalgica fino agli Archivi della Cupola per cercare l'Uccello Azzurro?";
"ap26_fetch02_intro_02" = "...il cui cinguettio riecheggia nei nostri preziosi ricordi.\"";
"ap26_fetch02_mem_01" = "\"Cara nipotina, abbiamo costruito per te questa altalena sul nostro albero preferito.\"";
"ap26_fetch02_mem_02" = "\"Guarda quanto puoi volare in alto adesso!\"";
"ap26_fetch02_mem_03" = "\"Figlia mia, è meraviglioso tornare qui con te dopo tutto questo tempo.\"";
"ap26_fetch02_outro_02" = "...ma più forte lo stringevamo, più velocemente svaniva.\"";
"ap26_fetch03_hint_01" = "Forse all'uccello piacerebbe vedervi esibire insieme!";
"ap26_fetch03_hint_02" = "Ma non hai ancora indossato il vestito dello spettacolo...";
"ap26_fetch03_intro_00" = "\"Esiste un uccello, azzurro come il tessuto indaco...";
"ap26_fetch03_intro_01" = "Vuoi seguire la Cugina festeggiante mascherata fino al Deserto Stellare per cercare l'Uccello Azzurro?";
"ap26_fetch03_intro_02" = "...il cui cinguettio risuonava ovunque la folla si radunasse ad ammirarlo.";
"ap26_fetch03_outro_02" = "...ma si srotolò come un gomitolo allentato.\"";
"ap26_fetch04_dialog_01" = "\"Questa foresta tranquilla ospita molti uccelli colorati.\"";
"ap26_fetch04_dialog_02" = "\"Scommetto che qui troveremo l'Uccello Azzurro!\"";
"ap26_fetch04_intro_00" = "\"Conosco un uccello, blu come un fiume incontaminato...";
"ap26_fetch04_intro_01" = "Vuoi seguire il Genitore supplice taglialegna nella Foresta Nascosta per cercare l'Uccello Azzurro ?";
"ap26_fetch04_intro_02" = "...il cui richiamo riflette la pacifica armonia della foresta.\"";
"ap26_fetch04_outro_01" = "\"Trovarono un uccello dalle piume azzurre...";
"ap26_fetch04_outro_02" = "...ma si disperse nel vento e lasciò solo silenzio.\"";
"ap26_fetch05_intro_00" = "\"Esiste un uccello, blu come il cielo stellato...";
"ap26_fetch05_intro_01" = "Vuoi seguire il Nonno saggio indovino per cercare l'Uccello Azzurro ?";
"ap26_fetch05_intro_02" = "...il cui verso risuona dove nascono grandi destini.\"";
"ap26_fetch05_outro_01" = "\"Trovarono un uccello dalle piume azzurre...";
"ap26_fetch05_outro_02" = "...ma come il destino, era libero di volare.\"";
"ap26_fetch05_quest_01" = "\"Questi piccoli conoscono il loro destino e stanno per nascere.\"";
"ap26_fetch05_quest_02" = "\"Altri hanno bisogno che l'Uccello Azzurro pronunci ad alta voce il loro destino.\"";
