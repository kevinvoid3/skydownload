"ap21_quest01_hint1" = "Esci dalla valle.";
"ap21_quest01_hint2" = "Hai ripristinato una sezione del murale.";
"ap21_quest01_narration_01" = "Questa è la storia del Cervo dai nove colori...";
"ap21_quest01_narration_02" = "...una bestia gentile di tanto tempo fa.";
"ap21_quest01_narration_03" = "Un giorno un bambino si smarrì";
"ap21_quest01_narration_04" = "in una valle oscura.";
"ap21_quest01_narration_05" = "Il Cervo dai nove colori salvò il bambino";
"ap21_quest01_narration_06" = "e disse: \"Vieni nella mia bellissima casa.\"";
"ap21_quest01_narration_07" = "In questo modo, il Cervo dai nove colori";
"ap21_quest01_narration_08" = "salvò il bambino da un mostro.";
"ap21_quest01_narration_09" = "Il bambino era spaventato";
"ap21_quest01_narration_10" = "e cercò di scappare.";
"ap21_quest02_gameplay_01" = "Trova il granchio nascosto sotto la sabbia.";
"ap21_quest02_gameplay_02" = "Trova la medusa nascosta sul fondo del lago.";
"ap21_quest02_gameplay_03" = "Prova a individuare la manta sulla duna.";
"ap21_quest02_hint1" = "Trova il granchio e la medusa attorno al lago.";
"ap21_quest02_hint2" = "Conduci la medusa dal Cervo.";
"ap21_quest02_hint3" = "Porta il granchio al cervo.";
"ap21_quest02_hint4" = "Visita il cervo per aiuto.";
"ap21_quest02_narration_01" = "Un giorno, un mostro arrivò all'Oasi a Mezzaluna.";
"ap21_quest02_narration_02" = "Tutti gli animali si nascosero spaventati.";
"ap21_quest02_narration_03" = "Il Cervo dai nove colori andò a cercare gli animali...";
"ap21_quest02_narration_04" = "...ma erano scomparsi tutti.";
"ap21_quest02_narration_05" = "Il Cervo dai nove colori sapeva esattamente cosa fare.";
"ap21_quest02_narration_06" = "Con benevolenza, il Cervo dai nove colori";
"ap21_quest02_narration_07" = "protegge tutti gli esseri viventi.";
"ap21_quest03_hint0" = "Accetta l’invito del Cervo dai nove colori a visitare l’oasi insieme.";
"ap21_quest03_narration_01" = "Un giorno, il Cervo dai nove colori voleva un compagno.";
"ap21_quest03_narration_02" = "Con il bambino, il Cervo celebrava la bellezza della vita.";
"ap21_quest03_narration_03" = "Apparve una manta, braccata da un abitante del villaggio!";
"ap21_quest03_narration_04" = "Ma la manta era troppo veloce...";
"ap21_quest03_narration_05" = "...e l'abitante del villaggio cadde nel lago.";
"ap21_quest03_narration_06" = "Il Cervo dai nove colori sapeva esattamente cosa fare.";
"ap21_quest03_narration_07" = "Sacrificando un po' di magia...";
"ap21_quest03_narration_08" = "...il cervo riportò in vita l'abitante del villaggio.";
"ap21_quest03_narration_09" = "In segno di gratitudine, l'abitante del villaggio si offrì di servire il Cervo per sempre.";
"ap21_quest03_narration_10" = "Il Cervo chiese solo che non raccontasse a nessuno del loro incontro...";
"ap21_quest03_narration_11" = "...ma l'abitante sapeva che avrebbe potuto essere ricompensato...";
"ap21_quest03_narration_12" = "...perché la principessa voleva il Cervo.";
"ap21_quest03_narration_13" = "Così l'abitante del villaggio tornò per raccontare al re ciò che aveva visto.";
"ap21_quest03_narration_14" = "Il re partì per dare la caccia al Cervo.";
"ap21_quest03_narration_15" = "Così il Cervo dai nove colori fu tradito.";
"ap21_quest04_hint1" = "Aiuta il Cervo a salvare le creature intrappolate nel lago.";
"ap21_quest04_narration_01" = "Assisti al tradimento del Cervo dai nove colori.";
"ap21_quest04_narration_02" = "Su ordine del Cacciatore del re,";
"ap21_quest04_narration_03" = "l’abitante del villaggio avvelenò le acque.";
"ap21_quest04_narration_04" = "E così, la trappola per la nobile creatura fu allestita.";
"ap21_quest04_narration_05" = "Il veleno del Cacciatore aveva fatto ammalare l’abitante del villaggio.";
"ap21_quest04_narration_06" = "Il Cervo voleva soccorrerlo, ma si era anche indebolito.";
"ap21_quest04_narration_07" = "Il Cervo sacrificò le forze vitali residue per salvare l’abitante del villaggio.";
"ap21_quest04_narration_08" = "Il re si compiacque del successo del cacciatore...";
"ap21_quest04_narration_09" = "...mentre l’abitante del villaggio fu schiacciato dal senso di colpa.";
"ap21_quest04_narration_10" = "Fu così che il Cervo dai nove colori venne catturato dal re.";
"ap21_quest05_hint0" = "Liberati delle piante scure per far salire la piattaforma.";
"ap21_quest05_hint1" = "Torna dal Cervo.";
"ap21_quest05_narration_01" = "Assisti al salvataggio del Cervo dai nove colori.";
"ap21_quest05_narration_02" = "Le ombre inghiottirono il regno.";
"ap21_quest05_narration_03" = "Indebolito, il Cervo non era in grado di scacciare l’oscurità.";
"ap21_quest05_narration_04" = "L’abitante del villaggio cercò di rimediare.";
"ap21_quest05_narration_05" = "Il Cervo dai nove colori sapeva esattamente cosa fare.";
"ap21_quest05_narration_06" = "Sprofondato nella vergogna, il re giurò che da quel momento innanzi avrebbe protetto tutte le creature.";
"ap21_quest05_narration_07" = "Fu così che il regno vide tornare pace e prosperità...";
"ap21_quest05_narration_08" = "...e il Cervo si dileguò, abitando terre selvagge...";
"ap21_quest05_narration_09" = "...e vivendo in libertà fino alla fine dei suoi giorni.";
