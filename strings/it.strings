"ap11_fetch_02_outro_04" = "ma troverà un'altra rosa come me?";
"ap11_fetch_02_top_01" = "Conosco un signore che non ha mai annusato un fiore.";
"ap11_fetch_02_top_02" = "Non ha mai guardato una stella.";
"ap11_fetch_02_top_03" = "Non ha mai voluto bene a nessuno.";
"ap11_fetch_02_top_04" = "Non fa altro che addizioni.";
"ap11_fetch_02_top_05" = "E tutto il giorno ripete";
"ap11_fetch_02_top_06" = "\"Io sono un uomo serio! Io sono un uomo serio!\"";
"ap11_fetch_02_top_07" = "E si gonfia di orgoglio.";
"ap11_fetch_02_top_08" = "Ma non è un uomo.";
"ap11_fetch_02_top_09" = "È un fungo!";
"ap11_fetch_02_whale_01" = "C'è nessuno?";
"ap11_fetch_02_whale_02" = "Che creatura maestosa!";
"ap11_fetch_02_whale_03" = "Questa si può addomesticare?";
"ap11_fetch_03_beach_01" = "Non ho mai visto così tanta acqua sugli altri pianeti che ho visitato!";
"ap11_fetch_03_beach_02" = "Vorrei poter vedere cosa c'è oltre l'orizzonte.";
