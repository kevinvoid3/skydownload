"ap31_fq1_letter1_part1" = "Non vedo l'ora che sia Natale.";
"ap31_fq1_letter1_part2" = "Due anni fa abbiamo fatto quella passeggiata serale nella neve...";
"ap31_fq1_letter1_part3" = "Te la ricordi?";
"ap31_fq1_letter1_part4" = "Quando abbiamo visto la luna sorgere su Mariënhof?";
"ap31_fq1_letter2_part1" = "Non trovo le parole per dire quanto sono felice...";
"ap31_fq1_letter2_part2" = "di aver ripreso a dipingere!";
"ap31_fq1_letter2_part3" = "Ci avevo riflettuto a lungo,";
"ap31_fq1_letter2_part4" = "ma l'avevo sempre considerato impossibile e oltre la mia portata.";
"ap31_fq1_letter3_part1" = "Scavatori, seminatori, zappatori, uomini e donne...";
"ap31_fq1_letter3_part2" = "Devo dipingerli senza sosta.";
"ap31_fq1_letter3_part3" = "Devo studiare e riprodurre tutto ciò che appartiene alla vita bucolica.";
"ap31_fq1_letter3_part4" = "Non mi sento più inerme come un tempo!";
"ap31_fq1_letter4_part1" = "Dipingere mi è più naturale di quanto pensassi.";
"ap31_fq1_letter4_part2" = "Forse è questa la via da seguire... Mettere ogni mio sforzo nella pittura?";
"ap31_fq1_letter4_part3" = "Devo confessare...";
"ap31_fq1_letter4_part4" = "di non averne idea.";
"ap31_fq1_letter5_part1" = "Non ho ancora esaurito il denaro,";
"ap31_fq1_letter5_part2" = "ma non ne resta molto.";
"ap31_fq1_letter5_part3" = "Ho dovuto spendere molto in materiali da pittura.";
"ap31_fq1_letter5_part4" = "Spero che tu possa mandarmi presto qualcosa.";
"ap31_fq2_letter1_part1" = "Non sapevo nemmeno chi fossero gli impressionisti,";
"ap31_fq2_letter1_part2" = "ma ora che li ho visti";
"ap31_fq2_letter1_part3" = "e pur non facendone ancora parte,";
"ap31_fq2_letter1_part4" = "provo grande ammirazione per alcune delle loro opere...";
"ap31_fq2_letter2_part1" = "Ti ho spedito alcuni disegni.";
"ap31_fq2_letter2_part2" = "Sii sincero e dimmi";
"ap31_fq2_letter2_part3" = "perché non venderanno";
"ap31_fq2_letter2_part4" = "e come posso crearne altri che vendano.";
"ap31_fq2_letter3_part1" = "Spero di migliorare a tal punto";
"ap31_fq2_letter3_part2" = "che tu possa mostrare";
"ap31_fq2_letter3_part3" = "il mio lavoro con sicurezza";
"ap31_fq2_letter3_part4" = "e senza sentirti in imbarazzo.";
"ap31_fq3_letter1_part1" = "Quest'anno voglio compiere dei veri progressi...";
"ap31_fq3_letter1_part2" = "Progressi dei quali,";
"ap31_fq3_letter1_part3" = "a essere sincero,";
"ap31_fq3_letter1_part4" = "ho un disperato bisogno.";
"ap31_fq3_letter2_part1" = "Pianifico con attenzione,";
"ap31_fq3_letter2_part2" = "ma oggi ho scoperto che, per i dieci metri di tela, avevo preventivato perfettamente";
"ap31_fq3_letter2_part3" = "tutti i colori... con un'eccezione:";
"ap31_fq3_letter2_part4" = "il giallo primario.";
"ap31_fq3_letter3_part1" = "Non sono mai stato così fortunato, poiché qui la natura è eccezionalmente meravigliosa.";
"ap31_fq3_letter3_part2" = "Ogni cosa, ovunque.";
"ap31_fq3_letter3_part3" = "La volta celeste è di un azzurro maestoso e il sole rifulge di zolfo pallido...";
"ap31_fq3_letter3_part4" = "Colori tenui e incantevoli come i gialli e i blu celesti di Vermeer di Delft.";
"ap31_fq3_letter3_part5" = "Non sono in grado di dipingere qualcosa di altrettanto bello.";
"ap31_fq3_letter3_part6" = "Ma mi affascina a tal punto da lasciarmi andare...";
"ap31_fq3_letter4_part1" = "Volevo arredare la casa non solo per me, ma affinché potesse ospitare qualcun altro.";
"ap31_fq3_letter4_part2" = "Ovviamente, ciò ha consumato quasi tutto il denaro.";
"ap31_fq3_letter4_part3" = "Con ciò che rimaneva, ho acquistato dodici sedie,";
"ap31_fq3_letter4_part4" = "uno specchio";
"ap31_fq3_letter4_part5" = "e piccoli oggetti di prima necessità...";
"ap31_fq3_letter4_part6" = "Pertanto, potrò trasferirmi entro la prossima settimana!";
"ap31_fq3_letter5_part1" = "Sono talmente felice per la casa e per il lavoro...";
"ap31_fq3_letter5_part2" = "da sperare che questa felicità non sarà solo mia,";
"ap31_fq3_letter5_part3" = "ma che tu possa condividerla con la tua buona fortuna!";
"ap31_fq3_letter6_part1" = "Sarò felice di poter arredare la mia casa, mi aiuterà a riprendermi.";
"ap31_fq4_letter1_part1" = "Sarebbe un vero piacere";
"ap31_fq4_letter1_part2" = "se venissi a farmi visita per vedere Jo e nostro figlio!";
"ap31_fq4_letter1_part3" = "Come ti ho già scritto,";
"ap31_fq4_letter1_part4" = "gli abbiamo dato il tuo nome.";
"ap31_fq4_letter2_part1" = "E sai cosa spero, quando mi concedo questo privilegio?";
"ap31_fq4_letter2_part2" = "Che la famiglia sia per te";
"ap31_fq4_letter2_part3" = "ciò che la natura è per me...";
"ap31_fq4_letter2_part4" = "Le zolle di terra, l'erba, il grano dorato, i contadini.";
"ap31_fq4_letter3_part1" = "Ora l'orrore della vita è già meno pronunciato,";
"ap31_fq4_letter3_part2" = "la malinconia meno acuta.";
"ap31_fq4_letter3_part3" = "Eppure non ho alcuno stimolo... Forse solo qualche desiderio...";
"ap31_fq4_letter3_part4" = "e quasi nulla di ciò che appartiene a una vita ordinaria.";
"ap31_fq4_letter4_part1" = "Lavoro incessantemente nella mia stanza.";
"ap31_fq4_letter4_part2" = "Mi fa bene";
"ap31_fq4_letter4_part3" = "e immagino che scacci";
"ap31_fq4_letter4_part4" = "queste idee aberranti.";
"ap31_fq4_letter5_part1" = "Sono sei settimane che non esco di casa,";
"ap31_fq4_letter5_part2" = "nemmeno in giardino.";
"ap31_fq4_letter5_part3" = "Ma la prossima settimana,";
"ap31_fq4_letter5_part4" = "quando avrò terminato le tele a cui sto lavorando,";
"ap31_fq4_letter5_part5" = "ci proverò.";
"ap31_fq4_letter6_part1" = "Persino io ho trovato degli amici e attività che amo.";
"ap31_fq4_letter6_part2" = "Puoi capire, quindi,";
"ap31_fq4_letter6_part3" = "pur trovando il mio malessere terribile,";
"ap31_fq4_letter6_part4" = "che qui ho comunque stretto legami";
"ap31_fq4_letter6_part5" = "un po' troppo profondi?";
"ap31_fq4_letter7_part1" = "Poco a poco, comincio a vedere la follia come un malanno.";
"ap31_fq4_letter7_part2" = "Cambiare ambiente mi sta facendo bene.";
"ap31_fq4_letter7_part3" = "Il medico è incline a vedere ciò che mi è accaduto come simile a una crisi epilettica.";
"ap31_fq4_letter7_part4" = "Ma non ho approfondito.";
"ap31_fq5_date1" = "Sei mesi dopo";
"ap31_fq5_date2" = "Due giorni dopo";
"ap31_fq5_letter1_part1" = "Oltre al bambino,";
"ap31_fq5_letter1_part10" = "mostrarlo e far sì che venga apprezzato";
"ap31_fq5_letter1_part11" = "il più possibile.";
"ap31_fq5_letter1_part2" = "mi ha dato un altro compito:";
"ap31_fq5_letter1_part3" = "preservare intatti, per il bambino,";
"ap31_fq5_letter1_part4" = "tutti i tesori che Theo e Vincent hanno raccolto.";
"ap31_fq5_letter1_part5" = "Anche questo è un mio dovere.";
"ap31_fq5_letter1_part6" = "Vivo pienamente nei miei pensieri con Theo e Vincent.";
"ap31_fq5_letter1_part7" = "Oh, quanto infinitamente dolce e amorevole era il loro rapporto!";
"ap31_fq5_letter1_part8" = "Quanto si amavano, quanto si capivano!";
"ap31_fq5_letter1_part9" = "Il lavoro di Vincent,";
"ap31_fq6_diary_part1" = "Oltre al bambino,";
"ap31_fq6_diary_part2" = "mi è stato lasciato un altro compito…";
"ap31_fq6_diary_part3" = "I dipinti di Vincent.";
"ap31_fq6_diary_part4" = "Devo mostrarli.";
"ap31_fq6_diary_part5" = "Devo assicurarmi che vengano apprezzati.";
"ap31_fq6_diary_part6" = "Questi dipinti sono tesori.";
"ap31_fq6_diary_part7" = "Non possono essere dimenticati.";
"ap31_fq6_diary_part8" = "Il mondo deve ricordare chi era.";
"ap31_fq6_endletter_1" = "Non devi credere che il tuo lavoro non abbia valore.";
"ap31_fq6_endletter_2" = "Non perdere coraggio. Ti aspettano giorni migliori.";
"ap31_fq6_endletter_3" = "Non sei solo... Io penso sempre a te.";
"ap31_fq6_endletter_4" = "Un giorno, le persone capiranno ciò che cerchi di fare.";
"ap31_fq6_epilogue2_part1" = "Nel corso di 10 anni, Vincent dipinse più di 800 opere";
"ap31_fq6_epilogue2_part2" = "e realizzò più di 1.000 disegni e bozzetti.";
"ap31_fq6_epilogue2_part3" = "Riuscì a venderne pochissimi.";
"ap31_fq6_epilogue_part1" = "Johanna ha dedicato la sua vita a portare all’attenzione del pubblico le centinaia di opere d’arte e lettere di Van Gogh che aveva ereditato.";
"ap31_fq6_epilogue_part2" = "Dopo 15 anni di perseveranza, lo Stedelijk Museum di Amsterdam organizzò una mostra a lui dedicata.";
"ap31_fq6_epilogue_part3" = "Questo consolidò la reputazione di Vincent come artista.";
"ap31_fq6_epilogue_part4" = "Ad oggi, rimane la più grande mostra di Van Gogh, con oltre 230 dipinti.";
