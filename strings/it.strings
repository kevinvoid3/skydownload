"sf_art_01_00" = "Sky è nato come sequel di Cloud (un gioco progettato prima della fondazione dello studio thatgamecompany).\n\nLo sviluppo di Sky è iniziato nel 2012 con un team di una decina di sviluppatori in un ufficio a Santa Monica, California.";
"sf_art_01_01" = "La prima immagine di Sky era uno straordinario schizzo a matita che raffigurava personaggi che volavano insieme, le loro anime intrecciate nella forma di un uccello mitico.\n(Schizzo di Jenova Chen)";
"sf_art_01_02" = "In principio, l'arte di Sky si ispirava fortemente al dipinto \"The Giant\" dell'artista americano N.C. Wyeth.\n(The Giant di N.C. Wyeth)";
"sf_art_01_03" = "I temi della storia de \"Il Piccolo Principe\" sono stati usati come riferimento nelle prime fasi dello sviluppo.\n(Immagine di \"Le Petit Prince\", opera di Antoine de Saint-Exupéry)";
"sf_art_01_04" = "Il documentario \"Il popolo migratore\" sugli uccelli migratori ci ha fornito informazioni sulle diverse condizioni atmosferiche affrontate dagli uccelli che volano su lunghe distanze.\n(Diretto da Jacques Perrin, Jacques Cluzaud, Michel Debats)";
"sf_art_02_01" = "Il video sull'effetto della veduta d'insieme, condiviso dagli astronauti della stazione spaziale, ha avuto un grande impatto. In esso viene descritto il senso di stupore che si prova ad osservare la Terra dallo spazio. Ciò ha ispirato una delle prime opere nella fase di pre-produzione.\n(Opera di Jenova Chen)";
"sf_art_03_00" = "Durante le nostre prime esplorazioni artistiche, i primi schizzi sull'atmosfera erano basati sull'idea di un personaggio giovane che vola per incontrare i giganti nel cielo.\n\nIn questa fase, avevamo dipinto diverse isole da sorvolare.";
"sf_art_03_01" = "Questi dipinti stillavano un senso di fantasia infantile.\n(Opera di Jacky Ke Jiang)";
"sf_art_03_02" = "Abbiamo immaginato un percorso di anime che incontravano giganti e creature fantastiche tra le nuvole.\n(Opera di Jacky Ke Jiang)";
"sf_art_03_03" = "La libertà e la sensazione di sorvolare isole erbose e oceani divennero un obiettivo di sviluppo di importanza fondamentale.\n(Opera di Yuichiro Tanabe)";
"sf_art_03_04" = "(Opera d'arte di Yuichiro Tanabe)";
"sf_art_03_05" = "(Opera d'arte di Tiffany Hayashi, Yuichiro Tanabe)";
"sf_art_04_00" = "Il nostro team aveva compreso che il tema della \"connessione\" sarebbe stato un elemento centrale dell'azione di gioco. Avevamo realizzato un prototipo per testare diverse modalità di connessione, inclusa la possibilità che i giocatori si tengano per mano. Questo test di gioco divenne una pietra miliare significativa nello sviluppo del nostro gioco.";
"sf_art_04_01" = "(Opera d'arte di Yuichiro Tanabe, Jacky Ke Jiang)";
"sf_art_05_01" = "(Opera d'arte di Tom Zhao)";
"sf_art_05_02" = "(Opera d'arte di Tom Zhao)";
"sf_art_05_03" = "(Opera d'arte di Tom Zhao)";
"sf_art_06_00" = "I pilastri fondamentali del nostro gioco, ossia il senso di meraviglia, umanità e comunità, sono diventati il nostro modo di razionalizzare la grafica, il design e la storia. Ciò che non rifletteva questi valori, non era considerato cruciale per Sky.";
"sf_art_06_01" = "SENSO DI MERAVIGLIA. Al centro c'è la sicurezza, ma tutto intorno è buio.\n(Opera di Tom Zhao)";
"sf_art_06_02" = "SENSO DI UMANITÀ. Ogni momento è migliore se vissuto in compagnia degli altri giocatori.\n(Opera di Tom Zhao)";
"sf_art_06_03" = "SENSO DI COMUNITÀ. La sensazione di appartenere a un collettivo globale che crede nella compassione e nell'altruismo.\n(Opera di Tom Zhao)";
"sf_art_07_00" = "Quest'area introduce le prime rappresentazioni artistiche dei reami e gli stati d'animo visivi dell'arco emotivo.";
"sf_art_07_01" = "Studio dell'Isola dell'Alba\n(Opera di Yuichiro Tanabe)";
"sf_art_07_02" = "Studio della Prateria Diurna\n(Opera di Tom Zhao)";
"sf_art_07_03" = "Studio della Foresta Nascosta\n(Opera di Tom Zhao)";
"sf_art_07_04" = "Studio della Valle del Trionfo\n(Opera di Tom Zhao)";
"sf_art_07_05" = "Studio del Deserto Dorato\n(Opera di Khang Le)";
"sf_art_07_06" = "Studio della Cupola della Conoscenza\n(Opera di Jacky Ke Jiang)";
"sf_art_07_07" = "Studio dell'Occhio di Eden\n(Opera di Trevor Stringer)";
"sf_art_07_08" = "Studio della morte\n(Opera di Tom Zhao)";
"sf_art_07_09" = "Studio dell'orbita\n(Opera di Tom Zhao)";
"sf_art_08_00" = "Nelle fasi iniziali, i \"custodi animali\" venivano delineati come figure mitiche che vegliavano sui loro reami. Si sono evoluti lentamente nei personaggi umanoidi degli anziani antenati che consideriamo parte integrante dell'ascesa e della caduta del regno.";
"sf_art_08_01" = "Insieme, erano guidati da un Sovrano, che alla fine si era sacrificato per dare vita a una nuova generazione di Figli della Luce.\n(Opera di Jacky Ke Jiang)";
"sf_art_08_02" = "ISOLA DELL'ALBA - SAGGEZZA\n(Opera di Tom Zhao)";
"sf_art_08_03" = "PRATERIA DIURNA - EMPATIA\n(Opera di Tom Zhao)";
"sf_art_08_04" = "FORESTA NASCOSTA - RESILIENZA\n(Opera di Tom Zhao)";
"sf_art_09_00" = "Il team artistico ha esplorato i momenti narrativi cruciali in cui ogni antenato avrebbe incontrato i Figli della Luce e ha studiato come catturarli visivamente per creare un maggiore impatto.";
"sf_art_09_01" = "VALLE DEL TRIONFO - ECCELLENZA\n(Opera di Tom Zhao)";
"sf_art_09_02" = "DESERTO DORATO - CORAGGIO\n(Opera di Tom Zhao)";
"sf_art_09_03" = "CUPOLA DELLA CONOSCENZA - FEDE\n(Opera di Tom Zhao)";
"sf_art_09_04" = "IL SOVRANO - SACRIFICIO\n(Opera di Khang Le)";
"sf_art_10_01" = "Nello sviluppare il retroscena, abbiamo delineato il possibile scopo della vita degli abitanti di questa civiltà.\n(Schizzo di Yuichiro Tanabe)";
"sf_art_10_02" = "(Schizzo di Yuichiro Tanabe)";
"sf_art_10_03" = "(Schizzo di Yuichiro Tanabe)";
"sf_art_10_04" = "In principio, gli abitanti dei villaggi di ogni reame adoravano il ciclo dell'anima come parte della coesistenza tra umanità e natura.\n(Schizzo di Yuichiro Tanabe)";
"sf_art_10_05" = "(Schizzo di Yuichiro Tanabe)";
"sf_art_10_06" = "(Opera d'arte di Jacky Ke Jiang, Tom Zhao)";
"sf_art_11_00" = "Gli spiriti ancestrali fornivano un legame con le civiltà del passato e i loro ricordi offrono consistenza e sapore a ogni reame, con vari livelli di sapere e scoperte.";
"sf_art_11_01" = "ISOLA DELL'ALBA\n(Opera di Yuichiro Tanabe)";
"sf_art_11_02" = "PRATERIA DIURNA\n(Opera di Yuichiro Tanabe)";
"sf_art_11_03" = "FORESTA NASCOSTA\n(Opera di Yuichiro Tanabe)";
"sf_art_11_04" = "VALLE DEL TRIONFO\n(Opera di Yuichiro Tanabe)";
"sf_art_11_05" = "DESERTO DORATO\n(Opera di Yuichiro Tanabe)";
"sf_art_11_06" = "CUPOLA DELLA CONOSCENZA\n(Opera di Yuichiro Tanabe)";
"sf_art_12_00" = "L'ecosistema più ampio delle costellazioni e del ciclo vitale è stato considerato in modo più approfondito mentre progettavamo le creature. Abbiamo piantato indizi su come la luce e il vuoto abbiano influenzato storicamente il loro mondo.";
"sf_art_12_01" = "Queste maestose creature guidavano la luce verso le stelle. Le abbiamo progettate per muoversi elegantemente come creature acquatiche che nuotano tra le nuvole.\n(Opera di Yuichiro Tanabe)";
"sf_art_12_02" = "Al principio, il team artistico ha iniziato con il disegno di un pesce, ma nelle iterazioni successive le forme si sono evolute diventando mante.n\\\\(Opera di Tom Zhao)";
"sf_art_13_00" = "Per visualizzare il vuoto nella narrazione, ne abbiamo presentato l'impatto in modo neutrale e abbiamo celebrato sia le forme di vita chiare che quelle oscure per la loro bellezza.\nOnorando allo stesso modo entrambi gli aspetti dell'esistenza, abbiamo potuto intessere un mondo più ricco.";
"sf_art_13_01" = "Così si è iniziato a sperimentare con colori e forme che potessero intensificare le emozioni suscitate dall'incontro con l'oscurità e il vuoto.\n(Opera di Khang Le)";
"sf_art_13_02" = "In queste opere, le forme di vita corrotte dal vuoto sono rappresentate come acqua scura, piante/fiori oscuri, granchi oscuri e draghi oscuri.\n(Opera di Tom Zhao)";
"sf_art_14_00" = "Avendo creato molte iterazioni del mondo di Sky, l'aspetto dell'avatar doveva rimanere aperto e malleabile.\nQuando abbiamo iniziato a progettare i personaggi nell'ambito di un gruppo, abbiamo considerato l'armonia della loro estetica sullo schermo.";
"sf_art_14_01" = "(Opera d'arte di Jacky Ke Jiang)";
"sf_art_14_02" = "(Opera d'arte di Yuichiro Tanabe)";
"sf_art_14_03" = "(Opera d'arte di Jacky Ke Jiang)";
"sf_art_14_04" = "(Opera d'arte di Jacky Ke Jiang)";
"sf_art_14_05" = "(Opera d'arte di Yuichiro Tanabe)";
"sf_art_15_00" = "Il nostro obiettivo era rendere gli avatar dei Figli della Luce rappresentativi di qualsiasi tipo di giocatore.\nInvece di proporre volti diversi, abbiamo aggiunto delle maschere affinché si possa scegliere la propria espressione e il proprio aspetto.";
"sf_art_15_01" = "Sebbene sia stata disegnata nel 2015, questa immagine di gruppo prefigurava l'evoluzione artistica di Sky prima dell'inizio delle stagioni delle avventure.\n(Opera di Yuichiro Tanabe)";
"sf_hist_02_00" = "Sony Computer Entertainment aveva accettato di pubblicare tre videogiochi: flOw, Flower e Journey.\n\nTutti questi titoli hanno ridefinito le possibilità di realizzare un gioco innovativo, accessibile e orientato alla positività.";
"sf_hist_03_00" = "Mosso dal riconoscimento di \"Gioco dell'anno\" di Journey e dalla sua capacità di connettere i giocatori a livello globale, il nostro studio ha cercato di concentrarsi sui temi della gratitudine e della comunità per il suo progetto successivo.\n\nQuesto è stato il punto di partenza per l'espansione su piattaforme mobili al fine di raggiungere più pubblico e sviluppare il titolo di propria pubblicazione: Sky.";
"sf_hist_03_01" = "Esplorando la progettazione del gioco";
"sf_hist_03_02" = "Idee per la narrazione e l'animazione";
"sf_hist_03_03" = "Un nuovo concetto di design";
"sf_hist_03_04" = "Pianificazione artistica";
"sf_hist_04_00" = "Durante i primi anni di sviluppo, lo studio si è concentrato sull'esplorazione e la scoperta giocosa. Il salto verso lo sviluppo per dispositivi portatili, il gioco free-to-start e l'autopubblicazione di un titolo con operazioni dal vivo ha messo alla prova il team e ha esteso il programma di produzione.";
"sf_hist_04_01" = "Sperimentando con la progettazione audio";
"sf_hist_04_02" = "Discussione sull'arte ambientale";
"sf_hist_04_05" = "Il team artistico ha studiato molte forme di nuvole e i loro comportamenti per progettare un mondo nel cielo.";
"sf_hist_04_06" = "L'ispirazione è venuta dalle varie emozioni che le nuvole trasmettevano nei diversi momenti della giornata.";
"sf_hist_04_07" = "Un primo prototipo da testare.";
"sf_hist_04_08" = "Sono stati realizzati molti prototipi per aiutare a pianificare le tecnologie e il motore di gioco necessari per i voli e i paesaggi nuvolosi.";
"sf_hist_04_09" = "Era evidente che, una volta collocati tra le nuvole, avremmo dovuto fare affidamento su di essi come sfondo e scenario emotivo.";
"sf_hist_04_10" = "Introduzione di ambienti familiari.";
"sf_hist_04_11" = "Il mondo umano in Sky.";
"sf_hist_04_12" = "Orizzonte sul paesaggio urbano umano per testare il volo.";
"sf_hist_04_13" = "Test iniziale del personaggio nel mondo di Sky.";
"sf_hist_04_14" = "Un altro esempio di avatar senza mantello.";
"sf_hist_04_15" = "Il team ha optato per questo primo progetto nella Prateria come esemplare di avatar con un anello energetico per mostrare la potenza del volo.";
"sf_hist_05_01" = "Primi teaser grafici di Sky";
"sf_hist_06_00" = "Nell'autunno del 2017, Sky è stato presentato ufficialmente all'evento speciale di Apple a Cupertino, in California. Ha debuttato sull'AppStore per iPhone e iPad.\n\nIl gioco è stato sottoposto a beta testing chiuso fino al 2019, per poi essere pubblicato il 18 luglio.";
"sf_hist_06_03" = "Ogni stagione era piena di azione, storie, personaggi, espressioni e oggetti nuovi.";
"sf_hist_06_04" = "Le prime tre stagioni sono state: \"Stagione della Gratitudine\", \"Stagione dei Cercatori della Luce\" e \"Stagione degli Affetti\".";
"sf_hist_06_05" = "DIETRO LE QUINTE: il legame del personale in studio si è consolidato tra ping pong e videogiochi, creando/regalando candele di cera reali, guardando film e partecipando a viaggi di ricerca a Disneyland. 🕯️";
"sf_hist_07_00" = "Nel 2020, Sky ha rilasciato quattro nuove stagioni di avventure oltre al lancio sul Google Play Store.";
"sf_hist_07_05" = "DIETRO LE QUINTE: due di queste stagioni avrebbero potuto essere pubblicate con nomi completamente diversi, indovinate di quali si tratta...\n\nStagione degli Incontri, del Risveglio, delle Origini\nStagione del Viaggio, dello Splendore, della Migrazione\n\n🕯️";
"sf_hist_08_00" = "Nel luglio 2020, il gioco ha celebrato il suo primo anniversario. In quello stesso periodo, il mondo è stato gravemente colpito dalla pandemia di COVID-19.";
"sf_hist_08_01" = "Primo anniversario di Sky\n\nAttraverso una la speciale iniziativa del \"Pacchetto di guarigione\", thatgamecompany ha lanciato la prima campagna senza scopo di lucro di Sky per aiutare i lavoratori in prima linea attraverso Medici Senza Frontiere. Grazie alla comunità, abbiamo raccolto oltre 1 milione di dollari.";
"sf_hist_09_00" = "Nell'ambito di ogni stagione di avventure nel 2021, il regno di Sky si è ampliato con l'introduzione di nuove funzionalità, storie approfondite, dinamiche multigiocatore e azione di gioco originale.";
"sf_hist_09_03" = "Stagione del Piccolo Principe\n\nOltre al secondo anniversario del gioco e all'espansione su Nintendo Switch, Sky ha anche dato il benvenuto alla sua prima collaborazione IP con Olivier d'Agay e l'amato \"Le Petit Prince\" di Antoine de Saint-Exupéry.";
"sf_hist_09_05" = "DIETRO LE QUINTE: lo sapevate che...?\n\nNella Stagione dei Sogni avevamo pensato di includere il proprietario di una caffetteria, un mangiatore di fuoco e un arpista.";
"sf_hist_09_06" = "DIETRO LE QUINTE: nella stagione del Piccolo Principe, le poesie della rosa non facevano originariamente parte del design e della narrazione.\n\nSono state aggiunte a metà della produzione apportando una maggiore profondità alla stagione.";
"sf_hist_10_00" = "Nel 2021, la mostra FUTURES presso lo Smithsonian e l'evento Barbican Virtual Realms hanno presentato agli astanti i progetti creativi di Sky e thatgamecompany.";
"sf_hist_10_01" = "Mostra FUTURES allo Smithsonian di Washington DC nel 2021";
"sf_hist_10_02" = "Sky presentato alla mostra FUTURES dello Smithsonian";
"sf_hist_10_03" = "Sky rivisitato per l'evento Barbican Virtual Realms di Londra nel 2021";
"sf_hist_11_00" = "Nel 2022, Sky è stato lanciato su Sony PlayStation, ampliando ulteriormente la community di Sky.\n\nDurante quell'anno, le stagioni delle avventure hanno introdotto nuove abilità per i giocatori e lo studio ha annunciato che era in produzione un progetto di animazione di Sky.";
"sf_hist_11_04" = "La collaborazione di Sky con un'artista musicale amata a livello internazionale, AURORA, ha introdotto nuove tecnologie per portare la sua musica nel gioco. Questa stagione ha incluso un concerto simultaneo dal vivo straordinario.";
"sf_hist_11_05" = "DIETRO LE QUINTE: il team ha inaugurato le \"Sky Assemblies\" a Long Beach, in California.\n\nIn questo raduno, gli appassionati di Sky hanno l'opportunità di incontrarsi per festeggiare e giocare di persona, stringendo nuove amicizie.";
"sf_hist_12_00" = "Man mano che Sky cresceva, crescevano anche i team di sviluppo e di pubblicazione dello studio per far evolvere il gioco e le sue partnership.";
"sf_hist_12_01" = "Sky ha festeggiato il suo terzo compleanno.";
"sf_hist_12_02" = "Grazie al generoso supporto dei giocatori, la collaborazione no-profit del team con il Trevor Project è entrata nel suo secondo anno e ha raccolto fondi per un totale di oltre 680.000 dollari.";
"sf_hist_13_00" = "Il team di Sky e thatgamecompany si sono concentrati sull'innovazione in vista del quarto anniversario.\n\nIn quest'anno sono state sviluppate e pubblicate anche quattro nuove stagioni.";
"sf_hist_13_05" = "Dal 2021, la community di Sky ha raccolto oltre 1,84 milioni di dollari per The Ocean Cleanup.\n\nLa loro missione è ricercare, estrarre e monitorare l'inquinamento da plastica negli oceani e nei fiumi in tutto il mondo.";
"sf_hist_14_00" = "Sky ha cercato di stabilire un nuovo Guinness World Record per \"il maggior numero di utenti in un mondo virtuale a tema musicale\" durante la sua presenza alla Gamescom.";
"sf_hist_14_01" = "L'evento Guinness World Record è stato un enorme successo. Sky non solo ha battuto il record, ma lo ha fatto ospitando oltre 10.000 utenti simultanei sullo stesso server.";
"sf_hist_15_00" = "Sky festeggerà il suo quinto anniversario in grande stile ospitando un evento di due giorni nello studio di Tokyo, in Giappone. I giocatori collegati al gioco in tutto il mondo ci aiuteranno a festeggiare.";
"sf_hist_15_01" = "La partnership della Stagione del Cervo dai nove colori introduce nel Regno di Sky una bellissima storia e un cast di personaggi straordinari.";
"sf_hist_15_02" = "Pubblicato quest'estate, il libro d'arte \"The Art of Sky\" ripercorre la fase di sviluppo del gioco durata sette anni (2012-2019).";
"sf_hist_15_03" = "Recentemente, il team ha anche pubblicato la \"Stagione dei Nidi\".";
