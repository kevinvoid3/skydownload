"sf_art_09_04" = "統治者——犧牲\n（Khang Le 繪）";
"sf_art_10_01" = "在開發背景故事時，我們勾勒出這個文明的居民可能的生活目的。\n（Yuichiro Tanabe 繪）";
"sf_art_10_02" = "(Yuichiro Tanabe 繪)";
"sf_art_10_03" = "(Yuichiro Tanabe 繪)";
"sf_art_10_04" = "一開始，每個領域的村民都崇拜靈魂輪迴，這是人類與自然共存的一部分。\n（Yuichiro Tanabe 繪）";
"sf_art_10_05" = "(Yuichiro Tanabe 繪)";
"sf_art_10_06" = "(江軻, Tom Zhao 繪)";
"sf_art_11_00" = "長老先靈提供了過去文明的縮影。祂們的記憶為每個領域增添了豐富的質感和風味，每個角落都埋藏著不同層次的故事與發現。";
"sf_art_11_01" = "晨島\n（Yuichiro Tanabe 繪）";
"sf_art_11_02" = "雲野\n（Yuichiro Tanabe 繪）";
"sf_art_11_03" = "雨林\n（Yuichiro Tanabe 繪）";
"sf_art_11_04" = "霞谷\n（Yuichiro Tanabe 繪）";
"sf_art_11_05" = "暮土\n（Yuichiro Tanabe 繪）";
"sf_art_11_06" = "禁閣\n（Yuichiro Tanabe 繪）";
"sf_art_12_00" = "在設計這些生物時，我們更深入地參考了涉及星座和生命週期的廣泛生態系統。我們埋下種種暗示，顯示從歷史角度，光和虛空在這個世界中如何影響牠們。";
"sf_art_12_01" = "這些宏偉的生物將光引領返回星辰。我們將牠們設計成能在雲中如水生生物般優雅地游動。\n（Yuichiro Tanabe 繪）";
"sf_art_12_02" = "美術團隊的最初設計是以一般的魚為出發點，但在後來的版本，牠們逐漸演變為鰩的型態。n\\\\（Tom Zhao 繪）";
"sf_art_13_00" = "作為說故事的人，我們在視覺化虛空時以中立的方式呈現其影響，並欣賞光明與黑暗生命形式各自的美麗。\n透過平等尊重其存在的兩面，我們得以編織出更豐富的世界。";
"sf_art_13_01" = "我們開始嘗試能在遭遇黑暗與虛空時強化情感的顏色和形狀。\n（Khang Le 繪）";
"sf_art_13_02" = "在這些美術稿中，被虛空腐化的生命被表現為黑水、黑暗腐植/花朵、暗蟹和冥龍。\n（Tom Zhao 繪）";
"sf_art_14_00" = "隨著《Sky光·遇》的世界經歷了無數次的演變，我們保持了角色造型的開放性和可塑性。\n等我們開始在群體情境下設計角色時，則考慮到了他們在螢幕上所呈現的美感協調性。";
"sf_art_14_01" = "(江軻 繪)";
"sf_art_14_02" = "(Yuichiro Tanabe 繪)";
"sf_art_14_03" = "(江軻 繪)";
"sf_art_14_04" = "(江軻 繪)";
"sf_art_14_05" = "(Yuichiro Tanabe 繪)";
"sf_art_15_00" = "我們的目標是讓光之子的化身能夠代表任何類型的玩家。\n我們沒有為角色設定面孔，而是加上了面具，讓玩家可以選擇自己的表情和外觀。";
"sf_art_15_01" = "儘管這張群像圖稿是在 2015 年畫的，但它早在《Sky光·遇》推出冒險季節之前就已經預示了往後的藝術演變。\n（Yuichiro Tanabe 繪）";
"sf_hist_01_01" = "《雲》, 2005 University of Southern California";
"sf_hist_01_02" = "《浮游世界》, 2007 Sony Computer Entertainment America LLC";
"sf_hist_01_03" = "《花》，2009 Sony Computer Entertainment America LLC";
"sf_hist_02_00" = "索尼電腦娛樂公司曾經發行了三款電玩遊戲，分別是《浮游世界》、《花》和《風之旅人》。\n\n這些作品都重新定義了創新、易於上手以及正向驅動力遊戲的可能性。";
"sf_hist_02_01" = "《風之旅人》，2012 Sony Computer Entertainment America LLC";
"sf_hist_03_00" = "受到《風之旅人》獲得年度遊戲殊榮並能夠連結全球玩家的啟發，工作室希望在他們的下一個項目中進一步探討感恩和社群的主題。\n\n這成為擴展到手遊平台、接觸更多受眾的起點，並發展出了他們獨立發行的遊戲——《Sky光·遇》。";
"sf_hist_03_01" = "探索遊戲設計";
"sf_hist_03_02" = "敘事和動畫腦力激盪";
"sf_hist_03_03" = "共同研討新的設計概念";
"sf_hist_03_04" = "美術規劃";
"sf_hist_04_00" = "在開發的最初幾年裡，工作室在探索和趣味發現中反覆鑽研。在邁向手遊開發、免費開玩遊戲模式，以及獨立發行即時運營的遊戲後，這些挑戰延長了製作時程。";
"sf_hist_04_01" = "聲音設計嘗試";
"sf_hist_04_02" = "環境美術討論";
"sf_hist_04_05" = "美術團隊研究了大量的雲朵形狀及其行為，以設計出一個在天空中的世界。";
"sf_hist_04_06" = "靈感來自雲朵在一天中不同時刻所傳達的各種情感。";
"sf_hist_04_07" = "早期測試原型";
"sf_hist_04_08" = "製作了多個原型來幫助計畫雲景和飛行所需的技術和遊戲引擎。";
"sf_hist_04_09" = "一旦置身於雲中，我們便需依賴它們作為表現情感的背景和景觀。";
"sf_hist_04_10" = "引入熟悉的環境。";
"sf_hist_04_11" = "《Sky光·遇》中的人類世界。";
"sf_hist_04_12" = "於人類城市景觀上空的天際線，測試飛行。";
"sf_hist_04_13" = "玩家出現在《Sky光·遇》世界的初步測試。";
"sf_hist_04_14" = "另一個玩家化身沒配備斗篷的範例。";
"sf_hist_04_15" = "團隊在這個早期的雲野設計中，確定了這個的化身範例，並以一個能量環來顯示飛行能力。";
"sf_hist_05_01" = "《Sky光·遇》首次發佈的搶先看素材";
"sf_hist_06_00" = "2017 秋，《Sky光·遇》在加州庫比蒂諾的蘋果特別活動上正式亮相，並在AppStore上首次推出iPhone和iPad版。\n\n遊戲開始進行封測，直到2019年7月18日正式發布。";
"sf_hist_06_03" = "每一季都帶來了全新的玩法、故事、角色、表情和物品。";
"sf_hist_06_04" = "前三個推出的季節分別是：感恩季、追光季和歸屬季。";
"sf_hist_06_05" = "幕後：成員們透過打乒乓球、打電動、為彼此製作/贈送真正的蠟燭、看電影，以及迪士尼樂園考察之旅而建立了深厚的感情。🕯️";
"sf_hist_07_00" = "2020年，《Sky光·遇》推出了四個全新冒險季節，並登陸 Google Play 商店。";
"sf_hist_07_05" = "幕後：這四個季節中的兩個，原本的名字跟最終發布的不一樣。你能猜出這些分別與哪個季節有關嗎？\n\n季節：團聚、覺醒、起源\n季節：漫遊、光輝、遷徙\n\n🕯️";
"sf_hist_08_00" = "2020 年 7 月，該遊戲慶祝了它的首個週年紀念。與此同時，全球也因新冠疫情而深受影響。";
"sf_hist_08_01" = "《Sky光·遇》的一週年紀念\n\n透過特別的「治癒禮包」計劃， thatgamecompany 發起了《Sky光·遇》首次非營利活動，以幫助無國界醫生救助前線工作者。感謝社群的支持，募集了超過 100 萬美元的善款。";
"sf_hist_09_00" = "2021年，每個冒險季節都在 Sky 的國度持續擴展，引入了新功能、更深入的故事、多人互動和獨特的遊戲玩法。";
"sf_hist_09_03" = "小王子季\n\n在遊戲的二週年紀念及登陸任天堂 Switch 平台的同時，《Sky光·遇》也迎來了首次 IP 合作，與 Olivier d’Agay 和 Antoine de Saint-Exupéry 鍾愛的《小王子》聯名。";
"sf_hist_09_05" = "幕後：你知道嗎？\n\n夢想季：我們曾經還想加入以下這些角色，一位咖啡店老闆、吞火表演者和豎琴師。";
"sf_hist_09_06" = "幕後：在小王子季中，玫瑰的詩並非最初的敘事和設計的一部分。\n\n它是在製作中途加入的，為這一季帶來了新的深度。";
"sf_hist_10_00" = "2021年，Smithsonian《FUTURES》展覽和 Barbican 虛擬領域活動向參觀者展示了《Sky光·遇》和 thatgamecompany 的創意設計。";
"sf_hist_10_01" = "Smithsonian《FUTURES》展，2021 年，華盛頓特區";
"sf_hist_10_02" = "《Sky光·遇》在 Smithsonian《FUTURES》展覽中的展示";
"sf_hist_10_03" = "Barbican 虛擬領域活動，《Sky光·遇》新詮釋，2021 年，倫敦";
"sf_hist_11_00" = "2022年，《Sky光·遇》在 Sony PlayStation 上線，進一步擴展了玩家社群。\n\n在那一年，冒險季節引入了新的玩家技能，且工作室宣布正在製作《Sky光·遇》的動畫。";
"sf_hist_11_04" = "《Sky光·遇》與國際知名音樂創作者 AURORA 合作，引入新技術，為她的音樂在遊戲中賦予新的生命。這一季節推出了一種前所未有的演唱會型態，讓玩家跨越全球同步齊聚一堂。";
"sf_hist_11_05" = "幕後：團隊在加州長灘舉行了首次 Sky Assembly 光遇線下聚會。\n\n活動中，玩家們參與了一系列慶祝活動、一起玩《Sky光·遇》，在現實生活中相遇並結交朋友。";
"sf_hist_12_00" = "隨著《Sky光·遇》的成長，工作室的開發和發行團隊也在不斷壯大，為了讓遊戲更好和拓展合作關係。";
"sf_hist_12_01" = "《Sky光·遇》慶祝了三歲生日。";
"sf_hist_12_02" = "感謝玩家們的慷慨支持，團隊與 Trevor Project 的非營利合作邁入第二年，總共募集了超過 68 萬美元的善款。";
"sf_hist_13_00" = "《Sky光·遇》團隊和 thatgamecompany 在邁向四週年紀念之際，專注於開拓新天地。\n\n今年，依然持續推出了四個新季節。";
"sf_hist_13_05" = "自2021年以來，《Sky光·遇》的社群已為 The Ocean Cleanup 海洋清理組織募集了超過 184 萬美元的資金。\n\n該項目的使命是研究、提取和監測全球海洋和河流中的塑膠污染。";
"sf_hist_14_00" = "在 Gamescom 期間，《Sky光·遇》力圖創造「演唱會主題虛擬世界最高用戶人數紀錄」的金氏世界紀錄。";
"sf_hist_14_01" = "金氏世界紀錄活動取得了巨大成功。《Sky光·遇》不僅打破了紀錄，還在同一伺服器上同時支援了超過1萬名用戶。";
"sf_hist_15_00" = "《Sky光·遇》將以盛大風格歡慶五週年紀念，工作室將在日本東京舉辦為期兩天的活動。全球各地的玩家也可以在遊戲中與我們一起慶祝。";
"sf_hist_15_01" = "九色鹿季的聯動將一個美麗的故事和一群令人驚豔的角色引入了 Sky 的國度。";
"sf_hist_15_02" = "今年夏天出版的《Sky光·遇之美》美術設定集回顧了遊戲的七年開發階段（2012-2019）。";
"sf_hist_15_03" = "最近，團隊還推出了「築巢季」。";
