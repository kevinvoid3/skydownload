"ap26_chase_intro" = "捕捉青色的鳥，一探牠的真實樣貌。";
"ap26_feather_hint" = "一根青色羽毛！這隻鳥一定就在附近⋯⋯";
"ap26_fetch01_fragment_intro_00" = "收集青色鳥羽，為慶典增添光彩！";
"ap26_fetch01_intro_00" = "「我聽說過有一隻鳥，羽色如藍寶石般閃耀⋯⋯";
"ap26_fetch01_intro_01" = "要跟著尊貴蓬頭青年前往霞谷城堡，尋找青色的鳥嗎？";
"ap26_fetch01_intro_02" = "⋯⋯牠的鳴叫聲響亮，於盛宴餐桌上迴盪。」";
"ap26_fetch01_outro_01" = "「有人找到了那隻鳥，羽毛是青藍色的⋯⋯";
"ap26_fetch01_outro_02" = "⋯⋯但牠卻轉瞬就像燭煙般消散了。」";
"ap26_fetch02_intro_00" = "「我聽說過有一隻鳥，青藍如母親的雙眼般美好⋯⋯";
"ap26_fetch02_intro_01" = "要跟著懷舊火花家長前往禁閣書庫，尋找青色的鳥嗎？";
"ap26_fetch02_intro_02" = "⋯⋯牠的鳴叫聲恆常，於我心最深處回響。」";
"ap26_fetch02_mem_01" = "「親愛的孩子，在這棵我們最愛的樹上，我們為你搭起了這座鞦韆。」";
"ap26_fetch02_mem_02" = "「看啊，現在你已經可以盪得這麼高了！」";
"ap26_fetch02_mem_03" = "「我的孩子，能在這麼多年後跟你一起回來，真是太好了。」";
"ap26_fetch02_outro_02" = "⋯⋯若我們越想抓住牠，牠消失得就越快。」";
"ap26_fetch03_hint_01" = "或許，那隻鳥想看你們一起表演呢！";
"ap26_fetch03_hint_02" = "不過，你還沒換上合適的戲服耶⋯⋯";
"ap26_fetch03_intro_00" = "「我聽說過有一隻鳥，羽毛好比身著靛藍色布袍⋯⋯";
"ap26_fetch03_intro_01" = "要跟著盛裝彩紙表親前往星漠，尋找青色的鳥嗎？";
"ap26_fetch03_intro_02" = "⋯⋯牠的鳴叫聲悠揚，因眾人簇擁而吟唱。」";
"ap26_fetch03_outro_02" = "⋯⋯但牠就像鬆開的絲線般，難以掌握。」";
"ap26_fetch04_dialog_01" = "「這片寧靜的森林，是眾多五彩鳥類的家園。」";
"ap26_fetch04_dialog_02" = "「我相信，我們一定能在這找到青色的鳥！」";
"ap26_fetch04_intro_00" = "「我聽說過有一隻鳥，色澤透亮似小溪波光輕搖⋯⋯";
"ap26_fetch04_intro_01" = "要跟著伐木不捨家長前往雨林，尋找青色的鳥嗎？";
"ap26_fetch04_intro_02" = "⋯⋯牠的鳴叫聲綿長，林間共鳴宛若迴廊。」";
"ap26_fetch04_outro_01" = "「有人找到了那隻鳥，羽毛是青藍色的⋯⋯";
"ap26_fetch04_outro_02" = "……但牠隨風四散，徒留你我靜默。」";
"ap26_fetch05_intro_00" = "「我聽說過有一隻鳥，宛若湛藍星辰夜空高照⋯⋯";
"ap26_fetch05_intro_01" = "要跟著占卜智慧長者去尋找青色的鳥嗎？";
"ap26_fetch05_intro_02" = "⋯⋯牠的鳴叫聲高亢，宣告命運使人激昂⋯⋯";
"ap26_fetch05_outro_01" = "「有人找到了那隻鳥，羽毛是青藍色的⋯⋯";
"ap26_fetch05_outro_02" = "……但正如命運一般，那並非你我所能掌握的。」";
"ap26_fetch05_quest_01" = "「這些孩子已知曉自己的命運，正準備邁向誕生之路。」";
"ap26_fetch05_quest_02" = "「而有些人，還需要青色的鳥相告，才能大聲說出自己的命運。」";
"ap26_fetch05_quest_03" = "「告訴我你的命運，孩子。」";
"ap26_fetch05_quest_04" = "「我將要當一位園丁，讓美麗的事物在我手中綻放！」";
"ap26_fetch05_quest_05" = "「等我出生後，我將要發明能治病的機器！」";
"ap26_fetch05_quest_06" = "「我將會放聲歌唱，爲絕望之人帶來希望！」";
"ap26_fetch05_quest_07" = "「知曉自己的命運，只是旅程的開始⋯⋯」";
"ap26_fetch06_quest_01" = "誰對你來說比財寶還要珍貴？";
"ap26_fetch06_quest_02" = "你還記得是哪件事驅使著你不斷向前？";
"ap26_fetch06_quest_03" = "當你照鏡子時，看見的是哪個自己？";
"ap26_fetch06_quest_04" = "我們為何會打亂自我身心的和諧？";
"ap26_fetch06_quest_05" = "你還要等多久，才會去勇敢追尋命運？";
"ap26_fetch06_quest_06" = "「你的青色飛鳥，又在何方？」";
"ap26_fetchintro_hint_01" = "想要療癒這個孩子心裡的傷痛，你必須找到青色的鳥。";
"ap26_prologue_00" = "這個孩子正受困於深沉且持續的憂傷 之中。";
