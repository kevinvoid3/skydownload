"ap11_spirit_beckon_01" = "你知道他們動不了，對吧？";
"ap11_spirit_beckon_02" = "我有權要求他們唯命是從！我的命令很合理。";
"ap11_spirit_beckon_03" = "從現在起，你就待在原地別動。";
"ap11_spirit_beckon_04" = "大人真是奇怪。";
"ap11_spirit_gloating_01" = "來自遠方的旅人來這裡崇拜我了。";
"ap11_spirit_gloating_02" = "我是這座島上最為英俊，衣著最得體，最富有，且最為聰慧之人。";
"ap11_spirit_gloating_03" = "但這裡只有你一個呀。";
"ap11_spirit_gloating_04" = "拜托，請一直為我鼓掌吧！";
"ap11_spirit_gloating_05" = "大人實在是古怪。";
"ap11_spirit_scheme_01" = "你拿這些星星做什麼？";
"ap11_spirit_scheme_02" = "我擁有他們。我有五億一百萬顆星星。";
"ap11_spirit_scheme_03" = "擁有這些星星對你有什麼用？";
"ap11_spirit_scheme_04" = "這使我變得富有。";
"ap11_spirit_scheme_05" = "你為什麼想變得富有？";
"ap11_spirit_scheme_06" = "這樣就可以買到更多星星。";
"ap11_spirit_scheme_07" = "大人真是異乎尋常。";
"ap11_spirit_slouch_01" = "你為什麼在喝這黑漆漆的水？";
"ap11_spirit_slouch_02" = "為了忘卻。";
"ap11_spirit_slouch_03" = "忘卻什麼？";
"ap11_spirit_slouch_04" = "為了忘卻我的羞愧。";
"ap11_spirit_slouch_05" = "你為什麼感到羞愧？";
"ap11_spirit_slouch_06" = "我為喝這些黑漆漆的髒水而羞愧！";
"ap11_spirit_slouch_07" = "大人實在是極其、非常地古怪。";
"ap11_spirit_sneeze_01" = "你好啊，你在看什麼？";
"ap11_spirit_sneeze_02" = "請別打擾我。我正在研究來自另外一顆星球的訪客。";
"ap11_spirit_sneeze_03" = "大人的確很有意思。";
"ap11_spirit_stretch_01" = "你看起來很疲憊！你為什麼一直在點燈？";
"ap11_spirit_stretch_02" = "這是我收到的命令，命令我在燈滅時把它點亮。";
"ap11_spirit_stretch_03" = "那你為什麼要在燈亮后又把燈熄滅？";
"ap11_spirit_stretch_04" = "我還有道命令是在燈亮時把燈熄滅。";
"ap11_spirit_stretch_05" = "那你還真是倒霉。";
"ap11_spirit_stretch_06" = "命令就是命令。";
"ap12_fetch_01_candle_01" = "將這支蠟燭送給樂鐘修補匠。";
"ap12_fetch_01_candle_02" = "將這支蠟燭送給天才建築者。";
"ap12_fetch_01_candle_03" = "將這支蠟燭送給活力導航員。";
"ap12_fetch_01_candle_04" = "將這支蠟燭送給光之低語者。";
