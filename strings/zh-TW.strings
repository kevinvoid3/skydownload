"ap21_quest01_narration_01" = "九色鹿的故事要從這裡說起……";
"ap21_quest01_narration_02" = "……從前從前有一個來自遙遠過去的祥獸。";
"ap21_quest01_narration_03" = "某一天，有一個孩子迷路了";
"ap21_quest01_narration_04" = "在這充滿黑暗的山谷之中。";
"ap21_quest01_narration_05" = "九色鹿救了這個孩子，";
"ap21_quest01_narration_06" = "並說：「來參觀我的美麗家園吧。」";
"ap21_quest01_narration_07" = "就這樣，九色鹿";
"ap21_quest01_narration_08" = "從怪物手中救出了孩子。";
"ap21_quest01_narration_09" = "孩子感到害怕，";
"ap21_quest01_narration_10" = "並試圖逃跑。";
"ap21_quest02_gameplay_01" = "找出藏在沙子裡的螃蟹。";
"ap21_quest02_gameplay_02" = "找到藏在湖底的水母。";
"ap21_quest02_gameplay_03" = "看看你是否能從沙丘上發現那隻光鰩。";
"ap21_quest02_hint1" = "在湖泊周圍找到螃蟹和水母。";
"ap21_quest02_hint2" = "引導水母前往九色鹿所在之處。";
"ap21_quest02_hint3" = "引導暗蟹前往九色鹿所在之處。";
"ap21_quest02_hint4" = "拜訪九色鹿尋求幫助。";
"ap21_quest02_narration_01" = "有一天，一隻怪物來到了新月綠洲。";
"ap21_quest02_narration_02" = "所有動物都因為害怕躲了起來。";
"ap21_quest02_narration_03" = "九色鹿開始尋找這些動物……";
"ap21_quest02_narration_04" = "……但牠們都不見了。";
"ap21_quest02_narration_05" = "九色鹿知道該怎麼做。";
"ap21_quest02_narration_06" = "慈悲為懷的九色鹿";
"ap21_quest02_narration_07" = "保護著所有生靈。";
"ap21_quest03_hint0" = "接受九色鹿的邀請，一同前往綠洲。";
"ap21_quest03_narration_01" = "某天，九色鹿渴望有個旅伴。";
"ap21_quest03_narration_02" = "九色鹿與孩子一起慶祝著生命之美。";
"ap21_quest03_narration_03" = "一隻光鰩出現了，身後有位村民正在獵捕牠！";
"ap21_quest03_narration_04" = "但光鰩的動作太敏捷……";
"ap21_quest03_narration_05" = "……一不小心，村民摔進了湖中。";
"ap21_quest03_narration_06" = "九色鹿知道該怎麼做。";
"ap21_quest03_narration_07" = "九色鹿犧牲了部分魔力……";
"ap21_quest03_narration_08" = "……換取村民重獲新生。";
"ap21_quest03_narration_09" = "為了報恩，村民承諾將永遠侍奉九色鹿左右。";
"ap21_quest03_narration_10" = "九色鹿則只要求他對這次的相遇守口如瓶……";
"ap21_quest03_narration_11" = "……但村民知道，他將會因此獲得獎賞……";
"ap21_quest03_narration_12" = "……因為公主渴望得到九色鹿。";
"ap21_quest03_narration_13" = "於是，村民回去便向國王報告他所見之事。";
"ap21_quest03_narration_14" = "國王隨即踏上狩獵九色鹿的征程。";
"ap21_quest03_narration_15" = "就這樣，九色鹿被出賣了。";
"ap21_quest04_hint1" = "幫助九色鹿救出被困在湖中的生物。";
"ap21_quest04_narration_01" = "親身見證九色鹿所遭遇的背叛。";
"ap21_quest04_narration_02" = "應國王麾下獵人的要求，";
"ap21_quest04_narration_03" = "村民污染了湖水。";
"ap21_quest04_narration_04" = "如此，為捕捉這尊貴生物而設的陷阱就完成了。";
"ap21_quest04_narration_05" = "獵人的毒藥讓那位村民病重。";
"ap21_quest04_narration_06" = "九色鹿想援助，但卻變得越來越虛弱。";
"ap21_quest04_narration_07" = "為了救村民，九色鹿犧牲了牠僅存的生命力。";
"ap21_quest04_narration_08" = "國王對獵人的成功表示滿意……";
"ap21_quest04_narration_09" = "……然而，村民卻被罪惡感所困。";
"ap21_quest04_narration_10" = "就這樣，九色鹿被國王捕獲。";
"ap21_quest05_hint0" = "清除黑暗腐植來啟動升降台。";
"ap21_quest05_hint1" = "回去找九色鹿。";
"ap21_quest05_narration_01" = "親身見證九色鹿的救贖。";
"ap21_quest05_narration_02" = "陰影吞噬了整個領域。";
"ap21_quest05_narration_03" = "九色鹿已虛弱到無法抵擋黑暗。";
"ap21_quest05_narration_04" = "村民想要彌補自己的過錯。";
"ap21_quest05_narration_05" = "九色鹿知道該怎麼做。";
"ap21_quest05_narration_06" = "羞愧的國王發誓從此保護一切生靈。";
"ap21_quest05_narration_07" = "於是，王國恢復了和平與繁榮……";
"ap21_quest05_narration_08" = "……而九色鹿消失在野外……";
"ap21_quest05_narration_09" = "……自在地生活，直至生命盡頭。";
