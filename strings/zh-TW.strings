"ap24_fq01_chat_01" = "我來帶你去你的新家。";
"ap24_fq01_chat_02" = "跟我走吧！";
"ap24_fq01_chat_03" = "我們快到了。";
"ap24_fq01_chat_04" = "快來快來！";
"ap24_fq01_chat_05" = "你帶了誰過來？";
"ap24_fq01_chat_06" = "這位是妮妮。";
"ap24_fq01_chat_07" = "妮妮以前曾被一位女士嚇壞。她雖然負責照顧，卻不是真心喜歡妮妮⋯⋯";
"ap24_fq01_chat_08" = "結果她就變得透明了。";
"ap24_fq01_chat_09" = "我見過那個女士，她真的很可怕——是那種會冷嘲熱諷的人。";
"ap24_fq01_chat_10" = "好討厭的感覺喔！";
"ap24_fq01_chat_11" = "如果一個人受過太多驚嚇，有時會因此失去形體，變成透明人。";
"ap24_fq01_chat_12" = "幫妮妮拿把椅子來吧。";
"ap24_fq01_chat_13" = "這裡就是你的新家！";
"ap24_fq01_story_01" = "一個雨夜裡，一位善良的女孩正帶著一個透明的孩子穿越姆明谷。";
"ap24_fq01_story_02" = "善良的女孩名叫迪琪。";
"ap24_fq01_story_03" = "也許她的朋友們可以幫助這個孩子恢復原貌";
"ap24_fq02_chat_01" = "你想睡多久就睡多久。早上我們隨時都會幫你準備好熱茶。";
"ap24_fq02_story_01" = "那個銀鈴一路叮叮噹噹地跟著姆明媽媽上樓。";
"ap24_fq02_story_02" = "晚安，妮妮。";
"ap24_fq03_chat_01" = "媽媽！妮妮有腳了！我看見她的腳了！";
