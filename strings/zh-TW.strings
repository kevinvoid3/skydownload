"sf_art_01_00" = "《Sky光·遇》最初是作為《雲》（一款在 thatgamecompany 成立之前設計的遊戲）的續作而誕生的。\n\n《Sky光·遇》於2012年在加州聖塔莫尼卡開始開發，當時開發團隊大約有十名成員。";
"sf_art_01_01" = "《Sky光·遇》的首張圖稿是一幅令人印象深刻的鉛筆素描，描繪了孩子一起飛翔，他們的靈魂交織成一隻神鳥。\n（陳星漢 繪）";
"sf_art_01_02" = "美國藝術家 N.C. Wyeth 的作品《巨人》是《Sky光·遇》早期的創作核心靈感來源。\n（N.C. Wyeth 的《巨人》）";
"sf_art_01_03" = "《小王子》的故事主題成為了開發初期的參考。\n（《小王子》圖片，作者：Antoine de Saint-Exupéry）";
"sf_art_01_04" = "紀錄片《鵬程千萬里》讓我們了解了鳥類在長途飛行中經歷的不同條件。\n（導演：Jacques Perrin、Jacques Cluzaud、Michel Debats）";
"sf_art_02_01" = "「總觀效應」來自太空站宇航員所分享的一段令人震撼的影片，他們談論了從太空俯瞰地球所感受到的敬畏感。這段影片啟發了前製期的一幅早期畫作。\n（陳星漢 繪）";
"sf_art_03_00" = "在我們早期的藝術探索中，我們的首批情境素描是基於一個孩子飛向天空與巨人會面的概念。\n\n在這段時間裡，我們繪製了各種可以滑翔飛越的島嶼。";
"sf_art_03_01" = "這些畫作散發出夢幻且充滿童趣的氛圍。\n（江軻 繪）";
"sf_art_03_02" = "我們想像了一條靈魂之路，在雲層中遇見奇妙的巨人和生物。\n（江軻 繪）";
"sf_art_03_03" = "在綠草如茵的島嶼和海洋上自由翱翔的感覺成為了一個重要的開發目標。\n（Yuichiro Tanabe 繪）";
"sf_art_03_04" = "(Yuichiro Tanabe 繪)";
"sf_art_03_05" = "(Tiffany Hayashi, Yuichiro Tanabe 繪)";
"sf_art_04_00" = "我們團隊意識到「連結」這個主題將會是遊戲玩法的核心元素。我們製作了一個原型來測試不同建立連結的方式，包括讓玩家牽手的選項。這次測試成為了我們遊戲開發中的一個重要里程碑。";
"sf_art_04_01" = "(Yuichiro Tanabe, 江軻 繪)";
"sf_art_05_01" = "(Tom Zhao 繪)";
"sf_art_05_02" = "(Tom Zhao 繪)";
"sf_art_05_03" = "(Tom Zhao 繪)";
"sf_art_06_00" = "我們將好奇心、人情味和社群這三大核心要素作為遊戲美術、設計和故事的指導原則。如果某個內容不涉及這三大要素，那就說明它可能對《Sky光·遇》來說不夠重要。";
"sf_art_06_01" = "好奇心：在一切的中心你能感到安心，但四周環伺的卻是無盡黑暗。\n（Tom Zhao 繪）";
"sf_art_06_02" = "人情味：每一刻，若能與其他玩家共度，都將更加美好。\n（Tom Zhao 繪）";
"sf_art_06_03" = "社群：一種你屬於一個全球性集體的感覺，而這個集體代表著無私和仁慈之心。\n（Tom Zhao 繪）";
"sf_art_07_00" = "此區域展示了王國各領域早期的圖稿，以及視覺上的情感曲線。";
"sf_art_07_01" = "晨島概念圖\n（Yuichiro Tanabe 繪）";
"sf_art_07_02" = "雲野概念圖\n（Tom Zhao 繪）";
