"ap31_fetch_letter_hint1" = "替文森送信給西奧";
"ap31_flowertouch_hint1" = "靠近西奧的向日葵";
"ap31_fq1_letter1_part1" = "我已經開始期待聖誕節了。";
"ap31_fq1_letter1_part2" = "兩年前，我們在雪中走過的那段夜路……";
"ap31_fq1_letter1_part3" = "你還記得嗎？";
"ap31_fq1_letter1_part4" = "看著月亮從瑪麗恩霍夫上方升起的那一刻？";
"ap31_fq1_letter2_part1" = "言語無法表達我有多開心，";
"ap31_fq1_letter2_part2" = "我終於又開始畫畫了！";
"ap31_fq1_letter2_part3" = "這件事在我心裡盤旋已久，";
"ap31_fq1_letter2_part4" = "但我一直覺得那是不可能的事，離我太遙遠了。";
"ap31_fq1_letter3_part1" = "挖土的、播種的、犁地的，無論男女……";
"ap31_fq1_letter3_part2" = "我必須不斷地把他們畫下來。";
"ap31_fq1_letter3_part3" = "所有屬於鄉村生活的點點滴滴，我都要仔細觀察並畫下來。";
"ap31_fq1_letter3_part4" = "面對大自然，我再也不像以前那樣感到無助了！";
"ap31_fq1_letter4_part1" = "畫畫對我來說，比想像中還要自然。";
"ap31_fq1_letter4_part2" = "或許這就是最好的出路……把所有心力都投注在畫畫上？";
"ap31_fq1_letter4_part3" = "我必須承認……";
"ap31_fq1_letter4_part4" = "其實我一點頭緒也沒有。";
"ap31_fq1_letter5_part1" = "我的錢還沒全部花光，";
"ap31_fq1_letter5_part2" = "但也所剩無幾了。";
"ap31_fq1_letter5_part3" = "買畫具花了我一大筆錢。";
"ap31_fq1_letter5_part4" = "希望你能盡快寄點錢過來。";
"ap31_fq2_letter1_part1" = "我原本連印象派是什麼都不知道，";
"ap31_fq2_letter1_part2" = "現在我親眼見識到了，";
"ap31_fq2_letter1_part3" = "雖然我還算不上他們的一員，";
"ap31_fq2_letter1_part4" = "但我非常欣賞某些印象派畫家的作品……";
"ap31_fq2_letter2_part1" = "我寄了一些畫給你。";
"ap31_fq2_letter2_part2" = "儘管直說吧，";
"ap31_fq2_letter2_part3" = "為什麼這些畫賣不出去，";
"ap31_fq2_letter2_part4" = "還有我該怎麼畫才賣得掉？";
"ap31_fq2_letter3_part1" = "我希望能不斷進步，";
"ap31_fq2_letter3_part2" = "好讓你未來能充滿自信地";
"ap31_fq2_letter3_part3" = "展示我的作品";
"ap31_fq2_letter3_part4" = "而不會覺得丟臉。";
"ap31_fq3_letter1_part1" = "我希望今年能有實質的進步……";
"ap31_fq3_letter1_part2" = "進步……";
"ap31_fq3_letter1_part3" = "老實說，";
"ap31_fq3_letter1_part4" = "這正是我目前迫切需要的。";
"ap31_fq3_letter2_part1" = "我明明精打細算了，";
"ap31_fq3_letter2_part2" = "但直到今天我才發現，為了這十公尺的畫布，我精準算好了";
"ap31_fq3_letter2_part3" = "所有的顏色……卻偏偏漏了一種——";
"ap31_fq3_letter2_part4" = "最基本的黃色。";
"ap31_fq3_letter3_part1" = "我從未感到如此幸運，因為這裡的自然風景實在美極了。";
"ap31_fq3_letter3_part2" = "無論何處，無論何物。";
"ap31_fq3_letter3_part3" = "蒼穹是一片壯麗的湛藍，太陽則散發著淡硫磺般的光輝……";
"ap31_fq3_letter3_part4" = "……就像台夫特的維梅爾畫中，那般柔和迷人的天藍與亮黃。";
"ap31_fq3_letter3_part5" = "我實在畫不出那麼美的景色。";
"ap31_fq3_letter3_part6" = "但這一切實在太令我著迷，讓我徹底沉浸其中……";
"ap31_fq3_letter4_part1" = "我想好好佈置這棟房子，不光是為了自己，也是希望能隨時招待別人來住。";
"ap31_fq3_letter4_part2" = "當然，這花掉了我一大半的錢。";
"ap31_fq3_letter4_part3" = "用剩下的錢，我買了十二張椅子、";
"ap31_fq3_letter4_part4" = "一面鏡子，";
"ap31_fq3_letter4_part5" = "還有一些不可或缺的小東西……";
"ap31_fq3_letter4_part6" = "……也就是說，下週我就能搬進去了！";
"ap31_fq3_letter5_part1" = "這棟房子和我的工作都讓我非常開心……";
"ap31_fq3_letter5_part2" = "……甚至讓我敢去相信，這份喜悅不會只屬於我一個人，";
"ap31_fq3_letter5_part3" = "而是你在遠方也能擁有屬於你的好運，與我共享這份喜悅！";
"ap31_fq3_letter6_part1" = "能親手佈置自己的房子，真的讓我非常開心……這也成了支撐我繼續下去的力量。";
"ap31_fq4_letter1_part1" = "我會非常開心的，";
"ap31_fq4_letter1_part2" = "如果你能來看看喬和我們的小寶寶！";
"ap31_fq4_letter1_part3" = "就如我們之前提到的，";
"ap31_fq4_letter1_part4" = "我們用你的名字幫他取了名。";
"ap31_fq4_letter2_part1" = "說真的，你知道當我放任自己去期盼時，我心裡盼望的是什麼嗎？";
"ap31_fq4_letter2_part2" = "我盼望家庭對你而言，";
"ap31_fq4_letter2_part3" = "就像大自然對我一樣重要……";
"ap31_fq4_letter2_part4" = "……就像泥塊、青草、金黃色的麥田，還有那些農夫。";
"ap31_fq4_letter3_part1" = "現在，那種對生存的恐懼已經淡去了不少，";
"ap31_fq4_letter3_part2" = "憂鬱也不再那麼強烈了。";
"ap31_fq4_letter3_part3" = "但說到動力，我是一點也沒有了……幾乎沒什麼特別渴望的事物……";
"ap31_fq4_letter3_part4" = "……對平凡生活該有的事物，也幾乎提不起任何興趣。";
"ap31_fq4_letter4_part1" = "我在房間裡拚命地工作，";
"ap31_fq4_letter4_part2" = "這樣對我很好，";
"ap31_fq4_letter4_part3" = "我想，這也能趕走";
"ap31_fq4_letter4_part4" = "那些反常的念頭。";
"ap31_fq4_letter5_part1" = "我已經有六個星期沒有踏出門了……";
"ap31_fq4_letter5_part2" = "……甚至連花園都沒去過。";
"ap31_fq4_letter5_part3" = "下個星期，";
"ap31_fq4_letter5_part4" = "等我畫完手邊的這幾幅畫，";
"ap31_fq4_letter5_part5" = "我會試著出去走走的。";
"ap31_fq4_letter6_part1" = "即使在這裡，我也結交了一些朋友，找到了我喜愛的事物。";
"ap31_fq4_letter6_part2" = "那麼你能明白嗎？";
"ap31_fq4_letter6_part3" = "雖然我依舊覺得這份病痛很折磨人，";
"ap31_fq4_letter6_part4" = "但我卻在這裡結下了";
"ap31_fq4_letter6_part5" = "一份或許太過深厚的羈絆？";
"ap31_fq4_letter7_part1" = "漸漸地，我開始把瘋狂視為一種疾病，就和其他的病一樣。";
"ap31_fq4_letter7_part2" = "換個環境對我有好處。";
"ap31_fq4_letter7_part3" = "這裡的醫生傾向將我所經歷的這一切，視為類似癲癇的發作。";
"ap31_fq4_letter7_part4" = "不過我並沒有深究。";
"ap31_fq5_date1" = "六個月後";
"ap31_fq5_date2" = "兩天後";
"ap31_fq5_letter1_part1" = "除了孩子之外，";
"ap31_fq5_letter1_part10" = "展示這些畫作，並讓它們";
"ap31_fq5_letter1_part11" = "盡可能地受到世人欣賞，";
"ap31_fq5_letter1_part2" = "他還留給了我另一項使命……";
"ap31_fq5_letter1_part3" = "為了孩子，完好無缺地保存下來";
"ap31_fq5_letter1_part4" = "那些西奧和文森共同收集的所有珍寶。";
"ap31_fq5_letter1_part5" = "這也是我的任務。";
"ap31_fq5_letter1_part6" = "我的心思全都沉浸在對西奧和文森的思念裡。";
"ap31_fq5_letter1_part7" = "噢，他們之間的感情是多麼溫柔、醇厚，充滿了愛！";
"ap31_fq5_letter1_part8" = "他們是多麼在乎彼此，又是多麼了解對方！";
"ap31_fq5_letter1_part9" = "那就是文森的作品……";
"ap31_fq6_diary_part1" = "除了孩子，";
"ap31_fq6_diary_part2" = "我還被交付了另一項使命……";
"ap31_fq6_diary_part3" = "文森的畫作。";
"ap31_fq6_diary_part4" = "我必須將它們展示出來。";
"ap31_fq6_diary_part5" = "我必須確保它們得到應有的欣賞。";
"ap31_fq6_diary_part6" = "這些畫作是珍寶。";
"ap31_fq6_diary_part7" = "它們不能被遺忘。";
"ap31_fq6_diary_part8" = "世界必須記住他是誰。";
"ap31_fq6_endletter_1" = "千萬別覺得你的作品毫無價值。";
"ap31_fq6_endletter_2" = "不要氣餒。美好的日子就在前方。";
"ap31_fq6_endletter_3" = "你不是孤單一個人……我一直都掛念著你。";
"ap31_fq6_endletter_4" = "總有一天，人們會懂得你真正想做的事。";
"ap31_fq6_epilogue2_part1" = "在這 10 年間，文森創作了超過 800 幅畫作，";
"ap31_fq6_epilogue2_part2" = "以及超過 1000 幅的素描與草圖。";
"ap31_fq6_epilogue2_part3" = "卻僅僅賣出過幾幅而已。";
"ap31_fq6_epilogue_part1" = "約翰娜一生致力於將她繼承的數百件梵谷藝術作品和書信帶入公眾視野。";
"ap31_fq6_epilogue_part2" = "經過 15 年的堅持，阿姆斯特丹的市立博物館終於舉辦了梵谷特展。";
"ap31_fq6_epilogue_part3" = "這場展覽奠定了文森身為藝術家的地位。";
"ap31_fq6_epilogue_part4" = "時至今日，這仍是規模最大的梵谷展覽，展出了超過 230 幅畫作。";
