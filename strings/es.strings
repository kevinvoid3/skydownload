"ap26_chase_intro" = "Atrapa al pájaro azul para develar su verdadera naturaleza.";
"ap26_feather_hint" = "¡Una pluma azul! El pájaro debe de estar cerca…";
"ap26_fetch01_fragment_intro_00" = "¡Recoge plumas del pájaro azul para incorporarlas a la celebración!";
"ap26_fetch01_intro_00" = "\"Conozco a un pájaro, azul como el zafiro…";
"ap26_fetch01_intro_01" = "¿Quieres seguir al adolescente despeinado de la realeza hasta la ciudadela para buscar al pájaro azul?";
"ap26_fetch01_intro_02" = "… cuyo canto suena en los banquetes más abundantes\".";
"ap26_fetch01_outro_01" = "\"Hallaron un pájaro, de plumas azules…";
"ap26_fetch01_outro_02" = "… pero se desvaneció como el humo de una vela\".";
"ap26_fetch02_intro_00" = "\"Conozco a un pájaro, azul como los ojos de mi madre…";
"ap26_fetch02_intro_01" = "¿Quieres seguir a la Madre iluminada nostálgica hasta el Archivo de la Bóveda para buscar al Pájaro Azul?";
"ap26_fetch02_intro_02" = "… cuyo canto resuena en nuestros recuerdos más preciados\".";
"ap26_fetch02_mem_01" = "\"Mi querida nieta, te construimos este columpio en nuestro árbol favorito\".";
"ap26_fetch02_mem_02" = "\"¡Mira lo alto que puedes llegar ahora!\".";
"ap26_fetch02_mem_03" = "\"Mi niña, es maravilloso regresar aquí contigo después de tanto tiempo\".";
"ap26_fetch02_outro_02" = "… pero cuanto más fuerte lo abrazamos, más rápido desapareció\".";
"ap26_fetch03_hint_01" = "¡Tal vez al pájaro le gustaría ver cómo actúan!";
"ap26_fetch03_hint_02" = "Pero aún no tienen el vestuario adecuado para la función…";
"ap26_fetch03_intro_00" = "\"Conozco a un pájaro, azul como un lienzo color añil…";
"ap26_fetch03_intro_01" = "¿Quieres seguir a la prima de confeti disfrazada hasta el desierto Luz de Estrellas para buscar al pájaro azul?";
"ap26_fetch03_intro_02" = "… que trina dondequiera que una multitud afluya para admirarlo\".";
"ap26_fetch03_outro_02" = "… pero fue deshilvanándose hasta desaparecer\".";
"ap26_fetch04_dialog_01" = "\"En este bosque tan tranquilo viven muchos pájaros de colores\".";
"ap26_fetch04_dialog_02" = "\"¡Sé que aquí encontraremos al pájaro azul!\".";
"ap26_fetch04_intro_00" = "\"Conozco a un pájaro, azul como un río cristalino…";
"ap26_fetch04_intro_01" = "¿Quieres seguir al padre suplicante talador hasta el Bosque Escondido para buscar al pájaro azul?";
"ap26_fetch04_intro_02" = "… cuyo canto refleja la apacible armonía del bosque\".";
"ap26_fetch04_outro_01" = "\"Hallaron un pájaro, de plumas azules…";
"ap26_fetch04_outro_02" = "… pero el viento se lo llevó y en su lugar dejó silencio\".";
"ap26_fetch05_intro_00" = "\"Conozco a un pájaro, azul como las estrellas…";
"ap26_fetch05_intro_01" = "¿Quieres seguir al abuelo sabio adivinador para buscar al pájaro azul?";
"ap26_fetch05_intro_02" = "… cuyo canto anuncia donde nacen los grandes destinos\".";
"ap26_fetch05_outro_01" = "\"Hallaron un pájaro, de plumas azules…";
"ap26_fetch05_outro_02" = "… pero, al igual que el destino, no debía quedar atrapado\".";
"ap26_fetch05_quest_01" = "\"Estos niños conocen su destino, y se marchan para nacer\".";
"ap26_fetch05_quest_02" = "\"Otras personas necesitan la ayuda del pájaro azul para pronunciar su destino en voz alta\".";
"ap26_fetch05_quest_03" = "\"Dime tu destino, mi niño\".";
"ap26_fetch05_quest_04" = "\"¡Voy a ser jardinero para cultivar plantas preciosas!\".";
