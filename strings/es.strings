"drinking_text1" = "¡Todo el mundo trabajó duro preparando la fiesta este año!";
"drinking_text10" = "Jamás lo creerías, ¡pero todo lo que existe en Sky tiene un esqueleto! ¡Huesos! ¡Incluso el CABELLO tiene huesos!";
"drinking_text11" = "Escuché que en aquellos tiempos podías encontrar magdalenas y pizza… pero se lo comieron todo.";
"drinking_text12" = "De hecho, soy el clon 73. Samantha está practicando para su acto.";
"drinking_text13" = "Una vez me enteré de que Ash dejó sobras de pizza de piña en la heladera de planta baja, pero eso fue hace años.";
"drinking_text14" = "¡Hasta el personal debate sobre los colores de las capas! ¿Puedes adivinar de cuáles?";
"drinking_text15" = "¡Hay más mascotas de TGC que personal de TGC! La mayoría son gatos.";
"drinking_text16" = "¡Hay tantos lugarcitos para explorar por aquí!";
"drinking_text17" = "Si bebes demasiado, el baño está en el piso de abajo. No te preocupes, no te chupará... Esta vez.";
"drinking_text18" = "¡La estación de sesiones improvisadas te permite realizar colaboraciones musicales con amistades!";
"drinking_text2" = "Los vi preparando espectáculos más temprano.";
"drinking_text3" = "¡¿Sabías que el personal de TGC va a actuar para nosotros?!";
"drinking_text4" = "¡Escuché que cada acto muestra un poco de la creatividad del diseñador!";
"drinking_text5" = "Me enteré de que hay un acto grupal que sucede a los 30 minutos de cada hora exacta.";
"drinking_text6" = "¡¿Ya viste los actos de los diseñadores?! Están pasando cosas geniales en el escenario.";
"drinking_text7" = "¡A algunas personas les gusta jugar con los dragones oscuros! Pero a mí no. Ni soñando.";
"drinking_text8" = "¿Alguna vez miraste por el tragaluz y te preguntaste si quizás todo es una simple simulación?";
"drinking_text9" = "Hay oradores gigantes junto al escenario. ¡Qué gran fiesta!";
