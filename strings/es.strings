"ap22_quest_05_hint_10" = "¡¡¡FELIZ ANIDACIÓN!!!";
"ap22_quest_05_hint_11" = "Cuando quieras finalizar la fiesta, habla con la guía acogedora y reclama tu recompensa.";
"ap22_quest_05_hint_12" = "¡Regresa a tu nido para reclamar la recompensa!";
