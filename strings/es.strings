"ap31_fq1_letter1_part1" = "Ya quiero que llegue la Navidad.";
"ap31_fq1_letter1_part2" = "Hace dos años, dimos un paseo vespertino en la nieve…";
"ap31_fq1_letter1_part3" = "¿Lo recuerdas?";
"ap31_fq1_letter1_part4" = "¿Cuando vimos salir la luna sobre Marienhof?";
"ap31_fq1_letter2_part1" = "¡Las palabras no bastan para expresar lo contento que estoy…";
"ap31_fq1_letter2_part2" = "de haber retomado el dibujo!";
"ap31_fq1_letter2_part3" = "Hacía mucho que me daba vueltas en la cabeza,";
"ap31_fq1_letter2_part4" = "pero siempre me resultó imposible y fuera de mi alcance.";
"ap31_fq1_letter3_part1" = "Cavadores, sembradores, labradores, hombres y mujeres.";
"ap31_fq1_letter3_part2" = "Preciso dibujarlos a todos sin descanso.";
"ap31_fq1_letter3_part3" = "He de estudiar y dibujar todo lo que pertenezca a la vida campesina.";
"ap31_fq1_letter3_part4" = "¡Ya no me siento tan impotente ante la naturaleza como antes!";
"ap31_fq1_letter4_part1" = "La pintura me nace con mayor presteza de lo que esperaba.";
"ap31_fq1_letter4_part2" = "Quizá ese sea el mejor camino a seguir, dedicarme de lleno a pintar…";
"ap31_fq1_letter4_part3" = "Debo confesar…";
"ap31_fq1_letter4_part4" = "que no tengo idea.";
"ap31_fq1_letter5_part1" = "Aún no se me acabó el dinero,";
"ap31_fq1_letter5_part2" = "pero no me queda mucho.";
"ap31_fq1_letter5_part3" = "Me vi obligado a gastar un dineral en insumos de pintura.";
"ap31_fq1_letter5_part4" = "Espero que pronto puedas enviarme un poco.";
"ap31_fq2_letter1_part1" = "Ni siquiera sabía quiénes eran los impresionistas.";
"ap31_fq2_letter1_part2" = "Ahora los he visto y,";
"ap31_fq2_letter1_part3" = "aunque aún no pertenezca al club,";
"ap31_fq2_letter1_part4" = "he admirado mucho la obra de uno de ellos.";
"ap31_fq2_letter2_part1" = "Te envié algunos dibujos.";
"ap31_fq2_letter2_part2" = "Dime sin rodeos…";
"ap31_fq2_letter2_part3" = "por qué no se venden…";
"ap31_fq2_letter2_part4" = "y cómo debería dibujarlos para que sí.";
"ap31_fq2_letter3_part1" = "Espero mejorar de forma";
"ap31_fq2_letter3_part2" = "que con seguridad";
"ap31_fq2_letter3_part3" = "puedas mostrar mi trabajo";
"ap31_fq2_letter3_part4" = "sin pasar vergüenza.";
"ap31_fq3_letter1_part1" = "Este año, quiero progresar.";
"ap31_fq3_letter1_part2" = "Progresar,";
"ap31_fq3_letter1_part3" = "con total sinceridad,";
"ap31_fq3_letter1_part4" = "es algo que necesito con apremio.";
"ap31_fq3_letter2_part1" = "A pesar de mi meticulosa planificación,";
"ap31_fq3_letter2_part2" = "hoy descubrí que, para los diez metros de lienzo, había separado dinero a la perfección";
"ap31_fq3_letter2_part3" = "para todos los colores… a excepción de uno:";
"ap31_fq3_letter2_part4" = "el amarillo fundamental.";
"ap31_fq3_letter3_part1" = "Jamás fui tan afortunado, pues aquí la naturaleza es de una belleza inconcebible.";
"ap31_fq3_letter3_part2" = "Todo y en todas partes.";
"ap31_fq3_letter3_part3" = "La bóveda celeste es de un azul glorioso, mientras que el sol emite un brillo de color azufre pálido,";
"ap31_fq3_letter3_part4" = "igual de tenues y cautivadores como los azules y amarillos celestiales en la obra de Vermeer de Delft.";
"ap31_fq3_letter3_part5" = "No soy capaz de pintar nada igual de bello,";
"ap31_fq3_letter3_part6" = "pero me fascina tanto que me dejé llevar…";
"ap31_fq3_letter4_part1" = "Quería amoblar la casa no solo para mí, sino con la idea de poder recibir a otras personas.";
"ap31_fq3_letter4_part2" = "Desde luego, en eso se fue la mayor parte del dinero.";
"ap31_fq3_letter4_part3" = "Con lo que quedaba, compré doce sillas,";
"ap31_fq3_letter4_part4" = "un espejo…";
"ap31_fq3_letter4_part5" = "y un par de objetos indispensables,";
"ap31_fq3_letter4_part6" = "lo que significa que, para la semana próxima, ya podré mudarme.";
"ap31_fq3_letter5_part1" = "Estoy tan feliz con la casa y el trabajo…";
"ap31_fq3_letter5_part2" = "… que me atrevo a creer que esta alegría no será solo mía,";
"ap31_fq3_letter5_part3" = "y que la buena fortuna no te la haga llegar a ti también.";
"ap31_fq3_letter6_part1" = "Qué dicha me traerá poder amoblar mi casa, y eso no hará sino ayudarme a salir adelante.";
"ap31_fq4_letter1_part1" = "¡Me haría muy feliz…";
"ap31_fq4_letter1_part2" = "que vinieras a ver a Jo y a nuestro bebé!";
"ap31_fq4_letter1_part3" = "Como ya mencionamos,";
"ap31_fq4_letter1_part4" = "lo nombramos en tu honor.";
"ap31_fq4_letter2_part1" = "¿Sabes qué deseo cuando me permito desear?";
"ap31_fq4_letter2_part2" = "Que la familia sea para ti…";
"ap31_fq4_letter2_part3" = "lo que la naturaleza es para mí.";
"ap31_fq4_letter2_part4" = "Los terrones, la hierba, el trigo dorado y los campesinos.";
"ap31_fq4_letter3_part1" = "Ahora, el horror de vivir ya es menos pronunciado,";
"ap31_fq4_letter3_part2" = "y la melancolía, menos aguda.";
"ap31_fq4_letter3_part3" = "Sin embargo, no tengo ni un poco de motivación… Deseos, pocos si los hay…";
"ap31_fq4_letter3_part4" = "y casi nada de lo que pertenece a una vida mundana.";
"ap31_fq4_letter4_part1" = "Trabajo sin parar en mi habitación,";
"ap31_fq4_letter4_part2" = "cosa que me hace bien…";
"ap31_fq4_letter4_part3" = "y ahuyenta, imagino,";
"ap31_fq4_letter4_part4" = "estas ideas extrañas.";
"ap31_fq4_letter5_part1" = "Hace seis semanas que no salgo de la casa,";
"ap31_fq4_letter5_part2" = "ni siquiera al jardín.";
"ap31_fq4_letter5_part3" = "Pero, la próxima semana,";
"ap31_fq4_letter5_part4" = "cuando haya terminado los lienzos que ya empecé,";
"ap31_fq4_letter5_part5" = "voy a intentarlo.";
"ap31_fq4_letter6_part1" = "A pesar de todo, encontré amistades y cosas que amo.";
"ap31_fq4_letter6_part2" = "¿Eres capaz de comprender, pues,";
"ap31_fq4_letter6_part3" = "aunque mi padecimiento aún te parezca horrible,";
"ap31_fq4_letter6_part4" = "que aun así formé lazos aquí…";
"ap31_fq4_letter6_part5" = "que son bastante profundos?";
"ap31_fq4_letter7_part1" = "De a poco, empiezo a ver a la locura como una enfermedad como cualquier otra.";
"ap31_fq4_letter7_part2" = "El cambio de aires me hace bien.";
"ap31_fq4_letter7_part3" = "El médico tiende a asemejar lo que viví con una crisis epiléptica,";
"ap31_fq4_letter7_part4" = "pero no lo investigué.";
"ap31_fq5_date1" = "Seis meses después";
"ap31_fq5_date2" = "Dos días después";
"ap31_fq5_letter1_part1" = "Además del niño,";
"ap31_fq5_letter1_part10" = "que la exponga para que se la aprecie…";
"ap31_fq5_letter1_part11" = "cuanto sea posible.";
"ap31_fq5_letter1_part2" = "me encomendó otra tarea:";
"ap31_fq5_letter1_part3" = "que preserve intactos, para el niño,";
"ap31_fq5_letter1_part4" = "todos los tesoros que Theo y Vincent habían recolectado.";
"ap31_fq5_letter1_part5" = "Esa también es mi labor.";
"ap31_fq5_letter1_part6" = "Vivo absorta en mi mente con Theo y Vincent.";
"ap31_fq5_letter1_part7" = "Ay, ¡su relación gozaba de una afabilidad, dulzura y cariño infinitos!";
"ap31_fq5_letter1_part8" = "Lo que sentían por el otro, ¡la forma en que se entendían!";
"ap31_fq5_letter1_part9" = "la obra de Vincent,";
"ap31_fq6_diary_part1" = "Además del niño,";
"ap31_fq6_diary_part2" = "me han dejado otra tarea…";
"ap31_fq6_diary_part3" = "Los cuadros de Vincent.";
"ap31_fq6_diary_part4" = "Debo mostrarlos.";
"ap31_fq6_diary_part5" = "Debo asegurarme de que sean apreciados.";
"ap31_fq6_diary_part6" = "Estas pinturas son tesoros.";
"ap31_fq6_diary_part7" = "No pueden ser olvidadas.";
"ap31_fq6_diary_part8" = "El mundo debe recordar quién fue.";
"ap31_fq6_endletter_1" = "No creas que tu trabajo no tiene valor.";
"ap31_fq6_endletter_2" = "No te desanimes. Mejores días se avecinan.";
"ap31_fq6_endletter_3" = "No estás solo… Siempre pienso en ti.";
"ap31_fq6_endletter_4" = "Algún día, la gente comprenderá lo que estás tratando de hacer.";
"ap31_fq6_epilogue2_part1" = "A lo largo de diez años, Vincent pintó más de 800 cuadros…";
"ap31_fq6_epilogue2_part2" = "y trazó más de mil dibujos y bocetos.";
"ap31_fq6_epilogue2_part3" = "Solo logró vender unos pocos.";
"ap31_fq6_epilogue_part1" = "Johanna dedicó su vida a dar a conocer al público las cientos de obras de arte y cartas de Van Gogh que heredó.";
"ap31_fq6_epilogue_part2" = "Tras 15 años de perseverancia, se llevó a cabo una exposición de Van Gogh en el Museo Stedelijk de Ámsterdam.";
"ap31_fq6_epilogue_part3" = "Cimentó la reputación de Vincent como artista.";
"ap31_fq6_epilogue_part4" = "Hasta la fecha, sigue siendo la mayor exposición de Van Gogh, con más de 230 pinturas.";
