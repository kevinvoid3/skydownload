"ap32_fetch_02_rudder_tutorial_1" = "Desliza rápido hacia la izquierda para girar a la derecha. Desliza rápido hacia la derecha para girar a la izquierda.";
"ap32_fetch_02_rudder_tutorial_2" = "Desliza rápido hacia la izquierda para mantener el bote en línea recta. Vuelve a deslizar rápido hacia la izquierda para girar a la derecha.";
"ap32_fetch_02_sail_tutorial_0" = "Baja la vela y amárrala.";
"ap32_fetch_02_sail_tutorial_1" = "Arrastra hacia abajo de nuevo para acelerar. Arrastra hacia arriba para desacelerar.";
"ap32_fetch_03_hint_10" = "¡Funcionó! ¡Date prisa y agarra la red!";
"ap32_fetch_03_hint_11" = "El viejo pescador sabía que seguir a las mantarrayas era una buena forma de encontrar perlas.";
"ap32_fetch_03_hint_12" = "Toma el timón y sigue a las mantarrayas.";
"ap32_fetch_03_hint_13" = "El viejo pescador sabía que los manatíes tienen olfato para encontrar perlas más grandes.";
"ap32_fetch_03_hint_14" = "¡El viejo pescador sabía que había una perla enorme cerca!";
"ap32_fetch_03_hint_15" = "Regresa a la superficie.";
"ap32_fetch_03_hint_16" = "¡Es ideal para atraer al monstruo!";
"ap32_fetch_03_hint_2" = "¡Sigue a las mantarrayas!";
"ap32_fetch_03_hint_4" = "¡Sigue a los manatíes!";
"ap32_fetch_03_hint_5" = "¡Sigue a las tortugas!";
"ap32_fetch_03_hint_6" = "La perla está muy profunda. ¡Sumérgete!";
"ap32_fetch_03_hint_7" = "Es muy pequeña.";
"ap32_fetch_03_hint_8" = "Esta también es muy pequeña.";
"ap32_fetch_03_intro_1" = "El monstruo no aparecía por ningún lado,\npero el viejo pescador estaba decidido a encontrar la perla legendaria.";
"ap32_fetch_03_outro_1" = "¡El monstruo mordió el anzuelo!";
"ap32_fetch_04_head_warning" = "¡El bote va muy lento y la línea se está acabando! ¡Ajusta las velas!";
"ap32_fetch_04_hint_1" = "Toma el timón y dirige el boto hacia el monstruo";
"ap32_fetch_04_hint_2" = "Desliza rápido hacia abajo para tirar de la cuerda.";
"ap32_fetch_04_hint_fail" = "El monstruo se escapó…";
"ap32_fetch_04_intro_1" = "El monstruo era increíblemente fuerte...\npero la línea resistió.";
