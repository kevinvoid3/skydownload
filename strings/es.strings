"ap25_fetch01_intro_01" = "Recupera luz amarilla de las nuevas plantas oscuras en la Planicie Luz de Día.";
"ap25_fetch02_intro_00" = "Algunas luces de color aparecen con menos frecuencia.";
"ap25_fetch02_intro_01" = "Recupera luz turquesa de las nuevas plantas oscuras en el Bosque Escondido.";
"ap25_fetch03_intro_01" = "Recupera luz púrpura de las nuevas plantas oscuras en el Páramo Dorado.";
