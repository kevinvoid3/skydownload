"ap23_quest02_hint1" = "Limpia las telarañas y enciende las velas en la mesa.";
"ap23_quest02_hint2" = "¡Intenta limpiar más telarañas!";
"ap23_quest02_hint3" = "¡Intenta purificar más plantas oscuras!";
"ap23_quest02_hint4" = "Primero termina de restaurar el resto del auditorio.";
