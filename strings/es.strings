"sf_art_01_00" = "Sky se creó como una secuela de Cloud (un juego diseñado antes de que se formara el estudio thatgamecompany).\n\nSky se empezó a desarrollar en 2012 con un equipo de unos diez desarrolladores en una oficina de Santa Monica, California.";
"sf_art_01_01" = "La primera imagen de Sky fue un sorprendente boceto hecho en lápiz que representaba niños volando en grupo, cuyas almas se entrelazaban con forma de un ave mítica.\n(Boceto de Jenova Chen).";
"sf_art_01_02" = "\"The Giant\" (\"El gigante\"), del artista estadounidense N. C. Wyeth, fue una inspiración fundamental en los inicios de Sky.\n(\"The Giant\", de N. C. Wyeth).";
"sf_art_01_03" = "Las temáticas de la historia de \"El principito\" se volvieron una referencia al inicio del desarrollo.\n(Imagen de \"El principito\", escrito por Antoine de Saint-Exupéry).";
"sf_art_01_04" = "Con el documental \"Winged Migration\", aprendimos sobre las condiciones climáticas a las que se someten las aves que vuelan largas distancias.\n(Dirigido por Jacques Perrin, Jacques Cluzaud y Michel Debats).";
"sf_art_02_01" = "El \"efecto perspectiva\" es un video impactante que compartieron algunos astronautas desde la estación espacial, en el que hablaron sobre el sobrecogimiento que sintieron al observar a la Tierra. Esto inspiró una de las primeras pinturas en preproducción.\n(Arte de Jenova Chen).";
"sf_art_03_00" = "Cuando empezamos a explorar el arte, los primeros bocetos del ambiente se basaron en la idea de un niño que vuela para encontrarse con los gigantes del cielo.\n\nDurante este período, pintamos diferentes islas sobre las que se podía planear.";
"sf_art_03_01" = "Estas pinturas exudan una calidad imaginaria e infantil.\n(Arte de Jacky Ke Jiang).";
"sf_art_03_02" = "Imaginamos un sendero de almas que se encontraban con gigantes fantásticos y otras criaturas entre las nubes.\n(Arte de Jacky Ke Jiang).";
"sf_art_03_03" = "La libertad y la sensación de volar sobre las islas cubiertas de césped y los océanos se volvió un objetivo fundamental del desarrollo.\n(Arte de Yuichiro Tanabe).";
"sf_art_03_04" = "(Obra de arte de Yuichiro Tanabe)";
"sf_art_03_05" = "(Obra de arte de Tiffany Hayashi, Yuichiro Tanabe)";
"sf_art_04_00" = "El equipo entendió que la temática de \"conexión\" sería un elemento central de la jugabilidad. Hicimos un prototipo para probar diferentes formas de conexión, que incluía una opción para que las personas se tomaran de las manos. Esta prueba se convirtió en un hito importante para el desarrollo del juego.";
"sf_art_04_01" = "(Obra de arte de Yuichiro Tanabe, Jacky Ke Jiang)";
"sf_art_05_01" = "(Obra de arte de Tom Zhao)";
"sf_art_05_02" = "(Obra de arte de Tom Zhao)";
"sf_art_05_03" = "(Obra de arte de Tom Zhao)";
"sf_art_06_00" = "Los pilares principales del juego: asombro, humanidad y comunidad se volvieron la forma en la que racionalizamos el arte, el diseño y la historia. Si algo no tenía mucho que ver con estos pilares, entonces no sería crucial para Sky.";
"sf_art_06_01" = "ASOMBRO. En el centro tenemos la seguridad, pero la oscuridad la rodea.\n(Arte de Tom Zhao).";
"sf_art_06_02" = "HUMANIDAD. Cada momento es mejor con otras personas.\n(Arte de Tom Zhao).";
"sf_art_06_03" = "COMUNIDAD. La sensación de pertenecer a un colectivo global que fomenta la compasión y el altruismo.\n(Arte de Tom Zhao).";
"sf_art_07_00" = "Esta área presenta el arte inicial de los reinos y los ambientes visuales del arco emocional.";
"sf_art_07_01" = "Concepto de la Isla del Amanecer\n(Arte de Yuichiro Tanabe)";
"sf_art_07_02" = "Concepto de la Planicie Luz de Día\n(Arte de Tom Zhao)";
"sf_art_07_03" = "Concepto del Bosque Escondido\n(Arte de Tom Zhao)";
"sf_art_07_04" = "Concepto del Valle del Triunfo\n(Arte de Tom Zhao)";
"sf_art_07_05" = "Concepto del Páramo Dorado\n(Arte de Khang Le)";
"sf_art_07_06" = "Concepto de la Bóveda de Conocimiento\n(Arte de Jacky Ke Jiang)";
"sf_art_07_07" = "Concepto del Ojo de Edén\n(Arte de Trevor Stringer)";
"sf_art_07_08" = "Concepto de la muerte\n(Arte de Tom Zhao)";
"sf_art_07_09" = "Concepto de órbita\n(Arte de Tom Zhao)";
"sf_art_08_00" = "En las primeras etapas, los \"guardianes animales\" se bocetaron como figuras míticas que observaban los reinos. Lentamente evolucionaron en los personajes humanoides, ancestros de los ancianos que reconocemos como parte integral del auge y la caída del reino.";
"sf_art_08_01" = "Juntos, fueron liderados por un soberano, quien a la larga se sacrificó a sí mismo para dar paso a una nueva generación de niños de la luz.\n(Arte de Jacky Ke Jiang)";
"sf_art_08_02" = "ISLA DEL AMANECER: SABIDURÍA\n(Arte de Tom Zhao)";
"sf_art_08_03" = "PLANICIE LUZ DE DÍA: EMPATÍA\n(Arte de Tom Zhao)";
"sf_art_08_04" = "BOSQUE ESCONDIDO: RESISTENCIA\n(Arte de Tom Zhao)";
"sf_art_09_00" = "El equipo de arte exploró los momentos cruciales de la narrativa en los que cada ancestro conocería a los niños de Sky… ¿Y cuál sería la forma más impactante de capturar esto visualmente?";
"sf_art_09_01" = "VALLE DEL TRIUNFO: EXCELENCIA\n(Arte de Tom Zhao)";
"sf_art_09_02" = "PÁRAMO DORADO: CORAJE\n(Arte de Tom Zhao)";
"sf_art_09_03" = "BÓVEDA DE CONOCIMIENTO: FE\n(Arte de Tom Zhao)";
"sf_art_09_04" = "EL SOBERANO: SACRIFICIO\n(Arte de Khang Le)";
"sf_art_10_01" = "Al desarrollar el trasfondo, bocetamos el posible propósito de vida de los habitantes de la civilización.\n(Boceto de Yuichiro Tanabe).";
"sf_art_10_02" = "(Boceto de Yuichiro Tanabe)";
"sf_art_10_03" = "(Boceto de Yuichiro Tanabe)";
"sf_art_10_04" = "Comenzó con aldeanos en cada reino, que adoraban al ciclo de almas como parte de coexistir con la humanidad y la naturaleza.\n(Boceto de Yuichiro Tanabe)";
"sf_art_10_05" = "(Boceto de Yuichiro Tanabe)";
"sf_art_10_06" = "(Obra de arte de Jacky Ke Jiang, Tom Zhao)";
"sf_art_11_00" = "Los espíritus ancestrales brindaron una representación de las civilizaciones pasadas. Sus recuerdos ofrecen una textura y un sabor importantes a cada reino, con capas de historia y descubrimiento a la vuelta de cada esquina.";
"sf_art_11_01" = "ISLA DEL AMANECER\n(Arte de Yuichiro Tanabe)";
"sf_art_11_02" = "PLANICIE LUZ DE DÍA\n(Arte de Yuichiro Tanabe)";
"sf_art_11_03" = "BOSQUE ESCONDIDO\n(Arte de Yuichiro Tanabe)";
"sf_art_11_04" = "VALLE DEL TRIUNFO\n(Arte de Yuichiro Tanabe)";
"sf_art_11_05" = "PÁRAMO DORADO\n(Arte de Yuichiro Tanabe)";
"sf_art_11_06" = "BÓVEDA DE CONOCIMIENTO\n(Arte de Yuichiro Tanabe)";
"sf_art_12_00" = "El amplio ecosistema que involucra las constelaciones y los ciclos de vida se consideró más a fondo mientras diseñábamos las criaturas. Colocamos pistas sobre cómo la luz y el vacío los impactaron de forma histórica en el mundo.";
"sf_art_12_01" = "Estas majestuosas criaturas guiaron a la luz de vuelta hacia las estrellas. Las diseñamos para que se muevan de forma elegante como vida marina que nada entre las nubes.\n(Arte de Yuichiro Tanabe).";
"sf_art_12_02" = "El equipo de arte inicialmente comenzó con un diseño de pez, pero esta forma evolucionó en otras iteraciones.n\\\\(Arte de Tom Zhao).";
"sf_art_13_00" = "Al visualizar al vacío como cuentistas, presentamos su impacto de forma neutral y celebramos tanto las vidas de forma de la luz como de la oscuridad por su belleza propia.\nAl honrar ambos lados de su existencia de igual manera, podemos tejer un mundo más abundante.";
"sf_art_13_01" = "Comenzamos a experimentar con colores y formas que podrían elaborar emociones para los encuentros con la oscuridad y el vacío.\n(Arte de Khang Le).";
"sf_art_13_02" = "En estas obras de arte, las formas de vida corrompidas por el vacío se representaron como aguas oscuras, plantas/flores oscuras, cangrejos oscuros y dragones oscuros.\n(Arte de Tom Zhao).";
"sf_art_14_00" = "Aunque el mundo de Sky veía varias iteraciones, mantuvimos la apariencia del avatar abierta y maleable.\nUna vez que comenzamos a diseñar personajes de a grupos, consideramos la armonía de sus apariencias en la pantalla.";
"sf_art_14_01" = "(Obra de arte de Jacky Ke Jiang)";
"sf_art_14_02" = "(Obra de arte de Yuichiro Tanabe)";
"sf_art_14_03" = "(Obra de arte de Jacky Ke Jiang)";
"sf_art_14_04" = "(Obra de arte de Jacky Ke Jiang)";
"sf_art_14_05" = "(Obra de arte de Yuichiro Tanabe)";
"sf_art_15_00" = "Nuestro objetivo era que los avatares de los niños de Sky fueran representativos de cualquier persona.\nEn lugar de un rostro, agregamos máscaras, para que puedas elegir tu propia expresión y aspecto.";
"sf_art_15_01" = "Aunque se bocetó en 2015, esta imagen grupal anunció la evolución artística de Sky antes de que comenzaran las temporadas de aventuras.\n(Arte de Yuichiro Tanabe).";
"sf_hist_02_00" = "Sony Computer Entertainment nos ofreció publicar tres videojuegos que abarcaron a flOw, Flower y Journey.\n\nTodos los títulos redefinieron las posibilidades de un juego innovador, accesible y positivo.";
"sf_hist_03_00" = "Conmovidos con el reconocimiento de \"Juego del año\" de Journey y su habilidad para conectar a personas de todo el mundo, el estudio buscó inclinarse hacia las temáticas de gratitud y comunidad para su siguiente proyecto.\n\nEsta fue la semilla que se expandió hacia las plataformas móviles para llegar a una mayor audiencia y el desarrollo de un título autopublicado, Sky.";
"sf_hist_03_01" = "Explorar el diseño de videojuegos";
"sf_hist_03_02" = "Tormenta de ideas de narrativa y animación";
"sf_hist_03_03" = "Taller para un nuevo concepto de diseño";
"sf_hist_03_04" = "Planeación de arte";
"sf_hist_04_00" = "Durante los primeros años de desarrollo, el estudio iteró a través de la exploración y el descubrimiento juguetón. El salto hacia el desarrollo móvil, un juego gratis de comenzar y la autopublicación de un título de operaciones en vivo desafió al equipo y extendió el calendario de producción.";
"sf_hist_04_01" = "Experimentar con el diseño de sonido";
"sf_hist_04_02" = "Discusión de arte ambiental";
"sf_hist_04_05" = "El equipo de arte estudió muchas formas de nubes y sus comportamientos para diseñar un mundo en el cielo.";
"sf_hist_04_06" = "La inspiración vino de las varias emociones que las nubes expresan en distintos momentos del día.";
"sf_hist_04_07" = "Un prototipo inicial para pruebas.";
"sf_hist_04_08" = "Se realizaron varios prototipos para ayudar a planificar las tecnologías y el motor del juego que se necesitaban para las nubes y los vuelos.";
"sf_hist_04_09" = "Fue evidente que una vez que colocáramos las nubes, tendríamos que depender de ellas como telón de fondo y paisaje emocionales.";
"sf_hist_04_10" = "Presentar entornos familiares.";
"sf_hist_04_11" = "El mundo humano en Sky.";
"sf_hist_04_12" = "Horizonte sobre el paisaje urbano humano para probar el vuelo.";
"sf_hist_04_13" = "Pruebas iniciales del jugador en el mundo de Sky.";
"sf_hist_04_14" = "Otro ejemplo del avatar del jugador sin capa.";
"sf_hist_04_15" = "El equipo se decidió por este diseño inicial de la planicie como un avatar de ejemplo con un anillo de energía para mostrar el poder de vuelo.";
"sf_hist_05_01" = "Primeros avances visuales de Sky";
"sf_hist_06_00" = "Durante el otoño de 2017, Sky se reveló de forma oficial en el evento especial de Apple en Cupertino, California. Se estrenó en la AppStore para iPhone y iPad.\n\nEl juego estuvo en beta cerrada hasta el 2019, cuando se lanzó el 18 de julio.";
"sf_hist_06_03" = "Cada temporada estaba repleta de nueva jugabilidad, historias, personajes, expresiones y objetos.";
"sf_hist_06_04" = "Los primeros tres lanzamientos fueron: \"Temporada de la gratitud\", \"Temporada de los buscadores de la luz\" y \"Temporada de la pertenencia\".";
"sf_hist_06_05" = "DETRÁS DE ESCENA: El estudio se vinculó jugando tenis de mesa, videojuegos, creando/regalando velas de cera reales entre sí, viendo películas y asistiendo a viajes de investigación a Disneyland. 🕯️";
"sf_hist_07_00" = "En 2020, Sky lanzó cuatro temporadas de aventuras nuevas y se lanzó también en la tienda de Google Play.";
"sf_hist_07_05" = "DETRÁS DE ESCENA: Dos de estas temporadas se podrían haber lanzado con otros nombres… ¿Puedes adivinar con qué temporada se relacionan?\n\nTemporada de: reuniones, despertar, orígenes\nTemporada de: asombro, resplandor, migración\n\n🕯️";
"sf_hist_08_00" = "En julio de 2020, el juego celebró su primer aniversario. Además, vio el grave impacto que la pandemia de COVID-19 causó en el mundo.";
"sf_hist_08_01" = "Primer aniversario de Sky\n\nMediante una iniciativa especial de \"Paquete de Curación\", thatgamecompany lanzó la primera campaña sin fines de lucro de Sky para ayudar a los trabajadores de la primera línea a través de Médicos sin fronteras. Gracias a la comunidad, se recaudó más de 1 millón de dólares.";
"sf_hist_09_00" = "Como parte de cada temporada de aventura DEL 2021, Sky siguió expandiéndose a través del reino donde se revelaron nuevas características, historias más profundas, dinámicas de multijugador y una jugabilidad exclusiva.";
"sf_hist_09_03" = "Temporada de El principito\n\nJunto al segundo aniversario del juego y la expansión hacia la Nintendo Switch, Sky le dio la bienvenida a su primera colaboración de PI con el querido El principito de Olivier d’Agay y Antoine de Saint-Exupéry.";
"sf_hist_09_05" = "DETRÁS DE ESCENA: ¿Sabías que…?\n\nTemporada de los sueños: algunos otros personajes que ideamos que se podrían haber incluido fueron el dueño de una cafetería, un artista tragallamas y un arpista.";
"sf_hist_09_06" = "DETRÁS DE ESCENA: En la temporada de El principito, los poemas de Rose no fueron parte de la narrativa ni del diseño originales.\n\nSu inclusión se agregó a mitad de camino mediante la producción y le trajo una nueva profundidad a la temporada.";
"sf_hist_10_00" = "En 2021, la exhibición FUTURES del Smithsoniano y el evento de Reinos Virtuales de Barbican les presentaron Sky y los diseños creativos de thatgamecompany a los asistentes.";
"sf_hist_10_01" = "Exhibición FUTURES del Smithsoniano en 2021, Washington D. C.";
"sf_hist_10_02" = "Muestra de Sky en la exhibición FUTURES del Smithsoniano.";
"sf_hist_10_03" = "Sky reimaginado en el evento Reinos Virtuales de Barbican en 2021, Londres.";
"sf_hist_11_00" = "En 2022, se lanzó Sky en Sony PlayStation, aumentando así la comunidad de Sky.\n\nDurante ese año, las temporadas de aventuras presentaron nuevas habilidades y el estudio anunció que un proyecto de animación de Sky estaba en producción.";
"sf_hist_11_04" = "La colaboración de Sky con la artista musical querida en todo el mundo, AURORA, presentó nuevas tecnologías para darle vida a su música dentro del juego. Esta temporada incluyó una reunión simultánea para un concierto en vivo inigualable.";
"sf_hist_11_05" = "DETRÁS DE ESCENA: El equipo arrancó sus \"Asambleas de Sky\" inaugurales en Long Beach, California.\n\nAquí, los niños de Sky celebraron con una variedad de festividades, reuniéndose para jugar en persona y creando nuevas amistades gracias al evento.";
"sf_hist_12_00" = "A medida que Sky crecía, también lo hicieron los equipos de desarrollo y publicación del estudio para poder evolucionar el juego y sus colaboraciones.";
"sf_hist_12_01" = "Sky celebró su tercer cumpleaños.";
"sf_hist_12_02" = "Gracias al generoso apoyo de los jugadores, la colaboración sin fines de lucro con el Trevor Project entró en su segundo año y recaudó más de 680 000 dólares en total.";
"sf_hist_13_00" = "El equipo de Sky y thatgamecompany se concentraron en abrir nuevos caminos en vísperas del cuarto aniversario.\n\nSe desarrollaron y se lanzaron cuatro temporadas nuevas adicionales este año.";
"sf_hist_13_05" = "Desde 2021, la comunidad de Sky ha recaudado más de 1,84 millones de dólares y contando para The Ocean Cleanup.\n\nSu misión es investigar, extraer y vigilar la contaminación plástica de los océanos y ríos del mundo.";
"sf_hist_14_00" = "Sky intentó conseguir un nuevo récord mundial Guinness para \"mayor cantidad de usuarios en un concierto en un mundo virtual\" durante su período en Gamescom.";
"sf_hist_14_01" = "El evento del récord mundial Guinness fue un éxito enorme. No solo Sky rompió el récord, sino que lo hizo teniendo a más de 10 000 usuarios en simultáneo en el mismo servidor.";
"sf_hist_15_00" = "Sky celebrará su quinto aniversario con estilo mientras el estudio realiza un evento de dos días en Tokio, Japón. Los jugadores de todo el mundo dentro del juego también nos ayudarán a celebrar.";
"sf_hist_15_01" = "La asociación de la temporada del ciervo de los nueve colores presenta un hermoso cuento y un reparto de personajes impresionantes al mundo de Sky.";
"sf_hist_15_02" = "Publicado este verano, el libro de arte \"El arte de Sky\" rememora los siete años de la fase de desarrollo del juego (2012-2019).";
"sf_hist_15_03" = "Más recientemente, el equipo también lanzó la \"temporada acogedora\".";
