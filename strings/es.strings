"ap23_quest02_hint6" = "El guía de los duetos quiere enseñarte el resto de su canción.";
"ap23_quest02_hint7" = "Enciende las velas en la mesa.";
"ap23_quest03_hint1" = "Restaura la cáscara con tu llama.";
"ap23_quest03_menu1" = "Vuelve al piano cuando estés listo para intentarlo de nuevo.";
"ap23_quest04_hint1" = "Toca el instrumento musical para ayudar al chelista compasivo.";
"ap23_quest04_hint2" = "Toca la canción del chelista compasivo.";
