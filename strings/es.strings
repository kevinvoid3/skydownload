"ap11_spirit_beckon_01" = "Sabes que no pueden moverse, ¿verdad?";
"ap11_spirit_beckon_02" = "¡Tengo derecho a demandar su obediencia! Mis órdenes son razonables.";
"ap11_spirit_beckon_03" = "Desde ahora, quédate donde estás.";
"ap11_spirit_beckon_04" = "Las personas mayores son tan extrañas.";
"ap11_spirit_gloating_01" = "Un viajero lejano está aquí para admirarme.";
"ap11_spirit_gloating_02" = "Soy el hombre más bello, mejor vestido, más rico y más inteligente de la isla.";
"ap11_spirit_gloating_03" = "Pero si eres el único hombre aquí.";
"ap11_spirit_gloating_04" = "¡Sigue aplaudiendo!";
"ap11_spirit_gloating_05" = "Decididamente, las personas mayores son muy extrañas.";
"ap11_spirit_scheme_01" = "¿Qué haces con estas estrellas?";
"ap11_spirit_scheme_02" = "Las poseo. Quinientos un millones de ellas.";
"ap11_spirit_scheme_03" = "¿De qué sirve poseer las estrellas?";
"ap11_spirit_scheme_04" = "Sirve para ser rico.";
"ap11_spirit_scheme_05" = "¿Y para qué quieres ser rico?";
"ap11_spirit_scheme_06" = "Para comprar más estrellas.";
"ap11_spirit_scheme_07" = "Decididamente, las personas mayores son extraordinarias.";
"ap11_spirit_slouch_01" = "¿Por qué bebes el agua oscura?";
