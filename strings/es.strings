"ap14_story_tree_0" = "Había una vez...";
"ap14_story_tree_1a" = "Una estrella resplandeciente";
"ap14_story_tree_1a2a" = "Que cada vez brillaba más";
"ap14_story_tree_1a2a3a" = "Y ya no podía contener la luz dentro de sí";
"ap14_story_tree_1a2a3a4a" = "Se fracturó, y le dio a los demás el resplandor que recolectó durante eones";
"ap14_story_tree_1a2a3a4a_abv" = "Se fracturó...";
"ap14_story_tree_1a2a3a4a_cont" = "El cielo nocturno brillaba con fuerza. Donde antes brillaba una estrella, ahora emergieron incontables agujeritos.";
"ap14_story_tree_1a2a3a4a_cont_abv" = "El cielo nocturno brillaba con fuerza...";
"ap14_story_tree_1a2a3a4b" = "Concedía su luz sobre un infante solitario que deambulaba por el desierto";
"ap14_story_tree_1a2a3a4b_abv" = "Concedía su luz...";
"ap14_story_tree_1a2a3a4b_cont" = "Guiado por su luz, el infante vio el camino a seguir. Desde ese momento, nunca estaría solo.";
"ap14_story_tree_1a2a3a4b_cont_abv" = "Guiado por su luz...";
"ap14_story_tree_1a2a3a_abv" = "Ya no podía contener...";
"ap14_story_tree_1a2a3a_cont" = "En un acto de desinterés...";
"ap14_story_tree_1a2a3b" = "Su luz envolvió el cielo entero";
"ap14_story_tree_1a2a3b4a" = "No podía verse nada más que los cegadores reflejos de sus rayos";
"ap14_story_tree_1a2a3b4a_abv" = "No podía verse nada...";
"ap14_story_tree_1a2a3b4a_cont" = "En silencio y soledad, sometió su luz hasta que regresaron las figuras. Sabía que si no tenía nada sobre lo que brillas, su resplandor era en vano.";
"ap14_story_tree_1a2a3b4a_cont_abv" = "En silencio y soledad...";
"ap14_story_tree_1a2a3b4b" = "Vio a un infante vagando con seguridad por el desierto iluminado";
"ap14_story_tree_1a2a3b4b_abv" = "Vio a un infante...";
"ap14_story_tree_1a2a3b4b_cont" = "Rebosante de orgullo, brilló maravillosamente hasta que el infante encontró refugio en un templo. Agradecido de ayudar, al fin se fue a descansar.";
"ap14_story_tree_1a2a3b4b_cont_abv" = "Rebosante de orgullo...";
"ap14_story_tree_1a2a3b_abv" = "Su luz envolvió...";
"ap14_story_tree_1a2a3b_cont" = "Cuando al fin miró hacia abajo...";
"ap14_story_tree_1a2a_cont" = "Hasta...";
"ap14_story_tree_1a2b" = "Se atenuó más";
"ap14_story_tree_1a2b3a" = "Su luz casi se había desvanecido del cielo";
"ap14_story_tree_1a2b3a4a" = "Se dividió en incontables motas de luz, que descienden suavemente hacia el suelo.";
"ap14_story_tree_1a2b3a4a_abv" = "Se dividió...";
"ap14_story_tree_1a2b3a4a_cont" = "Desde sus ecos flamean hermosas criaturas de luz. El fin de una desencadena la nueva vida de otra.";
"ap14_story_tree_1a2b3a4a_cont_abv" = "Desde sus ecos...";
"ap14_story_tree_1a2b3a4b" = "Comenzó su descenso hacia el suelo, brillando incluso más fuerte que la luna.";
"ap14_story_tree_1a2b3a4b_abv" = "Comenzó su descenso...";
"ap14_story_tree_1a2b3a4b_cont" = "Un infante emergió, una estrella se transformó.";
"ap14_story_tree_1a2b3a4b_cont_abv" = "Un infante emergió...";
"ap14_story_tree_1a2b3a_cont" = "Pero antes de desaparecer por completo...";
"ap14_story_tree_1a2b3b" = "Un infante le pidió un deseo";
"ap14_story_tree_1a2b3b4a" = "Reunió todo su esfuerzo para parpadear débilmente una última vez.";
"ap14_story_tree_1a2b3b4a_abv" = "Reunió todo su esfuerzo...";
"ap14_story_tree_1a2b3b4a_cont" = "Al presenciar sus últimos destellos, el infante ya no se sintió solo. Ahora, con optimismo, ambos persistieron.";
"ap14_story_tree_1a2b3b4a_cont_abv" = "Al presenciar sus últimos destellos...";
"ap14_story_tree_1a2b3b4b" = "Dedicó su última luz para ayudar al infante errante.";
"ap14_story_tree_1a2b3b4b_abv" = "Dedicó...";
"ap14_story_tree_1a2b3b4b_cont" = "Al iluminar una cueva, la estrella guio al infante a un refugio... Como la profecía lo había anunciado.";
"ap14_story_tree_1a2b3b4b_cont_abv" = "Al iluminar una cueva...";
"ap14_story_tree_1a2b3b_cont" = "Al escuchar su llamado...";
"ap14_story_tree_1a2b_cont" = "Hasta...";
"ap14_story_tree_1a_cont" = "Cada noche...";
"ap14_story_tree_1b" = "Allí vivió un infante silencioso";
"ap14_story_tree_1b2a" = "Buscaba una compañía";
"ap14_story_tree_1b2a3a" = "Sus agotadas piernas ya no podían llevarlo más";
"ap14_story_tree_1b2a3a4a" = "Observaron a otro infante entrar a una modesta cueva.";
"ap14_story_tree_1b2a3a4a_abv" = "Observaron a otro infante...";
"ap14_story_tree_1b2a3a4a_cont" = "Los infantes encontraron compañía entre ellos, y convirtieron la cueva en su hogar. Algún día se encontrarían.";
"ap14_story_tree_1b2a3a4a_cont_abv" = "Los infantes encontraron compañía...";
"ap14_story_tree_1b2a3a4b" = "Notaron que los patrones en la piedra comenzaron a brillar.";
"ap14_story_tree_1b2a3a4b_abv" = "Notaron que los patrones...";
"ap14_story_tree_1b2a3a4b_cont" = "Los patrones mostraban tres figuras viajando en botes. El infante estaba destinado a ser el cuarto.";
"ap14_story_tree_1b2a3a4b_cont_abv" = "Los patrones mostraban...";
"ap14_story_tree_1b2a3a_abv" = "Estas piernas cansadas...";
"ap14_story_tree_1b2a3a_cont" = "Descansando a la sombra de una curiosa formación rocosa...";
"ap14_story_tree_1b2a3a_cont_abv" = "Descansando a la sombra...";
"ap14_story_tree_1b2a3b" = "Un templo eclipsó el sol poniente";
"ap14_story_tree_1b2a3b4a" = "Al ver al infante, la figura levantó un báculo radiante.";
"ap14_story_tree_1b2a3b4a_abv" = "Al ver al infante...";
"ap14_story_tree_1b2a3b4a_cont" = "Salió una parvada de pájaros y guiaron al infante a salvo. Dentro, descubrirían el destino de su compañero.";
"ap14_story_tree_1b2a3b4a_cont_abv" = "Salió una parvada de pájaros...";
"ap14_story_tree_1b2a3b4b" = "Débil, la figura se apoyó en un bastón tembloroso.";
"ap14_story_tree_1b2a3b4b_abv" = "Débil, la figura...";
"ap14_story_tree_1b2a3b4b_cont" = "El infante le ofreció su luz, lo que restauró la fuerza de la figura. Juntos, reunirían a las estrellas.";
"ap14_story_tree_1b2a3b4b_cont_abv" = "El infante le ofreció su luz...";
"ap14_story_tree_1b2a3b_abv" = "Un templo eclipsó...";
"ap14_story_tree_1b2a3b_cont" = "De adentro, emergió una figura imponente.";
"ap14_story_tree_1b2a3b_cont_abv" = "De adentro...";
"ap14_story_tree_1b2a_cont" = "Hasta...";
"ap14_story_tree_1b2b" = "Marcharon por el desierto";
"ap14_story_tree_1b2b3a" = "Escalaron la duna desértica más alta";
"ap14_story_tree_1b2b3a4a" = "Vislumbraron una modesta cueva.";
"ap14_story_tree_1b2b3a4a_cont" = "Un par de veleros salieron con los brazos abiertos. Al fin, el infante encontró un hogar.";
"ap14_story_tree_1b2b3a4a_cont_abv" = "Un par de veleros...";
"ap14_story_tree_1b2b3a4b" = "Detectaron una fatídica cueva.";
"ap14_story_tree_1b2b3a4b_cont" = "Dentro de las amenazantes cámaras se enfrentaron a muchos desafíos. Estaba predicho que serían los primeros en salir victoriosos.";
"ap14_story_tree_1b2b3a4b_cont_abv" = "Dentro de las amenazantes cámaras...";
"ap14_story_tree_1b2b3a_cont" = "Observando como el sol iluminaba el paisaje...";
"ap14_story_tree_1b2b3b" = "Cayeron en un valle";
"ap14_story_tree_1b2b3b4a" = "Vieron una llama distante en el horizonte que se acercaba lentamente hacia ellos.";
"ap14_story_tree_1b2b3b4a_abv" = "Vieron una llama distante...";
"ap14_story_tree_1b2b3b4a_cont" = "El extraño les ofreció una vela de luz, y luego su mano. Un guardián, quizás una amistad, había llegado.";
"ap14_story_tree_1b2b3b4a_cont_abv" = "El extraño les ofreció...";
"ap14_story_tree_1b2b3b4b" = "Miraron hacia arriba en búsqueda de rescate, y vieron una estrella brillante.";
"ap14_story_tree_1b2b3b4b_abv" = "Miraron hacia arriba...";
"ap14_story_tree_1b2b3b4b_cont" = "Delineó la silueta de un magnífico templo. Escucharon campanas, porque su aventura acababa de comenzar.";
"ap14_story_tree_1b2b3b4b_cont_abv" = "Delineó la silueta...";
"ap14_story_tree_1b2b3b_cont" = "Despierta en el frío de la noche...";
"ap14_story_tree_1b2b_cont" = "Hasta...";
"ap14_story_tree_1b_cont" = "Cada día...";
