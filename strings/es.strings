"ap32_fetch_01_hint_0" = "¡Se avecina una tormenta! ¡A recoger las velas!";
"ap32_fetch_01_hint_1" = "Ata las líneas de pesca.";
"ap32_fetch_01_hint_10" = "... Y, por último, su aprendiz.";
"ap32_fetch_01_hint_11" = "El viejo pescador sabía que la perla legendaria estaba en algún lado...";
"ap32_fetch_01_hint_13" = "Regresa a tu hogar, al naufragio que está al final de la isla.";
"ap32_fetch_01_hint_14" = "Pero un monstruo le robó su pesca...";
"ap32_fetch_01_hint_2" = "Echa un vistazo a la pesca de hoy.";
"ap32_fetch_01_hint_6" = "Hace mucho tiempo, el viejo pescador sacó del agua\nuna perla legendaria.";
"ap32_fetch_01_hint_7" = "El monstruo se había llevado todo...";
"ap32_fetch_01_hint_8" = "Su suerte...";
"ap32_fetch_01_hint_9" = "Su dignidad...";
"ap32_fetch_02_hint_0" = "Sube al bote con el viejo pescador.";
"ap32_fetch_02_hint_1" = "Baja la vela y amárrala.";
"ap32_fetch_02_hint_10" = "Por favor, toma el timón.";
"ap32_fetch_02_hint_11" = "Fuera del área de la misión; recalibrando...";
"ap32_fetch_02_hint_12" = "El espíritu preparó un remo del tamaño del niño.";
"ap32_fetch_02_hint_13" = "Deja el obsequio y prepárate para zarpar.";
"ap32_fetch_02_hint_2" = "Las criaturas de luz se escaparon. ¡Síguelas!";
"ap32_fetch_02_hint_3" = "Sigue a las criaturas de luz para encontrar perlas.";
"ap32_fetch_02_hint_4" = "¡Sigue a las mantarrayas!";
"ap32_fetch_02_hint_5" = "Presiona izquierda para ir a la derecha. Presiona derecha para ir a la izquierda.";
"ap32_fetch_02_hint_6" = "Espera mientras el bote sale del puerto.";
"ap32_fetch_02_hint_7" = "Te desviaste demasiado. Grita para saber hacia dónde ir.";
"ap32_fetch_02_hint_8" = "Toma el timón y sigue a las criaturas de luz.";
"ap32_fetch_02_hint_9" = "Toma el timón y sigue a las mantarrayas.";
"ap32_fetch_02_intro_1" = "El viejo pescador no se dio por vencido.";
"ap32_fetch_02_outro_1" = "Todavía no se veía ni rastro del monstruo,\npero el viejo pescador estaba decidido a encontrar la perla legendaria.";
