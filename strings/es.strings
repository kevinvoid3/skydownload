"ap25_fetch05_intro_00" = "¡Los espíritus quieren combinar estilos para honrarte! Crea un estilo para ti y para ellos.";
"ap25_fetch05_intro_00_b" = "¡Usa el taller de tinturas para combinar con el estilo grupal de los espíritus!";
"ap25_found_dye" = "Entrega esta luz de color a la guía de resplandor en el taller de tinturas, en la aldea aviaria.";
