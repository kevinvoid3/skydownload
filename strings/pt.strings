"ap21_quest01_hint1" = "Saia do vale.";
"ap21_quest01_hint2" = "Uma parte do mural foi restaurada com sucesso.";
"ap21_quest01_narration_01" = "Esta é a história do Cervo de Nove Cores...";
"ap21_quest01_narration_02" = "... um ser benevolente de muito tempo atrás.";
"ap21_quest01_narration_03" = "Um dia, uma criança se perdeu";
"ap21_quest01_narration_04" = "em um vale tomado pela escuridão.";
"ap21_quest01_narration_05" = "O Cervo de Nove Cores resgatou a criança";
"ap21_quest01_narration_06" = "e disse: \"Venha e conheça meu belo lar.\"";
"ap21_quest01_narration_07" = "Assim, o Cervo de Nove Cores";
"ap21_quest01_narration_08" = "salvou a criança de um monstro.";
"ap21_quest01_narration_09" = "A criança estava com medo";
"ap21_quest01_narration_10" = "e tentou fugir.";
"ap21_quest02_gameplay_01" = "Ache o caranguejo escondido na areia.";
"ap21_quest02_gameplay_02" = "Ache a água-viva escondida no fundo do lago.";
"ap21_quest02_gameplay_03" = "Veja se consegue localizar a arraia da duna.";
"ap21_quest02_hint1" = "Ache o caranguejo e a água-viva em volta do lago.";
"ap21_quest02_hint2" = "Guie a água-viva até o Cervo.";
"ap21_quest02_hint3" = "Leve o caranguejo ao cervo.";
"ap21_quest02_hint4" = "Visite o cervo para obter ajuda.";
"ap21_quest02_narration_01" = "Um dia, um monstro apareceu no Oásis Crescente.";
"ap21_quest02_narration_02" = "Os animais, com medo, se esconderam.";
"ap21_quest02_narration_03" = "O Cervo de Nove cores saiu à procura dos animais...";
"ap21_quest02_narration_04" = "... mas eles haviam desaparecido.";
"ap21_quest02_narration_05" = "O Cervo de Nove Cores sabia o que tinha que fazer.";
"ap21_quest02_narration_06" = "Com benevolência, o Cervo de Nove Cores";
"ap21_quest02_narration_07" = "protege todos os seres vivos.";
"ap21_quest03_hint0" = "Aceite o convite do Cervo de Nove Cores para visitarem o oásis juntos.";
"ap21_quest03_narration_01" = "Um dia, o Cervo de Nove Cores queria companhia.";
"ap21_quest03_narration_02" = "Com a criança, o Cervo comemorou a beleza da vida.";
"ap21_quest03_narration_03" = "Uma arraia apareceu... sendo caçada por um aldeão!";
"ap21_quest03_narration_04" = "Mas a arraia era muito rápida...";
"ap21_quest03_narration_05" = "... e o aldeão caiu no lago.";
"ap21_quest03_narration_06" = "O Cervo de Nove Cores sabia o que tinha que fazer.";
"ap21_quest03_narration_07" = "Sacrificando um pouco de magia…";
"ap21_quest03_narration_08" = "… o Cervo reviveu o aldeão.";
"ap21_quest03_narration_09" = "Em agradecimento, o aldeão ofereceu servir ao Cervo para sempre.";
"ap21_quest03_narration_10" = "O Cervo só pediu que o encontro fosse mantido em segredo…";
"ap21_quest03_narration_11" = "… mas o aldeão sabia que poderia ser recompensado…";
"ap21_quest03_narration_12" = "… pois a princesa desejava o Cervo.";
"ap21_quest03_narration_13" = "Então o aldeão voltou para contar ao rei o que tinha visto.";
"ap21_quest03_narration_14" = "O rei partiu para caçar o Cervo.";
"ap21_quest03_narration_15" = "Assim, o Cervo de Nove Cores foi traído.";
"ap21_quest04_hint1" = "Ajude o Cervo a salvar as criaturas presas no lago.";
"ap21_quest04_narration_01" = "Observe a traição do Cervo de Nove Cores.";
"ap21_quest04_narration_02" = "A mando do Caçador do Rei,";
"ap21_quest04_narration_03" = "o Aldeão contaminou as águas.";
"ap21_quest04_narration_04" = "Assim, armou-se uma armadilha para capturar a nobre criatura.";
"ap21_quest04_narration_05" = "O veneno do Caçador intoxicou o Aldeão.";
"ap21_quest04_narration_06" = "O Cervo quis ajudar, mas estava enfraquecendo.";
"ap21_quest04_narration_07" = "Para salvar o Aldeão, o Cervo sacrificou o que lhe restava de força vital.";
"ap21_quest04_narration_08" = "O Rei se contentou com o sucesso do Caçador...";
"ap21_quest04_narration_09" = "... mas a culpa consumia o Aldeão.";
"ap21_quest04_narration_10" = "Assim, o Rei capturou o Cervo de Nove Cores.";
"ap21_quest05_hint0" = "Remova as plantas escuras para subir o elevador.";
"ap21_quest05_hint1" = "Volte ao Cervo.";
"ap21_quest05_narration_01" = "Observe a salvação do Cervo de Nove Cores.";
"ap21_quest05_narration_02" = "As sombras devoraram o reino.";
"ap21_quest05_narration_03" = "Enfraquecido, o Cervo não conseguiu afastar as trevas.";
"ap21_quest05_narration_04" = "O Aldeão tentou reparar tudo.";
"ap21_quest05_narration_05" = "O Cervo de Nove Cores sabia o que fazer.";
"ap21_quest05_narration_06" = "O Rei, envergonhado, prometeu que dali em diante protegeria todas as criaturas.";
"ap21_quest05_narration_07" = "Assim, a paz e a prosperidade voltaram ao Reino...";
"ap21_quest05_narration_08" = "... e o Cervo sumiu na mata...";
"ap21_quest05_narration_09" = "... e lá viveu até o fim dos seus dias.";
