"season_intro_2_06" = "Um grupo de espíritos iniciou sua viagem em direção à prosperidade.";
"season_intro_2_07" = "Um grupo de espíritos da Campina da Aurora tem procurado relaxar em ilhas próximas.";
"season_intro_2_08" = "Um grupo de Profetas que desejam passar sua sabedoria aguarda sua chegada na Ilha da Aurora.";
"season_intro_2_09" = "Participantes aposentados e aldeões vivem uma vida simples na sombra do coliseu do Vale do Triunfo";
"season_intro_2_10" = "Um batalhão de jovens batedores se estabeleceram nos acampamentos da Floresta Oculta.";
"season_intro_2_11" = "As estrelas se alinharam para dar boas-vindas a um visitante longínquo no Relicário do Conhecimento.";
"season_intro_2_12" = "Os ventos revelam uma rede de passagens acima da Floresta Oculta.";
"season_intro_2_13" = "Uma equipe de caçadores descobriu uma ilha distante no Sertão Dourado.";
"season_intro_2_14" = "Um grupo de jovens artistas subiu ao palco no Vale do Triunfo.";
"season_intro_2_15" = "A escuridão do olho de Éden está recaindo sobre o Reino de Sky.";
"season_intro_2_16" = "Uma voz encantadora ecoa pelo Vale do Triunfo.";
"season_intro_2_17" = "Sob o Relicário do Conhecimento, a porta para um Repositório perdido foi aberta. Lá dentro, espíritos se refugiam.";
"season_intro_2_18" = "Em algum lugar da Ilha do Alvorecer, uma fabricante de máscaras prepara-se para guiar adolescentes relutantes no estudo da Passagem.";
"season_intro_2_19" = "Uma balsa apareceu perto das Cavernas da Campina. Encontre-a para viajar para uma terra de tirar o fôlego.";
"season_intro_2_20" = "Nas ruínas de um refúgio nas nuvens, um Gestor Otimista aguarda a sua chegada há bastante tempo.";
"season_intro_2_21" = "Um visitante e um mural no Oásis Crescente esperam para contar uma história mágica.";
"season_intro_2_22" = "Na Aldeia Aviária, explore uma nova oficina cheia de decorações aconchegantes...";
"season_intro_2_23" = "Uma entrada para uma misteriosa sala de concertos foi aberta na Aldeia Aviária...";
"season_intro_2_24" = "Um Livro de Histórias escondido no Relicário do Conhecimento contém contos de um vale muito distante";
"season_intro_2_25" = "A luz emerge do outrora fechado Ateliê de Tintas na Aldeia Aviária...";
"season_intro_2_26" = "Na Clareira Elevada da Floresta Oculta...";
"season_intro_2_27" = "Uma lanterna de lembrança escondida no Relicário do Conhecimento guarda o poder de viajar para um tempo e espaço distantes.";
"season_intro_2_28" = "Na Ilha do Alvorecer, este rebanho de criaturas de luz migratórias é o último de sua espécie.";
"season_intro_2_29" = "Uma tarefa importante acontece atrás de portas fechadas no Relicário do Conhecimento.";
"season_intro_2_30" = "No alto dos céus, acima da Aldeia Aviária...";
"season_intro_2_31" = "Na Sala das Histórias, um homem chega para seguir a sua paixão.";
"season_intro_2_32" = "No cais naMuralha Externa...";
