"ap24_credits_01" = "Obrigado por jogar...";
"ap24_credits_02" = "a Temporada dos Mumins";
"ap24_credits_03" = "Baseado em “A Criança Invisível”";
"ap24_credits_04" = "de Tove Jansson";
"ap24_credits_05" = "Apresentando cenas selecionadas dos livros";
"ap24_credits_06" = "“Cometa na Terra dos Mumins”";
"ap24_credits_07" = "“A Família Mumin”";
"ap24_credits_08" = "e “Contos do Vale dos Mumins”";
"ap24_fq01_chat_01" = "Vou te levar para sua casa nova.";
"ap24_fq01_chat_02" = "Vamos lá!";
"ap24_fq01_chat_03" = "Estamos quase chegando.";
"ap24_fq01_chat_04" = "Vamos lá!";
"ap24_fq01_chat_05" = "Quem você trouxe?";
"ap24_fq01_chat_06" = "O nome dela é Ninny.";
"ap24_fq01_chat_07" = "Ela estava com medo de uma mulher que cuidava dela sem gostar dela de verdade...";
"ap24_fq01_chat_08" = "... aí ela ficou invisível.";
"ap24_fq01_chat_09" = "Conheci essa mulher, e ela era horrível – do tipo gelidamente irônica.";
"ap24_fq01_chat_10" = "Isso não é legal!";
"ap24_fq01_chat_11" = "Se as pessoas ficam com medo com muita frequência, às vezes, ficam invisíveis.";
"ap24_fq01_chat_12" = "Dê uma cadeira para a criança.";
"ap24_fq01_chat_13" = "Essa é sua nova família!";
"ap24_fq01_story_01" = "Numa noite chuvosa, uma figura gentil guiava uma criança invisível pelo Vale dos Mumins.";
"ap24_fq01_story_02" = "O nome da figura era Too-Ticky.";
"ap24_fq01_story_03" = "Talvez os amigos dela pudessem ajudar a menina a ficar visível novamente.";
"ap24_fq02_chat_01" = "Durma o mais tarde que puder. Você pode beber chá de manhã sempre que quiser.";
"ap24_fq02_story_01" = "O sino de prata tilintou atrás de Mãe Mumin no andar de cima.";
"ap24_fq02_story_02" = "Agora durma bem, Ninny.";
"ap24_fq03_chat_01" = "Mamãe! Ela tem patas! Dá pra ver as patas dela!";
"ap24_fq03_chat_02" = "Esplêndido! E vai ser ainda melhor quando ela mostrar o focinho um dia.";
"ap24_fq03_chat_03" = "Eles pegavam maçãs. Era uma linda manhã de outono.";
"ap24_fq03_chat_04" = "Bom trabalho, Ninny!";
"ap24_fq03_chat_05" = "Ah, esse era o pote que usamos para dar as abelhas.";
"ap24_fq03_chat_06" = "Agora não precisamos mais levá-lo até o campo.";
"ap24_fq03_chat_07" = "Tô vendo as pernas dela!";
"ap24_fq04_chat_01" = "Agradeço demais a todos.";
"ap24_fq04_chat_02" = "Estamos felizes em ver mais de você hoje!";
"ap24_fq04_chat_03" = "Que bom que você começou a falar. Você conhece algum jogo legal?";
"ap24_fq04_chat_04" = "Não...";
"ap24_fq04_chat_05" = "... mas ouvi falar sobre jogos!";
"ap24_fq04_story_01" = "Naquela noite, Mãe Mumin fez um vestido rosa para Ninny e o deixou no sótão leste.";
"ap24_fq04_story_02" = "Ninny desceu para se juntar à família Mumin para o chá da manhã.";
"ap24_fq05_chat_01" = "Ninny aparecia só até o pescoço, restando apenas o rosto.";
"ap24_fq05_chat_02" = "Mumintroll ficou animado. Decidiu ensinar a Ninny todos os jogos que ele conhecia.";
"ap24_fq05_chat_03" = "Sobe aí, Ninny!";
"ap24_fq05_chat_04" = "Desculpe, não posso...";
"ap24_fq05_chat_05" = "Corre, corre, não consegue?";
"ap24_fq05_chat_06" = "Desculpa...";
"ap24_fq05_chat_07" = "Não consegue nem pular?";
"ap24_fq05_chat_08" = "Dava para ver que ela jogava apenas por educação, e não porque estava se divertindo.";
"ap24_fq05_chat_09" = "Eu sinto muito...";
"ap24_fq05_chat_10" = "Você acha que alguém gosta disso?";
"ap24_fq05_chat_11" = "Você não tem vida dentro de você?";
"ap24_fq05_chat_12" = "Quer um soco no nariz?";
"ap24_fq05_chat_13" = "Ela não sabe jogar...";
"ap24_fq05_chat_14" = "Ela não consegue ficar brava.";
"ap24_fq05_chat_15" = "Esse é o problema dela.";
"ap24_fq05_chat_16" = "Você nunca vai ter seu próprio rosto até aprender a brigar!";
"ap24_fq05_chat_17" = "Sim, claro.";
"ap24_fq06_chat_01" = "O que aconteceu com a Ninny?";
"ap24_fq06_chat_01b" = "Ela está com medo?";
"ap24_fq06_chat_02" = "Sim, a Ninny acha que o mar é grande demais.";
"ap24_fq06_chat_03" = "Olá.";
"ap24_fq06_chat_04" = "Como está a criança invisível?";
"ap24_fq06_chat_05" = "Só sobrou a cabeça.";
"ap24_fq06_chat_06" = "Você pode ajudar a gente com o barco?";
"ap24_fq06_chat_07" = "Nossa, como parece frio!";
"ap24_fq06_chat_08" = "Faz semanas que nada de emocionante acontece.";
"ap24_fq06_chat_09" = "Bom trabalho!";
"ap24_fq06_chat_10" = "Eu não teria feito melhor!";
"ap24_fq06_chat_11" = "Eu tô vendo ela, tô vendo ela!";
"ap24_fq06_chat_12" = "Nem pense em jogá-la naquele mar grande e terrível!";
"ap24_fq06_story_01" = "Os dias se passaram e Ninny ainda estava sem rosto.";
"ap24_fq06_story_02" = "Um dia, a família foi à praia recolher o barco para o inverno.";
"ap24_fq06_story_03" = "Quando avistaram o mar, Ninny parou de repente.";
"ap24_fq06_story_04" = "Pai Mumin teve uma ideia travessa e começou a se aproximar de fininho de Mãe Mumin.";
"ap24_fq06_story_05" = "Ele não queria empurrá-la na água de verdade, só queria fazer as crianças rirem um pouco.";
"ap24_name_little" = "Pequena My";
"ap24_name_moominmamma" = "Mãe Mumin";
"ap24_name_moominpappa" = "Pai Mumin";
"ap24_name_moomintroll" = "Mumintroll";
"ap24_name_ninny" = "Ninny";
"ap24_name_sniff" = "Sniff";
"ap24_name_snufkin" = "Snufkin";
"ap24_name_too_ticky" = "Too-ticky";
"ap24_side01_chat_01" = "É a noite certa para uma música.";
"ap24_side01_chat_02" = "Uma nova música.";
"ap24_side01_chat_03" = "Uma pitada de expectativa...";
"ap24_side01_chat_04" = "... duas pitadas de tristeza primaveril.";
"ap24_side01_chat_05" = "E, de resto,";
"ap24_side01_chat_06" = "só o grande prazer de estar só e gostar disso!";
"ap24_side02_chat_01" = "Sentamos exatamente assim na primavera.";
"ap24_side02_chat_02" = "Você se lembra?";
"ap24_side02_chat_03" = "Tínhamos acordado do sono de inverno e era o primeiro dia.";
"ap24_side02_chat_04" = "Todos os outros ainda estavam dormindo.";
"ap24_side02_chat_05" = "Você falou de planos.";
"ap24_side02_chat_06" = "Você tem algum?";
"ap24_side02_chat_07" = "É, tenho sim.";
"ap24_side02_chat_08" = "Mas é um plano meio solitário, sabe.";
"ap24_side02_chat_09" = "Você está pensando em ir embora.";
"ap24_side02_chat_10" = "Quando você vai?";
"ap24_side02_chat_11" = "Agora – neste momento!";
"ap24_side02_chat_12" = "Você vai ficar longe por muito tempo?";
"ap24_side02_chat_13" = "Não, estarei aqui de novo no primeiro dia da primavera, assobiando na sua janela.";
"ap24_side02_chat_14" = "Um ano passa bem rápido!";
"ap24_side03_chat_01" = "Você não é, por acaso – er – um pintor?";
"ap24_side03_chat_02" = "Ou talvez um poeta?";
"ap24_side03_chat_03" = "Eu sou tudo!";
"ap24_side03_chat_04" = "E, pelo que vejo, vocês são descobridores.";
"ap24_side03_chat_05" = "O que estão pensando em descobrir?";
"ap24_side03_chat_06" = "Ah, tudo!";
"ap24_side03_chat_07" = "Estrelas, por exemplo!";
"ap24_side03_chat_08" = "Estrelas!";
"ap24_side03_chat_09" = "Então vou com vocês.";
"ap24_side03_chat_10" = "Estrelas são minhas coisas preferidas.";
"ap24_side03_chat_11" = "Eu sempre deito e olho para elas antes de dormir...";
"ap24_side03_chat_12" = "... e fico imaginando quem está nelas.";
"ap24_side04_chat_01" = "Suspiro...";
"ap24_side04_chat_02" = "Você parece meio pra baixo.";
"ap24_side04_chat_03" = "Eu dei meu brinquedo preferido.";
"ap24_side04_chat_04" = "Pensei que seria bom fazer algo legal.";
"ap24_side04_chat_05" = "Ah. Tá se arrependendo?";
"ap24_side04_chat_06" = "É.";
"ap24_side04_chat_07" = "Você perdeu o brinquedo...";
"ap24_side04_chat_08" = "... mas talvez tenha ganhado mais do que pensa.";
"ap24_side06_chat_01" = "O segredo deles tem a ver com tempestades!";
"ap24_side06_chat_02" = "São as tempestades que eles sempre procuram e anseiam…";
"ap24_side06_chat_03" = "O que aconteceu comigo?";
"ap24_side06_chat_04" = "Não sou um hattifattener, sou o Pai Mumin...";
"ap24_side06_chat_05" = "O que estou fazendo aqui?";
"ap24_side06_chat_06" = "Estou indo para casa! Vou embora agora!";
"ap24_side07_story_01" = "Uma vez, o Pai Mumin foi embora sem a menor explicação.";
"ap24_side07_story_02" = "Ninguém sabia aonde ele tinha ido.";
"ap24_side07_story_03" = "Nunca na vida o Pai Mumin se sentira tão à vontade.";
"ap24_side07_story_04" = "Ele achou esplêndido ter a chance de não ter que dizer nada...";
"ap24_side07_story_05" = "... nem explicar qualquer coisa – para si mesmo ou para os outros.";
"ap24_side07_story_06" = "Ele poderia simplesmente sentar, olhar o horizonte...";
"ap24_side07_story_07" = "... e ouvir o barulho da água.";
"ap24_storybook_hint01" = "Deseja virar uma borboleta e viajar para o Vale dos Mumins?";
"ap24_storybook_hint02" = "Deseja explorar livremente o Vale dos Mumins como uma borboleta?";
"ap24_storybook_hint03" = "Deseja viajar para o Vale dos Mumins?";
