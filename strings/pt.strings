"ap26_chase_intro" = "Pegue o pássaro azul para revelar sua verdadeira natureza.";
"ap26_feather_hint" = "Uma pena azul! O pássaro deve estar por perto...";
"ap26_fetch01_fragment_intro_00" = "Pegue penas do pássaro azul para adicionar à comemoração!";
"ap26_fetch01_intro_00" = "\"Eu conheço um pássaro, azul como safira...";
"ap26_fetch01_intro_01" = "Seguir o Adolescente Desgrenhado Real até a Cidadela para procurar o Pássaro Azul?";
"ap26_fetch01_intro_02" = "... cujo chamado ressoa em festas luxuosas.\"";
"ap26_fetch01_outro_01" = "\"Um pássaro foi encontrado e suas penas eram azuis...";
"ap26_fetch01_outro_02" = "... mas ele desapareceu feito fumaça de vela.\"";
"ap26_fetch02_intro_00" = "\"Eu conheço um pássaro, azul como os olhos da minha mãe...";
"ap26_fetch02_intro_01" = "Seguir a Mãe Cintilante Nostálgica até os Arquivos do Relicário para procurar o Pássaro Azul?";
"ap26_fetch02_intro_02" = "... cujo chamado ecoa em nossas preciosas lembranças.\"";
"ap26_fetch02_mem_01" = "\"Querida neta, fizemos este balanço para você em nossa árvore preferida.\"";
"ap26_fetch02_mem_02" = "\"Olha o quanto você consegue ir alto agora!\"";
"ap26_fetch02_mem_03" = "\"Minha filha, é maravilhoso voltar para cá com você depois de tanto tempo.\"";
"ap26_fetch02_outro_02" = "... mas, quanto mais forte segurávamos, mais rápido desaparecia.\"";
"ap26_fetch03_hint_01" = "Talvez o pássaro queira ver vocês se apresentando juntos!";
"ap26_fetch03_hint_02" = "Mas você ainda não está com a roupa certa para uma apresentação...";
"ap26_fetch03_intro_00" = "\"Eu conheço um pássaro, azul como tecido índigo...";
"ap26_fetch03_intro_01" = "Seguir a Prima do Confete Fantasiada até o Deserto da Luz Estelar para procurar o Pássaro Azul?";
"ap26_fetch03_intro_02" = "... cujo chamado ressoa onde multidões se reúnem em admiração.";
"ap26_fetch03_outro_02" = "... mas se desenrolou como um fio solto.\"";
"ap26_fetch04_dialog_01" = "\"Esta floresta pacífica é o lar de muitos pássaros coloridos.\"";
"ap26_fetch04_dialog_02" = "\"Tenho certeza de que vamos encontrar o pássaro azul aqui!\"";
"ap26_fetch04_intro_00" = "\"Eu conheço um pássaro, azul como um rio cristalino...";
"ap26_fetch04_intro_01" = "Seguir o Pai Suplicante Lenhador até a Floresta Oculta para procurar o Pássaro Azul?";
"ap26_fetch04_intro_02" = "... cujo chamado reflete a harmonia pacífica da floresta.\"";
"ap26_fetch04_outro_01" = "\"Um pássaro foi encontrado e suas penas eram azuis...";
"ap26_fetch04_outro_02" = "... mas o vento o levou e apenas silêncio deixou.\"";
"ap26_fetch05_intro_00" = "\"Eu conheço um pássaro, azul como as estrelas...";
"ap26_fetch05_intro_01" = "Seguir o Avô Sábio Vidente para procurar o Pássaro Azul?";
"ap26_fetch05_intro_02" = "... cujo chamado faz soar as trombetas onde nascem grandes destinos\"";
"ap26_fetch05_outro_01" = "\"Um pássaro foi encontrado e suas penas eram azuis...";
"ap26_fetch05_outro_02" = "... mas, como um destino, ele não foi feito para ser simplesmente mantido.\"";
"ap26_fetch05_quest_01" = "\"Essas crianças conhecem seus destinos e estão prestes a nascer.\"";
"ap26_fetch05_quest_02" = "\"Outros precisam da ajuda do pássaro azul para dizer seu destino em voz alta.\"";
"ap26_fetch05_quest_03" = "\"Diga-me qual é o seu destino, criança.\"";
