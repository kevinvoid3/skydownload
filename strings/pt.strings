"ap31_fetch_letter_hint1" = "Entregue a carta de Vincent a Theo";
"ap31_flowertouch_hint1" = "Vá até o girassol de Theo";
"ap31_fq1_letter1_part1" = "Mal posso esperar o Natal.";
"ap31_fq1_letter1_part2" = "Dois anos atrás, fizemos aquela caminhada ao entardecer na neve...";
"ap31_fq1_letter1_part3" = "Você lembra?";
"ap31_fq1_letter1_part4" = "Quando vimos a lua nascer sobre Mariënhof?";
"ap31_fq1_letter2_part1" = "As palavras não conseguem expressar minha felicidade...";
"ap31_fq1_letter2_part2" = "... por ter voltado a desenhar!";
"ap31_fq1_letter2_part3" = "Eu já pensava nisso há muito tempo,";
"ap31_fq1_letter2_part4" = "... mas sempre achei que era impossível pra mim.";
"ap31_fq1_letter3_part1" = "Escavadores, semeadores, agricultores, homens e mulheres...";
"ap31_fq1_letter3_part2" = "Preciso desenhar sem parar.";
"ap31_fq1_letter3_part3" = "Tudo o que faz parte da vida no campo, devo observar e desenhar.";
"ap31_fq1_letter3_part4" = "Não me sinto mais tão indefeso diante da natureza quanto me sentia antes!";
"ap31_fq1_letter4_part1" = "A pintura vem mais naturalmente do que eu esperava.";
"ap31_fq1_letter4_part2" = "Talvez a melhor solução seja esta... colocar toda a minha energia na pintura?";
"ap31_fq1_letter4_part3" = "Preciso admitir...";
"ap31_fq1_letter4_part4" = "... Não tenho ideia.";
"ap31_fq1_letter5_part1" = "Ainda não fiquei totalmente sem dinheiro,";
"ap31_fq1_letter5_part2" = "mas não sobrou muito.";
"ap31_fq1_letter5_part3" = "Precisei investir muito em materiais de pintura.";
"ap31_fq1_letter5_part4" = "Espero que consiga me mandar alguma coisa em breve.";
"ap31_fq2_letter1_part1" = "Eu nem sabia o que eram os impressionistas,";
"ap31_fq2_letter1_part2" = "agora eu os conheci";
"ap31_fq2_letter1_part3" = "e, apesar de ainda não ser um deles,";
"ap31_fq2_letter1_part4" = "passei a admirar profundamente as obras de alguns impressionistas...";
"ap31_fq2_letter2_part1" = "Mandei alguns desenhos para você.";
"ap31_fq2_letter2_part2" = "Pode me dizer";
"ap31_fq2_letter2_part3" = "por que eles não vendem";
"ap31_fq2_letter2_part4" = "e o que devo fazer para criar pinturas que vendam?";
"ap31_fq2_letter3_part1" = "Espero melhorar a ponto";
"ap31_fq2_letter3_part2" = "de você mostrar meu trabalho";
"ap31_fq2_letter3_part3" = "com confiança,";
"ap31_fq2_letter3_part4" = "sem sentir vergonha.";
"ap31_fq3_letter1_part1" = "Quero fazer progressos reais este ano...";
"ap31_fq3_letter1_part2" = "... progresso,";
"ap31_fq3_letter1_part3" = "para falar a verdade,";
"ap31_fq3_letter1_part4" = "... me faz muita falta.";
"ap31_fq3_letter2_part1" = "Faço meus planos com tanto cuidado,";
"ap31_fq3_letter2_part2" = "mas ainda hoje descobri que, para os dez metros de tela, eu havia calculado perfeitamente";
"ap31_fq3_letter2_part3" = "todas as tintas... com uma exceção:";
"ap31_fq3_letter2_part4" = "o amarelo básico.";
"ap31_fq3_letter3_part1" = "Nunca tive tanta sorte porque a natureza deste lugar é extraordinariamente bonita.";
"ap31_fq3_letter3_part2" = "Tudo, em todos os lugares.";
"ap31_fq3_letter3_part3" = "O céu forma uma abóbada de azul magnífico, e o sol irradia um brilho de enxofre suave...";
"ap31_fq3_letter3_part4" = "... tão delicados e fascinantes quanto os tons celestiais de azul e amarelo nas obras de Vermeer de Delft.";
"ap31_fq3_letter3_part5" = "Não consigo pintar nada tão belo assim.";
"ap31_fq3_letter3_part6" = "Mas isso me fascina tanto que eu me deixo levar...";
"ap31_fq3_letter4_part1" = "Queria decorar a casa não só para mim, mas de um jeito que pudesse acomodar alguém mais.";
"ap31_fq3_letter4_part2" = "É claro que acabei gastando quase todo o dinheiro.";
"ap31_fq3_letter4_part3" = "Com o que restou, comprei doze cadeiras,";
"ap31_fq3_letter4_part4" = "um espelho";
"ap31_fq3_letter4_part5" = "e algumas coisas indispensáveis...";
"ap31_fq3_letter4_part6" = "... o que significa que, na semana que vem, finalmente poderei me mudar!";
"ap31_fq3_letter5_part1" = "Estou tão feliz com a casa e com o trabalho...";
"ap31_fq3_letter5_part2" = "... que ouso acreditar que essa felicidade não será só minha,";
"ap31_fq3_letter5_part3" = "que essa felicidade será compartilhada por você, com a sorte sorrindo ao seu lado!";
"ap31_fq3_letter6_part1" = "Vou ficar muito feliz por finalmente poder mobiliar minha casa, e isso certamente me dará forças para continuar.";
"ap31_fq4_letter1_part1" = "Eu ficaria tão feliz";
"ap31_fq4_letter1_part2" = "se você viesse nos visitar para conhecer Jo e o nosso bebê!";
"ap31_fq4_letter1_part3" = "Como comentamos anteriormente,";
"ap31_fq4_letter1_part4" = "decidimos dar a ele o seu nome.";
"ap31_fq4_letter2_part1" = "Você sabe o que eu espero quando me deixo sonhar?";
"ap31_fq4_letter2_part2" = "Que a família seja para você";
"ap31_fq4_letter2_part3" = "o que a natureza é para mim...";
"ap31_fq4_letter2_part4" = "... os torrões de terra, a grama, o trigo dourado, o camponês.";
"ap31_fq4_letter3_part1" = "Agora, esse horror de viver é menos intenso";
"ap31_fq4_letter3_part2" = "e a melancolia menos aguda.";
"ap31_fq4_letter3_part3" = "Mas não tenho motivação alguma... poucos desejos, se é que algum...";
"ap31_fq4_letter3_part4" = "... e quase nada do que compõe uma vida comum.";
"ap31_fq4_letter4_part1" = "Estou trabalhando sem parar no quarto,";
"ap31_fq4_letter4_part2" = "o que me faz bem";
"ap31_fq4_letter4_part3" = "e afasta, imagino,";
"ap31_fq4_letter4_part4" = "essas ideias anormais.";
"ap31_fq4_letter5_part1" = "Faz um mês e meio que não ponho os pés fora de casa...";
"ap31_fq4_letter5_part2" = "... nem mesmo no jardim.";
"ap31_fq4_letter5_part3" = "Na semana que vem,";
"ap31_fq4_letter5_part4" = "quando terminar as telas que estou fazendo,";
"ap31_fq4_letter5_part5" = "vou tentar.";
"ap31_fq4_letter6_part1" = "De tempos em tempos, até eu encontro amigos e coisas que amo.";
"ap31_fq4_letter6_part2" = "Consegue entender, então, que,";
"ap31_fq4_letter6_part3" = "apesar de achar meu sofrimento terrível,";
"ap31_fq4_letter6_part4" = "acabei criando aqui vínculos";
"ap31_fq4_letter6_part5" = "um tanto profundos demais?";
"ap31_fq4_letter7_part1" = "Pouco a pouco, começo a encarar a loucura como uma enfermidade, como qualquer outra.";
"ap31_fq4_letter7_part2" = "A troca de ambiente está me fazendo bem.";
"ap31_fq4_letter7_part3" = "O médico local acredita que o que passei foi semelhante a uma crise de epilepsia.";
"ap31_fq4_letter7_part4" = "Mas não procurei saber mais sobre isso.";
"ap31_fq5_date1" = "Seis meses depois";
"ap31_fq5_date2" = "Dois dias depois";
"ap31_fq5_letter1_part1" = "Além da criança,";
"ap31_fq5_letter1_part10" = "mostrá-lo e fazer com que seja apreciado";
"ap31_fq5_letter1_part11" = "o máximo possível.";
"ap31_fq5_letter1_part2" = "ele me deixou ainda outra tarefa:";
"ap31_fq5_letter1_part3" = "preservar intactos, para a criança,";
"ap31_fq5_letter1_part4" = "todos os tesouros que Theo e Vincent haviam reunido.";
"ap31_fq5_letter1_part5" = "Isso também é o meu trabalho.";
"ap31_fq5_letter1_part6" = "Toda a minha vida se passa em pensamentos com Theo e Vincent.";
"ap31_fq5_letter1_part7" = "Ah, o quanto a relação deles era infinitamente terna, doce e amorosa!";
"ap31_fq5_letter1_part8" = "O que sentiam um pelo outro... como se entendiam!";
"ap31_fq5_letter1_part9" = "o trabalho de Vincent,";
"ap31_fq6_diary_part1" = "Além da criança,";
"ap31_fq6_diary_part2" = "fui deixada com outra tarefa…";
"ap31_fq6_diary_part3" = "As pinturas de Vincent.";
"ap31_fq6_diary_part4" = "Devo mostrá-las.";
"ap31_fq6_diary_part5" = "Devo garantir que sejam apreciadas.";
"ap31_fq6_diary_part6" = "Estas pinturas são tesouros.";
"ap31_fq6_diary_part7" = "Elas não podem ser esquecidas.";
"ap31_fq6_diary_part8" = "O mundo deve lembrar quem ele foi.";
"ap31_fq6_endletter_1" = "Você não deve pensar que seu trabalho não tem valor.";
"ap31_fq6_endletter_2" = "Não perca a coragem. Dias melhores virão.";
"ap31_fq6_endletter_3" = "Você não está só... estou sempre pensando em você.";
"ap31_fq6_endletter_4" = "Um dia, as pessoas vão entender o que você está tentando fazer.";
"ap31_fq6_epilogue2_part1" = "Durante 10 anos, Vincent produziu mais de 800 obras";
"ap31_fq6_epilogue2_part2" = "e mais de 1.000 desenhos e rascunhos.";
"ap31_fq6_epilogue2_part3" = "Ele mal conseguiu vender alguns.";
"ap31_fq6_epilogue_part1" = "Johanna dedicou sua vida a trazer ao conhecimento público as centenas de obras de arte e cartas de Van Gogh que herdou.";
"ap31_fq6_epilogue_part2" = "Após 15 anos de persistência, uma exposição de Van Gogh foi realizada no Museu Stedelijk de Amsterdã.";
"ap31_fq6_epilogue_part3" = "Isso consolidou a reputação de Vincent como artista.";
"ap31_fq6_epilogue_part4" = "Até hoje, continua sendo a maior exposição de Van Gogh, com mais de 230 pinturas.";
