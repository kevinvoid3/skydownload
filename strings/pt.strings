"sf_art_01_00" = "Sky foi originalmente criado como uma sequência de Cloud (um jogo projetado antes da formação do estúdio thatgamecompany).\n\nSky começou a ser desenvolvido em 2012 com uma equipe de cerca de dez desenvolvedores em um escritório em Santa Mônica, Califórnia.";
"sf_art_01_01" = "A primeira imagem de Sky foi um impressionante rascunho a lápis de crianças voando juntas, suas almas entrelaçadas na forma de um pássaro mítico.\n(Esboço feito por Jenova Chen)";
"sf_art_01_02" = "The Giant, do artista norte-americano N.C. Wyeth, foi a principal inspiração para Sky no início.\n(The Giant feito por N.C. Wyeth)";
"sf_art_01_03" = "Os temas da história de O Pequeno Príncipe viraram uma referência no início do desenvolvimento.\n(Imagem de O Pequeno Príncipe, escrito por Antoine de Saint-Exupéry)";
"sf_art_01_04" = "O documentário Migração Alada nos informou sobre as diferentes condições enfrentadas por pássaros que voam longas distâncias.\n(Dirigido por Jacques Perrin, Jacques Cluzaud, Michel Debats)";
"sf_art_02_01" = "O \"Efeito Perspectiva\" foi um vídeo impactante compartilhado por astronautas da estação espacial, que falaram sobre o sentimento de admiração que sentiam ao contemplar a Terra. Isso inspirou uma pintura inicial na pré-produção.\n(Arte feita por Jenova Chen)";
"sf_art_03_00" = "Durante nossa exploração de arte inicial, os primeiros esboços foram baseados na ideia de uma criança voando para encontrar os gigantes no céu.\n\nDurante este período, pintamos diferentes ilhas sobre as quais você poderia planar.";
"sf_art_03_01" = "Essas pinturas tinham uma qualidade fantasiosa e infantil única.\n(Arte feita por Jacky Ke Jiang)";
"sf_art_03_02" = "Nós imaginamos um caminho de almas que encontravam gigantes e criaturas fantásticas entre as nuvens.\n(Arte feita por Jacky Ke Jiang)";
"sf_art_03_03" = "A liberdade e a sensação de planar sobre ilhas cheias de grama e oceanos se tornaram um objetivo vital de desenvolvimento.\n(Arte feita por Yuichiro Tanabe)";
"sf_art_03_04" = "(Obra de arte de Yuichiro Tanabe)";
"sf_art_03_05" = "(Obra de arte de Tiffany Hayashi, Yuichiro Tanabe)";
"sf_art_04_00" = "Nossa equipe percebeu que o tema de \"conexão\" seria um elemento central da jogabilidade. Fizemos um protótipo para testar diferentes formas de conexão, incluindo uma opção para os jogadores segurarem as mãos uns dos outros. Esse teste de jogo virou um marco significativo no desenvolvimento do jogo.";
"sf_art_04_01" = "(Obra de arte de Yuichiro Tanabe, Jacky Ke Jiang)";
"sf_art_05_01" = "(Obra de arte de Tom Zhao)";
"sf_art_05_02" = "(Obra de arte de Tom Zhao)";
"sf_art_05_03" = "(Obra de arte de Tom Zhao)";
"sf_art_06_00" = "Os pilares principais do jogo – Maravilhamento, Humanidade e Comunidade – viraram nossa maneira de transmitir a arte, o design e a história. Se algo não se encaixasse nesse pilares, talvez não fosse crucial para Sky.";
"sf_art_06_01" = "MARAVILHAMENTO. Há segurança em seu centro, mas escuridão para todos os lados.\n(Arte feita por Tom Zhao)";
"sf_art_06_02" = "HUMANIDADE. Os momentos ficam melhores na companhia de outros jogadores.\n(Arte feita por Tom Zhao)";
"sf_art_06_03" = "COMUNIDADE. Um sentimento de que você pertence a um coletivo global que defende a compaixão e o altruísmo.\n(Arte feita por Tom Zhao)";
"sf_art_07_00" = "Esta área apresenta as primeiras artes dos territórios do reino e as ideias ilustradas do arco emocional.";
"sf_art_07_01" = "Conceito da Ilha do Alvorecer\n(Arte feita por Yuichiro Tanabe)";
"sf_art_07_02" = "Conceito da Campina da Aurora\n(Arte feita por Tom Zhao)";
"sf_art_07_03" = "Conceito da Floresta Oculta\n(Arte feita por Tom Zhao)";
"sf_art_07_04" = "Conceito do Vale do Triunfo\n(Arte feita por Tom Zhao)";
"sf_art_07_05" = "Conceito do Sertão Dourado\n(Arte feita por Khang Le)";
"sf_art_07_06" = "Conceito do Relicário do Conhecimento\n(Arte feita por Jacky Ke Jiang)";
"sf_art_07_07" = "Conceito do Olho de Éden\n(Arte feita por Trevor Stringer)";
"sf_art_07_08" = "Conceito da Morte\n(Arte feita por Tom Zhao)";
"sf_art_07_09" = "Conceito da Órbita\n(Arte feita por Tom Zhao)";
"sf_art_08_00" = "Nos estágios iniciais, \"guardiões animais\" foram esboçados como figuras míticas que protegiam seus reinos. Eles evoluíram lentamente para os personagens humanoides de ancestrais-anciões que reconhecemos como sendo essenciais para a ascensão e a queda do reino.";
"sf_art_08_01" = "Juntos, eles foram liderados por um Governante que, por fim, se sacrificou para a criação de uma nova geração de filhos da luz.\n(Arte feita por Jacky Ke Jiang)";
"sf_art_08_02" = "ILHA DO ALVORECER - SABEDORIA\n(Arte feita por Tom Zhao)";
"sf_art_08_03" = "CAMPINA DA AURORA - EMPATIA\n(Arte feita por Tom Zhao)";
"sf_art_08_04" = "FLORESTA OCULTA - RESILIÊNCIA\n(Arte feita por Tom Zhao)";
"sf_art_09_00" = "A equipe de arte explorou os momentos narrativos fundamentais em que cada Ancestral se encontraria com as crianças de Sky... e qual seria a maneira mais impactante de capturar isso visualmente?";
"sf_art_09_01" = "VALE DO TRIUNFO - EXCELÊNCIA\n(Arte feita por Tom Zhao)";
"sf_art_09_02" = "SERTÃO DOURADO - CORAGEM\n(Arte feita por Tom Zhao)";
"sf_art_09_03" = "RELICÁRIO DO CONHECIMENTO - FÉ\n(Arte feita por Tom Zhao)";
"sf_art_09_04" = "O GOVERNANTE - SACRIFÍCIO\n(Arte feita por Khang Le)";
"sf_art_10_01" = "Ao desenvolver o contexto da história, esboçamos o possível propósito de vida dos habitantes da civilização.\n(Esboço feito por Yuichiro Tanabe)";
"sf_art_10_02" = "(Esboço de Yuichiro Tanabe)";
"sf_art_10_03" = "(Esboço de Yuichiro Tanabe)";
"sf_art_10_04" = "Começou com aldeões em cada reino que adoravam o ciclo da alma como parte da convivência entre humanidade e natureza.\n(Esboço feito por Yuichiro Tanabe)";
"sf_art_10_05" = "(Esboço de Yuichiro Tanabe)";
"sf_art_10_06" = "(Obra de arte de Jacky Ke Jiang, Tom Zhao)";
"sf_art_11_00" = "Os Espíritos Ancestrais forneceram uma visão das civilizações passadas. Suas lembranças oferecem textura significativa e dão um sabor único a cada reino, com camadas de conhecimento e descobertas em cada canto.";
"sf_art_11_01" = "ILHA DO ALVORECER\n(Arte feita por Yuichiro Tanabe)";
"sf_art_11_02" = "CAMPINA DA AURORA\n(Arte feita por Yuichiro Tanabe)";
"sf_art_11_03" = "FLORESTA OCULTA\n(Arte feita por Yuichiro Tanabe)";
"sf_art_11_04" = "VALE DO TRIUNFO\n(Arte feita por Yuichiro Tanabe)";
"sf_art_11_05" = "SERTÃO DOURADO\n(Arte feita por Yuichiro Tanabe)";
"sf_art_11_06" = "RELICÁRIO DO CONHECIMENTO\n(Arte feita por Yuichiro Tanabe)";
"sf_art_12_00" = "Um ecossistema mais amplo, envolvendo as constelações e o ciclo de vida, foi considerado mais cuidadosamente enquanto projetávamos as criaturas. Plantamos pistas de como a luz e o vazio as impactaram historicamente no mundo.";
"sf_art_12_01" = "Essas criaturas majestosas guiavam a luz de volta às estrelas. Nós as projetamos para se moverem de forma elegante, como criaturas marinhas nadando entre as nuvens.\n(Arte feita por Yuichiro Tanabe)";
"sf_art_12_02" = "A equipe de arte começou inicialmente com um formato de peixe, mas evoluiu sua forma para arraias em iterações posteriores.n\\\\(Arte feita por Tom Zhao)";
"sf_art_13_00" = "Ao visualizar o vazio como contadores de histórias, apresentamos seu impacto de forma neutra e celebramos tanto as formas de vida de luz quanto as das trevas pela própria beleza.\nAo honrar igualmente ambos os lados de sua existência, somos capazes de tecer um mundo mais rico.";
"sf_art_13_01" = "Começamos a experimentar cores e formas que poderiam expressar emoções ao encontrar a escuridão e o vazio.\n(Arte feita por Khang Le)";
"sf_art_13_02" = "Nessas artes, formas de vida corrompidas pelo vazio são representadas como Águas Sombrias, Plantas/Flores Sombrias, Caranguejos Sombrios e Dragões Sombrios.\n(Arte feita por Tom Zhao)";
"sf_art_14_00" = "Conforme o mundo de Sky passava por várias iterações, mantivemos o visual do avatar aberto e maleável.\nQuando começamos a projetar personagens em grupo, consideramos a harmonia estética deles na tela.";
"sf_art_14_01" = "(Obra de arte de Jacky Ke Jiang)";
"sf_art_14_02" = "(Obra de arte de Yuichiro Tanabe)";
"sf_art_14_03" = "(Obra de arte de Jacky Ke Jiang)";
"sf_art_14_04" = "(Obra de arte de Jacky Ke Jiang)";
"sf_art_14_05" = "(Obra de arte de Yuichiro Tanabe)";
"sf_art_15_00" = "O objetivo era fazer com que os avatares das crianças de Sky representassem todos os tipo de jogadores.\nEm vez de um rosto, colocamos máscaras para que você possa escolher a própria expressão e aparência.";
"sf_art_15_01" = "Embora tenha sido esboçada em 2015, esta imagem em grupo prenunciou a evolução artística de Sky antes que as temporadas da aventura começassem.\n(Arte feita por Yuichiro Tanabe)";
"sf_hist_02_00" = "A Sony Computer Entertainment se ofereceu a publicar três jogos que incluíam flOw, Flower e Journey.\n\nTodos os títulos redefiniram as possibilidades de jogabilidade de forma inovadora, acessível e impulsionada por uma abordagem positiva.";
"sf_hist_03_00" = "Movidos pelo reconhecimento de 'Jogo do Ano' de Journey e sua capacidade de conectar jogadores globalmente, o estúdio buscou enfatizar temas de gratidão e comunidade para o próximo projeto.\n\nIsso foi o ponto de partida para expandir para plataformas móveis e alcançar mais público, e para desenvolver o título autopublicado, Sky.";
"sf_hist_03_01" = "Explorando o design do jogo";
"sf_hist_03_02" = "Criação de ideias de narrativa e animação";
"sf_hist_03_03" = "Trabalhando em um novo conceito de design";
"sf_hist_03_04" = "Planejamento de arte";
"sf_hist_04_00" = "Durante os primeiros anos do desenvolvimento, o estúdio iterou por meio da exploração e da descoberta lúdica. O salto para o desenvolvimento móvel, jogo gratuito para começar e a autopublicação de um título com operações ao vivo desafiaram a equipe e estenderam o cronograma de produção.";
"sf_hist_04_01" = "Experimentando com design de som";
"sf_hist_04_02" = "Discussão sobre arte de ambientes";
"sf_hist_04_05" = "A equipe de arte estudou muitos formatos de nuvens e seus comportamentos para projetar um mundo no céu.";
"sf_hist_04_06" = "A inspiração veio das diferentes emoções que as nuvens transmitiam em diferentes momentos do dia.";
"sf_hist_04_07" = "Um protótipo inicial para testes.";
"sf_hist_04_08" = "Foram feitos vários protótipos para ajudar no planejamento das tecnologias e do motor de jogo necessários para paisagens de nuvens e voos.";
"sf_hist_04_09" = "Ficou evidente que, uma vez entre as nuvens, teríamos que contar com elas como plano de fundo emocional e cenário.";
"sf_hist_04_10" = "Apresentação de ambientes familiares.";
"sf_hist_04_11" = "O mundo humano em Sky.";
"sf_hist_04_12" = "Silhueta sobre o horizonte da cidade humana para testar o voo.";
"sf_hist_04_13" = "Testes iniciais do jogador no mundo de Sky.";
"sf_hist_04_14" = "Outro exemplo do avatar do jogador sem capa.";
"sf_hist_04_15" = "A equipe decidiu por este design inicial na Campina como um exemplo de avatar com um anel de energia para mostrar o poder de voo.";
"sf_hist_05_01" = "Primeiros teasers visuais de Sky";
"sf_hist_06_00" = "Durante o outono de 2017, Sky foi oficialmente revelado no Evento Especial da Apple em Cupertino, Califórnia. Estreou na App Store para iPhone e iPad.\n\nO jogo entrou em fase de testes de beta fechado até 2019, quando foi lançado em 18 de julho.";
"sf_hist_06_03" = "Cada temporada foi preenchida com jogabilidade nova, histórias, personagens, expressões e itens.";
"sf_hist_06_04" = "Os três primeiros lançamentos foram: Temporada da Gratidão, Temporada dos Caçadores de Luz e Temporada do Pertencer.";
"sf_hist_06_05" = "BASTIDORES: o estúdio se uniu jogando pingue-pongue, videogames, fazendo e presenteando velas de cera de verdade uns para os outros, assistindo a filmes e participando de viagens de pesquisa à Disneylândia. 🕯️";
"sf_hist_07_00" = "Em 2020, Sky lançou quatro novas temporadas de aventura, além de ser lançado na loja Google Play.";
"sf_hist_07_05" = "BASTIDORES: duas dessas temporadas poderiam ter sido lançadas com nomes completamente diferentes... Você consegue adivinhar a quais temporadas elas se referem?\n\nTemporada de: Encontros, Despertar, Origens\nTemporada de: Caminhadas, Radiância, Migração\n\n🕯️";
"sf_hist_08_00" = "Em julho de 2020, o jogo celebrou seu primeiro aniversário. Na época, também testemunhou o mundo sendo gravemente impactado pela pandemia de COVID-19.";
"sf_hist_08_01" = "Primeiro aniversário de Sky\n\nAtravés da iniciativa especial 'Pacote de Cura', a thatgamecompany lançou a primeira campanha sem fins lucrativos de Sky para ajudar trabalhadores da linha de frente através dos Médicos Sem Fronteiras. Graças à comunidade, mais de 1 milhão de dólares foram arrecadados.";
"sf_hist_09_00" = "Como parte de cada temporada da aventura em 2021, Sky teve expansões contínuas por todo o reino, onde novos recursos, histórias mais profundas, dinâmicas multijogador e jogabilidade única foram introduzidos.";
"sf_hist_09_03" = "Temporada do Pequeno Príncipe\n\nJuntamente com o segundo aniversário do jogo e a expansão para o Nintendo Switch, Sky também recebeu sua primeira colaboração de propriedade intelectual com Olivier d'Agay e Antoine de Saint-Exupéry com o amado O Pequeno Príncipe.";
"sf_hist_09_05" = "BASTIDORES: você sabia...?\n\nTemporada dos Sonhos: alguns outros personagens que consideramos incluir foram um dono de cafeteria, um artista cuspidor de fogo e um harpista.";
"sf_hist_09_06" = "BASTIDORES: na Temporada do Pequeno Príncipe, os poemas da Rosa originalmente não faziam parte da escrita e do projeto narrativo.\n\nSua inclusão foi adicionada no meio da produção e trouxe mais profundidade à temporada.";
"sf_hist_10_00" = "Em 2021, a exibição Smithsonian FUTURES e o evento Barbican Virtual Realms destacaram os projetos criativos de Sky e da thatgamecompany aos participantes.";
"sf_hist_10_01" = "Exibição Smithsonian FUTURES em 2021, Washington DC";
"sf_hist_10_02" = "Mostra de Sky na exibição Smithsonian FUTURES";
"sf_hist_10_03" = "Sky reimaginado no evento Barbican Virtual Realms em 2021, Londres";
"sf_hist_11_00" = "Em 2022, Sky foi lançado no Sony PlayStation, aumentando ainda mais a comunidade de Sky.\n\nDurante esse ano, as temporadas da aventura introduziram novas habilidades para os jogadores e o estúdio anunciou que um projeto de animação de Sky estava em produção.";
"sf_hist_11_04" = "A colaboração de Sky com a artista musical internacionalmente amada, AURORA, introduziu novas tecnologias para dar vida à sua música no jogo. Esta temporada apoiou um show simultâneo ao vivo, diferente de qualquer outro já visto.";
"sf_hist_11_05" = "BASTIDORES: a equipe lançou o primeiro 'Encontro de Sky' em Long Beach, Califórnia.\n\nAqui, os jogadores de Sky celebraram o evento com várias festividades, encontrando-se pessoalmente para jogar e fazendo novas amizades.";
"sf_hist_12_00" = "À medida que Sky crescia, também cresciam as equipes de desenvolvimento e publicação do estúdio, a fim de evoluir o jogo e suas parcerias.";
"sf_hist_12_01" = "Sky comemorou seu terceiro aniversário.";
"sf_hist_12_02" = "Graças ao generoso apoio dos jogadores, a colaboração sem fins lucrativos da equipe com o The Trevor Project entrou em seu segundo ano e arrecadou mais de $680.000 dólares no total.";
"sf_hist_13_00" = "A equipe de Sky e a thatgamecompany se concentraram em abrir novos caminhos em preparação para o quarto aniversário.\n\nQuatro novas temporadas foram desenvolvidas e lançadas neste ano.";
"sf_hist_13_05" = "Desde 2021, a comunidade de Sky arrecadou mais de 1,84 milhão de dólares para o The Ocean Cleanup.\n\nSua missão é pesquisar, extrair e monitorar a poluição de plástico nos oceanos e rios globalmente.";
"sf_hist_14_00" = "Sky tentou estabelecer um novo recorde mundial do Guinness de \"Maior número de usuários em um mundo virtual com tema de show\" durante sua participação na Gamescom.";
"sf_hist_14_01" = "O evento do Guinness World Record foi um grande sucesso. Não só Sky quebrou o recorde, mas o fez hospedando mais de 10.000 usuários simultâneos no mesmo servidor.";
"sf_hist_15_00" = "Sky vai honrar seu quinto aniversário com estilo enquanto o estúdio realiza um evento de dois dias em Tóquio, Japão. Nossos jogadores globais aqui no jogo também nos ajudarão a comemorar.";
"sf_hist_15_01" = "A parceria da Temporada do Cervo de Nove Cores traz um conto belíssimo e um elenco de personagens deslumbrantes para o reino de Sky.";
"sf_hist_15_02" = "Publicado neste verão, o livro “A Arte de Sky” faz uma retrospectiva da fase de desenvolvimento de sete anos do jogo (2012-2019).";
"sf_hist_15_03" = "Mais recentemente, a equipe também lançou a Temporada do Ninho.";
