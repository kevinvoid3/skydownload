"samantha_ann_text1" = "Aham, eu tenho um anúncio muito importante!";
"samantha_ann_text2" = "Ai minha nossa!";
"samantha_ann_text3" = "Agora, falando sério, obrigada, do fundo do coração, por tornarem a comunidade Sky inclusiva e calorosa!";
"samantha_ann_text4" = "Alguém viu meus outros dois camarões? Eles caíram do meu sobretudo no caminho pra cá.";
"samk_ann_text1" = "Oi, meu nome é Sam! Encontrei alguém cheio de mistério enquanto estava explorando! Dê um oi!!";
"samk_ann_text2" = "Não fala muito, mas tem uma música mágica pra compartilhar.";
"samk_ann_text3" = "Vamos para mais uma aventura! A gente se vê por aí!";
"samk_ann_text4" = "Ah, olha só aquelas ovelhas de origem ali. Tá na hora de elas brilharem!";
"samk_ann_text5" = "E aí. Já parou pra pensar no que são as estrelas?";
"samk_ann_text6" = "São emissoras de partículas ligadas ao jogador. Então, quando o jogador se mexe, as estrelas também se mexem!";
"samk_ann_text7" = "Olá. Sou eu, Charley. Você sabe que nada disso é real, né? Não se alinha com a construção do mundo de Sky e não sei onde Sam encontrou aquele espírito flutuante.";
