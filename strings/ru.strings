"ap26_chase_intro" = "Поймайте синюю птицу и раскройте её истинную природу.";
"ap26_feather_hint" = "Синее перо! Птица должна быть неподалёку...";
"ap26_fetch01_fragment_intro_00" = "Собирайте перья синей птицы, чтобы устроить грандиозный праздник!";
"ap26_fetch01_intro_00" = "«Я знаю птицу, цвет которой прекраснее сапфира...";
"ap26_fetch01_intro_01" = "Последовать за королевским Косматым подростком к цитадели, чтобы найти синюю птицу?";
"ap26_fetch01_intro_02" = "...её голос звенит на роскошных пирах».";
"ap26_fetch01_outro_01" = "«Птица нашлась, и её перья были самыми синими...";
"ap26_fetch01_outro_02" = "...а потом она исчезла, как дымок от свечи».";
"ap26_fetch02_intro_00" = "«Я знаю птицу, цвет её перьев — как глаза моей мамы...";
"ap26_fetch02_intro_01" = "Последовать за вспоминающим Блестящем родителем к Архиву хранилища, чтобы найти синюю птицу?";
"ap26_fetch02_intro_02" = "... а её песнь возвращает к жизни самые дорогие моменты».";
"ap26_fetch02_mem_01" = "«Милая внучка, мы сделали качели на твоём любимом дереве».";
"ap26_fetch02_mem_02" = "«Давай посмотрим, как высоко ты сможешь взлететь!»";
"ap26_fetch02_mem_03" = "«Моё милое дитя, как же прекрасно вновь вернуться сюда с тобой».";
"ap26_fetch02_outro_02" = "...но чем сильнее мы пытались ее удержать, тем быстрее она исчезала».";
"ap26_fetch03_hint_01" = "Возможно, птица захочет увидеть ваше совместное выступление!";
"ap26_fetch03_hint_02" = "Но вы ещё не одеты для выступления...";
"ap26_fetch03_intro_00" = "«Я знаю птицу, синюю, как лоскут цвета индиго...";
"ap26_fetch03_intro_01" = "Последовать за наряженным Конфетти-кузеном в Звёздную пустыню, чтобы найти синюю птицу?";
"ap26_fetch03_intro_02" = "...чья песня звучит там, где толпы приходят в восторг.";
"ap26_fetch03_outro_02" = "...но она ускользала, как нить размотавшегося клубка».";
"ap26_fetch04_dialog_01" = "«Мирный лес стал домом самых разных птиц».";
"ap26_fetch04_dialog_02" = "«Здесь обязательно найдётся наша птица!»";
"ap26_fetch04_intro_00" = "«Я знаю птицу синее, чем чистейшая вода...";
"ap26_fetch04_intro_01" = "Проследовать за рубящим лес Умоляющим родителем в Тайный лес, чтобы найти синюю птицу?";
"ap26_fetch04_intro_02" = "...чей голос вторит гармонии лесов».";
"ap26_fetch04_outro_01" = "«Птица нашлась, и её перья были самыми синими...";
"ap26_fetch04_outro_02" = "...но она испарилась, оставив лишь тишину».";
"ap26_fetch05_intro_00" = "«Я знаю птицу синее, чем звёздное небо...";
"ap26_fetch05_intro_01" = "Проследовать за предвидящим Мудрым дедушкой, чтобы найти синюю птицу?";
"ap26_fetch05_intro_02" = "...чей голос звенит там, где рождаются судьбы».";
"ap26_fetch05_outro_01" = "«Птица нашлась, и её перья были самыми синими...";
"ap26_fetch05_outro_02" = "...но её, как и нить судьбы, никто не смог ухватить».";
"ap26_fetch05_quest_01" = "«Это дитя знает своё предназначение и готово появиться на свет».";
"ap26_fetch05_quest_02" = "«Другим нужна помощь синей птицы, чтобы услышать голос судьбы».";
"ap26_fetch05_quest_03" = "«Расскажи мне свою судьбу, дитя».";
"ap26_fetch05_quest_04" = "«Я хочу разбить садик и выращивать красоту!»";
"ap26_fetch05_quest_05" = "«Я появлюсь на свет и изобрету машины, что лечат людей!»";
"ap26_fetch05_quest_06" = "«Я буду петь песни, которые подарят надежду тем, кто её потерял!»";
"ap26_fetch05_quest_07" = "«Узнать свою судьбу — это только начало...»";
"ap26_fetch06_quest_01" = "Что вы цените больше, чем богатства?";
"ap26_fetch06_quest_02" = "Какие воспоминания заставляют вас идти вперёд?";
"ap26_fetch06_quest_03" = "Когда смотритесь в зеркало, кого вы в нём видите?";
"ap26_fetch06_quest_04" = "Почему мы сами нарушаем свою гармонию?";
"ap26_fetch06_quest_05" = "Сколько вы будете ждать, прежде чем отправитесь навстречу судьбе?";
"ap26_fetch06_quest_06" = "«Где твоя синяя птица?»";
