"ap24_credits_01" = "Спасибо за ваше участие";
"ap24_credits_02" = "в сезоне Муми-троллей";
"ap24_credits_03" = "По мотивам \"Дитя-невидимка\"";
"ap24_credits_04" = "Туве Янссон";
"ap24_credits_05" = "Включая избранные эпизоды из книг";
"ap24_credits_06" = "\"Муми-тролль и комета\"";
"ap24_credits_07" = "\"Шляпа волшебника\"";
"ap24_credits_08" = "и сборник рассказов \"Дитя-невидимка\"";
"ap24_fq01_chat_01" = "Я веду тебя в твой новый дом.";
"ap24_fq01_chat_02" = "Пойдём скорее!";
"ap24_fq01_chat_03" = "Почти добрались.";
"ap24_fq01_chat_04" = "Пойдём скорее!";
"ap24_fq01_chat_05" = "Кого ты привела?";
"ap24_fq01_chat_06" = "Малютку зовут Нинни.";
"ap24_fq01_chat_07" = "Она была напугала тетенькой, которая взяла малютку на свое попечение, хотя и не любила ее,";
"ap24_fq01_chat_08" = "вот малышка и стала невидимкой.";
"ap24_fq01_chat_09" = "Я встретила эту тетю, она ужасная - холодная как лед и ироничная.";
"ap24_fq01_chat_10" = "Тьфу, как противно!";
"ap24_fq01_chat_11" = "Если тебя часто пугают, то легко захотеть стать невидимкой.";
"ap24_fq01_chat_12" = "Дайте малютке стул.";
"ap24_fq01_chat_13" = "Вот твоя новая семья!";
"ap24_fq01_story_01" = "Одним дождливым вечером некто вёл дитя-невидимку по Долине муми-троллей.";
"ap24_fq01_story_02" = "Фигурка называлась «Туу-тикки».";
"ap24_fq01_story_03" = "Возможно, друзья помогут малышке перестать быть невидимкой.";
"ap24_fq02_chat_01" = "Спи вволю, столко, сколько сможешь. Я утром оставлю для тебя чайник под грелкой.";
"ap24_fq02_story_01" = "Серебрянный колокольчик прозвучал вслед за Муми-мамой по лестнице.";
"ap24_fq02_story_02" = "Теперь, Нинни, спи.";
"ap24_fq03_chat_01" = "Мама! У нее появились лапки! Теперь их видно!";
"ap24_fq03_chat_02" = "Отлично! А еще лучше будет, когда она предъявит нам свою мордашку.";
"ap24_fq03_chat_03" = "Стояло прекрасное осеннее утро. Все собирали яблоки.";
"ap24_fq03_chat_04" = "Отлично, Нинни!";
"ap24_fq03_chat_05" = "Это та самая банка, которую мы всегда отдаем шмелям.";
"ap24_fq03_chat_06" = "Теперь нам не придется тащить ее на луг.";
"ap24_fq03_chat_07" = "Я вижу ее ножки!";
"ap24_fq04_chat_01" = "Большое спасибо!";
"ap24_fq04_chat_02" = "Так приятно, что тебя сегодня видно гораздо лучше!";
"ap24_fq04_chat_03" = "Хорошо, что ты начала болтать. Знаешь какие-нибудь интересные игры?";
"ap24_fq04_chat_04" = "Нет,";
"ap24_fq04_chat_05" = "но я слышала, что некоторые умеют играть.";
"ap24_fq04_story_01" = "Вечером Муми-мама сшила для Нинни пунцовое платьице и отнесла его в восточную мансарду.";
"ap24_fq04_story_02" = "Нинни спустилась, чтобы присоединиться к утреннему чаепитию.";
"ap24_fq05_chat_01" = "Нинни была видна до самой шейки, и только лицо по прежнему оставалось невидимым.";
"ap24_fq05_chat_02" = "Муми-тролль был в восторге. Он решил научить Нинни всем играм, какие только знал сам.";
"ap24_fq05_chat_03" = "Залезай, Нинни!";
"ap24_fq05_chat_04" = "Простите, я не умею...";
"ap24_fq05_chat_05" = "Ну беги же!";
"ap24_fq05_chat_06" = "Простите...";
"ap24_fq05_chat_07" = "Выходит, ты даже прыгать не умеешь?";
"ap24_fq05_chat_08" = "Все совершенно определенно понимали, что играла она из вежливости, а не ради забавы.";
"ap24_fq05_chat_09" = "Извините меня...";
"ap24_fq05_chat_10" = "Ты что, ждешь, пока тебя похвалят, а?";
"ap24_fq05_chat_11" = "Чего ты такая дохлая?";
"ap24_fq05_chat_12" = "Хочешь, чтобы я тебя поколотила, а?";
"ap24_fq05_chat_13" = "Она не умеет играть...";
"ap24_fq05_chat_14" = "Она не умеет злиться.";
"ap24_fq05_chat_15" = "Это ее главный недостаток.";
"ap24_fq05_chat_16" = "У тебя никогда не будет собственного лица, пока ты не научишься драться!";
"ap24_fq05_chat_17" = "Ладно.";
"ap24_fq06_chat_01" = "Что это с Нинни?";
"ap24_fq06_chat_01b" = "Она чего-то испугалась?";
"ap24_fq06_chat_02" = "Да, Нинни видит море впервые и думает, что оно слишком большое.";
"ap24_fq06_chat_03" = "Привет!";
"ap24_fq06_chat_04" = "Как поживает дитя-невидимка?";
"ap24_fq06_chat_05" = "Не хватает только мордочки.";
"ap24_fq06_chat_06" = "Поможешь с лодкой?";
"ap24_fq06_chat_07" = "Ух, какой холодной кажется вода.";
"ap24_fq06_chat_08" = "В течение следующих недель не происходило ничего значимого.";
"ap24_fq06_chat_09" = "Браво, браво!";
"ap24_fq06_chat_10" = "Я сама бы лучше не сделала!";
"ap24_fq06_chat_11" = "Она больше не невидимка!";
"ap24_fq06_chat_12" = "Не смей толкать ее в это огромное, жуткое море!";
"ap24_fq06_story_01" = "Дни шли, а у Нинни по-прежнему не было лица.";
"ap24_fq06_story_02" = "В один день все семейство отправилось на пляж, чтобы вытащить на берег лодку.";
"ap24_fq06_story_03" = "Когда они спустились к морю, Нинни внезапно остановилась.";
"ap24_fq06_story_04" = "У Муми-папы появилась коварная идея и он начал подкрадываться к Муми-маме.";
"ap24_fq06_story_05" = "На самом деле он не хотел столкнуть ее в воду, лишь немного развлечь детей.";
"ap24_name_little" = "Малышка Мю";
"ap24_name_moominmamma" = "Муми-мама";
"ap24_name_moominpappa" = "Муми-папа";
"ap24_name_moomintroll" = "Муми-тролль";
