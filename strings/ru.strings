"ap11_fetch_05_outro_06" = "Узнает ли он когда-нибудь?..";
"ap11_fetch_05_reflect_01" = "Надо было судить не по словам, а по делам...";
"ap11_fetch_05_reflect_02" = "а по делам.";
"ap11_fetch_05_reflect_04" = "Думаешь, я в ответе за мою розу,";
