"ap31_fetch_letter_hint1" = "Доставьте письмо Винсента Тео";
"ap31_flowertouch_hint1" = "Подойдите к подсолнуху Тео";
"ap31_fq1_letter1_part1" = "Я уже с нетерпением жду Рождества.";
"ap31_fq1_letter1_part2" = "Два года назад мы гуляли тем снежным вечером —";
"ap31_fq1_letter1_part3" = "ты ещё помнишь?";
"ap31_fq1_letter1_part4" = "Когда мы увидели луну, поднимающуюся над Мариенхофом?";
"ap31_fq1_letter2_part1" = "Словами не выразить, как я счастлив...";
"ap31_fq1_letter2_part2" = "...снова заняться рисованием!";
"ap31_fq1_letter2_part3" = "Я давно об этом думал,";
"ap31_fq1_letter2_part4" = "но всегда считал это невозможным и недостижимым.";
"ap31_fq1_letter3_part1" = "Землекопов, сеятелей, пахарей, мужчин и женщин —";
"ap31_fq1_letter3_part2" = "я должен рисовать их всех без устали.";
"ap31_fq1_letter3_part3" = "Всё, что относится к сельской жизни, я должен изучать и изображать.";
"ap31_fq1_letter3_part4" = "Я больше не чувствую себя таким беспомощным перед природой, как прежде!";
"ap31_fq1_letter4_part1" = "Живопись даётся мне гораздо естественнее, чем я ожидал.";
"ap31_fq1_letter4_part2" = "Может, это и есть лучший путь... посвятить все свои силы живописи?";
"ap31_fq1_letter4_part3" = "Должен признаться...";
"ap31_fq1_letter4_part4" = "...я и сам не знаю.";
"ap31_fq1_letter5_part1" = "Мои деньги ещё не закончились полностью,";
"ap31_fq1_letter5_part2" = "но их осталось совсем немного.";
"ap31_fq1_letter5_part3" = "Мне пришлось потратить значительную сумму на художественные принадлежности.";
"ap31_fq1_letter5_part4" = "Надеюсь, ты сможешь вскоре прислать ещё немного денег.";
"ap31_fq2_letter1_part1" = "Раньше я даже не знал, кто такие импрессионисты,";
"ap31_fq2_letter1_part2" = "а теперь познакомился с их работами,";
"ap31_fq2_letter1_part3" = "и хотя я пока не принадлежу к их кругу,";
"ap31_fq2_letter1_part4" = "некоторые картины вызвали у меня искреннее восхищение...";
"ap31_fq2_letter2_part1" = "Я отправил тебе несколько своих рисунков.";
"ap31_fq2_letter2_part2" = "Скажи же мне,";
"ap31_fq2_letter2_part3" = "почему они не продаются";
"ap31_fq2_letter2_part4" = "и как мне писать такие картины, которые будут продаваться?";
"ap31_fq2_letter3_part1" = "Я надеюсь достичь такого мастерства,";
"ap31_fq2_letter3_part2" = "чтобы ты мог с уверенностью";
"ap31_fq2_letter3_part3" = "показывать мои творения";
"ap31_fq2_letter3_part4" = "и не испытывать неловкости.";
"ap31_fq3_letter1_part1" = "В этом году я хочу добиться настоящего прогресса...";
"ap31_fq3_letter1_part2" = "...прогресса,";
"ap31_fq3_letter1_part3" = "в котором, сказать по правде,";
"ap31_fq3_letter1_part4" = "я очень нуждаюсь.";
"ap31_fq3_letter2_part1" = "Я всё так тщательно планирую,";
"ap31_fq3_letter2_part2" = "но даже сегодня обнаружил, что на десять метров холста я идеально рассчитал";
"ap31_fq3_letter2_part3" = "все краски... кроме одной:";
"ap31_fq3_letter2_part4" = "самой необходимой жёлтой.";
"ap31_fq3_letter3_part1" = "Мне ещё никогда так не везло, ведь природа здесь необыкновенно прекрасна.";
"ap31_fq3_letter3_part2" = "Повсюду и во всём.";
"ap31_fq3_letter3_part3" = "Небесный свод окрашен в великолепную синеву, а солнце сияет бледно-серным светом...";
"ap31_fq3_letter3_part4" = "...таким же мягким и чарующим, как небесные голубые и жёлтые тона у Вермеера Делфтского.";
"ap31_fq3_letter3_part5" = "Я не способен написать ничего столь прекрасного.";
"ap31_fq3_letter3_part6" = "Но это настолько меня завораживает, что я забываю обо всём остальном...";
"ap31_fq3_letter4_part1" = "Мне хотелось обустроить этот дом не только для себя, но и сделать так, чтобы в нём можно было принять кого-нибудь ещё.";
"ap31_fq3_letter4_part2" = "Разумеется, на это ушла большая часть денег.";
"ap31_fq3_letter4_part3" = "На оставшиеся средства я купил двенадцать стульев,";
"ap31_fq3_letter4_part4" = "зеркало";
"ap31_fq3_letter4_part5" = "и ещё несколько необходимых мелочей...";
"ap31_fq3_letter4_part6" = "...а это значит, что уже на следующей неделе я смогу переехать!";
"ap31_fq3_letter5_part1" = "Я так счастлив и из-за дома, и из-за работы...";
"ap31_fq3_letter5_part2" = "...что осмеливаюсь верить: эта радость будет принадлежать не только мне,";
"ap31_fq3_letter5_part3" = "но и тебе, когда удача окажется и на твоей стороне!";
"ap31_fq3_letter6_part1" = "Я буду так рад наконец обставить свой дом — думаю, это поможет мне держаться.";
"ap31_fq4_letter1_part1" = "Я был бы очень счастлив,";
"ap31_fq4_letter1_part2" = "если бы ты смог приехать и увидеть Йо и нашего малыша!";
"ap31_fq4_letter1_part3" = "Как мы и говорили раньше,";
"ap31_fq4_letter1_part4" = "мы назвали его в твою честь.";
"ap31_fq4_letter2_part1" = "Знаешь, на что я надеюсь, когда позволяю себе надеяться?";
"ap31_fq4_letter2_part2" = "Что семья станет для тебя тем,";
"ap31_fq4_letter2_part3" = "чем для меня является природа...";
"ap31_fq4_letter2_part4" = "...комья земли, трава, золотая пшеница и крестьяне.";
"ap31_fq4_letter3_part1" = "Теперь этот ужас жизни уже не так силён,";
"ap31_fq4_letter3_part2" = "и меланхолия уже не так мучительна.";
"ap31_fq4_letter3_part3" = "Но никакой мотивации у меня нет... почти никаких желаний...";
"ap31_fq4_letter3_part4" = "...почти ничего из того, что составляет обычную жизнь.";
"ap31_fq4_letter4_part1" = "Я неустанно работаю в своей комнате,";
"ap31_fq4_letter4_part2" = "и это идёт мне на пользу";
"ap31_fq4_letter4_part3" = "и, как мне кажется, прогоняет";
"ap31_fq4_letter4_part4" = "эти болезненные мысли.";
"ap31_fq4_letter5_part1" = "Уже шесть недель я не выходил за порог...";
"ap31_fq4_letter5_part2" = "...даже в сад.";
"ap31_fq4_letter5_part3" = "На следующей неделе,";
"ap31_fq4_letter5_part4" = "когда я закончу начатые полотна,";
"ap31_fq4_letter5_part5" = "думаю, я попробую.";
"ap31_fq4_letter6_part1" = "И всё же здесь я нашёл друзей и вещи, которые люблю.";
"ap31_fq4_letter6_part2" = "Можешь ли ты понять,";
"ap31_fq4_letter6_part3" = "что, хотя я по-прежнему считаю свой недуг ужасным,";
"ap31_fq4_letter6_part4" = "я всё же привязался к этому месту немного сильнее,";
"ap31_fq4_letter6_part5" = "чем следовало бы?";
"ap31_fq4_letter7_part1" = "Постепенно я начинаю воспринимать безумие как болезнь, такую же, как и любая другая.";
"ap31_fq4_letter7_part2" = "Смена обстановки идёт мне на пользу.";
"ap31_fq4_letter7_part3" = "Местный врач склонен считать, что пережитое мной было чем-то вроде эпилептического припадка.";
