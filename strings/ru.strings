"ap14_story_tree_1a2a3a4b" = "Она отдала весь свой свет одинокому ребенку, шедшему сквозь пустыню...";
"ap14_story_tree_1a2a3a4b_abv" = "Она отдала весь свой свет...";
"ap14_story_tree_1a2a3a4b_cont" = "Следуя за светом, дитя нашло путь, и с тех пор ни разу не оставалось в одиночестве.";
"ap14_story_tree_1a2a3a4b_cont_abv" = "Следуя за светом..";
"ap14_story_tree_1a2a3a_abv" = "Пока не стала слишком яркой...";
"ap14_story_tree_1a2a3a_cont" = "Пожертвовав собой...";
"ap14_story_tree_1a2a3b" = "Ее свет охватил все уголки небес.";
"ap14_story_tree_1a2a3b4a" = "То ничего не увидела за светом своих сияющих лучей.";
"ap14_story_tree_1a2a3b4a_abv" = "То ничего не увидела...";
"ap14_story_tree_1a2a3b4a_cont" = "В тишине и одиночестве звезда приглушила свет, пока фигуры не вернулись. Она знала, что если тебе некому сиять, то лучше не сиять вовсе.";
"ap14_story_tree_1a2a3b4a_cont_abv" = "В тишине и одиночестве...";
"ap14_story_tree_1a2a3b4b" = "Увидела ребенка, уверенно идущего по ярко освещенной пустыне.";
"ap14_story_tree_1a2a3b4b_abv" = "Увидела ребенка...";
"ap14_story_tree_1a2a3b4b_cont" = "Звезда гордо засияла еще ярче, направляя дитя к убежищу в храме. И лишь затем позволила себе отдохнуть.";
"ap14_story_tree_1a2a3b4b_cont_abv" = "Звезда гордо засияла еще ярче...";
"ap14_story_tree_1a2a3b_abv" = "Ее свет охватил...";
"ap14_story_tree_1a2a3b_cont" = "И когда она наконец посмотрела вниз...";
"ap14_story_tree_1a2a_cont" = "Пока...";
"ap14_story_tree_1a2b" = "Она светила всё тусклее";
"ap14_story_tree_1a2b3a" = "Ее свет практически потух.";
"ap14_story_tree_1a2b3a4a" = "Она разделилась на бесчисленные огоньки, которые мягко опустились на землю.";
"ap14_story_tree_1a2b3a4a_abv" = "Она разделилась...";
"ap14_story_tree_1a2b3a4a_cont" = "Из них родились чудесные создания света. Конец одной жизни стал началом другой.";
"ap14_story_tree_1a2b3a4a_cont_abv" = "Из них...";
"ap14_story_tree_1a2b3a4b" = "Она начала спуск на землю, светя ярче, чем полная луна.";
"ap14_story_tree_1a2b3a4b_abv" = "Она начала опускаться...";
"ap14_story_tree_1a2b3a4b_cont" = "И вот звезда обратилась в дитя.";
