"ap14_story_tree_0" = "Когда-то давным-давно...";
"ap14_story_tree_1a" = "Жила-была звезда.";
"ap14_story_tree_1a2a" = "Она становилась всё ярче";
"ap14_story_tree_1a2a3a" = "Пока не стала слишком яркой даже для самой себя.";
