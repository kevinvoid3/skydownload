"ap24_side01_chat_01" = "Этот вечер создан для песни.";
"ap24_side01_chat_02" = "Для новой песни,";
"ap24_side01_chat_03" = "в которой немного ожидания,";
"ap24_side01_chat_04" = "чуть побольше весенней грусти,";
"ap24_side01_chat_05" = "а под конец -";
"ap24_side01_chat_06" = "одно лишь неопреодолимое восхищение тем, что можно быть одному и в полном ладу с самим собой.";
"ap24_side02_chat_01" = "Точно так же сидели мы весной.";
"ap24_side02_chat_02" = "Помнишь,";
"ap24_side02_chat_03" = "как мы проснулись после зимней спячки, и это был наш первый день?";
"ap24_side02_chat_04" = "Все остальные еще спали.";
"ap24_side02_chat_05" = "Ты спрашивал о планах.";
"ap24_side02_chat_06" = "А у тебя самого они есть?";
"ap24_side02_chat_07" = "Да, у меня есть план.";
"ap24_side02_chat_08" = "Но он касается только меня одного. Ты ведь сам знаешь!";
"ap24_side02_chat_09" = "Ты собираешься уйти.";
"ap24_side02_chat_10" = "Когда ты ходишь?";
"ap24_side02_chat_11" = "Сию минуту!";
"ap24_side02_chat_12" = "Надолго уходишь?";
"ap24_side02_chat_13" = "Нет, в первый же весенний день я снова буду здесь и свистну под твоим окном.";
"ap24_side02_chat_14" = "Время пролетит так быстро!";
"ap24_side03_chat_01" = "А ты случаем не художник?";
"ap24_side03_chat_02" = "Или может быть пишешь стихи?";
"ap24_side03_chat_03" = "Занимаюсь всем понемножку.";
"ap24_side03_chat_04" = "А вы, как я вижу, путешественники, первооткрыватели.";
"ap24_side03_chat_05" = "Что же вы намерены открывать?";
"ap24_side03_chat_06" = "Все, что угодно.";
"ap24_side03_chat_07" = "Звезды, например.";
"ap24_side03_chat_08" = "Звезды!";
"ap24_side03_chat_09" = "Тогда вы непременно должны взять меня с собой!";
"ap24_side03_chat_10" = "Ничего так не люблю, как звезды.";
"ap24_side03_chat_11" = "Перед сном я всегда смотрю на звезды";
"ap24_side03_chat_12" = "и гадаю, кто там живет.";
"ap24_side04_chat_01" = "Вздох...";
"ap24_side04_chat_02" = "Ты выглядишь расстроенным.";
"ap24_side04_chat_03" = "Я отдал свою любимую игрушку.";
"ap24_side04_chat_04" = "Думал, что мне будет приятно сделать что-то хорошее.";
"ap24_side04_chat_05" = "Аа.. Теперь жалеешь?";
"ap24_side04_chat_06" = "Ага.";
"ap24_side04_chat_07" = "Ты лишился игрушки, но...";
"ap24_side04_chat_08" = "возможно, получил взамен нечто большее.";
"ap24_side06_chat_01" = "Их тайна как-то связана с грозой.";
"ap24_side06_chat_02" = "Гроза - то, что они ищут и о чем мечтают...";
"ap24_side06_chat_03" = "Что это со мной?";
"ap24_side06_chat_04" = "Ведь я же не хатифнатт, а папа Муми-тролля...";
"ap24_side06_chat_05" = "Что мне здесь делать?..";
"ap24_side06_chat_06" = "Иду домой! Немедленно плыву домой!";
"ap24_side07_story_01" = "Однажды Муми-папа ушел из дому, никому ничего не объяснив.";
"ap24_side07_story_02" = "Никто не знал, когда он отправился в путь.";
"ap24_side07_story_03" = "Муми-папа никогда не чувствовал себя таким спокойным.";
"ap24_side07_story_04" = "Это прекрасно, когда не нужно ничего говорить,";
"ap24_side07_story_05" = "и объяснять - ни себе самому, ни другим.";
"ap24_side07_story_06" = "А только сидеть и вглядываться в горизонт,";
"ap24_side07_story_07" = "и слышать, как под лодкой плещутся волны.";
