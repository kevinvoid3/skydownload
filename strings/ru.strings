"ap11_fetch_01_chase_03" = "Давай поиграем!";
"ap11_fetch_01_end_quote" = "Жил да был Маленький принц. Он жил на планете, которая была чуть побольше его самого, и ему очень не хватало друга…";
"ap11_fetch_01_meet_01" = "Мне нравится твоя накидка.";
"ap11_fetch_01_meet_02" = "Такая красивая!";
"ap11_fetch_01_meet_03" = "Хочу кое-что тебе показать!";
"ap11_fetch_01_outro_01" = "В такие дни";
"ap11_fetch_01_outro_02" = "Я с любовью вспоминаю...";
"ap11_fetch_01_outro_03" = "Своего друга, что отправился изучать небеса.";
"ap11_fetch_01_outro_04" = "С каким теплом он за мной ухаживал!";
"ap11_fetch_01_outro_05" = "И теперь я жду, когда он вернется...";
"ap11_fetch_01_play_a_01" = "Закрой глаза!";
"ap11_fetch_01_play_a_02" = "Досчитай до пяти.";
"ap11_fetch_01_play_b_01" = "У меня что-то не очень хорошо получается, да?";
"ap11_fetch_01_play_b_02" = "Попробую еще раз.";
"ap11_fetch_01_play_c_01" = "Давай еще раз сыграем!";
"ap11_fetch_01_play_hint_01" = "Отыщите Маленького принца";
"ap11_fetch_01_star_01" = "Идем, здесь недалеко!";
"ap11_fetch_01_star_02" = "Ты слышишь?";
"ap11_fetch_02_burn_01" = "Это что, баобабы?";
"ap11_fetch_02_burn_02" = "Баобабы с шипами.";
"ap11_fetch_02_butterfly_01" = "Здесь нет роз.";
"ap11_fetch_02_butterfly_02" = "Только бабочки. Как удивительно!";
"ap11_fetch_02_butterfly_03" = "На своей планете я только двух или трех гусениц оставил — чтобы вывелись бабочки.";
"ap11_fetch_02_butterfly_04" = "Я еще никогда столько не видел!";
"ap11_fetch_02_butterfly_05" = "Полетели выше!";
"ap11_fetch_02_butterfly_06" = "Нужно найти самую вершину!";
"ap11_fetch_02_bye_01" = "Ох, это было весело!";
"ap11_fetch_02_bye_02" = "Все всегда недовольны быть там, где они есть...";
"ap11_fetch_02_bye_03" = "Только дети знают, что они ищут...";
"ap11_fetch_02_bye_04" = "Мне еще нужно найти друзей и понять много всяких штук.";
"ap11_fetch_02_carry_01" = "Я рад, что ты здесь.";
"ap11_fetch_02_carry_02" = "Взрослые забывают, как парить вместе.";
"ap11_fetch_02_door_01" = "Исследовать легко.";
"ap11_fetch_02_door_02" = "Найти дом — уже не так.";
"ap11_fetch_02_end_quote" = "Все взрослые сначала были детьми, только мало кто из них об этом помнит.";
"ap11_fetch_02_jelly_01" = "А создания в этих пещерах поют?";
"ap11_fetch_02_jelly_02" = "Представляю, как они споют нам.";
"ap11_fetch_02_meet_01" = "Я потерялся...";
"ap11_fetch_02_meet_02" = "Знаешь, как выйти отсюда?";
"ap11_fetch_02_outro_01" = "Когда мой милый друг нашел меня, я была семечком.";
"ap11_fetch_02_outro_02" = "И я цвела для него.";
"ap11_fetch_02_outro_03" = "А теперь он ищет новые планеты,";
"ap11_fetch_02_outro_04" = "Но найдет ли он другую такую розу?";
"ap11_fetch_02_top_01" = "Я знаю одного господина, он за всю свою жизнь ни разу не понюхал цветка.";
"ap11_fetch_02_top_02" = "Ни разу не поглядел на звезду.";
"ap11_fetch_02_top_03" = "Он никогда никого не любил.";
"ap11_fetch_02_top_04" = "И никогда ничего не делал. Он занят только одним: складывает цифры.";
"ap11_fetch_02_top_05" = "И с утра до ночи твердит одно:";
"ap11_fetch_02_top_06" = "«Я человек серьезный! Я человек серьезный!»";
"ap11_fetch_02_top_07" = "И прямо раздувается от гордости.";
"ap11_fetch_02_top_08" = "А на самом деле он не человек.";
"ap11_fetch_02_top_09" = "Он гриб.";
"ap11_fetch_02_whale_01" = "Есть здесь кто?";
"ap11_fetch_02_whale_02" = "Что за чудесное создание!";
"ap11_fetch_02_whale_03" = "А его можно приручить?";
"ap11_fetch_03_beach_01" = "Еще ни на одной планете я не видел столько много воды!";
"ap11_fetch_03_beach_02" = "Вот бы увидеть, что скрывается там, за горизонтом.";
"ap11_fetch_03_beach_03" = "Поднимешь меня на вершину острова?";
"ap11_fetch_03_beach_04" = "Поднимемся на самую вершину!";
"ap11_fetch_03_belltower_01" = "Что за странный дом!";
"ap11_fetch_03_belltower_02" = "Моя родная планета вся-то величиной с дом!";
"ap11_fetch_03_belltower_03" = "Как здорово она поет на ветру!";
"ap11_fetch_03_belltower_04" = "И как красиво украшен колокольчиками.";
"ap11_fetch_03_belltower_05" = "Будто небо, усыпанное звездами!";
"ap11_fetch_03_belltower_06" = "Колокольчики, должно быть, для созданий.";
"ap11_fetch_03_belltower_07" = "Все дети это знают.";
"ap11_fetch_03_belltower_08" = "Пойдем к той статуе!";
"ap11_fetch_03_bye_01" = "А как это...";
"ap11_fetch_03_bye_02" = "«приручить»?";
"ap11_fetch_03_bye_03" = "Лис сказал мне, что это означает создать узы.";
"ap11_fetch_03_bye_04" = "Смотри!";
"ap11_fetch_03_bye_05" = "Но если ты меня приручишь, мы станем нужны друг другу.";
"ap11_fetch_03_bye_06" = "Среди миллионов детей...";
"ap11_fetch_03_bye_07" = "Ты будешь для меня единственным в целом свете.";
"ap11_fetch_03_bye_08" = "Я буду для тебя единственным в целом свете.";
"ap11_fetch_03_end_quote" = "Когда даешь себя приручить, потом случается и плакать.";
"ap11_fetch_03_geyser_01" = "Это вулкан!";
"ap11_fetch_03_geyser_02" = "У меня есть три вулкана, я каждую неделю их прочищаю.";
"ap11_fetch_03_geyser_03" = "Все три прочищаю, и потухший тоже.";
"ap11_fetch_03_geyser_04" = "Мало ли что может случиться.";
"ap11_fetch_03_geyser_06" = "Это что, водопад?";
"ap11_fetch_03_geyser_07" = "Давай посмотрим!";
"ap11_fetch_03_outro_01" = "Тигров я не боялась,";
"ap11_fetch_03_outro_02" = "Ведь у меня были мои шипы.";
"ap11_fetch_03_outro_03" = "Но мой друг позабыл меня,";
"ap11_fetch_03_outro_04" = "и я осталась дрожать на сквозняке.";
"ap11_fetch_03_outro_05" = "Вспомнит ли он меня?";
"ap11_fetch_03_statue_01" = "Что они за создания?";
"ap11_fetch_03_statue_02" = "Их можно приручить?";
"ap11_fetch_03_statue_03" = "Сделать друзьями навсегда?";
"ap11_fetch_03_statue_05" = "Что за звук?";
"ap11_fetch_03_statue_06" = "Идем со мной!";
"ap11_fetch_03_tunnel_01" = "Продолжим исследования!";
"ap11_fetch_03_tunnel_02" = "Куда он ведет?";
"ap11_fetch_03_tunnel_03" = "Ух ты!";
"ap11_fetch_03_tunnel_04" = "Это было весело!";
"ap11_fetch_03_waterfall_01" = "Слышишь?";
"ap11_fetch_03_waterfall_02" = "Это водопад поет...";
"ap11_fetch_03_waterfall_03" = "Вода может быть полезна для души...";
"ap11_fetch_03_waterfall_hint_01" = "Откуда эта вода?";
"ap11_fetch_03_waterfall_hint_02" = "Давай узнаем, где она берет начало.";
