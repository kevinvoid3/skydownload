"ap11_fetch_06_campfire_03" = "Сегодня я возвращаюсь домой.";
"ap11_fetch_06_campfire_04" = "На звезду, где я живу.";
"ap11_fetch_06_campfire_05" = "Где я смеюсь.";
"ap11_fetch_06_campfire_06" = "Ты посмотришь ночью на небо...";
"ap11_fetch_06_campfire_07" = "и ты услышишь, что все звезды смеются.";
"ap11_fetch_06_campfire_08" = "Это очень далеко. И слишком тяжело...";
"ap11_fetch_06_campfire_09" = "Тебе покажется, что мне больно.";
"ap11_fetch_06_campfire_10" = "Покажется даже, что я умираю.";
"ap11_fetch_06_campfire_11" = "Не приходи, не надо.";
