"ap24_fq05_chat_13" = "Dia tidak bisa bermain...";
"ap24_fq05_chat_14" = "Dia tidak bisa marah.";
"ap24_fq05_chat_15" = "Itulah yang salah dengan dirinya.";
"ap24_fq05_chat_16" = "Kamu tidak akan pernah memiliki wajahmu sendiri sampai kamu belajar untuk berkelahi!";
"ap24_fq05_chat_17" = "Ya, tentu saja.";
"ap24_fq06_chat_01" = "Apa yang terjadi pada Ninny?";
