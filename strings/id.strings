"sf_art_10_01" = "Dalam mengembangkan cerita latar, kami membuat sketsa tentang kemungkinan tujuan hidup para penghuni peradaban.\n(Sketsa oleh Yuichiro Tanabe)";
"sf_art_10_02" = "(Sketsa oleh Yuichiro Tanabe)";
