"ap24_fq01_chat_04" = "Nah, ayo ikut!";
"ap24_fq01_chat_05" = "Siapa yang kamu bawa?";
"ap24_fq01_chat_06" = "Namanya Ninny.";
"ap24_fq01_chat_07" = "Dia ketakutan oleh seorang wanita yang telah merawatnya tanpa benar-benar menyukainya...";
"ap24_fq01_chat_08" = "...dan dia berubah menjadi tak terlihat.";
"ap24_fq01_chat_09" = "Aku pernah bertemu wanita ini, dan dia sangat mengerikan, jenis yang sangat ironis.";
"ap24_fq01_chat_10" = "Sungguh tak menyenangkan!";
"ap24_fq01_chat_11" = "Jika orang sangat ketakutan, mereka terkadang menjadi tidak terlihat.";
