"ap31_fetch_letter_hint1" = "Kirim surat Vincent kepada Theo";
"ap31_flowertouch_hint1" = "Hampiri bunga matahari Theo";
"ap31_fq1_letter1_part1" = "Aku sudah menantikan hari Natal.";
"ap31_fq1_letter1_part2" = "Dua tahun lalu kita berjalan-jalan di malam hari di tengah salju—";
"ap31_fq1_letter1_part3" = "apakah kamu masih ingat?";
"ap31_fq1_letter1_part4" = "Saat kita melihat bulan terbit di atas Mariënhof?";
"ap31_fq1_letter2_part1" = "Kata-kata tidak bisa mengungkapkan betapa bahagianya diriku...";
"ap31_fq1_letter2_part2" = "...mulai menggambar lagi!";
"ap31_fq1_letter2_part3" = "Hal ini sudah lama ada di pikiranku,";
"ap31_fq1_letter2_part4" = "namun aku selalu menganggapnya tidak mungkin dan di luar jangkauanku.";
"ap31_fq1_letter3_part1" = "Penggali, penabur, pembajak, pria dan wanita—";
"ap31_fq1_letter3_part2" = "Aku harus menggambar semuanya tanpa henti.";
"ap31_fq1_letter3_part3" = "Segala hal yang berhubungan dengan kehidupan pedesaan, aku harus mengamati dan menggambarnya.";
"ap31_fq1_letter3_part4" = "Aku tidak lagi merasa tidak berdaya di hadapan alam seperti dulu!";
"ap31_fq1_letter4_part1" = "Melukis terasa lebih alami bagiku daripada yang kubayangkan.";
"ap31_fq1_letter4_part2" = "Mungkin itu cara terbaik ke depan...mencurahkan seluruh usahaku untuk melukis?";
"ap31_fq1_letter4_part3" = "Aku harus mengakui...";
"ap31_fq1_letter4_part4" = "...aku tidak tahu.";
"ap31_fq1_letter5_part1" = "Uangku belum sepenuhnya habis,";
"ap31_fq1_letter5_part2" = "tapi tidak banyak yang tersisa.";
"ap31_fq1_letter5_part3" = "Aku harus menghabiskan banyak uang untuk perlengkapan melukis.";
"ap31_fq1_letter5_part4" = "Aku harap kamu bisa mengirim sesuatu segera.";
"ap31_fq2_letter1_part1" = "Aku bahkan tidak tahu apa itu pelukis impresionis,";
"ap31_fq2_letter1_part2" = "sekarang aku telah melihat mereka,";
"ap31_fq2_letter1_part3" = "dan meskipun belum menjadi salah satu dari klub tersebut,";
"ap31_fq2_letter1_part4" = "aku sangat mengagumi lukisan impresionis tertentu...";
"ap31_fq2_letter2_part1" = "Aku telah mengirimkan beberapa gambar kepadamu.";
"ap31_fq2_letter2_part2" = "Silakan dan beri tahu aku";
"ap31_fq2_letter2_part3" = "mengapa mereka tidak laku,";
"ap31_fq2_letter2_part4" = "dan bagaimana aku bisa menggambar sesuatu yang akan laku?";
"ap31_fq2_letter3_part1" = "Aku berharap bisa berkembang sedemikian rupa";
"ap31_fq2_letter3_part2" = "sehingga kamu dapat dengan percaya diri";
"ap31_fq2_letter3_part3" = "memamerkan karyaku";
"ap31_fq2_letter3_part4" = "tanpa mempermalukan dirimu sendiri.";
"ap31_fq3_letter1_part1" = "Aku ingin membuat kemajuan nyata tahun ini...";
"ap31_fq3_letter1_part2" = "...kemajuan,";
"ap31_fq3_letter1_part3" = "sejujurnya,";
"ap31_fq3_letter1_part4" = "yang sangat aku butuhkan.";
"ap31_fq3_letter2_part1" = "Aku berencana dengan sangat hati-hati,";
"ap31_fq3_letter2_part2" = "tetapi bahkan hari ini aku menemukan bahwa untuk sepuluh meter kanvas, yang telah aku anggarkan dengan sempurna";
"ap31_fq3_letter2_part3" = "semua warna...dengan satu pengecualian:";
"ap31_fq3_letter2_part4" = "warna dasar kuning.";
"ap31_fq3_letter3_part1" = "Aku belum pernah seberuntung ini, karena alam di sini luar biasa indah.";
"ap31_fq3_letter3_part2" = "Segalanya dan di mana saja.";
"ap31_fq3_letter3_part3" = "Kubah langit berwarna biru yang indah, dan matahari memancarkan cahaya sulfur pucat...";
"ap31_fq3_letter3_part4" = "...sama lembut dan menawannya dengan biru dan kuning langit di karya Vermeer of Delft.";
"ap31_fq3_letter3_part5" = "Aku tidak bisa melukis sesuatu yang seindah itu.";
"ap31_fq3_letter3_part6" = "Tapi itu sangat memikatku sehingga aku membiarkan diriku terbawa suasana...";
"ap31_fq3_letter4_part1" = "Aku ingin melengkapi rumah ini tidak hanya untuk diriku sendiri, tetapi sedemikian rupa sehingga bisa menampung orang lain.";
"ap31_fq3_letter4_part2" = "Tentu saja, ini menghabiskan sebagian besar uang.";
"ap31_fq3_letter4_part3" = "Dengan apa yang tersisa, aku telah membeli dua belas kursi,";
"ap31_fq3_letter4_part4" = "sebuah cermin,";
"ap31_fq3_letter4_part5" = "dan beberapa barang kecil yang sangat diperlukan...";
"ap31_fq3_letter4_part6" = "...yang berarti, minggu depan, aku akan bisa pindah!";
"ap31_fq3_letter5_part1" = "Aku sangat senang dengan rumah ini, dan dengan pekerjaanku...";
"ap31_fq3_letter5_part2" = "...sampai aku berani percaya kalau kebahagiaan ini nggak cuma buat aku sendiri,";
"ap31_fq3_letter5_part3" = "tetapi kamu juga akan membagikannya di tempatmu dengan mendapatkan nasib baik juga!";
"ap31_fq3_letter6_part1" = "Aku akan sangat senang bisa melengkapi rumahku - dan itu hanya bisa membantuku melewati ini semua.";
"ap31_fq4_letter1_part1" = "Aku akan sangat bahagia";
"ap31_fq4_letter1_part2" = "jika kamu bisa berkunjung untuk melihat Jo dan bayi kecil kita!";
"ap31_fq4_letter1_part3" = "Seperti yang telah kita sebutkan sebelumnya,";
"ap31_fq4_letter1_part4" = "kami menamainya sama dengan namamu.";
"ap31_fq4_letter2_part1" = "Nah, tahukah kamu apa yang kuharapkan, ketika aku membiarkan diriku berharap?";
"ap31_fq4_letter2_part2" = "Bahwa keluarga akan ada bagimu";
"ap31_fq4_letter2_part3" = "seperti halnya alam bagiku...";
"ap31_fq4_letter2_part4" = "...gumpalan tanah, rumput, gandum kuning, petani.";
"ap31_fq4_letter3_part1" = "Sekarang, kengerian hidup ini sudah tidak terlalu terasa,";
"ap31_fq4_letter3_part2" = "rasa melankolisnya tidak terlalu akut.";
"ap31_fq4_letter3_part3" = "Tetapi tentang motivasi, aku tidak punya sama sekali...sedikit, jika ada, keinginan...";
"ap31_fq4_letter3_part4" = "...dan hampir tidak ada apa yang menjadi bagian dari kehidupan biasa.";
"ap31_fq4_letter4_part1" = "Aku bekerja tanpa henti di kamarku,";
"ap31_fq4_letter4_part2" = "yang memberikan kebaikan untukku";
"ap31_fq4_letter4_part3" = "dan mengusir, aku membayangkan,";
"ap31_fq4_letter4_part4" = "ide-ide tidak normal ini.";
"ap31_fq4_letter5_part1" = "Sudah enam minggu sejak aku menginjakkan kaki ke luar...";
"ap31_fq4_letter5_part2" = "...bahkan tidak ke taman.";
"ap31_fq4_letter5_part3" = "Minggu depan,";
"ap31_fq4_letter5_part4" = "ketika aku telah menyelesaikan kanvas yang sedang dikerjakan,";
"ap31_fq4_letter5_part5" = "bagaimanapun juga, aku akan mencoba.";
"ap31_fq4_letter6_part1" = "Di sana-sini, bahkan aku telah menemukan teman dan hal-hal yang kucintai.";
"ap31_fq4_letter6_part2" = "Bisakah kamu mengerti, kemudian,";
"ap31_fq4_letter6_part3" = "meskipun masih menganggap penderitaanku mengerikan,";
"ap31_fq4_letter6_part4" = "bahwa bagaimanapun aku telah membentuk ikatan di sini";
"ap31_fq4_letter6_part5" = "yang sedikit terlalu dalam?";
"ap31_fq4_letter7_part1" = "Sedikit demi sedikit, aku mulai memandang kegilaan sebagai penyakit, sama seperti yang lainnya.";
"ap31_fq4_letter7_part2" = "Perubahan pemandangan membawa kebaikan untukku.";
"ap31_fq4_letter7_part3" = "Dokter di sini cenderung memandang apa yang aku alami sebagai sesuatu yang mirip dengan serangan epilepsi.";
"ap31_fq4_letter7_part4" = "Tapi aku belum memeriksanya.";
"ap31_fq5_date1" = "Enam Bulan Kemudian";
"ap31_fq5_date2" = "Dua Hari Kemudian";
"ap31_fq5_letter1_part1" = "Selain anak itu,";
