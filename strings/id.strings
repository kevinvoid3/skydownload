"ap24_fq01_chat_13" = "Ini adalah keluarga barumu!";
"ap24_fq01_story_01" = "Pada suatu malam ketika hujan turun, seorang wanita yang baik hati menuntun seorang gadis yang tak terlihat melewati Moominvalley.";
"ap24_fq01_story_02" = "Nama wanita itu adalah Too-ticky.";
"ap24_fq01_story_03" = "Mungkin teman-temannya bisa membantu gadis itu agar bisa terlihat lagi.";
"ap24_fq02_chat_01" = "Tidurlah selarut mungkin. Akan ada teh untukmu di pagi hari kapanpun kamu mau.";
"ap24_fq02_story_01" = "Lonceng perak berdenting setelah Moominmamma naik ke atas.";
"ap24_fq02_story_02" = "Sekarang tidurlah yang nyenyak, Ninny.";
"ap24_fq03_chat_01" = "Mamma! Dia punya cakar! Kamu bisa melihat cakarnya!";
"ap24_fq03_chat_02" = "Bagus sekali! Dan lebih baik lagi ketika dia menunjukkan hidungnya suatu hari nanti.";
"ap24_fq03_chat_03" = "Mereka memetik apel. Itu adalah pagi musim gugur yang indah.";
"ap24_fq03_chat_04" = "Kerja bagus, Ninny!";
"ap24_fq03_chat_05" = "Oh, itu toples yang biasa kita gunakan untuk memberi makan lebah.";
"ap24_fq03_chat_06" = "Sekarang kita tidak perlu membawanya ke ladang.";
"ap24_fq03_chat_07" = "Aku bisa melihat kakinya!";
"ap24_fq04_chat_01" = "Terima kasih banyak untuk semuanya.";
"ap24_fq04_chat_02" = "Kita senang bisa bertemu dengan kalian semua hari ini!";
"ap24_fq04_chat_03" = "Baiklah, kamu sudah mulai berbicara. Apakah kamu tahu permainan yang bagus?";
"ap24_fq04_chat_04" = "Tidak...";
"ap24_fq04_chat_05" = "... Tapi aku pernah dengar tentang permainan!";
"ap24_fq04_story_01" = "Malam itu, Moominmamma membuatkan Ninny gaun berwarna merah muda dan menaruhnya di kamar loteng sebelah timur.";
"ap24_fq04_story_02" = "Ninny turun ke bawah untuk bergabung dengan keluarga Moomin dan minum teh di pagi hari.";
"ap24_fq05_chat_01" = "Ninny sudah terlihat sampai ke lehernya, dan yang tersisa hanyalah wajahnya.";
"ap24_fq05_chat_02" = "Moomintroll sangat senang. Dia memutuskan untuk mengajari Ninny semua permainan yang dia tahu.";
"ap24_fq05_chat_03" = "Naiklah, Ninny!";
"ap24_fq05_chat_04" = "Maaf, aku tidak bisa...";
"ap24_fq05_chat_05" = "Lari, lari, tidak bisakah kamu!";
"ap24_fq05_chat_06" = "Maaf...";
"ap24_fq05_chat_07" = "Atau kamu bahkan tidak bisa melompat?";
"ap24_fq05_chat_08" = "Sudah jelas bagi semua orang bahwa dia bermain hanya karena kesopanan dan bukan untuk bersenang-senang.";
"ap24_fq05_chat_09" = "Aku sangat menyesal...";
"ap24_fq05_chat_10" = "Apakah kamu pikir ada orang yang seperti itu?";
"ap24_fq05_chat_11" = "Apakah kamu tidak punya kehidupan di dalam dirimu?";
