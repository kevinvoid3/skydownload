"sf_art_11_05" = "GURUN EMAS\n(Karya seni oleh Yuichiro Tanabe)";
"sf_art_11_06" = "KUBAH PENGETAHUAN\n(Karya seni oleh Yuichiro Tanabe)";
"sf_art_12_00" = "Ekosistem yang lebih luas yang melibatkan rasi bintang dan siklus kehidupan dipertimbangkan secara lebih menyeluruh saat kami merancang makhluk-makhluk tersebut. Kami menanamkan petunjuk tentang bagaimana cahaya dan kehampaan memengaruhi mereka secara historis di dunia.";
"sf_art_12_01" = "Mahluk yang agung ini menggiring cahaya kembali ke arah bintang-bintang. Kami mendesain mereka untuk bergerak secara elegan seperti kehidupan air yang berenang di antara awan.\n(Karya seni oleh Yuichiro Tanabe)";
"sf_art_12_02" = "Tim seni awalnya memulai dengan desain ikan, tetapi mereka mengembangkan bentuknya menjadi manta pada iterasi berikutnya.\n(Karya seni oleh Tom Zhao)";
"sf_art_13_00" = "Dalam memvisualisasikan kekosongan sebagai pendongeng, kami menyajikan dampaknya secara netral dan merayakan bentuk kehidupan yang terang dan gelap untuk keindahannya masing-masing.\nDengan menghormati keberadaan keduanya secara setara, kami dapat membangun dunia yang lebih kaya.";
"sf_art_13_01" = "Kami mulai bereksperimen dengan warna dan bentuk yang dapat memadukan emosi dalam menghadapi kegelapan dan kehampaan.\n(Karya seni oleh Khang Le)";
"sf_art_13_02" = "Dalam karya seni ini, makhluk hidup yang rusak akibat kehampaan direpresentasikan sebagai Perairan Kegelapan, Tumbuhan/Bunga Kegelapan, Kepiting Kegelapan, dan Naga Kegelapan.\n(Karya seni oleh Tom Zhao)";
"sf_art_14_00" = "Saat dunia Sky mengalami banyak iterasi, kami menjaga tampilan avatar tetap terbuka dan mudah dibentuk.\nSetelah kami mulai mendesain karakter dalam pengaturan kelompok, kami mempertimbangkan keselarasan estetika mereka di layar.";
"sf_art_14_01" = "(Karya seni oleh Jacky Ke Jiang)";
"sf_art_14_02" = "(Karya seni oleh Yuichiro Tanabe)";
"sf_art_14_03" = "(Karya seni oleh Jacky Ke Jiang)";
"sf_art_14_04" = "(Karya seni oleh Jacky Ke Jiang)";
"sf_art_14_05" = "(Karya seni oleh Yuichiro Tanabe)";
"sf_art_15_00" = "Tujuan kami adalah membuat avatar Anak Sky yang mewakili semua jenis pemain. Alih-alih menampilkan wajah, kami menambahkan topeng sehingga kamu bisa memilih ekspresi dan penampilanmu sendiri.";
"sf_art_15_01" = "Meskipun sketsa ini dibuat pada tahun 2015, namun gambar kelompok ini meramalkan evolusi artistik Sky sebelum petualangan musim dimulai.\n(Karya seni oleh Yuichiro Tanabe)";
"sf_hist_02_00" = "Sony Computer Entertainment menawarkan untuk menerbitkan tiga video game yang mencakup flOw, Flower, dan Journey.\n\nSemua judul game tersebut mendefinisikan ulang kemungkinan permainan yang inovatif, mudah diakses, dan digerakkan oleh hal yang positif.";
"sf_hist_03_00" = "Tergerak oleh penghargaan 'Game of the Year' dari Journey dan kemampuannya untuk menghubungkan para pemain secara global, studio ini berusaha untuk mengangkat tema-tema rasa syukur dan komunitas untuk proyek mereka selanjutnya, yang merupakan awal dari perluasan ke platform mobile untuk menjangkau lebih banyak pemain, dan mengembangkan judul yang mereka terbitkan sendiri, Sky.";
"sf_hist_03_01" = "Menjelajahi Desain Game";
"sf_hist_03_02" = "Diskusi Narasi dan Animasi";
"sf_hist_03_03" = "Melatih Konsep Desain Baru";
"sf_hist_03_04" = "Perencanaan Seni";
"sf_hist_04_00" = "Selama beberapa tahun pertama pengembangan, studio ini melakukan iterasi melalui eksplorasi dan penemuan yang menyenangkan. Lompatan ke pengembangan mobile, game yang dapat dimainkan secara gratis, dan menerbitkan sendiri sebuah judul game yang dapat dimainkan secara real-time menantang tim dan memperpanjang jadwal produksi.";
"sf_hist_04_01" = "Bereksperimen dengan Desain Suara";
"sf_hist_04_02" = "Diskusi Seni Lingkungan";
"sf_hist_04_05" = "Tim seni mempelajari banyak bentuk awan dan perilakunya untuk mendesain dunia di sky.";
"sf_hist_04_06" = "Inspirasi datang dari berbagai emosi yang disampaikan awan pada waktu yang berbeda sepanjang hari.";
"sf_hist_04_07" = "Prototipe awal untuk pengujian.";
"sf_hist_04_08" = "Beberapa prototipe dibuat untuk membantu merencanakan teknologi dan mesin permainan yang dibutuhkan untuk lanskap awan dan penerbangan.";
"sf_hist_04_09" = "Terbukti bahwa setelah ditempatkan di antara awan, kami harus mengandalkan awan sebagai latar belakang dan pemandangan yang emosional.";
"sf_hist_04_10" = "Memperkenalkan lingkungan yang sudah dikenal.";
"sf_hist_04_11" = "Dunia manusia di Sky.";
"sf_hist_04_12" = "Cakrawala di atas lanskap kota manusia untuk menguji penerbangan.";
"sf_hist_04_13" = "Pengujian awal pemain di dunia Sky.";
"sf_hist_04_14" = "Contoh lain dari avatar pemain tanpa jubah.";
"sf_hist_04_15" = "Tim menetapkan desain awal ini di Padang Rumput sebagai contoh avatar dengan cincin energi untuk menunjukkan kekuatan terbang.";
"sf_hist_05_01" = "Teaser visual pertama dari Sky";
"sf_hist_06_00" = "Pada musim gugur 2017, Sky secara resmi diluncurkan di Acara Khusus Apple di Cupertino, California. Game ini memulai debutnya di AppStore untuk iPhone dan iPad.\n\nGame ini menjalani pengujian beta tertutup hingga tahun 2019, saat dirilis pada tanggal 18 Juli.";
"sf_hist_06_03" = "Setiap musim diisi dengan gameplay, cerita, karakter, ekspresi, dan item baru.";
"sf_hist_06_04" = "Tiga perilisan pertama ini adalah: 'Musim Syukur', 'Musim Pencari Cahaya', dan 'Musim Kepemilikan'.";
"sf_hist_06_05" = "DI BALIK LAYAR: Para anggota studio menjalin ikatan melalui permainan pingpong, video game, membuat/memberi hadiah lilin asli kepada satu sama lain, menonton film, dan menghadiri perjalanan riset ke Disneyland. 🕯️";
"sf_hist_07_00" = "Pada tahun 2020, Sky merilis empat petualangan musim baru dan juga meluncurkannya di Google Play Store.";
"sf_hist_07_05" = "DI BALIK LAYAR: Dua dari musim ini bisa saja dirilis dengan nama yang berbeda... Dapatkah kamu menebak musim mana yang berhubungan dengan musim ini? Pertemuan, Kebangkitan, Asal-Usul\n\nMusim dari: Pengembaraan, Pencerahan, Migrasi";
"sf_hist_08_00" = "Pada bulan Juli 2020, game ini merayakan hari jadinya yang pertama. Kali ini juga merupakan masa dimana dunia terkena dampak besar dari pandemi COVID-19.";
"sf_hist_08_01" = "Ulang tahun pertama Sky\n\nMelalui inisiatif khusus 'Healing Pack', thatgamecompany meluncurkan kampanye nirlaba pertama Sky untuk membantu para pekerja di garis depan melalui Doctors Without Borders. Berkat komunitas, lebih dari USD 1 Juta berhasil dikumpulkan.";
"sf_hist_09_00" = "Sebagai bagian dari setiap petualangan musim DI 2021, Sky melihat ekspansi berkelanjutan di seluruh kerajaan di mana fitur-fitur baru, cerita yang lebih dalam, dinamika multipemain, dan gameplay yang unik diperkenalkan.";
"sf_hist_09_03" = "Musim Pangeran Kecil\n\nBersamaan dengan ulang tahun game kedua dan ekspansi ke Nintendo Switch, Sky juga menyambut kolaborasi IP pertamanya dengan Olivier d'Agay dan Pangeran Kecil kesayangan Antoine de Saint-Exupéry.";
"sf_hist_09_05" = "DI BALIK LAYAR: Tahukah kamu...?\n\nMusim Mimpi: Beberapa karakter lain yang kami pikirkan untuk dimasukkan adalah Pemilik Kafe, Penampil Pemakan Api, dan Pemain Harpa.";
"sf_hist_09_06" = "DI BALIK LAYAR: Dalam Musim Pangeran Kecil, puisi-puisi Rose pada awalnya tidak menjadi bagian dari penulisan narasi dan desain.\n\nPenulisan puisi-puisi tersebut ditambahkan di tengah-tengah produksi dan memberikan nuansa baru pada musim tersebut.";
"sf_hist_10_00" = "Pada tahun 2021, pameran Smithsonian FUTURES dan acara Barbican Virtual Realms memamerkan desain kreatif Sky dan thatgamecompany kepada para pengunjung yang hadir.";
"sf_hist_10_01" = "Pameran Smithsonian FUTURES pada tahun 2021, Washington DC";
"sf_hist_10_02" = "Pameran Sky di pameran Smithsonian FUTURES";
"sf_hist_10_03" = "Sky ditampilkan kembali di acara Barbican Virtual Realms pada tahun 2021, London";
"sf_hist_11_00" = "Pada tahun 2022, Sky diluncurkan di Sony PlayStation, sehingga semakin mengembangkan komunitas Sky.\n\nSelama tahun tersebut, petualangan musim memperkenalkan kemampuan pemain baru, dan studio mengumumkan proyek animasi Sky yang sedang diproduksi.";
"sf_hist_11_04" = "Kolaborasi Sky dengan artis musik yang dicintai secara internasional, AURORA, memperkenalkan teknologi baru untuk menghidupkan musiknya di dalam game. Musim ini mendukung pertemuan konser langsung secara simultan yang belum pernah ada sebelumnya.";
"sf_hist_11_05" = "DI BALIK LAYAR: Tim memulai 'Sky Assemblies' perdananya di Long Beach, California.\n\nDi sini, Sky Kids merayakannya dengan berbagai kemeriahan, bertemu untuk bermain secara langsung, dan menjalin pertemanan baru melalui acara tersebut.";
"sf_hist_12_00" = "Seiring dengan pertumbuhan Sky, begitu juga dengan tim pengembangan studio dan penerbitan untuk mengembangkan game dan kemitraannya.";
"sf_hist_12_01" = "Sky merayakan ulang tahunnya yang ke-3.";
"sf_hist_12_02" = "Berkat dukungan para pemain yang luar biasa, kolaborasi non-profit tim dengan Trevor Project memasuki tahun ke-2 dan berhasil menggalang dana lebih dari 680.000 dollar AS.";
"sf_hist_13_00" = "Tim Sky dan thatgamecompany berfokus pada terobosan baru menjelang ulang tahun ke-4.\n\nEmpat musim baru juga dikembangkan dan dirilis tahun ini.";
"sf_hist_13_05" = "Sejak 2021, komunitas Sky kita telah mengumpulkan lebih dari USD $1,84 Juta dan terus bertambah untuk The Ocean Cleanup.\n\nMisi mereka adalah meneliti, mengekstraksi, dan memantau polusi plastik di lautan dan sungai secara global.";
"sf_hist_14_00" = "Sky ingin mencetak Guinness World Record baru untuk \"Pengguna terbanyak di dunia virtual bertema konser\" selama di Gamescom.";
"sf_hist_14_01" = "Acara Guinness World Record ini sukses besar. Sky tidak hanya memecahkan rekor tersebut tetapi juga dengan menampung lebih dari 10.000 pengguna secara bersamaan di server yang sama.";
"sf_hist_15_00" = "Sky akan merayakan ulang tahunnya yang ke-5 dengan penuh gaya saat studio ini menyelenggarakan acara selama dua hari di Tokyo, Jepang. Para pemain global kami di dalam game akan membantu kami merayakannya juga.";
"sf_hist_15_01" = "Kemitraan Musim Rusa Sembilan Warna memperkenalkan kisah yang indah dan sejumlah karakter yang memukau ke dalam kerajaan Sky.";
"sf_hist_15_02" = "Diterbitkan pada musim panas ini, buku seni 'The Art of Sky' mengulas kembali fase pengembangan game ini selama tujuh tahun (2012-2019).";
"sf_hist_15_03" = "Baru-baru ini, tim juga merilis 'Musim Bersarang'.";
