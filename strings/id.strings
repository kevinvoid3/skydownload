"sf_art_01_00" = "Sky awalnya dibuat sebagai sekuel dari Cloud (game yang dirancang sebelum studio thatgamecompany dibentuk).\n\nSky mulai dikembangkan pada tahun 2012 dengan tim beranggotakan sekitar sepuluh pengembang di sebuah kantor di Santa Monica, California.";
"sf_art_01_01" = "Gambar pertama Sky adalah sketsa pensil yang mencolok dari anak-anak yang terbang bersama, jiwa mereka terjalin ke dalam bentuk burung mitos.\n(Sketsa oleh Jenova Chen)";
"sf_art_01_02" = "The Giant karya seniman Amerika, N.C. Wyeth, adalah inspirasi utama bagi Sky pada awalnya.\n(The Giant karya N.C. Wyeth)";
"sf_art_01_03" = "Tema cerita Le Petit Prince menjadi referensi dalam pengembangan awal.\n(Gambar Le Petit Prince, yang ditulis oleh Antoine de Saint-Exupéry)";
"sf_art_01_04" = "Film dokumenter The Winged Migration menginformasikan kepada kita tentang berbagai kondisi yang dialami oleh burung yang terbang jarak jauh.\n(Disutradarai oleh Jacques Perrin, Jacques Cluzaud, Michel Debats)";
"sf_art_02_01" = "\"Overview Effect\" adalah video yang sangat berdampak, yang dibagikan oleh para astronot dari stasiun ruang angkasa, yang berbicara tentang rasa kagum yang mereka rasakan saat melihat bumi. Hal ini mengilhami lukisan awal dalam praproduksi.\n(Karya seni oleh Jenova Chen)";
"sf_art_03_00" = "Selama eksplorasi seni awal kami, sketsa suasana hati pertama kami didasarkan pada gagasan tentang seorang anak yang terbang untuk bertemu dengan para raksasa di langit, dan selama periode ini, kami melukis berbagai pulau yang bisa kamu lewati.";
"sf_art_03_01" = "Lukisan-lukisan ini memancarkan kualitas yang fantastis dan seperti anak-anak.\" (Karya seni oleh Jacky Ke Jiang)";
"sf_art_03_02" = "Kami membayangkan sebuah jalur jiwa yang bertemu dengan raksasa dan makhluk fantastis di antara awan.\" (Karya seni oleh Jacky Ke Jiang)";
"sf_art_03_03" = "Kebebasan dan perasaan melayang di atas pulau-pulau berumput dan samudra menjadi tujuan pengembangan yang sangat penting./n(Karya seni oleh Yuichiro Tanabe)";
"sf_art_03_04" = "(Karya seni oleh Yuichiro Tanabe)";
"sf_art_03_05" = "(Karya seni oleh Tiffany Hayashi, Yuichiro Tanabe)";
"sf_art_04_00" = "Tim kami menyadari bahwa tema \"koneksi\" akan menjadi elemen inti dari permainan. Kami membuat prototipe untuk menguji berbagai cara untuk terhubung, termasuk opsi bagi para pemain untuk saling berpegangan tangan. Uji coba ini menjadi tonggak penting dalam pengembangan game kami.";
"sf_art_04_01" = "(Karya seni oleh Yuichiro Tanabe, Jacky Ke Jiang)";
"sf_art_05_01" = "(Karya seni oleh Tom Zhao)";
"sf_art_05_02" = "(Karya seni oleh Tom Zhao)";
"sf_art_05_03" = "(Karya seni oleh Tom Zhao)";
"sf_art_06_00" = "Pilar permainan inti kami yaitu Keajaiban, Kemanusiaan, dan Komunitas menjadi cara kami untuk menyederhanakan seni, desain, dan cerita. Jika tidak menyentuh pilar-pilar ini, maka hal tersebut tidak akan menjadi hal yang penting bagi Sky.";
"sf_art_06_01" = "KEAJAIBAN. Ada keamanan di pusatnya, tetapi di sekelilingnya terdapat kegelapan.\n(Karya seni oleh Tom Zhao)";
"sf_art_06_02" = "KEMANUSIAAN. Setiap momen lebih baik bersama pemain lain.\n(Karya seni oleh Tom Zhao)";
"sf_art_06_03" = "KOMUNITAS. Perasaan bahwa kamu adalah bagian dari sebuah kelompok global yang berdiri untuk kasih sayang dan kebaikan.\n(Karya seni oleh Tom Zhao)";
"sf_art_07_00" = "Area ini memperkenalkan karya seni awal kerajaan, dan suasana visual dari rangkaian emosi.";
"sf_art_07_01" = "Konsep Pulau Fajar\n(Karya seni oleh Yuichiro Tanabe)";
"sf_art_07_02" = "Konsep Padang Rumput Siang\n(Karya seni oleh Tom Zhao)";
"sf_art_07_03" = "Konsep Hutan Tersembunyi\n(Karya seni oleh Tom Zhao)";
