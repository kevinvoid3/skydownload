"ap26_chase_intro" = "Attrapez l'oiseau bleu pour révéler sa véritable nature.";
"ap26_feather_hint" = "Une plume bleue ! L'oiseau ne doit pas être loin...";
"ap26_fetch01_fragment_intro_00" = "Trouvez les plumes de l'oiseau bleu et la fête sera plus belle !";
"ap26_fetch01_intro_00" = "« Il est un oiseau, d'un bleu saphir...";
"ap26_fetch01_intro_01" = "Suivre l'Adolescent ébouriffé à la citadelle pour y chercher l'oiseau bleu ?";
"ap26_fetch01_intro_02" = "dont le chant ravit les plus belles fêtes. »";
"ap26_fetch01_outro_01" = "« On a trouvé un oiseau, ses plumes sont bleues...";
"ap26_fetch01_outro_02" = "mais il a disparu telle la fumée d'une bougie. »";
"ap26_fetch02_intro_00" = "« Il est un oiseau, du même bleu que les yeux de ma mère...";
"ap26_fetch02_intro_01" = "Suivre la Parente étincelante à la Archives de la Chambre Forte pour y chercher l'Oiseau Bleu ?";
"ap26_fetch02_intro_02" = "dont le chant résonne encore dans nos souvenirs. »";
"ap26_fetch02_mem_01" = "« Ma chère petite-fille, nous avons installé cette balançoire pour toi dans notre arbre préféré. »";
"ap26_fetch02_mem_02" = "« Regarde, tu peux presque t'envoler ! »";
"ap26_fetch02_mem_03" = "« Mon enfant, quelle joie de revenir ici avec toi, après tout ce temps. »";
"ap26_fetch02_outro_02" = "mais plus nous serrions, plus son image se dissipait. »";
"ap26_fetch03_hint_01" = "L'oiseau voudrait peut-être vous voir jouer ensemble !";
"ap26_fetch03_hint_02" = "Mais cette tenue n'est pas celle de la scène...";
"ap26_fetch03_intro_00" = "« Il est un oiseau, bleu comme un tissu indigo...";
"ap26_fetch03_intro_01" = "Suivre la Cousine des confettis au Désert stellaire pour y chercher l'oiseau bleu ?";
"ap26_fetch03_intro_02" = "qui ravit la foule admirative de ses trilles.";
"ap26_fetch03_outro_02" = "mais il s'est déplié comme un fil rebelle. »";
"ap26_fetch04_dialog_01" = "« Cette paisible forêt abrite bien des oiseaux chatoyants. »";
"ap26_fetch04_dialog_02" = "« Nous y trouverons l'oiseau bleu, c'est certain ! »";
"ap26_fetch04_intro_00" = "« Il est un oiseau, aussi bleu qu'une rivière de montagne... »";
"ap26_fetch04_intro_01" = "Suivre le Parent suppliant bûcheron dans la Forêt cachée pour y chercher l'oiseau bleu ?";
"ap26_fetch04_intro_02" = "... dont le chant reflète l'harmonie des lieux. »";
"ap26_fetch04_outro_01" = "« On a trouvé un oiseau, ses plumes sont bleues...";
"ap26_fetch04_outro_02" = "... mais le vent l'a emporté, il n'est resté que le silence. »";
"ap26_fetch05_intro_00" = "« Il est un oiseau, du bleu des étoiles...";
"ap26_fetch05_intro_01" = "Suivre Grand-parent sage divinateur pour chercher l'oiseau bleu ?";
"ap26_fetch05_intro_02" = "... dont le chant claironne la naissance des grandes destinées. »";
"ap26_fetch05_outro_01" = "« On a trouvé un oiseau, ses plumes sont bleues...";
"ap26_fetch05_outro_02" = "... mais comme le destin, l'on n'a aucune prise sur lui. »";
"ap26_fetch05_quest_01" = "« Ces enfants connaissent leur destin et s'apprêtent à naître. »";
"ap26_fetch05_quest_02" = "« D'autres ont besoin que l'oiseau bleu chante leur destinée. »";
"ap26_fetch05_quest_03" = "« Parle-moi de ton destin, mon enfant. »";
"ap26_fetch05_quest_04" = "« Je m'occuperai d'un jardin où pousseront de magnifiques plantes ! »";
"ap26_fetch05_quest_05" = "« Quand je naîtrai, j'inventerai des machines pour soigner les malades ! »";
"ap26_fetch05_quest_06" = "« Je chanterai pour redonner espoir à ceux qui n'en ont plus ! »";
"ap26_fetch05_quest_07" = "« Connaître son destin n'est que le début... »";
"ap26_fetch06_quest_01" = "Qui chérissez-vous encore plus que votre propre santé ?";
"ap26_fetch06_quest_02" = "Dans votre souvenir, quelle est la chose qui vous pousse à avancer ?";
"ap26_fetch06_quest_03" = "Devant votre miroir, qui voyez-vous ?";
"ap26_fetch06_quest_04" = "Pourquoi compromettons-nous notre propre harmonie ?";
"ap26_fetch06_quest_05" = "Combien de temps attendez-vous encore avant de poursuivre votre destin ?";
"ap26_fetch06_quest_06" = "« Où se cache cet oiseau bleu ? »";
