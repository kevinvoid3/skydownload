"drinking_text1" = "Tout le monde s'est démené pour tout organiser cette année !";
"drinking_text10" = "Ça paraît fou, mais tout dans Sky a un squelette ! Des os ! Même les CHEVEUX ont des os !";
"drinking_text11" = "Il paraît qu'à une époque, on pouvait trouver des cupcakes et de la pizza… mais tout a été dévoré.";
"drinking_text12" = "En réalité, je suis le Clone 73. Samantha s'entraîne pour son numéro.";
"drinking_text13" = "J'ai entendu dire il y a longtemps qu'Ash avait laissé de la pizza à l'ananas dans le frigo du bas, mais c'était il y a de nombreuses années.";
"drinking_text14" = "Même les membres du personnel se chamaillaient au sujet de la couleur de certaines capes ! Pouvez-vous deviner lesquelles ?";
"drinking_text15" = "Il y a plus d'animaux de compagnie TGC que d'employés TGC ! Ce sont des chats, pour la plupart.";
"drinking_text16" = "Il y a tellement de petits endroits à explorer par ici !";
"drinking_text17" = "Si vous buvez trop, les toilettes sont en bas. Ne vous en faites pas, vous n’y serez pas aspiré... cette fois-ci.";
"drinking_text18" = "Le studio de musique permet des collaborations musicales avec vos amis !";
"drinking_text2" = "Je les ai vus tout à l'heure, ils étaient en pleins préparatifs pour leurs numéros.";
"drinking_text3" = "Tu savais que les employés de TGC allaient nous présenter un numéro ?!";
"drinking_text4" = "Il paraît que chaque numéro exprime un peu de l'inventivité de son créateur !";
"drinking_text5" = "Il paraît qu'un numéro collectif a lieu 30 minutes après chaque heure.";
"drinking_text6" = "T'as vu les numéros ?! Il se passe des choses incroyables sur scène.";
"drinking_text7" = "Certains aiment jouer avec les Dragons sombres. Mais pas moi. Oh que non !";
"drinking_text8" = "Ça t'est déjà arrivé de regarder à travers la lucarne et de te demander si tout n'était peut-être pas une simulation ?";
"drinking_text9" = "Il y a d'immenses enceintes à côté de la scène. Cette fête est dingue !";
