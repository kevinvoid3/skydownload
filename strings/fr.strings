"ap11_spirit_stretch_03" = "Alors pourquoi l'éteindre après l'avoir allumée ?";
"ap11_spirit_stretch_04" = "J'ai la consigne d'éteindre la lumière quand elle est allumée.";
"ap11_spirit_stretch_05" = "Alors tu n'as pas de chance.";
"ap11_spirit_stretch_06" = "La consigne c'est la consigne.";
