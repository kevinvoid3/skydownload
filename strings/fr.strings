"ap31_fetch_letter_hint1" = "Livrez la lettre de Vincent à Théo";
"ap31_flowertouch_hint1" = "Approchez-vous du tournesol de Théo";
"ap31_fq1_letter1_part1" = "Je me réjouis déjà à l'idée de Noël;";
"ap31_fq1_letter1_part2" = "il y a deux ans, nous avons fait cette promenade dans la neige, un soir,";
"ap31_fq1_letter1_part3" = "t'en souviens-tu encore,";
"ap31_fq1_letter1_part4" = "lorsque nous avons vu la lune se lever au-dessus de Mariënhof ?";
"ap31_fq1_letter2_part1" = "Les mots ne peuvent exprimer le bonheur que je ressens...";
"ap31_fq1_letter2_part2" = "... d'avoir repris la peinture !";
"ap31_fq1_letter2_part3" = "J'y pensais depuis longtemps,";
"ap31_fq1_letter2_part4" = "mais j'ai toujours cru que c'était impossible et hors de ma portée.";
"ap31_fq1_letter3_part1" = "Bêcheurs, semeurs, laboureurs, hommes et femmes...";
"ap31_fq1_letter3_part2" = "Je dois tous les peindre sans relâche.";
"ap31_fq1_letter3_part3" = "Tout ce qui appartient à la vie rurale, je dois l'observer et le dessiner.";
"ap31_fq1_letter3_part4" = "Je ne me sens plus aussi démuni devant la nature qu'autrefois !";
"ap31_fq1_letter4_part1" = "La peinture me vient plus naturellement que je ne l'aurais cru.";
"ap31_fq1_letter4_part2" = "Peut-être que la meilleure chose à faire est de consacrer toute mon énergie à la peinture ?";
"ap31_fq1_letter4_part3" = "Je dois dire...";
"ap31_fq1_letter4_part4" = "que je n'en ai aucune idée.";
"ap31_fq1_letter5_part1" = "Mon argent n'a pas encore totalement disparu,";
"ap31_fq1_letter5_part2" = "mais il m'en reste peu.";
"ap31_fq1_letter5_part3" = "J'ai dû dépenser une somme importante en matériel de peinture.";
"ap31_fq1_letter5_part4" = "J'espère que tu pourras envoyer quelque chose bientôt.";
"ap31_fq2_letter1_part1" = "Je ne savais même pas qui étaient les impressionnistes,";
"ap31_fq2_letter1_part2" = "mais maintenant que je les ai vus,";
"ap31_fq2_letter1_part3" = "et même si je ne faisais pas encore partie de leur cercle,";
"ap31_fq2_letter1_part4" = "J'ai beaucoup admiré certains tableaux impressionnistes...";
"ap31_fq2_letter2_part1" = "Je t'ai envoyé quelques dessins.";
"ap31_fq2_letter2_part2" = "Alors, dis-moi...";
"ap31_fq2_letter2_part3" = "pourquoi mes peintures ne se vendent-elles pas,";
"ap31_fq2_letter2_part4" = "et comment en dessiner qui se vendraient ?";
"ap31_fq2_letter3_part1" = "J’espère faire du progrès";
"ap31_fq2_letter3_part2" = "de façon à ce que tu puisses";
"ap31_fq2_letter3_part3" = "hardiment montrer ce que je fais";
"ap31_fq2_letter3_part4" = "sans te compromettre.";
"ap31_fq3_letter1_part1" = "Je veux faire de vrais progrès cette année...";
"ap31_fq3_letter1_part2" = "Des progrès...";
"ap31_fq3_letter1_part3" = "Pour être honnête,";
"ap31_fq3_letter1_part4" = "j'en ai vraiment besoin.";
"ap31_fq3_letter2_part1" = "Pourtant je calcule tant";
"ap31_fq3_letter2_part2" = "et aujourd’hui encore je trouvais que pour les dix mètres de toile j’avais calculé juste toutes les couleurs";
"ap31_fq3_letter2_part3" = "sauf une seule,";
"ap31_fq3_letter2_part4" = "le jaune primitif.";
"ap31_fq3_letter3_part1" = "Parceque jamais j’ai eu une telle chance, ici la nature est extraordinairement belle.";
"ap31_fq3_letter3_part2" = "Tout et partout.";
"ap31_fq3_letter3_part3" = "La coupole du ciel est d’un bleu admirable, le soleil a un rayonnement de souffre pâle";
"ap31_fq3_letter3_part4" = "et c’est doux et charmant comme la combinaison des bleus celestes et des jaunes dans les Van der Meer de Delft.";
"ap31_fq3_letter3_part5" = "Je ne peux pas peindre aussi beau que cela";
"ap31_fq3_letter3_part6" = "mais cela m’absorbe tant, que je me laisse aller sans penser à aucune règle.";
"ap31_fq3_letter4_part1" = "Dès le commencement j’ai voulu arranger la maison non pas pour moi seul mais de façon à pouvoir loger quelqu’un.";
"ap31_fq3_letter4_part2" = "Naturellement cela m’a mangé la plus grande partie de l’argent.";
"ap31_fq3_letter4_part3" = "Avec le restant j’ai acheté 12 chaises,";
"ap31_fq3_letter4_part4" = "un miroir,";
"ap31_fq3_letter4_part5" = "et des petites choses indispensables.";
"ap31_fq3_letter4_part6" = "Ce qui fait en somme que je pourrai semaine prochaine déjà aller y rester.";
"ap31_fq3_letter5_part1" = "J’ai tant de bonheur avec la maison – avec le travail –";
"ap31_fq3_letter5_part2" = "que j'ose croire que cette joie ne sera pas réservée à moi seule,";
"ap31_fq3_letter5_part3" = "mais que tu les partageras de ton côté en ayant de la veine aussi.";
"ap31_fq3_letter6_part1" = "Je suis fort bien aise de pouvoir me meubler et cela ne peut que m’avancer.";
"ap31_fq4_letter1_part1" = "Comme je serais heureux si d’içi quelque temps Jo est guéri,";
"ap31_fq4_letter1_part2" = "tu pourras venir la voir & voir notre petit!";
"ap31_fq4_letter1_part3" = "Comme nous te l’avions dit nous l’appèlerons comme toi";
"ap31_fq4_letter1_part4" = "& je fais le voeux qu’il puisse être aussi persévérant & aussi courageux que toi.";
"ap31_fq4_letter2_part1" = "Eh bien sais tu ce que j’espère une fois que je me mets à avoir de l’espoir,";
"ap31_fq4_letter2_part2" = "c’est que la famille soit pour toi";
"ap31_fq4_letter2_part3" = "ce qu’est pour moi";
"ap31_fq4_letter2_part4" = "la nature, les mottes de terre, l’herbe, le blé jaune, le paysan.";
"ap31_fq4_letter3_part1" = "A présent cette horreur de la vie est moins prononcée déjà";
"ap31_fq4_letter3_part2" = "et la mélancolie moins aiguë.";
"ap31_fq4_letter3_part3" = "Mais de la volonte je n’en ai encore aucune, des désirs guère ou pas et tout ce qui est de la vie ordinaire,";
"ap31_fq4_letter3_part4" = "le désir par exemple de revoir les amis auquels cependant je pense, presque nul.";
"ap31_fq4_letter4_part1" = "Je travaille d’arrache pied dans ma chambre";
"ap31_fq4_letter4_part2" = "ce qui me fait du bien";
"ap31_fq4_letter4_part3" = "et chasse à ce que je m’imagine";
"ap31_fq4_letter4_part4" = "ces idées abnormales.";
"ap31_fq4_letter5_part1" = "Il y a 6 semaines que je n’ai pas mis le pied dehors,";
"ap31_fq4_letter5_part2" = "même pas dans le jardin.";
"ap31_fq4_letter5_part3" = "La semaine prochaine";
"ap31_fq4_letter5_part4" = "lorsque j’aurai fini les toiles en train";
"ap31_fq4_letter5_part5" = "je vais cependant essayer.";
"ap31_fq4_letter6_part1" = "et que par ci par là moi j’ai trouvé aussi des amis et des choses que j’aime ici.";
"ap31_fq4_letter6_part2" = "Comprendras tu alors";
"ap31_fq4_letter6_part3" = "que tout en trouvant horrible mon mal";
"ap31_fq4_letter6_part4" = "je sens que quand même je me suis fait des attaches";
"ap31_fq4_letter6_part5" = "un peu trop fortes ici";
"ap31_fq4_letter7_part1" = "Et peu à peu puis arriver à considérer la folie en tant qu’etant une maladie comme une autre.";
"ap31_fq4_letter7_part2" = "Puis le changement d’entourage, à ce que j’imagine, me fait du bien.";
"ap31_fq4_letter7_part3" = "Pour autant que je sache le médecin d’ici est enclin à considérer ce que j’ai eu comme une attaque de nature épileptique.";
"ap31_fq4_letter7_part4" = "Mais j’ai pas demandé après.";
"ap31_fq5_date1" = "Six mois plus tard";
"ap31_fq5_date2" = "Deux jours plus tard";
"ap31_fq5_letter1_part1" = "À part l'enfant,";
"ap31_fq5_letter1_part10" = "le montrer et le faire apprécier";
"ap31_fq5_letter1_part11" = "autant que possible,";
"ap31_fq5_letter1_part2" = "il m'a encore confié une tâche,";
"ap31_fq5_letter1_part3" = "celle de conserver intacts, pour l'enfant,";
"ap31_fq5_letter1_part4" = "tous les trésors que Théo et Vincent avaient rassemblés.";
"ap31_fq5_letter1_part5" = "C'est cela aussi, mon travail.";
"ap31_fq5_letter1_part6" = "Je vis entièrement dans mes pensées avec Théo et Vincent.";
"ap31_fq5_letter1_part7" = "Oh, combien leur relation était infiniment tendre, douce et pleine d'amour !";
"ap31_fq5_letter1_part8" = "Quelle affection ils avaient l'un pour l'autre. Comme ils se comprenaient !";
"ap31_fq5_letter1_part9" = "le travail de Vincent...";
"ap31_fq6_diary_part1" = "En plus de l’enfant,";
"ap31_fq6_diary_part2" = "une autre tâche m’a été confiée…";
"ap31_fq6_diary_part3" = "Les tableaux de Vincent.";
"ap31_fq6_diary_part4" = "Je dois les montrer.";
"ap31_fq6_diary_part5" = "Je dois m’assurer qu’ils soient appréciés.";
"ap31_fq6_diary_part6" = "Ces tableaux sont des trésors.";
"ap31_fq6_diary_part7" = "Ils ne peuvent pas être oubliés.";
"ap31_fq6_diary_part8" = "Le monde doit se souvenir de qui il était.";
"ap31_fq6_endletter_1" = "Tu ne dois pas croire que ton travail est sans aucune valeur.";
"ap31_fq6_endletter_2" = "Ne perds pas courage. De meilleurs jours arrivent.";
"ap31_fq6_endletter_3" = "Tu n'es pas seul... Je pense toujours à toi.";
"ap31_fq6_endletter_4" = "Un jour, les gens comprendront ce que tu essaies vraiment de faire.";
"ap31_fq6_epilogue2_part1" = "Sur une période de dix ans, Vincent a produit plus de 800 peintures,";
"ap31_fq6_epilogue2_part2" = "et plus de 1 000 dessins et esquisses.";
"ap31_fq6_epilogue2_part3" = "Il n'a réussi à en vendre que quelques-uns.";
"ap31_fq6_epilogue_part1" = "Johanna a consacré sa vie à faire connaître au grand public les centaines d’œuvres et de lettres de Van Gogh qu’elle avait héritées.";
"ap31_fq6_epilogue_part2" = "Après 15 ans de persistance, une exposition Van Gogh a eu lieu au musée de Stedelijk à Amsterdam.";
"ap31_fq6_epilogue_part3" = "Cela a consolidé la réputation de Vincent en tant qu'artiste.";
"ap31_fq6_epilogue_part4" = "À ce jour, c’est la plus grande exposition Van Gogh, avec plus de 230 tableaux.";
