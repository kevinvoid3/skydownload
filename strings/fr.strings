"ap14_story_tree_0" = "Il était une fois...";
"ap14_story_tree_1a" = "Une étoile scintillante";
"ap14_story_tree_1a2a" = "Qui devenait de plus en plus brillante";
"ap14_story_tree_1a2a3a" = "Elle ne pouvait plus contenir la lumière en elle";
"ap14_story_tree_1a2a3a4a" = "Elle se brisa, donnant aux autres l'éclat qu'elle a accumulé au cours des éons.";
"ap14_story_tree_1a2a3a4a_abv" = "Elle se brisa...";
"ap14_story_tree_1a2a3a4a_cont" = "Le ciel nocturne brillait de mille feux. Là où brillait une étoile, d'innombrables piqûres d'épingle venaient d'émerger.";
"ap14_story_tree_1a2a3a4a_cont_abv" = "Le ciel nocturne brillait de mille feux...";
"ap14_story_tree_1a2a3a4b" = "Il allouait sa lumière à un enfant solitaire qui errait dans le désert";
"ap14_story_tree_1a2a3a4b_abv" = "Il allouait sa lumière...";
"ap14_story_tree_1a2a3a4b_cont" = "Guidé par sa lumière, l'enfant vit le chemin à suivre. Désormais, il ne serait plus jamais seul.";
"ap14_story_tree_1a2a3a4b_cont_abv" = "Guidé par sa lumière...";
"ap14_story_tree_1a2a3a_abv" = "Elle ne pouvait plus contenir...";
"ap14_story_tree_1a2a3a_cont" = "Dans un acte désintéressé...";
"ap14_story_tree_1a2a3b" = "Sa lumière enveloppait le ciel entier";
"ap14_story_tree_1a2a3b4a" = "Elle ne pouvait rien voir d'autre que l'éclat aveuglant de ses rayons";
"ap14_story_tree_1a2a3b4a_abv" = "Elle ne pouvait rien voir...";
"ap14_story_tree_1a2a3b4a_cont" = "Silencieuse et seule, elle tamisa sa lumière jusqu'à ce que les figures reviennent. Elle savait que sans rien sur quoi briller, son éclat était inutile.";
"ap14_story_tree_1a2a3b4a_cont_abv" = "Silencieuse et seule...";
"ap14_story_tree_1a2a3b4b" = "Elle vit un enfant errant d'un pas décidé dans le désert illuminé";
"ap14_story_tree_1a2a3b4b_abv" = "Elle vit un enfant...";
"ap14_story_tree_1a2a3b4b_cont" = "Rayonnante de fierté, elle brilla merveilleusement jusqu'à ce que l'enfant trouve refuge dans un temple. Contente de l'avoir aidé, elle s'est enfin reposée.";
"ap14_story_tree_1a2a3b4b_cont_abv" = "Rayonnante de fierté...";
"ap14_story_tree_1a2a3b_abv" = "Sa lumière enveloppa...";
"ap14_story_tree_1a2a3b_cont" = "Quand finalement elle regarda en bas...";
"ap14_story_tree_1a2a_cont" = "Jusqu'à ce que...";
"ap14_story_tree_1a2b" = "Elle s'assombrit";
"ap14_story_tree_1a2b3a" = "Sa lumière avait presque disparu des cieux";
"ap14_story_tree_1a2b3a4a" = "Elle éclata en d'innombrables particules de lumière, descendant doucement vers le sol en dessous.";
"ap14_story_tree_1a2b3a4a_abv" = "Elle éclata...";
"ap14_story_tree_1a2b3a4a_cont" = "De ses échos s'envolèrent de magnifiques créatures de lumière. Chaque créature qui disparaissait donnait naissance à la suivante.";
"ap14_story_tree_1a2b3a4a_cont_abv" = "De ses échos...";
"ap14_story_tree_1a2b3a4b" = "Elle commença sa descente vers le sol, brillant d'une lumière plus intense que la lune.";
"ap14_story_tree_1a2b3a4b_abv" = "Elle commença sa descente...";
"ap14_story_tree_1a2b3a4b_cont" = "Un enfant en émergea, une étoile s'était transformée.";
"ap14_story_tree_1a2b3a4b_cont_abv" = "Un enfant en émergea...";
"ap14_story_tree_1a2b3a_cont" = "Mais avant qu'elle ne disparaisse complètement...";
"ap14_story_tree_1a2b3b" = "Un enfant fit un vœu";
"ap14_story_tree_1a2b3b4a" = "Elle rassembla tous ses efforts pour vaciller faiblement une dernière fois.";
"ap14_story_tree_1a2b3b4a_abv" = "Elle rassembla tous ses efforts...";
"ap14_story_tree_1a2b3b4a_cont" = "En voyant ses dernières lueurs, l'enfant ne se sentit plus seul. Désormais rempli d'espoir, il persévéra.";
"ap14_story_tree_1a2b3b4a_cont_abv" = "En voyant ses dernières lueurs...";
"ap14_story_tree_1a2b3b4b" = "Elle consacra sa dernière lumière pour aider l'enfant errant.";
"ap14_story_tree_1a2b3b4b_abv" = "Elle consacra...";
"ap14_story_tree_1a2b3b4b_cont" = "Éclairant une grotte, l'étoile conduit l'enfant à un refuge... comme la prophétie l'avait annoncé.";
"ap14_story_tree_1a2b3b4b_cont_abv" = "Éclairant une grotte...";
"ap14_story_tree_1a2b3b_cont" = "Entendant son appel...";
"ap14_story_tree_1a2b_cont" = "Jusqu'à ce que...";
"ap14_story_tree_1a_cont" = "Chaque nuit...";
"ap14_story_tree_1b" = "Vivait ici un enfant silencieux";
"ap14_story_tree_1b2a" = "Il cherchait un compagnon";
"ap14_story_tree_1b2a3a" = "Ses jambes fatiguées ne pouvaient plus le porter";
"ap14_story_tree_1b2a3a4a" = "Il observa un autre enfant entrer dans une grotte quelconque.";
"ap14_story_tree_1b2a3a4a_abv" = "Il observa un autre enfant...";
"ap14_story_tree_1b2a3a4a_cont" = "Les enfants trouvèrent un compagnon dans l'autre, faisant de la grotte leur maison. Un jour, ils en accueilleraient un autre.";
"ap14_story_tree_1b2a3a4a_cont_abv" = "Les enfants trouvèrent un compagnon...";
"ap14_story_tree_1b2a3a4b" = "Ils remarquèrent que les motifs sur la pierre commençaient à briller.";
"ap14_story_tree_1b2a3a4b_abv" = "Ils remarquèrent que les motifs...";
"ap14_story_tree_1b2a3a4b_cont" = "Les motifs montraient trois personnages voyageant sur des bateaux. L'enfant était destiné à devenir le quatrième.";
"ap14_story_tree_1b2a3a4b_cont_abv" = "Les motifs montraient ...";
"ap14_story_tree_1b2a3a_abv" = "Ses jambes fatiguées...";
"ap14_story_tree_1b2a3a_cont" = "Se reposant à l'ombre d'une curieuse formation rocheuse...";
"ap14_story_tree_1b2a3a_cont_abv" = "Se reposant à l'ombre ...";
"ap14_story_tree_1b2a3b" = "Un temple éclipsait le soleil couchant";
"ap14_story_tree_1b2a3b4a" = "Remarquant l'enfant, la silhouette leva un bâton rayonnant.";
"ap14_story_tree_1b2a3b4a_abv" = "Remarquant l'enfant...";
"ap14_story_tree_1b2a3b4a_cont" = "Une volée d'oiseaux émergea, guidant l'enfant en sécurité. À l'intérieur, il découvrit le sort de son compagnon.";
"ap14_story_tree_1b2a3b4a_cont_abv" = "Une volée d'oiseaux émergea...";
"ap14_story_tree_1b2a3b4b" = "Faiblement, la silhouette s'appuyait sur un bâton tremblant.";
"ap14_story_tree_1b2a3b4b_abv" = "Faiblement, la silhouette...";
"ap14_story_tree_1b2a3b4b_cont" = "L'enfant offrit sa lumière, restaurant la force de la silhouette. Ensemble, ils réuniraient les étoiles.";
"ap14_story_tree_1b2a3b4b_cont_abv" = "L'enfant offrit sa lumière...";
"ap14_story_tree_1b2a3b_abv" = "Un temple éclipsait...";
"ap14_story_tree_1b2a3b_cont" = "De l'intérieur, une figure imposante émergea.";
"ap14_story_tree_1b2a3b_cont_abv" = "De l'intérieur...";
"ap14_story_tree_1b2a_cont" = "Jusqu'à ce que...";
"ap14_story_tree_1b2b" = "Ils traversèrent le désert";
"ap14_story_tree_1b2b3a" = "Ils grimpèrent la plus haute dune de sable";
"ap14_story_tree_1b2b3a4a" = "Ils observèrent une grotte quelconque.";
"ap14_story_tree_1b2b3a4a_cont" = "Une paire de fabricants de bougies apparut les bras ouverts. L'enfant avait enfin trouvé un foyer.";
"ap14_story_tree_1b2b3a4a_cont_abv" = "Une paire de fabricants de bougies ...";
"ap14_story_tree_1b2b3a4b" = "Ils remarquèrent une grotte menaçante.";
"ap14_story_tree_1b2b3a4b_cont" = "Dans les chambres sinistres, ils relevèrent de nombreux défis. Il a été dit qu'ils seraient les premiers à réussir.";
"ap14_story_tree_1b2b3a4b_cont_abv" = "Dans les chambres sinistres...";
"ap14_story_tree_1b2b3a_cont" = "Regardant dehors alors que le soleil illuminait le paysage...";
"ap14_story_tree_1b2b3b" = "Ils tombèrent dans une vallée";
"ap14_story_tree_1b2b3b4a" = "Ils virent une flamme lointaine à l'horizon qui se dirigeait lentement vers eux.";
"ap14_story_tree_1b2b3b4a_abv" = "Ils virent une flamme lointaine...";
"ap14_story_tree_1b2b3b4a_cont" = "L'étranger offrit une bougie de lumière, puis sa main. Un gardien, peut-être même un ami, était arrivé.";
"ap14_story_tree_1b2b3b4a_cont_abv" = "L'étranger offrit...";
"ap14_story_tree_1b2b3b4b" = "Ils levèrent les yeux en quête de secours, et virent une étoile scintillante.";
"ap14_story_tree_1b2b3b4b_abv" = "Ils levèrent les yeux en quête...";
"ap14_story_tree_1b2b3b4b_cont" = "Elle dessina la silhouette d'un temple magnifique. Ils entendirent des cloches, car leur aventure venait de commencer.";
"ap14_story_tree_1b2b3b4b_cont_abv" = "Elle dessina la silhouette...";
"ap14_story_tree_1b2b3b_cont" = "Se réveillant au cœur de la nuit...";
"ap14_story_tree_1b2b_cont" = "Jusqu'à ce que...";
"ap14_story_tree_1b_cont" = "Chaque jour...";
